rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getClaimWorkspaceId() {
      return request.auth.token.get('workspaceId',
        request.auth.token.get('tenantId',
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('workspaceId', '') : ''
        )
      );
    }

    function getClaimRole() {
      return request.auth.token.get('role',
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') : ''
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getClaimRole() in ['SuperAdmin', 'SUPER_ADMIN'] ||
        request.auth.token.get('isSuperAdmin', false) == true ||
        (exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.get('active', false) == true)
      );
    }

    function hasRole(role) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getClaimRole() == role ||
        (role == 'SuperAdmin' && getClaimRole() in ['SuperAdmin', 'SUPER_ADMIN']) ||
        (role == 'Trustee' && getClaimRole() in ['Trustee', 'TRUSTEE', 'SUPER_ADMIN']) ||
        (role == 'Accountant' && getClaimRole() in ['Accountant', 'ACCOUNTANT']) ||
        (role == 'Priest' && getClaimRole() in ['Priest', 'PRIEST', 'PUROHIT']) ||
        (role == 'Sevadar' && getClaimRole() in ['Sevadar', 'SEVADAR', 'VOLUNTEER', 'MANAGER']) ||
        (role == 'Devotee' && getClaimRole() in ['Devotee', 'DEVOTEE'])
      );
    }

    function isDemoWorkspace(workspaceId) {
      return workspaceId != null && workspaceId.matches('^DEMO_.*');
    }

    function isTenantUser(workspaceId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isDemoWorkspace(workspaceId) && getClaimWorkspaceId() == workspaceId) ||
        (workspaceId != null && workspaceId != '' && getClaimWorkspaceId() == workspaceId) ||
        workspaceId == 'PUROHIT_' + request.auth.uid
      );
    }

    function isTenantAdmin(workspaceId) {
      return isTenantUser(workspaceId) && (isSuperAdmin() || hasRole('Trustee'));
    }

    function isBlocked() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', null) == 'BLOCKED')
      );
    }

    match /platform_admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /platform_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /global_purohits/{purohitId} {
      allow read: if isAuthenticated();
      allow write: if (isAuthenticated() && request.auth.uid == purohitId) || isSuperAdmin();
    }

    match /upgrade_requests/{reqId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['admin', 'isGlobalAdmin', 'status'])
        && (
           !request.resource.data.keys().hasAny(['workspaceId', 'defaultWorkspaceId', 'role', 'membership'])
           || isDemoWorkspace(request.resource.data.get('workspaceId', null))
        );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId && !isBlocked()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'isGlobalAdmin', 'status', 'role', 'workspaceId', 'defaultWorkspaceId', 'membership'])
      );
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isTenantUser(workspaceId);
      allow create: if isAuthenticated();
      allow update: if isTenantAdmin(workspaceId) || (isDemoWorkspace(workspaceId) && isAuthenticated());
      allow delete: if isSuperAdmin();
    }

    match /devotees/{devoteeId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Sevadar') || hasRole('Priest') || hasRole('Accountant') ||
        resource.data.get('userId', '') == request.auth.uid || devoteeId == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Sevadar') ||
        (hasRole('Devotee') && (request.resource.data.get('userId', '') == request.auth.uid || devoteeId == request.auth.uid))
      );
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId && (
          hasRole('Trustee') || hasRole('Sevadar') ||
          (hasRole('Devotee') && (resource.data.get('userId', '') == request.auth.uid || devoteeId == request.auth.uid))
        );
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /households/{householdId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Sevadar') || hasRole('Priest') || hasRole('Accountant') ||
        resource.data.get('kartaId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Sevadar') ||
        (hasRole('Devotee') && (request.resource.data.get('kartaId', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid))
      );
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId && (
          hasRole('Trustee') || hasRole('Sevadar') ||
          (hasRole('Devotee') && (resource.data.get('kartaId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid))
        );
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /donations/{donationId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Accountant') || resource.data.get('donorId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Accountant') ||
        (hasRole('Devotee') && request.resource.data.get('donorId', '') == request.auth.uid && request.resource.data.get('status', '') == 'pledged')
      );
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /treasury_ledgers/{docId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Accountant') || resource.data.get('devoteeId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow delete: if false;
    }

    match /treasury/{docId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Accountant') || resource.data.get('devoteeId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow delete: if false;
    }

    match /tax_receipts/{receiptId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Accountant') || resource.data.get('donorId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow delete: if false;
    }

    match /inventory_items/{itemId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /inventory/{itemId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /fixed_assets/{assetId} {
      allow read: if isTenantUser(resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow create, update: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant')) &&
        (resource == null || request.resource.data.workspaceId == resource.data.workspaceId);
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /assets/{assetId} {
      allow read: if isTenantUser(resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant') || hasRole('Sevadar'));
      allow create, update: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant')) &&
        (resource == null || request.resource.data.workspaceId == resource.data.workspaceId);
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /puja_bookings/{bookingId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
        resource.data.get('devoteeId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
        (hasRole('Devotee') && (request.resource.data.get('devoteeId', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid))
      );
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId && (
          hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
          (hasRole('Devotee') && (resource.data.get('devoteeId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid))
        );
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /poojaBookings/{bookingId} {
      allow read: if isTenantUser(resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
        resource.data.get('devoteeId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isTenantUser(request.resource.data.workspaceId) && (
        hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
        (hasRole('Devotee') && (request.resource.data.get('devoteeId', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid))
      );
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId && (
          hasRole('Trustee') || hasRole('Priest') || hasRole('Sevadar') ||
          (hasRole('Devotee') && (resource.data.get('devoteeId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid))
        );
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /gaushala_cattle/{cattleId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /cows/{cattleId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /dharamshala_rooms/{roomId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /rooms/{roomId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (hasRole('Trustee') || hasRole('Sevadar'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /audit_logs/{logId} {
      allow read: if isTenantUser(resource.data.workspaceId) &&
        (hasRole('Trustee') || hasRole('Accountant'));
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /crisis_events/{eventId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId);
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (isSuperAdmin() || hasRole('Trustee'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);
    }

    match /panchayat_polls/{pollId} {
      allow read: if isTenantUser(resource.data.workspaceId);
      allow create: if isTenantUser(request.resource.data.workspaceId) &&
        (isSuperAdmin() || hasRole('Trustee'));
      allow update: if isTenantUser(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        (isSuperAdmin() || hasRole('Trustee'));
      allow delete: if isTenantAdmin(resource.data.workspaceId);

      match /votes/{userId} {
        allow read: if isTenantUser(get(/databases/$(database)/documents/panchayat_polls/$(pollId)).data.workspaceId) &&
          (hasRole('Trustee') || request.auth.uid == userId);
        allow create: if isTenantUser(get(/databases/$(database)/documents/panchayat_polls/$(pollId)).data.workspaceId) &&
          request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/panchayat_polls/$(pollId)/votes/$(userId));
        allow update, delete: if false;
      }
    }

    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasRole('Trustee');
    }

    match /yatra_broadcasts/{bId} {
      allow read: if isSuperAdmin() || isTenantUser(resource.data.get('communityId', null));
      allow create: if isSuperAdmin() || isTenantUser(request.resource.data.get('communityId', null));
      allow update: if isSuperAdmin() || (
        isTenantUser(resource.data.get('communityId', null)) &&
        request.resource.data.get('communityId', null) == resource.data.get('communityId', null)
      );
      allow delete: if isSuperAdmin();
    }

    match /global_support_threads/{tId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /global_support_replies/{rId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource == null || (resource.data.participants != null && request.auth.uid in resource.data.participants)) ||
          hasRole('Trustee')
        )
      );
      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
          hasRole('Trustee')
        )
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.participants != null && request.auth.uid in resource.data.participants && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])) ||
          hasRole('Trustee')
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (
          isAuthenticated() && (
            (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
            hasRole('Trustee')
          )
        );
        allow create: if isSuperAdmin() || (
          isAuthenticated() && (
            (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && request.resource.data.senderId == request.auth.uid) ||
            hasRole('Trustee')
          )
        );
        allow update, delete: if false;
      }
    }

    match /communities/{communityId}/{collectionName}/{docId} {
      allow read: if isTenantUser(communityId);
      allow write: if isTenantUser(communityId) && (
        collectionName in ['vivah_profiles', 'vivah_connections', 'sadhana_logs', 'social_feed', 'yatra_social_feed', 'purohit_gigs', 'purohit_applications'] ||
        isDemoWorkspace(communityId) ||
        hasRole('Trustee') || hasRole('Priest')
      );
    }

    match /{collection}/{docId} {
      allow read: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords'] && (
        isSuperAdmin() || (
          isTenantUser(resource.data.workspaceId) && (
            isDemoWorkspace(resource.data.workspaceId) ||
            hasRole('Trustee') || hasRole('Sevadar') || hasRole('Priest') || hasRole('Accountant') ||
            docId == request.auth.uid
          )
        )
      );
      allow create: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords'] && (
        isSuperAdmin() || (
          isTenantUser(request.resource.data.workspaceId) && (
            isDemoWorkspace(request.resource.data.workspaceId) ||
            hasRole('Trustee') || hasRole('Sevadar') || hasRole('Priest') || hasRole('Accountant')
          )
        )
      );
      allow update: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords'] && (
        isSuperAdmin() || (
          isTenantUser(resource.data.workspaceId) &&
          request.resource.data.workspaceId == resource.data.workspaceId && (
            isDemoWorkspace(resource.data.workspaceId) ||
            hasRole('Trustee') || hasRole('Sevadar') || hasRole('Priest') || hasRole('Accountant')
          )
        )
      );
      allow delete: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords'] && (
        isSuperAdmin() || (
          isTenantUser(resource.data.workspaceId) &&
          (isDemoWorkspace(resource.data.workspaceId) || hasRole('Trustee'))
        )
      );
    }
  }
}
