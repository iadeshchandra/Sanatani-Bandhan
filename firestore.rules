// Sanatani Bandhan — Hardened Firestore Security Rules. DENY-BY-DEFAULT.
// Source-dieted 2026-11-24 (comments stripped to fit the 262,144-byte source cap;
// token stream verified identical — behaviour unchanged). Full commented source in git history.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAnonymous() {
      return isLoggedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isSuperAdmin() {
      return isLoggedIn() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role in ['SuperAdmin', 'SUPER_ADMIN'] ||
        (request.auth.token.roles is list &&
          request.auth.token.roles.hasAny(['SuperAdmin', 'SUPER_ADMIN'])) ||
        (exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
          docGet(/databases/$(database)/documents/platform_admins/$(request.auth.uid), 'active', true) != false)
      );
    }

    function isOwner() {
      return isSelf('sxIGHmvpYUTqPnpI1bLFT1O1cA62');
    }

    function effTenant() {
      return request.auth == null ? null :
        (request.auth.token.tenantId != null ? request.auth.token.tenantId :
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            docGet(/databases/$(database)/documents/users/$(request.auth.uid), 'workspaceId', null) : null));
    }

    function roleIn(roles) {
      return request.auth != null && (
        request.auth.token.role in roles ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(roles)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          docGet(/databases/$(database)/documents/users/$(request.auth.uid), 'role', null) in roles)
      );
    }

    function isDemoWs(id) {
      return id != null && id.matches('^DEMO_.*');
    }

    function isRegionId(v) {
      return v == '' || v in ['tamil-nadu', 'karnataka', 'andhra-telangana',
        'kerala', 'maharashtra', 'gujarat', 'west-bengal', 'bangladesh',
        'hindi-belt', 'punjab', 'odisha', 'assam', 'northeast',
        'global-diaspora', 'other'];
    }

    function wsMemberPath(tenantId) {
      return /databases/$(database)/documents/workspaceMembers/$(tenantId + '_' + request.auth.uid);
    }
    function isWsMember(tenantId) {
      return isLoggedIn() && tenantId != null && exists(wsMemberPath(tenantId));
    }
    function wsMemberRoleIn(tenantId, roles) {
      return isWsMember(tenantId)
        && docGet(wsMemberPath(tenantId), 'role', null) in roles;
    }
    function isTenantMember(tenantId) {
      return isLoggedIn() && tenantId != null && (
        isSuperAdmin() ||
        tenantId == effTenant() ||
        effTenant() == '*' ||
        isWsMember(tenantId)
      );
    }

    function hasRole(tenantId, roles) {
      return isSuperAdmin()
        || (isTenantMember(tenantId) && (roleIn(roles) || wsMemberRoleIn(tenantId, roles)));
    }

    function isOrgTrustee(orgId) {
      return isLoggedIn() && orgId != null && orgId != '' && (
        isSuperAdmin() ||
        (isTenantMember(orgId) && (
          roleIn(R_TRUSTEE()) ||
          wsMemberRoleIn(orgId, R_TRUSTEE())
        ))
      );
    }

    function chatOrgId(chatData) {
      return chatData.get('orgId', '') != '' ? chatData.get('orgId', '') :
        (chatData.get('participants', null) is list &&
         chatData.get('participants', []).size() == 2 ?
         chatData.get('participants', [])[1] : '');
    }

    function isChatOrgTrustee(chatData) {
      return chatData.get('type', '') == 'org' &&
        isOrgTrustee(chatOrgId(chatData));
    }

    function grantableRole(orgId, targetRole) {
      return isSuperAdmin() || (
        isOrgTrustee(orgId) &&
        !(targetRole in R_TRUSTEE()) &&
        targetRole in ['Priest', 'PRIEST', 'PUROHIT', 'Accountant', 'ACCOUNTANT',
          'Sevadar', 'SEVADAR', 'Devotee', 'DEVOTEE', 'Member', 'MEMBER',
          'CSO', 'Manager', 'MANAGER', 'Auditor', 'AUDITOR']
      );
    }

    function demoPublicRead(wsId) {
      return isDemoWs(wsId) && (request.auth == null || effTenant() == wsId || isSuperAdmin());
    }
    function demoWriteOk(wsId) {
      return isLoggedIn() && isDemoWs(wsId);
    }

    function docWs() {
      return tkOldGet('workspaceId', null);
    }
    function newDocWs() {
      return tkNewGet('workspaceId', null);
    }
    function wsImmutable() {
      return newDocWs() == docWs();
    }

    function festRsvpPath(eventId) {
      return /databases/$(database)/documents/festival_rsvps/$(eventId + '__' + request.auth.uid);
    }

    function festRsvpShapeOk() {
      return reqWorkspaceId() != ''
        && tkNewGet('eventId', '') != ''
        && reqName().size() >= 2
        && reqName().size() <= 80
        && tkNewGet('headcount', 0) >= 1
        && tkNewGet('headcount', 0) <= 20
        && (!('days' in reqData())
            || (tkNewGet('days', []) is list
                && tkNewGet('days', []).size() <= 14))
        && request.resource.data.keys().hasOnly(
             ['eventId', 'workspaceId', 'uid', 'name', 'headcount', 'slotId', 'createdAt',
              'status', 'days', 'ticketId']);
    }
    function festBooked(data, slotId) {
      return data.get('slotBooked', {}).get(slotId, 0);
    }

    function festSlotMoveOk(oldData, newData, slotBefore, slotAfter, hcBefore, hcAfter) {
      return slotBefore == slotAfter
        ? (slotAfter == ''
            || (festBooked(newData, slotAfter) == festBooked(oldData, slotAfter) + (hcAfter - hcBefore)
                && festBooked(newData, slotAfter) >= 0))
        : (festBooked(newData, slotBefore) == festBooked(oldData, slotBefore) - hcBefore
            && festBooked(newData, slotBefore) >= 0
            && festBooked(newData, slotAfter) == festBooked(oldData, slotAfter) + hcAfter);
    }

    function festSlotCapacityOk(oldData, newData, slotAfter) {
      return slotAfter == ''
        || !('slotCaps' in newData)
        || festBooked(newData, slotAfter) <= festBooked(oldData, slotAfter)
        || festBooked(newData, slotAfter) <= newData.get('slotCaps', {}).get(slotAfter, 0);
    }

    function festEffHc(data) {
      return data.get('status', 'confirmed') == 'waitlisted' ? 0 : data.get('headcount', 0);
    }

    function festWlSlotOk(oldWl, newWl, slotId, uid, delta) {
      let o = oldWl.get(slotId, {});
      let n = newWl.get(slotId, {});
      return delta == 1
        ? (n.diff(o).addedKeys().hasOnly([uid])
            && n.diff(o).removedKeys().size() == 0
            && n.diff(o).changedKeys().size() == 0
            && n.size() == o.size() + 1)
        : delta == -1
          ? (n.diff(o).removedKeys().hasOnly([uid])
              && n.diff(o).addedKeys().size() == 0
              && n.diff(o).changedKeys().size() == 0
              && n.size() + 1 == o.size())
          : n == o;
    }

    function festWaitlistOk(oldData, newData, slotBefore, slotAfter, uid, wasWl, isWl) {
      let oldWl = oldData.get('slotWaitlist', {});
      let newWl = newData.get('slotWaitlist', {});
      let dBefore = (wasWl && slotBefore != '' ? -1 : 0) + (isWl && slotAfter == slotBefore && slotBefore != '' ? 1 : 0);
      let dAfter = slotAfter != slotBefore ? (isWl && slotAfter != '' ? 1 : 0) : dBefore;
      return diffKeysOnly(newWl, oldWl, [slotBefore, slotAfter])
        && festWlSlotOk(oldWl, newWl, slotBefore, uid, slotBefore == slotAfter ? dAfter : dBefore)
        && (slotAfter == slotBefore || festWlSlotOk(oldWl, newWl, slotAfter, uid, dAfter));
    }

    function festCounterOk(eventId, rp, uid, anchorKey) {
      let had = exists(rp);
      let has = existsAfter(rp);
      let hcBefore = had ? festEffHc(docData(rp)) : 0;
      let hcAfter = has ? festEffHc(tkAfterData(rp)) : 0;
      let slotBefore = had ? docGet(rp, 'slotId', '') : '';
      let slotAfter = has ? afterDocGet(rp, 'slotId', '') : '';
      let wasWl = had && docGet(rp, 'status', 'confirmed') == 'waitlisted';
      let isWl = has && afterDocGet(rp, 'status', 'confirmed') == 'waitlisted';
      return (anchorKey == '' || tkDeskSaleWitnessOk(eventId, uid))
        && (had || has)
        && diffKeys()
             .hasOnly(['rsvpHeadcount', 'slotBooked', 'slotWaitlist', 'updatedAt', anchorKey])
        && tkNewGet('rsvpHeadcount', 0)
             == tkOldGet('rsvpHeadcount', 0) + (hcAfter - hcBefore)
        && tkNewGet('rsvpHeadcount', 0) >= 0
        && tkNewGet('slotBooked', {}).diff(tkOldGet('slotBooked', {}))
             .affectedKeys().hasOnly([slotBefore, slotAfter])
        && festSlotMoveOk(resource.data, reqData(), slotBefore, slotAfter, hcBefore, hcAfter)
        && festSlotCapacityOk(resource.data, reqData(), slotAfter)
        && festWaitlistOk(resource.data, reqData(), slotBefore, slotAfter, uid, wasWl, isWl);
    }
    function anchoredFestivalCounter(eventId) {
      return festCounterOk(eventId, festRsvpPath(eventId), request.auth.uid, '');
    }

    function tkDeskSaleWitnessOk(eventId, auid) {
      let rp = /databases/$(database)/documents/festival_rsvps/$(eventId + '__' + auid);
      let tid = existsAfter(rp) ? afterDocGet(rp, 'ticketId', '') : '';
      let tp = ticketPath(tid);
      let tk = tid != '' && existsAfter(tp) ? tkAfterData(tp)
        : (tid != '' && exists(tp) ? docData(tp) : {});
      return auid.matches('desk_.+')
        && tk.size() > 0
        && tk.get('deskSale', false) == true
        && uidIs(tk.get('recordedBy', ''))
        && tkBuyerOf(tk) == auid
        && tkFestOf(tk) == eventId;
    }

    function anchoredDeskCounter(eventId) {
      let auid = tkNewGet('rsvpAnchorUid', '');
      return festCounterOk(eventId,
        /databases/$(database)/documents/festival_rsvps/$(eventId + '__' + auid),
        auid, 'rsvpAnchorUid');
    }

    function tkDiff(keys) {
      return diffKeysOnly(request.resource.data, resource.data, keys);
    }
    function tkNewGet(k, dv) {
      return request.resource.data.get(k, dv);
    }
    function tkOldGet(k, dv) {
      return resource.data.get(k, dv);
    }
    function tkStateOf(m) {
      return m.get('paymentState', '');
    }
    function tkBuyerOf(m) {
      return m.get('buyerUid', '');
    }
    function tkFestOf(m) {
      return m.get('festivalId', '');
    }
    function tkTierOf(m) {
      return m.get('tierId', '');
    }
    function tkWsOf(m) {
      return m.get('workspaceId', '');
    }
    function tkTrStateOf(m) {
      return m.get('transferState', '');
    }
    function tkPlanCfg(m) {
      return m.get('ticketing', {});
    }
    function tkTotalOf(m) {
      return m.get('amounts', {}).get('total', 0);
    }
    function tkUseCount(m, code) {
      return m.get('discountUses', {}).get(code, 0);
    }
    function tkAfterData(tp) {
      return getAfter(tp).data;
    }
    function tkLadMin(lad, i) {
      return lad[i].get('minDaysBefore', 0);
    }
    function tkLadPct(lad, i) {
      return lad[i].get('percent', 0);
    }
    function tkPlanRes() {
      return docData(/databases/$(database)/documents/festival_plans/$(tkOldGet('festivalId', '')));
    }
    function tkStaffVenue() {
      return hasRole(docWs(), R_ANY_STAFF())
        && tkOldGet('paymentState', '') == 'pay-at-venue';
    }
    function tkBuyerGuard() {
      return loggedUidIs(tkOldGet('buyerUid', ''));
    }
    function tkIsTransferTo() {
      return uidIs(tkOldGet('transferToUid', ''));
    }
    function ticketPath(ticketId) {
      return /databases/$(database)/documents/event_tickets/$(ticketId);
    }
    function tkEffQty(data) {
      return data.get('paymentState', '') in ['paid-wallet', 'pay-at-venue', 'comp']
        ? data.get('qty', 0) : 0;
    }

    function anchoredTierCounter(eventId) {
      let tid = tkNewGet('tierAnchorTicketId', '');
      let tp = ticketPath(tid);
      let had = exists(tp);
      let has = existsAfter(tp);
      let qBefore = had ? tkEffQty(docData(tp)) : 0;
      let qAfter = has ? tkEffQty(tkAfterData(tp)) : 0;
      let tierId = has ? tkTierOf(tkAfterData(tp))
        : (had ? tkTierOf(docData(tp)) : '');
      let soldBefore = tkOldGet('tierSold', {});
      let soldAfter = tkNewGet('tierSold', {});
      return tid != ''
        && (had || has)
        && (has ? tkFestOf(tkAfterData(tp)) == eventId
                : tkFestOf(docData(tp)) == eventId)
        && diffKeys().hasOnly(['tierSold', 'tierAnchorTicketId', 'updatedAt'])
        && diffKeysOnly(soldAfter, soldBefore, [tierId])
        && soldAfter.get(tierId, 0) == soldBefore.get(tierId, 0) + (qAfter - qBefore)
        && soldAfter.get(tierId, 0) >= 0
        && (!('tierCaps' in reqData())
            || !(tierId in tkNewGet('tierCaps', {}))
            || soldAfter.get(tierId, 0) <= tkNewGet('tierCaps', {}).get(tierId, 0));
    }

    function tkUnitPrice(tk, tierId) {
      let early = tk.get('tierEarly', {}).get(tierId, {});
      return (early.size() > 0 && request.time.toMillis() <= early.get('untilMs', 0))
        ? early.get('price', 0) : tk.get('tierPrices', {}).get(tierId, -1);
    }
    function tkDisc(tk, code, price) {
      let cm = tk.get('codeMap', {}).get(code, {});
      let v = cm.get('value', 0);
      let k = cm.get('kind', '');
      return code == '' ? 0
        : k == 'flat' ? (v < price ? v : price)
        : k == 'percent' ? (price * v) / 100
        : k == 'full' ? price : -1;
    }
    function tkCodeOk(tk, code) {
      let cm = tk.get('codeMap', {}).get(code, {});
      return cm.size() > 0
        && (!('maxUses' in cm)
            || tkUseCount(tk, code) < cm.get('maxUses', 0));
    }
    function tkAmountsOk(d, ev, plan) {
      let tk = tkPlanCfg(plan);
      let code = d.get('discountCode', '');
      let price = tkUnitPrice(tk, tkTierOf(d)) * d.get('qty', 0);
      let disc = tkDisc(tk, code, price);
      let fee = (price - disc) * 5 / 100;
      let gst = d.get('currency', '') == 'INR' ? fee * 18 / 100 : 0;
      let total = (price - disc) + (ev.get('ticketFeeBearer', 'organiser') == 'buyer' ? fee + gst : 0);
      let a = d.get('amounts', {});
      return tk.get('tierPrices', {}).get(tkTierOf(d), -1) >= 0
        && disc >= 0 && disc <= price
        && a.get('price', -1) == price
        && a.get('discount', -1) == disc
        && a.get('fee', -1) == fee
        && a.get('gst', -1) == gst
        && a.get('total', -1) == total
        && ((total <= 0 && tkStateOf(d) == 'comp')
            || (total > 0 && tkStateOf(d) in ['paid-wallet', 'pay-at-venue']))
        && (code == '' || tkCodeOk(tk, code));
    }

    function tkCreateShapeOk(d, plan) {
      return tkShapeOk(d, plan, request.auth.uid);
    }
    function tkShapeOk(d, plan, rsvpUid) {
      let tk = tkPlanCfg(plan);
      let kind = tk.get('tierKinds', {}).get(tkTierOf(d), '');
      let qty = d.get('qty', 0);
      return kind != ''
        && qty >= 1
        && qty <= tk.get('tierMax', {}).get(tkTierOf(d), 6)
        && qty <= 20
        && d.get('attendees', []) is list
        && d.get('currency', '') in ['INR', 'BDT', 'USD']
        && d.get('buyerName', '').size() >= 1
        && (kind == 'addon'
            ? (d.get('attendees', []).size() == 0 && !('rsvpId' in d))
            : (d.get('attendees', []).size() == qty
               && d.get('rsvpId', '') == tkFestOf(d) + '__' + rsvpUid));
    }
    function tkDeskShapeOk(d, plan) {
      return tkShapeOk(d, plan, tkBuyerOf(d));
    }

    function tkRefundPct(plan, ev) {
      let lad = tkPlanCfg(plan).get('refundLadder', []);
      let days = (tkPlanCfg(plan).get('startMs', 0) - request.time.toMillis()) / 86400000;
      return ev.get('festivalCancelled', false) == true ? 100
        : lad.size() == 0 ? 0
        : days >= tkLadMin(lad, 0) ? tkLadPct(lad, 0)
        : lad.size() > 1 && days >= tkLadMin(lad, 1) ? tkLadPct(lad, 1)
        : lad.size() > 2 && days >= tkLadMin(lad, 2) ? tkLadPct(lad, 2)
        : lad.size() > 3 && days >= tkLadMin(lad, 3) ? tkLadPct(lad, 3)
        : lad.size() > 4 && days >= tkLadMin(lad, 4) ? tkLadPct(lad, 4)
        : tkLadPct(lad, lad.size() - 1);
    }

    function tkBuyerCancelOk() {
      let plan = tkPlanRes();
      let ev = docData(/databases/$(database)/documents/festival_events/$(tkFestOf(resource.data)));
      let pct = tkRefundPct(plan, ev);
      let due = (tkTotalOf(resource.data) * pct) / 100;
      let ns = tkStateOf(reqData());
      return tkDiff(['paymentState', 'refundAmount', 'refundedAt', 'updatedAt'])
        && ((ns == 'refunded'
             && tkStateOf(resource.data) == 'paid-wallet'
             && due > 0
             && tkNewGet('refundAmount', 0) == due)
          || (ns == 'cancelled'
              && (tkStateOf(resource.data) != 'paid-wallet' || due == 0)));
    }

    function tkAcceptOk() {
      let plan = tkPlanRes();
      return tkTrStateOf(resource.data) == 'offered'
        && tkIsTransferTo()
        && uidIs(tkBuyerOf(reqData()))
        && tkNewGet('transferFromUid', '') == tkBuyerOf(resource.data)
        && !('transferToUid' in reqData())
        && !('transferState' in reqData())
        && tkDiff(['buyerUid', 'buyerName', 'transferFromUid', 'transferredAt',
             'transferToUid', 'transferToName', 'transferState', 'offeredAt', 'rsvpId', 'updatedAt'])
        && request.time.toMillis() < tkPlanCfg(plan).get('startMs', 0);
    }

    function tkWalletDebitOk() {
      let data = reqData();
      let old = resource.data;
      let tid = data.get('lastDebitTicketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      let total = tkTotalOf(tk);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitTicketId', 'currency'])
        && tid != '' && tid != old.get('lastDebitTicketId', '')
        && existsAfter(tp)
        && uidIs(tkBuyerOf(tk))
        && tkStateOf(tk) == 'paid-wallet'
        && total > 0
        && data.get('balance', -1) == old.get('balance', 0) - total
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + total;
    }

    function tkWalletRefundOk(uid) {
      let data = reqData();
      let old = resource.data;
      let tid = data.get('lastRefundTicketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      let amt = tk.get('refundAmount', 0);
      return diffKeysOnly(data, old, ['balance', 'totalReceived', 'updatedAt', 'lastRefundTicketId', 'currency'])
        && tid != '' && tid != old.get('lastRefundTicketId', '')
        && existsAfter(tp)
        && tkBuyerOf(tk) == uid
        && tkStateOf(tk) == 'refunded'
        && amt > 0
        && data.get('balance', -1) == old.get('balance', 0) + amt
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + amt;
    }

    function anchoredDiscountUse(planId) {
      let oldTk = tkPlanCfg(resource.data);
      let newTk = tkPlanCfg(reqData());
      let evAfter = tkAfterData(/databases/$(database)/documents/festival_events/$(planId));
      let tp = ticketPath(evAfter.get('tierAnchorTicketId', ''));
      let tk = tkAfterData(tp);
      let code = tk.get('discountCode', '');
      let cm = oldTk.get('codeMap', {}).get(code, {});
      return code != ''
        && !exists(tp) && existsAfter(tp)
        && tkFestOf(tk) == planId
        && uidIs(tkBuyerOf(tk))
        && tkDiff(['ticketing'])
        && diffKeysOnly(newTk, oldTk, ['discountUses'])
        && diffKeysOnly(newTk.get('discountUses', {}), oldTk.get('discountUses', {}), [code])
        && tkUseCount(newTk, code) == tkUseCount(oldTk, code) + 1
        && (!('maxUses' in cm) || tkUseCount(newTk, code) <= cm.get('maxUses', 0));
    }

    function tkReleaseOpen(ev) {
      return ev.get('ticketReleaseAtMs', 0) <= 0
        || request.time.toMillis() >= ev.get('ticketReleaseAtMs', 0);
    }

    function dipPath(festivalId, tierId, uid) {
      return /databases/$(database)/documents/event_dip_entries/$(festivalId + '__' + tierId + '__' + uid);
    }
    function dipIsDipTier(ev, tierId) {
      return ev.get('dipOpensAtMs', {}).get(tierId, 0) > 0;
    }
    function tkDipOk(d, ev) {
      let tierId = tkTierOf(d);
      let ep = dipPath(tkFestOf(d), tierId, request.auth.uid);
      return !dipIsDipTier(ev, tierId)
        || (exists(ep)
            && docGet(ep, 'status', '') == 'selected'
            && ev.get('dipDraws', {}).get(tierId, {}).get('claimByMs', 0)
                 >= request.time.toMillis());
    }

    function tkDocsAgreeOk(d, ev, plan) {
      return tkWsOf(d) != ''
        && tkFestOf(d) != ''
        && tkWsOf(ev) == tkWsOf(d)
        && tkWsOf(plan) == tkWsOf(d);
    }
    function tkCreateOk() {
      let d = reqData();
      let ev = docData(/databases/$(database)/documents/festival_events/$(tkFestOf(d)));
      let plan = docData(/databases/$(database)/documents/festival_plans/$(tkFestOf(d)));
      return uidIs(tkBuyerOf(d))
        && tkDocsAgreeOk(d, ev, plan)
        && d.keys().hasOnly(
             ['workspaceId', 'festivalId', 'tierId', 'tierName', 'buyerUid', 'buyerName',
              'attendees', 'qty', 'amounts', 'currency', 'discountCode', 'paymentState',
              'rsvpId', 'createdAt'])
        && tkCreateShapeOk(d, plan)
        && tkAmountsOk(d, ev, plan)
        && tkReleaseOpen(ev)
        && tkDipOk(d, ev);
    }

    function tkDeskCreateOk(ticketId) {
      let d = reqData();
      let ev = docData(/databases/$(database)/documents/festival_events/$(tkFestOf(d)));
      let plan = docData(/databases/$(database)/documents/festival_plans/$(tkFestOf(d)));
      return hasRole(tkWsOf(d), R_ANY_STAFF())
        && tkDocsAgreeOk(d, ev, plan)
        && d.get('deskSale', false) == true
        && tkBuyerOf(d) == 'desk_' + ticketId
        && uidIs(d.get('recordedBy', ''))
        && !('discountCode' in d)
        && d.keys().hasOnly(
             ['workspaceId', 'festivalId', 'tierId', 'tierName', 'buyerUid', 'buyerName',
              'attendees', 'qty', 'amounts', 'currency', 'paymentState',
              'rsvpId', 'createdAt', 'deskSale', 'recordedBy',
              'venueReceived', 'receivedBy', 'receivedAt'])
        && tkDeskShapeOk(d, plan)
        && tkAmountsOk(d, ev, plan)
        && tkStateOf(d) != 'paid-wallet'
        && (tkStateOf(d) == 'comp'
            || (d.get('venueReceived', false) == true
                && d.get('receivedBy', '') != ''))
        && tkReleaseOpen(ev)

        && !dipIsDipTier(ev, tkTierOf(d));
    }

    function tkRefundLedgerOk() {
      let tk = tkAfterData(ticketPath(reqOrderId()));
      return reqOrderId() != ''
        && reqAmount() > 0
        && uidIs(tkBuyerOf(tk))
        && tkStateOf(tk) == 'refunded'
        && tk.get('refundAmount', 0) == reqAmount();
    }

    function festRsvpTransferDeleteOk() {
      let tid = tkOldGet('ticketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      return tid != ''
        && existsAfter(tp)
        && uidIs(tkBuyerOf(tk))
        && tk.get('transferFromUid', '') == resUid()
        && tkFestOf(tk) == tkOldGet('eventId', '');
    }

    function R_FINANCE() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Accountant', 'ACCOUNTANT'];
    }

    function R_OVERSIGHT() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Accountant', 'ACCOUNTANT', 'Auditor', 'AUDITOR'];
    }
    function R_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }
    function R_RITUAL() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Priest', 'PRIEST', 'PUROHIT', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR'];
    }
    function R_ANY_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER',
              'Accountant', 'ACCOUNTANT', 'Priest', 'PRIEST', 'PUROHIT', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }

    function R_TRUSTEE() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'];
    }
    function R_BOARD() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER'];
    }
    function R_TRUSTEE_PAIR() {
      return ['Trustee', 'TRUSTEE'];
    }
    function ORDER_ACTIVE() {
      return ['paid', 'accepted', 'in_progress'];
    }
    function ORDER_DONE() {
      return ['COMPLETED', 'DAKSHINA_RELEASED'];
    }
    function DECISION_STATES() {
      return ['ACCEPTED', 'DECLINED'];
    }
    function PLATFORMS() {
      return ['android', 'ios', 'desktop', 'unknown'];
    }
    function KEYS_STATUS_ONLY() {
      return ['status', 'updatedAt'];
    }
    function UTSAV_COLLECTIONS() {
      return ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins'];
    }

    function bumpToggleOk(field) {
      return diffKeys().hasOnly([field])
        && tkNewGet(field, -1) >= 0
        && (tkNewGet(field, 0) == tkOldGet(field, 0) + 1
            || tkNewGet(field, 0) == tkOldGet(field, 0) - 1);
    }
    function bumpUpOk(field) {
      return diffKeys().hasOnly([field])
        && tkNewGet(field, 0) == tkOldGet(field, 0) + 1;
    }

    function diffKeysOnly(newData, oldData, keys) {
      return newData.diff(oldData).affectedKeys().hasOnly(keys);
    }

    function diffKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function reqKeys() {
      return request.resource.data.keys();
    }

    function isSelf(x) {
      return isLoggedIn() && request.auth.uid == x;
    }
    function uidIs(x) {
      return x == request.auth.uid;
    }

    function docGet(p, k, dv) {
      return get(p).data.get(k, dv);
    }
    function afterDocGet(p, k, dv) {
      return getAfter(p).data.get(k, dv);
    }
    function docData(p) {
      return get(p).data;
    }
    function reqData() {
      return request.resource.data;
    }
    function resData() {
      return resource.data;
    }
    function loggedUidIs(x) {
      return isLoggedIn() && uidIs(x);
    }

    function reqGigDoc() {
      return get(/databases/$(database)/documents/gigs/$(tkNewGet('orderId', '')));
    }
    function reqConsultDoc() {
      return get(/databases/$(database)/documents/jyotishConsultations/$(tkNewGet('orderId', '')));
    }
    function reqCreditDoc() {
      return get(/databases/$(database)/documents/referralCredits/$(tkNewGet('lastReferralCreditId', '')));
    }
    function reqStatus() {
      return tkNewGet('status', '');
    }
    function reqOrderId() {
      return tkNewGet('orderId', '');
    }
    function reqUid() {
      return tkNewGet('uid', '');
    }
    function reqReferredBy() {
      return tkNewGet('referredBy', {});
    }
    function reqOrgId() {
      return tkNewGet('orgId', '');
    }
    function reqText() {
      return tkNewGet('text', '');
    }
    function reqOrderType() {
      return tkNewGet('orderType', '');
    }
    function reqName() {
      return tkNewGet('name', '');
    }
    function reqWorkspaceId() {
      return tkNewGet('workspaceId', '');
    }
    function reqTitle() {
      return tkNewGet('title', '');
    }
    function reqAmount() {
      return tkNewGet('amount', 0);
    }
    function reqRole() {
      return tkNewGet('role', '');
    }
    function reqOptions() {
      return tkNewGet('options', {});
    }
    function reqProviderUid() {
      return tkNewGet('providerUid', '');
    }
    function reqRatingCount() {
      return tkNewGet('ratingCount', 0);
    }
    function reqVerificationTier() {
      return tkNewGet('verificationTier', '');
    }
    function reqAuthorUid() {
      return tkNewGet('authorUid', '');
    }
    function reqAuthorName() {
      return tkNewGet('authorName', '');
    }
    function reqRating() {
      return tkNewGet('rating', 0);
    }
    function reqOptionIds() {
      return tkNewGet('optionIds', []);
    }
    function reqLastReferralCreditId() {
      return tkNewGet('lastReferralCreditId', '');
    }
    function reqRsvpCount() {
      return tkNewGet('rsvpCount', 0);
    }
    function resStatus() {
      return tkOldGet('status', '');
    }
    function resProviderUid() {
      return tkOldGet('providerUid', '');
    }
    function resUid() {
      return tkOldGet('uid', '');
    }
    function resClientUid() {
      return tkOldGet('clientUid', '');
    }
    function resAuthorUid() {
      return tkOldGet('authorUid', '');
    }
    function resExpiresAtTs() {
      return tkOldGet('expiresAtTs', null);
    }

    function rsvpWithinCap() {
      return !('capacity' in resource.data) || tkOldGet('capacity', 0) <= 0
        || reqRsvpCount() <= tkOldGet('capacity', 0);
    }
    function DECISION_KEYS() {
      return ['status', 'decidedBy', 'decidedByName', 'decidedAt', 'note'];
    }
    function RATING_KEYS() {
      return ['ratingAggregate', 'ratingCount', 'lastReviewId', 'updatedAt'];
    }
    function TIRTHA_VISIT_KEYS() {
      return ['id', 'uid', 'templeName', 'orgId', 'visitedAt', 'note', 'darshanKind', 'photoVaultUrl', 'yatraId', 'createdAt'];
    }
    function TIRTHA_YATRA_KEYS() {
      return ['id', 'uid', 'name', 'reflection', 'coverVaultUrl', 'createdAt'];
    }

    match /platform_admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /platformAdmins/{adminUid} {
      allow read: if isOwner()
        || (isSelf(adminUid));
      allow create, update: if isOwner()
        && reqKeys().hasOnly(
          ['uid', 'email', 'displayName', 'role', 'active',
           'grantedBy', 'grantedAt', 'updatedAt'])
        && reqUid() == adminUid
        && reqRole() in ['admin', 'moderator']
        && uidIs(tkNewGet('grantedBy', ''));
      allow delete: if isOwner();
    }

    match /platform_leads/{leadId} {
      allow create: if true;
      allow read, update: if isSuperAdmin() || isOwner();
      allow delete: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin() || isOwner());
      allow create: if isSelf(userId)
        && !reqKeys().hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId',

          'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
        && (

          isDemoWs(newDocWs())

          || !reqKeys().hasAny(['role', 'workspaceId', 'defaultWorkspaceId', 'membership'])
        );
      allow update: if isSuperAdmin() || (
        isSelf(userId)
        && !diffKeys()
            .hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId', 'role', 'workspaceId', 'defaultWorkspaceId', 'membership',

              'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
      )

        || (isOwner()
          && diffKeys()
              .hasOnly(['suspended', 'suspendReason', 'suspendedAt', 'suspendedBy', 'updatedAt']));
      allow delete: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isSelf(userId);
    }

    match /user_follows/{uid} {
      function followsShapeOk() {
        return reqKeys().hasOnly(['orgIds', 'festivalIds', 'updatedAt'])
          && tkNewGet('orgIds', []) is list
          && tkNewGet('orgIds', []).size() <= 200
          && tkNewGet('festivalIds', []) is list
          && tkNewGet('festivalIds', []).size() <= 200
          && tkNewGet('updatedAt', 0) is number;
      }
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && reqKeys().hasAll(['orgIds', 'festivalIds', 'updatedAt'])
        && followsShapeOk();
      allow update: if isSelf(uid) && followsShapeOk();
      allow delete: if isSelf(uid);
    }

    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if hasRole(tenantId, R_TRUSTEE())
        && diffKeys()
            .hasOnly(['name', 'city', 'state', 'country', 'type', 'logoUrl', 'tagline', 'updatedAt']);
      allow delete: if isSuperAdmin();

      match /private/{docId} {
        allow read, write: if hasRole(tenantId, R_TRUSTEE());
      }

      match /publicProfile/{docId} {
        allow read: if true;
        allow write: if hasRole(tenantId, R_TRUSTEE());
      }

      match /treasury/{docId} {
        allow read: if demoPublicRead(tenantId) || hasRole(tenantId, R_OVERSIGHT());
        allow create: if demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE());
        allow update: if (demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE()));
        allow delete: if false;
      }

      match /devotees/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create, update: if demoWriteOk(tenantId) || hasRole(tenantId, R_STAFF());
        allow delete: if hasRole(tenantId, R_TRUSTEE());
      }

      match /yatranet_alerts/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create: if demoWriteOk(tenantId) || isTenantMember(tenantId);
        allow update, delete: if hasRole(tenantId, R_TRUSTEE());
      }
    }

    match /workspaces/{workspaceId} {

      allow read: if isTenantMember(workspaceId) || isOwner();

      allow create: if isLoggedIn() && !isAnonymous()
        && !reqKeys().hasAny(['adminPinHash', 'adminPin']);

      allow update: if (isOwner()
          && tkDiff(['planId', 'limitsBypassed', 'updatedAt']))
        || ((demoWriteOk(workspaceId) || hasRole(workspaceId, R_TRUSTEE()))
          && !diffKeys().hasAny(['adminPinHash', 'adminPin']))

        || (hasRole(workspaceId, R_BOARD())
          && tkDiff(['pollTemplates', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /treasury/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('devoteeId', '')));
      allow create: if hasRole(newDocWs(), R_FINANCE());
      allow update: if hasRole(docWs(), R_FINANCE()) && wsImmutable();
      allow delete: if false;
    }

    match /treasury_ledgers/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('devoteeId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('donorId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('donorId', ''))
            && reqStatus() == 'pledged'));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /tax_receipts/{receiptId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('donorId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    match /receiptCounters/{counterId} {
      allow read: if resource == null
        || hasRole(tkOldGet('workspaceId', ''), R_OVERSIGHT());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()))
        && reqWorkspaceId() != ''
        && counterId == reqWorkspaceId() + '_' + tkNewGet('series', '') + '_' + string(tkNewGet('year', 0))
        && tkNewGet('series', '') in ['SB-80G', 'SB-CHANDA']
        && tkNewGet('seq', -1) >= 0;
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE()))
        && wsImmutable()
        && tkNewGet('series', '') == tkOldGet('series', '')
        && tkNewGet('year', 0) == tkOldGet('year', 0)
        && tkNewGet('seq', 0) > tkOldGet('seq', 0);
      allow delete: if false;
    }

    match /devotees/{devoteeId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || uidIs(tkOldGet('userId', '')) || uidIs(devoteeId);
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('userId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_STAFF())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('userId', '')))) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /households/{householdId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /puja_bookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('devoteeId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /poojaBookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('devoteeId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /festival_plans/{planId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF()))
        && (resource == null || wsImmutable());
      allow update: if ((demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF()))
          && wsImmutable())

        || (isLoggedIn() && anchoredDiscountUse(planId));
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /festival_events/{eventId} {
      allow read: if tkOldGet('published', false) == true
        || demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if demoWriteOk(newDocWs())
        || hasRole(newDocWs(), R_BOARD());
      allow update: if demoWriteOk(docWs())
        || hasRole(docWs(), R_BOARD())
        || (isLoggedIn() && wsImmutable() && anchoredFestivalCounter(eventId))

        || (isLoggedIn() && wsImmutable() && anchoredTierCounter(eventId))

        || (isLoggedIn() && wsImmutable() && anchoredDeskCounter(eventId));
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /festival_rsvps/{rsvpId} {
      allow read: if isTenantMember(docWs())
        || (loggedUidIs(resUid()));
      allow create: if loggedUidIs(reqUid())
        && festRsvpShapeOk()

        && tkNewGet('status', 'confirmed') in ['confirmed', 'waitlisted']

        && rsvpId == request.resource.data.get('eventId', '') + '__' + request.auth.uid;

      allow create: if isLoggedIn()
        && hasRole(reqWorkspaceId(), R_ANY_STAFF())
        && reqUid().matches('desk_.+')
        && festRsvpShapeOk()
        && tkNewGet('status', 'confirmed') == 'confirmed'
        && rsvpId == request.resource.data.get('eventId', '') + '__' + reqUid()
        && tkDeskSaleWitnessOk(tkNewGet('eventId', ''), reqUid());
      allow update: if (loggedUidIs(resUid())
          && tkDiff(['headcount', 'slotId', 'days', 'status'])

          && (tkNewGet('status', 'confirmed') == tkOldGet('status', 'confirmed')
              || (tkOldGet('status', 'confirmed') == 'waitlisted'
                  && reqStatus() == 'confirmed')))
        || hasRole(docWs(), R_TRUSTEE());
      allow delete: if (loggedUidIs(resUid()))
        || hasRole(docWs(), R_TRUSTEE())

        || (isLoggedIn() && festRsvpTransferDeleteOk());
    }

    match /event_tickets/{ticketId} {
      allow read: if isLoggedIn()
        && (uidIs(tkOldGet('buyerUid', ''))
          || tkIsTransferTo()
          || hasRole(docWs(), R_ANY_STAFF()));
      allow create: if isLoggedIn() && tkCreateOk();

      allow create: if isLoggedIn() && tkDeskCreateOk(ticketId);

      allow update: if tkBuyerGuard()
        && tkBuyerCancelOk();

      allow update: if tkBuyerGuard()
        && tkStateOf(resource.data) in ['paid-wallet', 'pay-at-venue', 'comp']
        && tkTrStateOf(reqData()) == 'offered'
        && tkNewGet('transferToUid', '') != ''
        && tkNewGet('transferToUid', '') != tkBuyerOf(resource.data)
        && tkDiff(['transferToUid', 'transferToName', 'transferState', 'offeredAt', 'updatedAt']);

      allow update: if tkBuyerGuard()
        && tkTrStateOf(resource.data) in ['offered', 'declined']
        && !('transferToUid' in reqData())
        && tkDiff(['transferToUid', 'transferToName', 'transferState', 'offeredAt', 'updatedAt']);

      allow update: if isLoggedIn() && tkIsTransferTo()
        && tkTrStateOf(resource.data) == 'offered'
        && tkTrStateOf(reqData()) == 'declined'
        && tkDiff(['transferState', 'updatedAt']);

      allow update: if isLoggedIn() && tkAcceptOk();

      allow update: if tkStaffVenue()
        && tkNewGet('venueReceived', false) == true
        && tkDiff(['venueReceived', 'receivedBy', 'receivedAt', 'updatedAt']);

      allow update: if tkStaffVenue()
        && tkOldGet('venueReceived', false) == true
        && tkStateOf(reqData()) == 'refunded'
        && tkNewGet('refundAmount', 0) == tkTotalOf(resource.data)
        && tkDiff(['paymentState', 'refundAmount', 'refundedAt', 'updatedAt']);

      allow update: if tkStaffVenue()
        && tkOldGet('venueReceived', false) != true
        && tkStateOf(reqData()) == 'cancelled'
        && tkDiff(['paymentState', 'updatedAt']);

      allow update: if hasRole(docWs(), R_ANY_STAFF())
        && tkNewGet('treasuryTxId', '') != ''
        && tkDiff(['treasuryTxId', 'treasuryPostedAt', 'updatedAt']);
      allow delete: if false;
    }

    function fbRatingOk(v) {
      return v is int && v >= 1 && v <= 5;
    }
    function fbAspectsOk(m) {
      return m.keys().hasAll(['arrangements', 'prasad', 'darshanFlow', 'cleanliness'])
        && m.keys().hasOnly(['arrangements', 'prasad', 'darshanFlow', 'cleanliness'])
        && fbRatingOk(m.get('arrangements', 0))
        && fbRatingOk(m.get('prasad', 0))
        && fbRatingOk(m.get('darshanFlow', 0))
        && fbRatingOk(m.get('cleanliness', 0));
    }
    function fbAttendedOk(fid) {
      return exists(festRsvpPath(fid))
        && docGet(festRsvpPath(fid), 'checkedIn', false) == true;
    }
    function fbTextOk() {
      return tkNewGet('text', '') is string && tkNewGet('text', '').size() <= 600;
    }
    function fbDayOk() {
      return !('attendedDay' in reqData())
        || (tkNewGet('attendedDay', '') is string && tkNewGet('attendedDay', '').size() <= 10);
    }
    match /event_feedback/{feedbackId} {
      allow read: if (loggedUidIs(resAuthorUid()))
        || hasRole(docWs(), R_STAFF());
      allow create: if loggedUidIs(tkNewGet('authorUid', ''))
        && feedbackId == tkNewGet('festivalId', '') + '__' + request.auth.uid
        && newDocWs() != null && newDocWs() != ''
        && tkNewGet('festivalId', '') != ''
        && tkNewGet('authorName', '').size() >= 2
        && tkNewGet('authorName', '').size() <= 80
        && tkNewGet('state', '') == 'visible'
        && !('orgResponse' in reqData())
        && reqKeys().hasAll(['workspaceId', 'festivalId', 'authorUid', 'authorName',
             'aspects', 'overall', 'text', 'wouldReturn', 'createdAt', 'updatedAt', 'state'])
        && reqKeys().hasOnly(['workspaceId', 'festivalId', 'authorUid', 'authorName',
             'aspects', 'overall', 'text', 'wouldReturn', 'attendedDay',
             'createdAt', 'updatedAt', 'state'])
        && fbAspectsOk(tkNewGet('aspects', {}))
        && fbRatingOk(tkNewGet('overall', 0))
        && fbTextOk()
        && tkNewGet('wouldReturn', false) is bool
        && fbDayOk()
        && fbAttendedOk(tkNewGet('festivalId', ''));
      allow update: if (loggedUidIs(resAuthorUid())
          && tkOldGet('state', '') == 'visible'
          && tkDiff(['aspects', 'overall', 'text', 'wouldReturn', 'attendedDay', 'updatedAt'])
          && fbAspectsOk(tkNewGet('aspects', {}))
          && fbRatingOk(tkNewGet('overall', 0))
          && fbTextOk()
          && tkNewGet('wouldReturn', false) is bool
          && fbDayOk())
        || (hasRole(docWs(), R_STAFF())
          && tkDiff(['state', 'orgResponse', 'updatedAt'])
          && tkNewGet('state', '') in ['visible', 'hidden']
          && (!('orgResponse' in reqData())
              || (tkNewGet('orgResponse', {}).keys().hasOnly(['text', 'at', 'byName'])
                  && tkNewGet('orgResponse', {}).get('text', '') is string
                  && tkNewGet('orgResponse', {}).get('text', '').size() <= 600)));
      allow delete: if false;
    }

    function dipEntryCreateOk(entryId) {
      let d = reqData();
      let ev = docData(/databases/$(database)/documents/festival_events/$(tkNewGet('festivalId', '')));
      let plan = docData(/databases/$(database)/documents/festival_plans/$(tkNewGet('festivalId', '')));
      let opens = ev.get('dipOpensAtMs', {}).get(tkNewGet('tierId', ''), 0);
      let closes = ev.get('dipClosesAtMs', {}).get(tkNewGet('tierId', ''), 0);
      return uidIs(tkNewGet('uid', ''))
        && entryId == tkNewGet('festivalId', '') + '__' + tkNewGet('tierId', '') + '__' + request.auth.uid
        && tkNewGet('festivalId', '') != ''
        && tkNewGet('tierId', '') != ''
        && tkWsOf(d) != ''
        && tkWsOf(ev) == tkWsOf(d)
        && tkNewGet('buyerName', '') is string
        && tkNewGet('buyerName', '').size() >= 1
        && tkNewGet('buyerName', '').size() <= 80
        && tkNewGet('attendees', []) is list
        && tkNewGet('attendees', []).size() >= 1
        && tkNewGet('attendees', []).size() <= 20
        && tkNewGet('heads', 0) == tkNewGet('attendees', []).size()
        && tkNewGet('heads', 0) <= tkPlanCfg(plan).get('tierMax', {}).get(tkNewGet('tierId', ''), 6)
        && tkNewGet('status', '') == 'entered'
        && tkNewGet('createdAt', 0) is number
        && tkNewGet('createdAt', 0) > 0
        && d.keys().hasOnly(['festivalId', 'tierId', 'workspaceId', 'uid', 'buyerName',
             'attendees', 'heads', 'createdAt', 'status'])
        && opens > 0
        && request.time.toMillis() >= opens
        && request.time.toMillis() <= closes;
    }

    function dipStaffUpdateOk() {
      let os = tkOldGet('status', '');
      let ns = tkNewGet('status', '');
      return hasRole(docWs(), R_ANY_STAFF())
        && tkDiff(['status', 'dipPosition', 'updatedAt'])
        && ((os == 'entered' && ns in ['selected', 'waitlisted'])
            || (os == 'waitlisted' && ns == 'selected')
            || (os == 'selected' && ns == 'lapsed'))
        && (tkNewGet('dipPosition', 1) is number && tkNewGet('dipPosition', 1) >= 1);
    }

    function dipClaimConsumeOk() {
      let evAfter = tkAfterData(/databases/$(database)/documents/festival_events/$(tkOldGet('festivalId', '')));
      let tp = ticketPath(evAfter.get('tierAnchorTicketId', ''));
      let tk = existsAfter(tp) ? tkAfterData(tp) : {};
      return tkOldGet('status', '') == 'selected'
        && tkNewGet('status', '') == 'claimed'
        && tkDiff(['status', 'updatedAt'])
        && tk.size() > 0
        && uidIs(tkBuyerOf(tk))
        && tkFestOf(tk) == tkOldGet('festivalId', '')
        && tkTierOf(tk) == tkOldGet('tierId', '')
        && tkStateOf(tk) in ['paid-wallet', 'pay-at-venue', 'comp'];
    }

    function dipWithdrawOk() {
      let ev = docData(/databases/$(database)/documents/festival_events/$(tkOldGet('festivalId', '')));
      let closes = ev.get('dipClosesAtMs', {}).get(tkOldGet('tierId', ''), 0);
      return uidIs(tkOldGet('uid', ''))
        && tkOldGet('status', '') == 'entered'
        && closes > 0
        && request.time.toMillis() <= closes;
    }

    match /event_dip_entries/{entryId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('uid', '')))
        || hasRole(docWs(), R_ANY_STAFF());
      allow create: if isLoggedIn() && dipEntryCreateOk(entryId);
      allow update: if dipStaffUpdateOk()
        || (loggedUidIs(tkOldGet('uid', '')) && dipClaimConsumeOk());
      allow delete: if isLoggedIn() && dipWithdrawOk();
    }

    function lotTxFrozen(o, d, k) {
      return o.settlement.get(k, '') == ''
        || d.settlement.get(k, '') == o.settlement.get(k, '');
    }
    function lotCreateOk() {
      let d = reqData();
      return d.status == 'draft'
        && d.lotClass in ['rights-lease', 'movables', 'immovable-sale']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.reservePrice is number && d.reservePrice >= 0
        && d.registrations is list && d.registrations.size() == 0
        && tkNewGet('lotMode', 'hall') in ['hall', 'sealed']
        && tkNewGet('bidderUids', []) == []
        && reqKeys().hasOnly(['workspaceId', 'source', 'lotClass', 'title', 'description', 'mediaRefs', 'reservePrice', 'valuationBasis', 'sanction', 'leaseTermYears', 'status', 'history', 'notice', 'affixtures', 'objections', 'registrations', 'outcome', 'settlement', 'failReason', 'createdAt', 'updatedAt', 'lotMode', 'bidderUids']);
    }
    function lotUpdateOk() {
      let os = resData().status;
      let ns = reqData().status;
      let d = reqData();
      let o = resData();
      return wsImmutable()
        && d.lotClass == o.lotClass
        && d.title is string && d.title.size() > 0
        && (ns == os
          || (os == 'draft' && ns in ['approved', 'withdrawn'])
          || (os == 'approved' && ns in ['noticed', 'withdrawn'])
          || (os == 'noticed' && ns in ['open', 'withdrawn'])
          || (os == 'open' && ns in ['accepted', 'failed', 'withdrawn'])
          || (os == 'accepted' && ns in ['settled', 'failed']))
        && (ns in ['draft', 'withdrawn']
          || (d.valuationBasis is map && d.valuationBasis.get('figure', -1) >= 0))
        && (!(ns in ['noticed', 'open', 'accepted', 'settled'])
          || !((d.lotClass == 'immovable-sale' || (d.leaseTermYears is number && d.leaseTermYears > 5))
            && !(d.sanction is map && d.sanction.get('authority', '') != '' && d.sanction.get('reference', '') != '')))
        && (lotTxFrozen(o, d, 'depositTxId'))
        && (lotTxFrozen(o, d, 'balanceTxId'))
        && (!(os in ['accepted', 'settled']) || d.outcome == o.outcome)
        && (!(os in ['noticed', 'open', 'accepted', 'settled']) || d.notice == o.notice)
        && tkNewGet('lotMode', 'hall') == tkOldGet('lotMode', 'hall')
        && tkNewGet('bidderUids', []).size() >= tkOldGet('bidderUids', []).size()
        && d.registrations.size() >= o.registrations.size()
        && d.registrations.size() <= 100
        && d.objections.size() >= o.objections.size()
        && d.affixtures.size() >= o.affixtures.size();
    }
    function lotWriteGate(ws) {
      return demoWriteOk(ws) || hasRole(ws, R_BOARD()) || hasRole(ws, R_FINANCE());
    }
    match /auction_lots/{lotId} {
      allow read: if isSuperAdmin() || hasRole(docWs(), R_ANY_STAFF()) || demoPublicRead(docWs());
      allow create: if (lotWriteGate(newDocWs())) && lotCreateOk();
      allow update: if (lotWriteGate(newDocWs())) && lotUpdateOk();
      allow delete: if false;

      match /bids/{bidId} {
        allow read: if isSuperAdmin() || uidIs(tkOldGet('bidderUid', '')) || bidReadOk(lotId);
        allow create: if isLoggedIn() && bidCreateOk(lotId, bidId);
        allow update: if bidOwnWindowOk(lotId) && tkDiff(['amount', 'updatedAt'])
          && tkNewGet('amount', 0) > 0;
        allow delete: if bidOwnWindowOk(lotId);
      }
    }
    function lotPath(lotId) {
      return /databases/$(database)/documents/auction_lots/$(lotId);
    }
    function lotCloseOf(l) {
      return l.get('notice', {}).get('auctionAt', 0);
    }

    function lotSealedWindowOpen(l) {
      return l.get('status', '') == 'open'
        && l.get('lotMode', 'hall') == 'sealed'
        && request.time.toMillis() < lotCloseOf(l);
    }
    function bidCreateOk(lotId, bidId) {
      let l = docData(lotPath(lotId));
      return bidId == request.auth.uid
        && uidIs(tkNewGet('bidderUid', ''))
        && lotSealedWindowOpen(l)
        && (request.auth.uid in l.get('bidderUids', [])
            || demoWriteOk(l.get('workspaceId', '')))
        && tkNewGet('amount', 0) > 0
        && reqKeys().hasOnly(['bidderUid', 'amount', 'createdAt', 'updatedAt']);
    }

    function bidOwnWindowOk(lotId) {
      return uidIs(tkOldGet('bidderUid', ''))
        && lotSealedWindowOpen(docData(lotPath(lotId)));
    }

    function bidReadOk(lotId) {
      let l = docData(lotPath(lotId));
      return lotCloseOf(l) > 0
        && request.time.toMillis() >= lotCloseOf(l)
        && (hasRole(l.get('workspaceId', ''), R_BOARD())
            || hasRole(l.get('workspaceId', ''), R_FINANCE())
            || demoPublicRead(l.get('workspaceId', '')));
    }

    match /utsav_stores/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || isTenantMember(workspaceId);
      allow create, update: if (demoWriteOk(workspaceId) || hasRole(workspaceId, R_STAFF()))
        && reqWorkspaceId() == workspaceId
        && reqKeys().hasOnly(['workspaceId', 'state', 'updatedAt', 'updatedBy']);
      allow delete: if hasRole(workspaceId, R_TRUSTEE());
    }

    match /inventory_items/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /inventory/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /fixed_assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /cows/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /gaushala_cattle/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /dharamshala_rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /qrPairTokens/{tokenId} {
      allow create: if isLoggedIn()
        && reqKeys().hasAll(['memberId', 'workspaceId', 'role', 'expiresAt'])
        && request.resource.data.role in ['Devotee', 'Sevadar', 'Priest', 'Accountant', 'Trustee']
        && (demoWriteOk(newDocWs())
            || hasRole(newDocWs(), R_ANY_STAFF()))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(600, 's');
      allow get, delete: if request.time < resource.data.expiresAt;
      allow list, update: if false;
    }

    match /{collection}/{docId} {
      allow read: if collection in UTSAV_COLLECTIONS()
        && (demoPublicRead(docWs()) || isTenantMember(docWs()));
      allow create: if collection in UTSAV_COLLECTIONS()
        && (demoWriteOk(newDocWs()) || (isTenantMember(newDocWs()) && roleIn(R_ANY_STAFF())));
      allow update: if collection in UTSAV_COLLECTIONS()
        && (demoWriteOk(docWs()) || (isTenantMember(docWs()) && roleIn(R_ANY_STAFF()))) && wsImmutable();
      allow delete: if collection in UTSAV_COLLECTIONS()
        && hasRole(docWs(), R_TRUSTEE());
    }

    match /audit_logs/{logId} {
      allow read: if isOwner() || demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE());
      allow create: if (isOwner() && uidIs(tkNewGet('actorUid', '')))
        || ((demoWriteOk(newDocWs()) || isTenantMember(newDocWs()))
          && uidIs(tkNewGet('actorId', '')));
      allow update, delete: if false;
    }

    match /verificationApplications/{appId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if loggedUidIs(tkNewGet('applicantUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /moderationReports/{reportId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if loggedUidIs(tkNewGet('reporterUid', ''));
      allow update: if isOwner();
      allow delete: if false;
    }

    match /moderationHides/{hideId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /reminderQueue/{reminderId} {

      allow read: if isLoggedIn()
        && (uidIs(tkOldGet('targetUid', ''))
          || uidIs(tkOldGet('ownerUid', '')));

      allow update: if isLoggedIn()
        && (uidIs(tkOldGet('targetUid', ''))
          || uidIs(tkOldGet('ownerUid', '')))
        && tkDiff(['status'])
        && reqStatus() == 'sent';
      allow create, delete: if false;
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /paymentClaims/{claimId} {
      allow read: if isSuperAdmin() || isOwner()
        || (loggedUidIs(tkOldGet('applicantUid', '')))

        || (isLoggedIn() && hasRole(tkOldGet('workspaceId', ''), R_FINANCE()));
      allow create: if loggedUidIs(tkNewGet('applicantUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /subscriptions/{workspaceId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isSelf(workspaceId))
        || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /workspaceSummaries/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || hasRole(workspaceId, R_OVERSIGHT());
      allow create, update: if hasRole(newDocWs(), R_FINANCE()) && (resource == null || wsImmutable());
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_OVERSIGHT());
      allow create: if (demoWriteOk(newDocWs()) || isTenantMember(newDocWs()))
        && uidIs(tkNewGet('actorUid', ''));
      allow update, delete: if false;
    }

    match /cashCustodyStates/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || hasRole(workspaceId, R_OVERSIGHT());
      allow create, update: if hasRole(newDocWs(), R_FINANCE()) && (resource == null || wsImmutable()) && uidIs(tkNewGet('savedByUid', ''));
      allow delete: if false;
    }

    match /publishedAccounts/{docId} {
      allow read: if true;
      allow create: if hasRole(newDocWs(), R_FINANCE());
      allow update: if hasRole(docWs(), R_FINANCE()) && wsImmutable();
      allow delete: if hasRole(docWs(), R_FINANCE());
    }

    match /approvalRequests/{requestId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (loggedUidIs(tkOldGet('requestedBy', '')));
      allow create: if isTenantMember(newDocWs())
        && uidIs(tkNewGet('requestedBy', ''))
        && reqStatus() == 'PENDING';
      allow update: if

        (hasRole(docWs(), R_OVERSIGHT())
          && resStatus() == 'PENDING'
          && reqStatus() in ['APPROVED', 'REJECTED']
          && uidIs(tkNewGet('decidedBy', ''))
          && tkNewGet('decidedBy', '') != tkOldGet('requestedBy', '')
          && diffKeys()
            .hasOnly(DECISION_KEYS())
          && wsImmutable())

        || (hasRole(docWs(), R_OVERSIGHT())
          && resStatus() == 'APPROVED'
          && reqStatus() == 'APPROVED'
          && diffKeys()
            .hasOnly(['appliedAt', 'applyError'])
          && wsImmutable())

        || (loggedUidIs(tkOldGet('requestedBy', ''))
          && resStatus() == 'PENDING'
          && reqStatus() == 'CANCELLED'
          && diffKeys()
            .hasOnly(DECISION_KEYS())
          && wsImmutable());
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isSuperAdmin() || isOwner()
        || (loggedUidIs(tkOldGet('targetUid', '')));
      allow create: if isOwner();
      allow update: if loggedUidIs(tkOldGet('targetUid', ''))
        && tkDiff(['read', 'readAt']);
      allow delete: if false;
    }

    match /messageCampaigns/{campaignId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /scheduledMessages/{schedId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /messageTemplates/{templateId} {
      allow read: if isSuperAdmin() || isOwner();

      allow create, update, delete: if isOwner();
    }

    match /commissionRules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /platformConfig/{configId} {
      allow read: if configId != 'public';
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /platformConfig/apiKeys/{keyId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    match /platformConfig/public {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /geoPaymentConfig/config {
      allow read: if isLoggedIn();
      allow create, update: if isOwner()
        && reqKeys().hasOnly(
          ['regions', 'defaultRegion', 'updatedAt', 'updatedBy'])
        && tkNewGet('regions', []) is list
        && tkNewGet('regions', []).size() >= 1
        && tkNewGet('regions', []).size() <= 50
        && tkNewGet('defaultRegion', '') is string;
      allow delete: if false;
    }

    match /platformConfig/apiKeysAudit/{auditId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    match /marketplaceTransactions/{txnId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isSuperAdmin() || isOwner()
        || (loggedUidIs(resProviderUid()));
      allow create: if isOwner()
        || (loggedUidIs(reqProviderUid())
          && reqStatus() == 'requested');
      allow update: if isOwner()
        || (loggedUidIs(resProviderUid())
          && reqStatus() == 'requested');
      allow delete: if false;
    }

    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /siteContent/{key} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /featureFlags/{flagId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isOwner();
    }

    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /marketplaceGigs/{gigId} {
      allow read: if true;
      allow create: if loggedUidIs(reqProviderUid())
        && tkNewGet('active', true) == true;
      allow update: if isOwner()
        || (loggedUidIs(resProviderUid())
          && uidIs(reqProviderUid())

          && tkNewGet('avgRating', 0) == tkOldGet('avgRating', 0)
          && reqRatingCount() == tkOldGet('ratingCount', 0))

        || (isLoggedIn()
          && tkDiff(['avgRating', 'ratingCount', 'updatedAt', 'lastRatedOrderId'])
          && reqProviderUid() == resProviderUid()
          && tkNewGet('avgRating', 0) >= 1
          && tkNewGet('avgRating', 0) <= 5
          && p1GigRatingOk(gigId));
      allow delete: if isOwner();
    }

    match /gigRatings/{orderId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('clientUid', ''))
        && reqRating() >= 1
        && reqRating() <= 5
        && reqKeys().hasOnly(
          ['gigId', 'orderId', 'clientUid', 'providerUid', 'rating', 'review', 'createdAt'])
        && docData(/databases/$(database)/documents/marketplaceOrders/$(orderId)).status == 'completed'
        && uidIs(docData(/databases/$(database)/documents/marketplaceOrders/$(orderId)).clientUid);
      allow update, delete: if false;
    }

    match /marketplaceOrders/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(resClientUid())
          || uidIs(resProviderUid())));
      allow create: if loggedUidIs(tkNewGet('clientUid', ''))
        && reqStatus() == 'pending_payment';
      allow update: if isOwner()
        || (isLoggedIn()
          && tkNewGet('commissionPercent', 0) == tkOldGet('commissionPercent', 0)
          && tkNewGet('commissionAmount', 0) == tkOldGet('commissionAmount', 0)
          && tkNewGet('providerNet', 0) == tkOldGet('providerNet', 0)
          && (

          (uidIs(resProviderUid())
            && reqStatus() in ['accepted', 'cancelled', 'in_progress', 'completed']
            && (reqStatus() != 'completed'
              || resStatus() in ORDER_ACTIVE()))

          || (uidIs(resProviderUid())
            && tkOldGet('payAfterTask', false) == true
            && reqStatus() == 'awaiting_commission'
            && resStatus() in ORDER_ACTIVE())

          || (uidIs(resProviderUid())
            && tkOldGet('rail', '') == 'rail2'
            && reqStatus() == 'pending_payment'
            && tkNewGet('rail2Proof', {}).get('disputed', false) == true)

          || (uidIs(resClientUid())
            && reqStatus() in ['completed', 'cancelled']
            && (reqStatus() != 'completed'
              || resStatus() in ORDER_ACTIVE()))

          || (uidIs(resClientUid())
            && tkOldGet('payWithWallet', false) == true
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkNewGet('escrowHeld', 0) == tkOldGet('amountGross', 0))

          || (uidIs(resClientUid())
            && tkOldGet('rail', '') == 'rail2'
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkNewGet('rail2Proof', {}).get('trxId', '') != '')

          || (uidIs(resProviderUid())
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkOldGet('rail', '') == 'rail1'
            && tkOldGet('payWithWallet', false) == false
            && tkDiff(['status', 'paidAt', 'paymentNote', 'updatedAt']))

          || (isLoggedIn()
            && (uidIs(resProviderUid())
              || uidIs(resClientUid()))
            && resStatus() in ORDER_ACTIVE()
            && reqStatus() == 'commission_held'
            && uidIs(tkNewGet('commissionHold', {}).get('frozenByUid', '')))

          || (isLoggedIn()
            && (uidIs(resProviderUid())
              || uidIs(resClientUid()))
            && resStatus() in ORDER_ACTIVE()
            && reqStatus() == 'disputed'
            && tkDiff(KEYS_STATUS_ONLY()))));
      allow delete: if false;
    }

    match /commissionFreezeRequests/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'providerUid', ''))
          || uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'clientUid', ''))));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('requestedBy', ''))
        && reqStatus() == 'requested'
        && docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'status', '') == 'completed'
        && (uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'providerUid', ''))
          || uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'clientUid', '')));
      allow update: if isOwner();
      allow delete: if false;
    }

    match /rail2Sequences/{providerUid} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn()
        && reqKeys().hasOnly(['seq', 'updatedAt'])
        && tkNewGet('seq', 0) is int;
    }

    match /marketplaceDisputes/{disputeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(tkOldGet('raisedByUid', ''))
          || uidIs(resProviderUid())
          || uidIs(resClientUid())));
      allow create: if loggedUidIs(tkNewGet('raisedByUid', ''))
        && reqStatus() == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /commissionOverrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /providerPaymentMethods/{mId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resProviderUid()));
      allow create: if loggedUidIs(reqProviderUid())
        && reqStatus() in ['pending', 'platform_assigned'];
      allow update: if isOwner();
      allow delete: if false;
    }

    match /providerInquiries/{inqId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resProviderUid()));
      allow create: if loggedUidIs(reqProviderUid())
        && reqStatus() == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /bypassFlags/{flagId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if loggedUidIs(tkNewGet('senderUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /bypassKeywords/{kwId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /providerStrikes/{strikeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resProviderUid()));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /platformDues/{dueId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resProviderUid()));
      allow create: if isLoggedIn()
        && reqStatus() == 'pending'
        && reqProviderUid() ==
           docGet(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId()), 'providerUid', '')
        && docGet(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId()), 'rail', '') == 'rail2';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /marketplaceProviders/{providerUid} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(providerUid));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    function walletDebitOk() {
      let data = reqData();
      let old = resource.data;
      let orderId = data.get('lastDebitOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let gross = docGet(opath, 'amountGross', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastDebitOrderId', '')
        && exists(opath)
        && uidIs(docGet(opath, 'clientUid', ''))
        && docGet(opath, 'payWithWallet', false) == true
        && docGet(opath, 'status', '') == 'pending_payment'
        && gross > 0
        && data.get('balance', -1) == old.get('balance', 0) - gross
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + gross;
    }

    function p2pSettlementDebitOk(uid) {
      let data = reqData();
      let old = resource.data;
      let requestId = data.get('lastDebitP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let amount = docGet(rpath, 'amount', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitP2PRequestId', 'currency'])
        && requestId != '' && requestId != old.get('lastDebitP2PRequestId', '')
        && exists(rpath)
        && uidIs(docGet(rpath, 'senderId', ''))
        && docGet(rpath, 'senderId', '') == uid
        && docGet(rpath, 'status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == old.get('balance', 0) - amount
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + amount;
    }

    function p2pSettlementCreditOk(uid) {
      let data = reqData();
      let old = resource.data;
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = docData(rpath);
      let amount = rdata.get('amount', 0);
      return diffKeysOnly(data, old,
          ['uid', 'balance', 'currency', 'totalToppedUp', 'totalSpent',
           'totalReceived', 'lastCreditP2PRequestId', 'updatedAt'])
        && requestId != '' && requestId != old.get('lastCreditP2PRequestId', '')
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && uidIs(rdata.get('senderId', ''))
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('currency', '') == old.get('currency', '')
        && data.get('balance', -1) == old.get('balance', 0) + amount
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + amount
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }

    function p2pSettlementCreditCreateOk(uid) {
      let data = reqData();
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = docData(rpath);
      let amount = rdata.get('amount', 0);
      return requestId != ''
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && uidIs(rdata.get('senderId', ''))
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == amount
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('totalReceived', -1) == amount
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    function walletCreditOk(uid) {
      let data = reqData();
      let old = resource.data;
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = docGet(opath, 'providerNet', 0);
      return diffKeysOnly(data, old, ['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastCreditOrderId', 'currency', 'uid'])
        && orderId != '' && orderId != old.get('lastCreditOrderId', '')
        && exists(opath)
        && docGet(opath, 'providerUid', '') == uid
        && (uidIs(docGet(opath, 'clientUid', ''))
          || uidIs(docGet(opath, 'providerUid', '')))
        && docGet(opath, 'status', '') in ORDER_ACTIVE()
        && net > 0
        && data.get('balance', -1) == old.get('balance', 0) + net
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + net
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }

    function commissionHoldOk(uid) {
      let data = reqData();
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let order = docData(opath);
      let cap = order.get('commissionAmount', 0);
      let debit = old.get('balance', 0) - data.get('balance', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastCommissionOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && order.get('providerUid', '') == uid
        && uidIs(order.get('providerUid', ''))
        && order.get('status', '') in ORDER_ACTIVE()
        && cap > 0
        && debit > 0 && debit <= cap
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + debit;
    }

    function sevaProfileCompletionOk() {
      let data = reqData();
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let freeOld = old.get('freeSevasRemaining', 0);
      let freeNew = data.get('freeSevasRemaining', -1);
      return uidIs(resUid())
        && diffKeysOnly(data, old, ['freeSevasRemaining', 'completedSevasSinceVerified', 'lastCommissionOrderId', 'updatedAt'])
        && data.get('completedSevasSinceVerified', -1) == old.get('completedSevasSinceVerified', 0) + 1
        && (freeNew == freeOld || (freeOld > 0 && freeNew == freeOld - 1))
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && uidIs(docGet(opath, 'providerUid', ''))
        && docGet(opath, 'status', '') in ORDER_ACTIVE();
    }

    function p1GigRatingOk(gigId) {
      let rid = tkNewGet('lastRatedOrderId', '');
      let rpath = /databases/$(database)/documents/gigRatings/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('avgRating', 0) * newCount;
      let oldSum = tkOldGet('avgRating', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastRatedOrderId', '')
        && existsAfter(rpath)
        && afterDocGet(rpath, 'gigId', '') == gigId
        && uidIs(afterDocGet(rpath, 'clientUid', ''))
        && newCount == oldCount + 1
        && newSum >= oldSum + afterDocGet(rpath, 'rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + afterDocGet(rpath, 'rating', 0) + (0.06 * newCount + 0.1);
    }
    function p1PurohitRatingOk(purohitId) {
      let rid = tkNewGet('lastReviewId', '');
      let rpath = /databases/$(database)/documents/reviews/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('ratingAggregate', 0) * newCount;
      let oldSum = tkOldGet('ratingAggregate', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastReviewId', '')
        && existsAfter(rpath)
        && uidIs(afterDocGet(rpath, 'reviewerUid', ''))
        && afterDocGet(rpath, 'reviewerKind', '') == 'devotee'
        && docGet(/databases/$(database)/documents/gigs/$(afterDocGet(rpath, 'gigId', '')), 'assignedPurohitId', '') == purohitId
        && newCount == oldCount + 1
        && newSum >= oldSum + afterDocGet(rpath, 'rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + afterDocGet(rpath, 'rating', 0) + (0.06 * newCount + 0.1);
    }
    function p1JyotishRatingOk(jyotishId) {
      let rid = tkNewGet('lastReviewId', '');
      let rpath = /databases/$(database)/documents/jyotishReviews/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('ratingAggregate', 0) * newCount;
      let oldSum = tkOldGet('ratingAggregate', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastReviewId', '')
        && existsAfter(rpath)
        && uidIs(afterDocGet(rpath, 'reviewerUid', ''))
        && afterDocGet(rpath, 'reviewerKind', '') == 'devotee'
        && docGet(/databases/$(database)/documents/jyotishConsultations/$(afterDocGet(rpath, 'consultationId', '')), 'assignedJyotishId', '') == jyotishId
        && newCount == oldCount + 1
        && newSum >= oldSum + afterDocGet(rpath, 'rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + afterDocGet(rpath, 'rating', 0) + (0.06 * newCount + 0.1);
    }

    function p1JyotishEndorsementOk(jyotishId) {
      let eid = request.resource.data.get('lastEndorsementId', '');
      let epath = /databases/$(database)/documents/jyotishEndorsements/$(eid);
      return eid != '' && eid != resource.data.get('lastEndorsementId', '')
        && existsAfter(epath)
        && getAfter(epath).data.get('jyotishId', '') == jyotishId
        && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0) + 1;
    }

    function jyotishTierClaimOk() {
      let from = tkOldGet('verificationTier', '');
      let to = reqVerificationTier();
      let endorsements = resource.data.get('endorsementCount', 0);
      let gigs = tkOldGet('completedConsultations', 0);
      let rating = tkOldGet('ratingAggregate', 0);
      return (to == 'ORG_ENDORSED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'VERIFIED')
          && endorsements >= 1)
        || (to == 'PLATFORM_VERIFIED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'ORG_ENDORSED' || from == 'VERIFIED')
          && endorsements >= 1 && gigs >= 10 && rating >= 4.5);
    }

    function p1PurohitEndorsementOk(purohitId) {
      let eid = request.resource.data.get('lastEndorsementId', '');
      let epath = /databases/$(database)/documents/endorsements/$(eid);
      return eid != '' && eid != resource.data.get('lastEndorsementId', '')
        && existsAfter(epath)
        && getAfter(epath).data.get('purohitId', '') == purohitId
        && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0) + 1;
    }

    function purohitTierClaimOk() {
      let from = tkOldGet('verificationTier', '');
      let to = reqVerificationTier();
      let endorsements = resource.data.get('endorsementCount', 0);
      let gigs = resource.data.get('completedGigs', 0);
      let rating = tkOldGet('ratingAggregate', 0);
      return (to == 'ORG_ENDORSED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'VERIFIED')
          && endorsements >= 1)
        || (to == 'PLATFORM_VERIFIED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'ORG_ENDORSED' || from == 'VERIFIED')
          && endorsements >= 1 && gigs >= 10 && rating >= 4.5);
    }

    function p1CompletedGigOk() {
      let gid = tkNewGet('lastCompletedGigId', '');
      let gpath = /databases/$(database)/documents/gigs/$(gid);
      return tkNewGet('completedGigs', 0) == tkOldGet('completedGigs', 0) + 1
        && gid != '' && gid != tkOldGet('lastCompletedGigId', '')
        && exists(gpath)
        && uidIs(docGet(gpath, 'assignedPurohitUid', ''))
        && docGet(gpath, 'status', '') in ORDER_DONE();
    }
    function p1CompletedConsultationOk() {
      let cid = tkNewGet('lastCompletedConsultationId', '');
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(cid);
      return tkNewGet('completedConsultations', 0) == tkOldGet('completedConsultations', 0) + 1
        && cid != '' && cid != tkOldGet('lastCompletedConsultationId', '')
        && exists(cpath)
        && uidIs(docGet(cpath, 'assignedJyotishUid', ''))
        && docGet(cpath, 'status', '') in ORDER_DONE();
    }

    function walletCreditCreateOk(uid) {
      let data = reqData();
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = docGet(opath, 'providerNet', 0);
      return orderId != ''
        && exists(opath)
        && docGet(opath, 'providerUid', '') == uid
        && (uidIs(docGet(opath, 'clientUid', ''))
          || uidIs(docGet(opath, 'providerUid', '')))
        && docGet(opath, 'status', '') in ORDER_ACTIVE()
        && net > 0
        && data.get('balance', -1) == net
        && data.get('totalReceived', -1) == net
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    match /wallets/{uid} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(uid));
      allow create: if isOwner()
        || (loggedUidIs(uid)
          && tkNewGet('balance', -1) == 0
          && tkNewGet('totalToppedUp', -1) == 0
          && tkNewGet('totalSpent', -1) == 0)
        || (isLoggedIn() && walletCreditCreateOk(uid))
        || (isLoggedIn() && p2pSettlementCreditCreateOk(uid))
        || (isLoggedIn() && referralWalletCreditCreateOk(uid));
      allow update: if isOwner()
        || (loggedUidIs(uid) && walletDebitOk())
        || (loggedUidIs(uid) && p2pSettlementDebitOk(uid))
        || (loggedUidIs(uid) && commissionHoldOk(uid))
        || (isLoggedIn() && walletCreditOk(uid))
        || (isLoggedIn() && p2pSettlementCreditOk(uid))
        || (isLoggedIn() && referralWalletCreditOk(uid))

        || (loggedUidIs(uid) && tkWalletDebitOk())
        || (loggedUidIs(uid) && tkWalletRefundOk(uid));
      allow delete: if false;
    }

    match /walletTransactions/{txnId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resUid()));
      allow create: if isOwner()
        || (loggedUidIs(reqUid())
          && tkNewGet('type', '') in ['spend', 'topup_request']
          && reqAmount() > 0)
        || (isLoggedIn()
          && tkNewGet('type', '') in ['receive', 'commission']
          && reqOrderId() != ''
          && (uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId()), 'clientUid', ''))
            || uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId()), 'providerUid', ''))))

        || (isLoggedIn()
          && tkNewGet('type', '') == 'referral_credit'
          && reqUid() != ''
          && tkNewGet('creditId', '') != ''
          && reqAmount() > 0
          && exists(/databases/$(database)/documents/referralCredits/$(tkNewGet('creditId', '')))
          && docGet(/databases/$(database)/documents/referralCredits/$(tkNewGet('creditId', '')), 'referrerUid', '') == reqUid()
          && docGet(/databases/$(database)/documents/referralCredits/$(tkNewGet('creditId', '')), 'status', '') == 'SETTLED'
          && docGet(/databases/$(database)/documents/referralCredits/$(tkNewGet('creditId', '')), 'creditAmount', 0) == reqAmount())

        || (isLoggedIn()
          && tkNewGet('type', '') == 'p2p_receive'
          && tkNewGet('requestId', '') != ''
          && reqAmount() > 0
          && reqUid() != request.auth.uid
          && uidIs(docGet(/databases/$(database)/documents/p2pRequests/$(tkNewGet('requestId', '')), 'senderId', ''))
          && docGet(/databases/$(database)/documents/p2pRequests/$(tkNewGet('requestId', '')), 'receiverId', '') == reqUid()
          && docGet(/databases/$(database)/documents/p2pRequests/$(tkNewGet('requestId', '')), 'amount', 0) == reqAmount()
          && docGet(/databases/$(database)/documents/p2pRequests/$(tkNewGet('requestId', '')), 'currency', '') == tkNewGet('currency', '')
          && docGet(/databases/$(database)/documents/p2pRequests/$(tkNewGet('requestId', '')), 'status', '') == 'accepted')

        || (loggedUidIs(reqUid())
          && tkNewGet('type', '') == 'refund'
          && tkRefundLedgerOk());
      allow update, delete: if false;
    }

    match /topupClaims/{claimId} {
      allow read: if isOwner() || isSuperAdmin()
        || (loggedUidIs(resUid()));
      allow create: if loggedUidIs(reqUid())
        && reqStatus() == 'pending'
        && reqAmount() > 0
        && tkNewGet('currency', '') in ['BDT', 'INR', 'USD'];
      allow update: if isOwner();
      allow delete: if false;
    }

    match /commissionPayments/{payId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(tkOldGet('paidByUid', ''))
          || uidIs(resClientUid())
          || uidIs(resProviderUid())));
      allow create: if loggedUidIs(tkNewGet('paidByUid', ''))
        && reqStatus() == 'pending'
        && reqAmount() > 0
        && reqOrderId() != '';
      allow update: if isOwner();
      allow delete: if false;
    }

    match /platformRevenue/{orderId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('recordedBy', ''))
        && tkNewGet('amount', -1) >= 0
        && tkNewGet('amount', -1) <=
             docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'commissionAmount', -1)
        && (uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'providerUid', ''))
          || uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'clientUid', '')));
      allow update: if isOwner();
      allow delete: if false;
    }

    match /crisis_events/{eventId} {
      function parent() {
        return docData(/databases/$(database)/documents/crisis_events/$(eventId));
      }
      function isCrisisCoord(ws) {
        return isLoggedIn() && ws != null
          && exists(/databases/$(database)/documents/crisisCoordinators/$(ws + '_' + request.auth.uid));
      }
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || (loggedUidIs(tkOldGet('senderUid', '')))

        || (isLoggedIn() && resStatus() == 'active'
          && exists(/databases/$(database)/documents/crisis_events/$(eventId)/notified/$(request.auth.uid)));
      allow create: if loggedUidIs(tkNewGet('senderUid', ''))
        && (demoWriteOk(newDocWs()) || isTenantMember(newDocWs()) || newDocWs() == null);
      allow update: if (demoWriteOk(docWs())
          || hasRole(docWs(), R_TRUSTEE())

          || (loggedUidIs(tkOldGet('senderUid', ''))
            && diffKeys()
              .hasOnly(['status', 'resolvedAt', 'outcomeNote', 'updatedAt'])
            && reqStatus() in ['cancelled', 'resolved'])

          || (loggedUidIs(tkOldGet('senderUid', ''))
            && diffKeys()
              .hasOnly(['voiceNoteUrl', 'updatedAt']))

          || (isCrisisCoord(docWs())
            && diffKeys()
              .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'ackCount',
                'resolvedAt', 'outcomeNote', 'updatedAt'])
            && reqStatus() in ['acknowledged', 'resolved'])

          || (isCrisisCoord(docWs())
            && diffKeys()
              .hasOnly(['assignments', 'status', 'responderCount', 'updatedAt'])
            && reqStatus()
              in ['active', 'responding', 'acknowledged']
            && tkNewGet('assignments', []) is list)

          || (isTenantMember(docWs())
            && diffKeys()
              .hasOnly(['status', 'ackCount', 'responderCount', 'updatedAt'])
            && reqStatus() == 'acknowledged'))
        && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
      match /responses/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (loggedUidIs(parent().get('senderUid', '')));
        allow create, update: if isSelf(uid)
          && reqUid() == uid
          && reqStatus() in ['coming', 'arrived'];
        allow delete: if false;
      }

      match /notified/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (loggedUidIs(parent().get('senderUid', '')));
        allow create: if isLoggedIn()
          && reqUid() == uid
          && reqKeys()
            .hasOnly(['uid', 'notifiedAt', 'distanceM'])
          && (

            (request.auth.uid == uid
              && isTenantMember(parent().get('workspaceId', null)))

            || uidIs(parent().get('senderUid', ''))
          );
        allow update, delete: if false;
      }
    }

    match /crisisCoordinators/{edgeId} {
      allow read: if isLoggedIn()
        && (uidIs(resUid())
          || isTenantMember(tkOldGet('orgId', null)));
      allow create, update: if isOrgTrustee(reqOrgId())
        && reqUid() != ''
        && (resource == null
          || reqOrgId() == tkOldGet('orgId', ''))
        && edgeId == reqOrgId() + '_'
          + reqUid();
      allow delete: if isOrgTrustee(tkOldGet('orgId', ''));
    }

    match /crisisAbuse/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /emergencyContacts/{uid} {
      allow read, write: if isSelf(uid);
    }

    function pollPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId);
    }
    function pollWs(pollId) {
      return docGet(pollPath(pollId), 'workspaceId', null);
    }
    function pollAudience(pollId) {
      return docGet(pollPath(pollId), 'targetAudience', 'ALL_MEMBERS');
    }
    function pollCommittee(ws) {
      return hasRole(ws, R_BOARD());
    }

    function pollBaseTotal(data) {
      return data.get('totalVotes', data.get('votedUsers', {}).size());
    }
    function pollKindOf(pollId) {
      return docGet(pollPath(pollId), 'kind', 'choice');
    }

    function pollVisOk() {
      return tkNewGet('resultVisibility', 'afterVote') in ['live', 'afterVote', 'afterClose', 'committee'];
    }
    function pollRealOptionCount(opts) {
      return opts.size() - (opts.keys().hasAny(['abstain']) ? 1 : 0);
    }

    function pollBallotNamed(pollId) {
      return docGet(pollPath(pollId), 'ballot', 'secret') == 'named';
    }

    function pollOptKeys(pdata) {
      return pdata.get('options', {}).keys();
    }
    function pollAllocOk(pdata, allocs, i) {
      return i >= allocs.size()
        || (allocs[i].get('optionId', '') in pollOptKeys(pdata)
            && allocs[i].get('points', -1) is int
            && allocs[i].get('points', -1) >= 0
            && allocs[i].get('points', -1) <= 100);
    }

    function pollAllocPts(allocs, i) {
      return i < allocs.size() ? allocs[i].get('points', 0) : 0;
    }
    function pollKeys(k) {
      return reqKeys().hasOnly([k, 'votedAt']);
    }
    function pollBallotOk(pollId) {
      let pdata = docData(pollPath(pollId));
      let kind = pdata.get('kind', 'choice');
      let ranking = tkNewGet('ranking', []);
      let allocs = tkNewGet('allocations', []);
      return (isTenantMember(pdata.get('workspaceId', null)) || demoWriteOk(pdata.get('workspaceId', null)))
        && pdata.get('status', '') == 'ACTIVE'
        && (pdata.get('targetAudience', 'ALL_MEMBERS') != 'MANAGERS'
            || pollCommittee(pdata.get('workspaceId', null)))

        && (pdata.get('opensAtTs', null) == null || request.time >= pdata.get('opensAtTs', null))
        && (pdata.get('expiresAtTs', null) == null || request.time < pdata.get('expiresAtTs', null))

        && (((kind == 'choice' || kind == 'time')
              && (tkNewGet('optionId', '') in pollOptKeys(pdata))
              && pollKeys('optionId'))
          || (kind == 'multi'
              && reqOptionIds() is list
              && reqOptionIds().size() >= 1
              && reqOptionIds().size() <= 5
              && pollOptKeys(pdata).hasAll(reqOptionIds())
              && (!('abstain' in reqOptionIds())
                  || reqOptionIds().size() == 1)
              && pollKeys('optionIds'))
          || (kind == 'text'
              && reqText() is string
              && reqText().size() >= 1
              && reqText().size() <= 280
              && pollKeys('text'))

          || (kind == 'ranked'
              && ranking is list
              && ranking.size() >= 1
              && ranking.size() <= 8
              && pollOptKeys(pdata).hasAll(ranking)
              && !('abstain' in ranking)
              && pollKeys('ranking'))

          || (kind == 'points'
              && allocs is list
              && allocs.size() >= 1
              && allocs.size() <= 8
              && pollAllocOk(pdata, allocs, 0)
              && pollAllocOk(pdata, allocs, 1)
              && pollAllocOk(pdata, allocs, 2)
              && pollAllocOk(pdata, allocs, 3)
              && pollAllocOk(pdata, allocs, 4)
              && pollAllocOk(pdata, allocs, 5)
              && pollAllocOk(pdata, allocs, 6)
              && pollAllocOk(pdata, allocs, 7)
              && (pollAllocPts(allocs, 0) + pollAllocPts(allocs, 1)
                  + pollAllocPts(allocs, 2) + pollAllocPts(allocs, 3)
                  + pollAllocPts(allocs, 4) + pollAllocPts(allocs, 5)
                  + pollAllocPts(allocs, 6) + pollAllocPts(allocs, 7)) == 100
              && pollKeys('allocations'))

          || (kind != 'text'
              && tkNewGet('abstain', false) == true
              && pdata.get('allowAbstain', false) == true
              && pollKeys('abstain')));
    }

    function pollVoteHeadOk() {
      return (demoWriteOk(docWs()) || isTenantMember(docWs())) && wsImmutable();
    }
    function pollVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let oldOpts = tkOldGet('options', {});
      let newOpts = reqOptions();

      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && (afterDocGet(vp, 'optionId', '') in oldOpts.keys())
        && newOpts.diff(oldOpts).addedKeys().size() == 0
        && newOpts.diff(oldOpts).removedKeys().size() == 0
        && newOpts.diff(oldOpts).changedKeys().hasOnly([afterDocGet(vp, 'optionId', '')])
        && newOpts.get(afterDocGet(vp, 'optionId', ''), {}).get('votes', 0)
             == oldOpts.get(afterDocGet(vp, 'optionId', ''), {}).get('votes', 0) + 1
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && diffKeys()
             .hasOnly(['options', 'totalVotes', 'updatedAt']);
    }

    function pollMultiDeltaOk(oldOpts, newOpts, id) {
      return newOpts.get(id, {}).get('votes', 0) == oldOpts.get(id, {}).get('votes', 0) + 1;
    }
    function pollMultiVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let oldOpts = tkOldGet('options', {});
      let newOpts = reqOptions();
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && tkOldGet('kind', 'choice') == 'multi'
        && afterDocGet(vp, 'optionIds', []) is list
        && afterDocGet(vp, 'optionIds', []).size() >= 1
        && afterDocGet(vp, 'optionIds', []).size() <= 5
        && newOpts.diff(oldOpts).addedKeys().size() == 0
        && newOpts.diff(oldOpts).removedKeys().size() == 0
        && newOpts.diff(oldOpts).changedKeys().size() == afterDocGet(vp, 'optionIds', []).size()
        && newOpts.diff(oldOpts).changedKeys().hasOnly(afterDocGet(vp, 'optionIds', []))
        && (afterDocGet(vp, 'optionIds', []).size() < 1 || pollMultiDeltaOk(oldOpts, newOpts, afterDocGet(vp, 'optionIds', [])[0]))
        && (afterDocGet(vp, 'optionIds', []).size() < 2 || pollMultiDeltaOk(oldOpts, newOpts, afterDocGet(vp, 'optionIds', [])[1]))
        && (afterDocGet(vp, 'optionIds', []).size() < 3 || pollMultiDeltaOk(oldOpts, newOpts, afterDocGet(vp, 'optionIds', [])[2]))
        && (afterDocGet(vp, 'optionIds', []).size() < 4 || pollMultiDeltaOk(oldOpts, newOpts, afterDocGet(vp, 'optionIds', [])[3]))
        && (afterDocGet(vp, 'optionIds', []).size() < 5 || pollMultiDeltaOk(oldOpts, newOpts, afterDocGet(vp, 'optionIds', [])[4]))
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && tkDiff(['options', 'totalVotes', 'updatedAt']);
    }

    function pollTextVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && tkOldGet('kind', 'choice') == 'text'
        && afterDocGet(vp, 'text', '') is string
        && afterDocGet(vp, 'text', '').size() >= 1
        && afterDocGet(vp, 'text', '').size() <= 280
        && reqOptions() == tkOldGet('options', {})
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && tkDiff(['totalVotes', 'updatedAt']);
    }

    function pollAbstainVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && afterDocGet(vp, 'abstain', false) == true
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && tkNewGet('abstainVotes', 0) == tkOldGet('abstainVotes', 0) + 1
        && tkDiff(['totalVotes', 'abstainVotes', 'updatedAt']);
    }

    function pollCountedVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let kind = tkOldGet('kind', 'choice');
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && kind in ['ranked', 'points']
        && ((kind == 'ranked'
             && afterDocGet(vp, 'ranking', []) is list
             && afterDocGet(vp, 'ranking', []).size() >= 1)
          || (kind == 'points'
             && afterDocGet(vp, 'allocations', []) is list
             && afterDocGet(vp, 'allocations', []).size() >= 1))
        && reqOptions() == tkOldGet('options', {})
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && tkDiff(['totalVotes', 'updatedAt']);
    }

    function pollEditOk() {

      return (resStatus() == 'ACTIVE' || resStatus() == 'DRAFT')
        && reqStatus() == resStatus()
        && pollBaseTotal(resource.data) == 0
        && diffKeys()
             .hasOnly(['title', 'description', 'options', 'expiresAt', 'expiresAtTs', 'opensAt', 'opensAtTs', 'resultVisibility', 'allowAbstain', 'updatedAt'])
        && pollVisOk()
        && (tkOldGet('kind', 'choice') == 'text'
            || (pollRealOptionCount(reqOptions()) >= 2
                && pollRealOptionCount(reqOptions()) <= 8));
    }

    function pollManageOk() {

      return (resStatus() == 'DRAFT'
              && reqStatus() == 'ACTIVE'
              && diffKeys()
                   .hasOnly(['status', 'eligibleCount', 'updatedAt']))
        || (diffKeys()
               .hasOnly(['status', 'adminNote', 'outcome', 'updatedAt'])
            && (reqStatus() == resStatus()
                || (resStatus() == 'ACTIVE'
                    && reqStatus() == 'CONCLUDED'))
            && (!diffKeys().hasAny(['outcome'])
                || (reqStatus() == 'CONCLUDED'
                    && !('outcome' in resource.data))));
    }

    function pollAutoConcludeOk() {
      return diffKeys()
               .hasOnly(KEYS_STATUS_ONLY())
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'CONCLUDED'
        && resExpiresAtTs() != null
        && request.time >= resExpiresAtTs();
    }

    match /polls/{pollId} {

      allow read: if (demoPublicRead(docWs()) || isSuperAdmin()
        || (isTenantMember(docWs())
            && (tkOldGet('targetAudience', 'ALL_MEMBERS') != 'MANAGERS'
                || pollCommittee(docWs()))))
        && (resStatus() != 'DRAFT'
            || pollCommittee(docWs()) || isSuperAdmin());
      allow create: if demoWriteOk(newDocWs())
        || (pollCommittee(newDocWs())
            && reqStatus() in ['ACTIVE', 'DRAFT']
            && tkNewGet('totalVotes', 0) == 0
            && tkNewGet('abstainVotes', 0) == 0
            && tkNewGet('votedUsers', {}).size() == 0
            && tkNewGet('targetAudience', '') in ['ALL_MEMBERS', 'MANAGERS']

            && (tkNewGet('kind', 'choice') == 'text'
                ? reqOptions().size() == 0
                : (pollRealOptionCount(reqOptions()) >= 2
                   && pollRealOptionCount(reqOptions()) <= 8))

            && tkNewGet('kind', 'choice') in ['choice', 'multi', 'text', 'ranked', 'points', 'time']
            && pollVisOk()

            && tkNewGet('pollClass', 'pulse') in ['pulse', 'decision']
            && tkNewGet('ballot', 'secret') in ['secret', 'named']
            && tkNewGet('quorumPct', 0) >= 0
            && tkNewGet('passPct', 0) >= 0
            && reqKeys().hasOnly(
                 ['workspaceId', 'title', 'description', 'targetAudience', 'status',
                  'createdAt', 'createdBy', 'expiresAt', 'expiresAtTs', 'options',
                  'totalVotes', 'votedUsers', 'kind', 'resultVisibility',
                  'pollClass', 'binding', 'ballot', 'eligibleCount', 'quorumPct',
                  'passPct', 'createdByUid',

                  'opensAt', 'opensAtTs', 'allowAbstain', 'abstainVotes',
                  'templateId', 'recurrence']));
      allow update: if (pollVoteHeadOk() && pollVoteAnchorOk(pollId))
        || (pollVoteHeadOk() && pollMultiVoteAnchorOk(pollId))
        || (pollVoteHeadOk() && pollTextVoteAnchorOk(pollId))
        || (pollVoteHeadOk() && pollAbstainVoteAnchorOk(pollId))
        || (pollVoteHeadOk() && pollCountedVoteAnchorOk(pollId))
        || (pollCommittee(docWs()) && wsImmutable() && pollEditOk())
        || (pollCommittee(docWs()) && wsImmutable() && pollManageOk())
        || (isTenantMember(docWs()) && wsImmutable() && pollAutoConcludeOk());

      allow delete: if pollCommittee(docWs()) && pollBaseTotal(resource.data) == 0;

      match /votes/{voterUid} {
        allow read: if isLoggedIn() && (uidIs(voterUid)
          || isSuperAdmin()
          || (pollAudience(pollId) == 'MANAGERS' && pollCommittee(pollWs(pollId)))

          || (pollBallotNamed(pollId) && pollCommittee(pollWs(pollId)))

          || (pollKindOf(pollId) == 'text' && pollCommittee(pollWs(pollId)))

          || (pollKindOf(pollId) in ['ranked', 'points']
              && pollCommittee(pollWs(pollId))));
        allow create: if uidIs(voterUid) && pollBallotOk(pollId);
        allow update, delete: if false;
      }
    }

    function SUGG_KINDS() {
      return ['feature', 'problem', 'praise', 'manual-gap'];
    }
    function SUGG_STATUSES() {
      return ['received', 'under-review', 'planned', 'in-progress',
        'shipped', 'not-now', 'duplicate'];
    }

    function suggAnchorOk(suggId, up) {
      let sp = /databases/$(database)/documents/suggestions/$(suggId)/supporters/$(request.auth.uid);
      return (up ? (!exists(sp) && existsAfter(sp))
                 : (exists(sp) && !existsAfter(sp)))
        && tkOldGet('hidden', false) == false
        && tkNewGet('supporterCount', 0)
             == tkOldGet('supporterCount', 0) + (up ? 1 : -1)
        && tkNewGet('supporterCount', 0) >= 0
        && tkDiff(['supporterCount', 'updatedAt']);
    }
    function suggVisible(suggId) {
      return docGet(/databases/$(database)/documents/suggestions/$(suggId), 'hidden', false) == false;
    }

    function suggDeskIdOk() {
      return tkNewGet('deskId', null) == null
        || (tkNewGet('deskId', '') is string
            && tkNewGet('deskId', '').size() <= 64);
    }
    function suggTitleBodyOk() {
      return tkNewGet('title', '') is string
        && tkNewGet('title', '').size() >= 1
        && tkNewGet('title', '').size() <= 140
        && tkNewGet('body', '') is string
        && tkNewGet('body', '').size() >= 1
        && tkNewGet('body', '').size() <= 2000;
    }

    match /suggestions/{suggId} {

      allow read: if tkOldGet('hidden', false) == false
        || isSuperAdmin()
        || (loggedUidIs(tkOldGet('authorId', '')));
      allow create: if loggedUidIs(tkNewGet('authorId', ''))
        && tkNewGet('status', '') == 'received'
        && tkNewGet('supporterCount', -1) == 0
        && tkNewGet('hidden', true) == false
        && tkNewGet('kind', '') in SUGG_KINDS()
        && suggTitleBodyOk()
        && tkNewGet('authorName', '') is string
        && tkNewGet('authorName', '').size() >= 1
        && tkNewGet('authorName', '').size() <= 80
        && tkNewGet('language', '') is string
        && tkNewGet('language', '').size() <= 8
        && suggDeskIdOk()
        && tkNewGet('officialReplies', []).size() == 0
        && tkNewGet('statusHistory', []).size() <= 1
        && tkNewGet('shippedVersion', null) == null
        && tkNewGet('duplicateOf', null) == null
        && request.resource.data.keys().hasOnly(
             ['authorId', 'authorName', 'kind', 'deskId', 'title', 'body',
              'language', 'status', 'statusHistory', 'officialReplies',
              'supporterCount', 'hidden', 'createdAt', 'updatedAt',
              'shippedVersion', 'duplicateOf']);
      allow update: if (loggedUidIs(tkOldGet('authorId', ''))
            && tkOldGet('status', '') == 'received'
            && tkNewGet('status', '') == 'received'
            && tkDiff(['title', 'body', 'deskId', 'kind', 'updatedAt'])
            && tkNewGet('kind', '') in SUGG_KINDS()
            && suggTitleBodyOk()
            && suggDeskIdOk())
        || (isLoggedIn() && suggAnchorOk(suggId, true))
        || (isLoggedIn() && suggAnchorOk(suggId, false))
        || (isSuperAdmin()
            && tkDiff(['status', 'statusHistory', 'officialReplies', 'hidden',
                  'duplicateOf', 'shippedVersion', 'updatedAt'])
            && tkNewGet('status', '') in SUGG_STATUSES()
            && tkNewGet('officialReplies', []).size() <= 50
            && tkNewGet('statusHistory', []).size() <= 50);

      allow delete: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('authorId', ''))
            && tkOldGet('supporterCount', 0) == 0);

      match /supporters/{supporterUid} {
        allow read: if isSuperAdmin()
          || (loggedUidIs(supporterUid));
        allow create: if loggedUidIs(supporterUid)
          && suggVisible(suggId)
          && reqKeys().hasOnly(['supportedAt']);
        allow update: if false;
        allow delete: if loggedUidIs(supporterUid);
      }
    }

    function resBoardRoles() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER'];
    }

    function resQuorumOk(data) {
      let cast = data.get('votesInFavor', 0) + data.get('votesAgainst', 0);
      let board = data.get('boardSize', 0);
      return board > 0 ? (cast * 2 > board) : (cast >= 2);
    }
    function resOutcomeOk(data) {
      return resQuorumOk(data) == data.get('quorumMet', false)
        && (data.get('quorumMet', false) == false
            ? data.get('status', '') == 'Deferred'
            : (data.get('votesInFavor', 0) > data.get('votesAgainst', 0)
                ? data.get('status', '') == 'Passed'
                : data.get('status', '') == 'Rejected'));
    }
    function resCreateCountsOk() {
      let v = tkNewGet('voters', {});
      return tkNewGet('votesAgainst', 0) == 0
        && tkNewGet('votesInFavor', 0) <= 1
        && v.size() <= 1
        && (v.size() == 0 || tkNewGet('votesInFavor', 0) == 1)
        && tkNewGet('quorumMet', false) == false
        && (tkNewGet('proposedByUid', '') == ''
            || uidIs(tkNewGet('proposedByUid', '')));
    }
    function resVoteOk() {
      let uid = request.auth.uid;
      let oldV = tkOldGet('voters', {});
      let newV = tkNewGet('voters', {});
      let choice = newV.get(uid, '');
      return resStatus() == 'Pending Review'
        && !(uid in oldV.keys())
        && (choice == 'favor' || choice == 'against')
        && newV.size() == oldV.size() + 1
        && newV.diff(oldV).addedKeys().hasOnly([uid])
        && newV.diff(oldV).changedKeys().size() == 0
        && newV.diff(oldV).removedKeys().size() == 0
        && tkNewGet('votesInFavor', 0)
             == tkOldGet('votesInFavor', 0) + (choice == 'favor' ? 1 : 0)
        && tkNewGet('votesAgainst', 0)
             == tkOldGet('votesAgainst', 0) + (choice == 'against' ? 1 : 0)
        && diffKeys()
             .hasOnly(['voters', 'votesInFavor', 'votesAgainst', 'updatedAt'])
        && (resExpiresAtTs() == null
            || request.time < resExpiresAtTs());
    }
    function resConcludeOk() {
      return resStatus() == 'Pending Review'
        && reqStatus() in ['Passed', 'Rejected', 'Deferred']
        && diffKeys()
             .hasOnly(['status', 'quorumMet', 'details', 'concludedAt', 'updatedAt'])
        && tkNewGet('votesInFavor', 0) == tkOldGet('votesInFavor', 0)
        && tkNewGet('votesAgainst', 0) == tkOldGet('votesAgainst', 0)
        && tkNewGet('boardSize', 0) == tkOldGet('boardSize', 0)
        && resOutcomeOk(reqData())
        && ((resExpiresAtTs() != null
              && request.time >= resExpiresAtTs())
            || (tkOldGet('boardSize', 0) > 0
                && tkOldGet('votesInFavor', 0) + tkOldGet('votesAgainst', 0)
                     >= tkOldGet('boardSize', 0))
            || resExpiresAtTs() == null);
    }
    function resEditOk() {
      return resStatus() == 'Pending Review'
        && reqStatus() == 'Pending Review'
        && diffKeys()
             .hasOnly(['title', 'description', 'details', 'secondedBy', 'bannerUrl', 'updatedAt']);
    }

    match /resolutions/{resId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if demoWriteOk(newDocWs())
        || (isTenantMember(newDocWs()) && roleIn(R_ANY_STAFF())
            && reqStatus() == 'Pending Review'
            && resCreateCountsOk());
      allow update: if (demoWriteOk(docWs()) && wsImmutable())
        || (isTenantMember(docWs()) && wsImmutable() && hasRole(docWs(), resBoardRoles()) && resVoteOk())
        || (isTenantMember(docWs()) && wsImmutable() && resConcludeOk())
        || (isTenantMember(docWs()) && wsImmutable() && roleIn(R_ANY_STAFF()) && resEditOk());

      allow delete: if hasRole(docWs(), R_TRUSTEE())
        && resStatus() == 'Pending Review'
        && tkOldGet('votesInFavor', 0) + tkOldGet('votesAgainst', 0) <= 1
        && tkOldGet('voters', {}).size() <= 1;
    }

    match /yatra_broadcasts/{bId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(tkOldGet('communityId', null)) && (request.auth == null || effTenant() == tkOldGet('communityId', null)))
        || isTenantMember(tkOldGet('communityId', null));
      allow create: if isLoggedIn() && (isDemoWs(tkNewGet('communityId', null))
        || isTenantMember(tkNewGet('communityId', null)));
      allow update: if isSuperAdmin() || (isTenantMember(tkOldGet('communityId', null))
        && tkNewGet('communityId', null) == tkOldGet('communityId', null));
      allow delete: if isSuperAdmin();
    }

    match /global_support_threads/{tId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }
    match /global_support_replies/{rId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSuperAdmin() || (isLoggedIn() && (
        (resource == null || (tkOldGet('participants', null) is list && request.auth.uid in tkOldGet('participants', []))) ||
        isChatOrgTrustee(resource.data)));
      allow create: if isSuperAdmin() || (isLoggedIn() && (
        (tkNewGet('participants', null) is list && request.auth.uid in tkNewGet('participants', [])) ||
        (tkNewGet('type', '') == 'org' &&
          tkNewGet('participants', null) is list &&
          tkNewGet('participants', []).size() == 2 &&
          isOrgTrustee(chatOrgId(reqData())))));
      allow update: if isSuperAdmin() || (isLoggedIn() && (
        (tkOldGet('participants', null) is list && request.auth.uid in tkOldGet('participants', []) &&
          !diffKeys().hasAny(['participants'])) ||
        (isChatOrgTrustee(resource.data) &&
          !diffKeys().hasAny(['participants', 'type', 'orgId']))));
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() && (
          (docGet(/databases/$(database)/documents/chats/$(chatId), 'participants', null) is list &&
            request.auth.uid in docGet(/databases/$(database)/documents/chats/$(chatId), 'participants', [])) ||
          isChatOrgTrustee(docData(/databases/$(database)/documents/chats/$(chatId)))));
        allow create: if isSuperAdmin() || (isLoggedIn() && (
          (docGet(/databases/$(database)/documents/chats/$(chatId), 'participants', null) is list &&
            request.auth.uid in docGet(/databases/$(database)/documents/chats/$(chatId), 'participants', []) &&
            uidIs(tkNewGet('senderId', ''))) ||
          isChatOrgTrustee(docData(/databases/$(database)/documents/chats/$(chatId)))));
        allow update, delete: if false;
      }
    }

    match /upgrade_requests/{reqId} {

      allow create: if isLoggedIn() && (isSuperAdmin()
        || isTenantMember(tkNewGet('communityId', ''))
        || isDemoWs(tkNewGet('communityId', null)));

      allow read: if isSuperAdmin()
        || hasRole(tkOldGet('communityId', ''), R_FINANCE())
        || (isDemoWs(tkOldGet('communityId', null)) && isLoggedIn());
      allow update, delete: if isSuperAdmin();
    }

    match /orgLiveStatus/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && reqOrgId() == orgId
        && tkNewGet('isLive', null) is bool
        && tkNewGet('updatedAt', null) is number
        && reqKeys().hasOnly([
          'orgId', 'isLive', 'videoId', 'title', 'startedAt',
          'updatedAt', 'nextPollAfter'
        ]);
      allow delete: if isSuperAdmin() || isOwner();
    }

    match /sangamVideos/{videoId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && tkNewGet('youtubeId', '') is string
        && tkNewGet('youtubeId', '').size() == 11
        && reqTitle() is string
        && reqTitle().size() >= 1
        && reqTitle().size() <= 120
        && uidIs(tkNewGet('sharedBy', ''))
        && tkNewGet('category', '') in ['shared', 'seva_demo', 'live_event']
        && reqKeys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'duration', 'sharedBy',
          'sharedByName', 'sharedBySanId', 'caption', 'category',
          'providerUid', 'providerTier', 'createdAt', 'reportCount',
          'serverCreatedAt'
        ]);
      allow update: if isLoggedIn()
        && bumpUpOk('reportCount');
      allow delete: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('sharedBy', '')));
    }

    match /sangamStories/{storyId} {
      allow read: if isLoggedIn();
      allow create: if loggedUidIs(reqAuthorUid())
        && reqAuthorName() is string
        && reqAuthorName().size() >= 1
        && reqAuthorName().size() <= 60
        && tkNewGet('mediaType', '') in ['photo', 'text']
        && tkNewGet('expiresAt', 0) is number
        && tkNewGet('expiresAt', 0) > request.time.toMillis()
        && tkNewGet('expiresAt', 0) <= request.time.toMillis() + 25 * 60 * 60 * 1000
        && reqKeys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'authorSanId',
          'mediaType', 'mediaUrl', 'text', 'backgroundId', 'caption',
          'createdAt', 'expiresAt', 'reportCount'
        ]);
      allow update: if isLoggedIn()
        && bumpUpOk('reportCount');
      allow delete: if isSuperAdmin()
        || (loggedUidIs(resAuthorUid()));

      match /viewers/{uid} {
        allow read: if isSuperAdmin()
          || (loggedUidIs(docGet(/databases/$(database)/documents/sangamStories/$(storyId), 'authorUid', '')));
        allow write: if loggedUidIs(uid);
      }
    }

    match /sangamShorts/{shortId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && tkNewGet('youtubeId', '') is string
        && tkNewGet('youtubeId', '').size() == 11
        && reqTitle() is string
        && reqTitle().size() >= 1
        && reqTitle().size() <= 120
        && uidIs(reqAuthorUid())
        && reqAuthorName() is string
        && reqAuthorName().size() >= 1
        && reqAuthorName().size() <= 60
        && reqKeys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'authorUid',
          'authorName', 'authorAvatar', 'authorSanId', 'caption',
          'duration', 'createdAt', 'viewCount', 'ashirvadCount',
          'commentCount', 'shareCount', 'reportCount',
          'serverCreatedAt'
        ]);

      allow update: if isLoggedIn() && (
        (bumpUpOk('viewCount'))
        || (bumpToggleOk('ashirvadCount'))
        || (bumpToggleOk('commentCount'))
        || (bumpToggleOk('shareCount'))
        || (bumpUpOk('reportCount'))
      );
      allow delete: if isSuperAdmin()
        || (loggedUidIs(resAuthorUid()));

      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if loggedUidIs(reqAuthorUid())
          && reqText() is string
          && reqText().size() >= 1
          && reqText().size() <= 300
          && reqKeys().hasOnly([
            'authorUid', 'authorName', 'text', 'createdAt', 'serverCreatedAt'
          ]);
        allow delete: if isSuperAdmin()
          || (loggedUidIs(resAuthorUid()));
      }
    }

    match /devoteeProfiles/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && reqUid() == uid
        && tkNewGet('displayName', '') is string
        && tkNewGet('displayName', '').size() >= 1
        && tkNewGet('displayName', '').size() <= 80
        && tkNewGet('sanId', '') is string
        && reqKeys().hasOnly([
          'uid', 'displayName', 'sanId', 'avatarUrl', 'bio',
          'isPublic', 'followerCount', 'followingCount', 'updatedAt'
        ]);
      allow delete: if isSuperAdmin()
        || (isSelf(uid));
    }

    match /follows/{followerUid}/following/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(followerUid));
      allow create: if isLoggedIn()
        && request.auth.uid == followerUid
        && followerUid != targetUid
        && reqKeys().hasOnly(['followerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(followerUid));
    }

    match /blocks/{blockerUid}/blocked/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(blockerUid));
      allow create: if isLoggedIn()
        && request.auth.uid == blockerUid
        && blockerUid != targetUid
        && reqKeys().hasOnly(['blockerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(blockerUid));
    }

    match /mutes/{muterUid}/muted/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(muterUid));
      allow create: if isLoggedIn()
        && request.auth.uid == muterUid
        && muterUid != targetUid
        && reqKeys().hasOnly(['muterUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(muterUid));
    }

    match /chatGroups/{groupId} {      allow read: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []));

      allow create: if isLoggedIn() &&
        tkNewGet('memberIds', null) is list &&
        request.auth.uid in tkNewGet('memberIds', []) &&
        tkNewGet('adminIds', null) is list &&
        request.auth.uid in tkNewGet('adminIds', []) &&
        reqName() is string &&
        reqName().size() >= 2 &&
        reqName().size() <= 60 &&
        tkNewGet('inviteCode', '') is string &&
        tkNewGet('inviteCode', '').size() == 8 &&
        uidIs(tkNewGet('createdBy', ''));

      allow update: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []) && (
          tkDiff(['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
             'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy']) ||
          (request.auth.uid in tkOldGet('adminIds', []) &&
            tkDiff(['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
               'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy',
               'name', 'description', 'memberIds', 'adminIds', 'memberInfo', 'inviteCode']) &&
            tkNewGet('memberIds', null) is list &&
            tkNewGet('adminIds', null) is list &&
            tkNewGet('createdBy', '') == tkOldGet('createdBy', ''))
        ));

      allow delete: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []) && (
          request.auth.uid in tkOldGet('adminIds', []) ||
          tkOldGet('memberIds', []).size() == 1));

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', null) is list &&
          request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', []));
        allow create: if isSuperAdmin() || (isLoggedIn() &&
          docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', null) is list &&
          request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', []) &&
          uidIs(tkNewGet('senderId', '')) &&
          (tkNewGet('kind', '') != 'system' ||
            tkNewGet('systemKind', '') in
              ['created', 'joined', 'left', 'added', 'removed', 'renamed', 'promoted']));

        allow delete: if isSuperAdmin() || (loggedUidIs(tkOldGet('senderId', '')) &&
          request.time.toMillis() - tkOldGet('createdAt', 0) < 5 * 60 * 1000);
        allow update: if false;
      }

      match /members/{uid} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', null) is list &&
          request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'memberIds', []));

        allow create: if isSuperAdmin() || (isLoggedIn() &&
          reqUid() == uid &&
          (uidIs(uid) ||
            request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'adminIds', [])));

        allow update: if isSuperAdmin() || (isLoggedIn() &&
          request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'adminIds', []) &&
          tkDiff(['role']));

        allow delete: if isSuperAdmin() || (isLoggedIn() &&
          (uidIs(uid) ||
            request.auth.uid in docGet(/databases/$(database)/documents/chatGroups/$(groupId), 'adminIds', [])));
      }
    }

    match /communities/{communityId}/{collectionName}/{docId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(communityId) && (request.auth == null || effTenant() == communityId))
        || isTenantMember(communityId);
      allow write: if isLoggedIn() && (isDemoWs(communityId) || isTenantMember(communityId));
    }

    match /purohits/{purohitId} {
      allow read: if true;
      allow create: if loggedUidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('ratingAggregate', 0) == 0
        && reqRatingCount() == 0
        && tkNewGet('completedGigs', 0) == 0

        && request.resource.data.get('endorsementCount', 0) == 0;
      allow update: if isSuperAdmin()
        || (loggedUidIs(resUid())
          && uidIs(reqUid())
          && tkNewGet('id', '') == tkOldGet('id', '')
          && reqVerificationTier() == tkOldGet('verificationTier', '')

          && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0)
          && request.resource.data.get('lastEndorsementId', '') == resource.data.get('lastEndorsementId', '')

          && tkNewGet('ratingAggregate', 0) == tkOldGet('ratingAggregate', 0)
          && reqRatingCount() == tkOldGet('ratingCount', 0)
          && (tkNewGet('completedGigs', 0) == tkOldGet('completedGigs', 0)
            || p1CompletedGigOk()))

        || (isLoggedIn()
          && diffKeys()
            .hasOnly(RATING_KEYS())
          && p1PurohitRatingOk(purohitId))

        || (isLoggedIn()
          && diffKeys()
            .hasOnly(['endorsementCount', 'lastEndorsementId', 'updatedAt'])
          && p1PurohitEndorsementOk(purohitId))

        || (loggedUidIs(resUid())
          && diffKeys()
            .hasOnly(['verificationTier', 'updatedAt'])
          && purohitTierClaimOk())

        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;
    }

    match /purohitAvailability/{purohitId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn()
          && exists(/databases/$(database)/documents/purohits/$(purohitId))
          && uidIs(docGet(/databases/$(database)/documents/purohits/$(purohitId), 'uid', '')));
    }

    match /sanataniProfiles/{uid} {
      allow read: if true;
      allow create: if loggedUidIs(uid)
        && uidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('roles', {}) == {};
      allow update: if isSuperAdmin()
        || (loggedUidIs(uid)
          && uidIs(resUid())
          && uidIs(reqUid())
          && tkNewGet('id', '') == tkOldGet('id', '')
          && reqVerificationTier() == tkOldGet('verificationTier', '')
          && (
            tkNewGet('roles', {}) == tkOldGet('roles', {})
            || validPurohitAttach()
            || validJyotishAttach()
          ));
      allow delete: if false;

      function validPurohitAttach() {
        let newRoles = tkNewGet('roles', {});
        let oldRoles = tkOldGet('roles', {});
        let newPid = newRoles.get('purohitId', '');
        return newPid != ''
          && newPid != oldRoles.get('purohitId', '')
          && diffKeysOnly(newRoles, oldRoles, ['purohitId'])
          && exists(/databases/$(database)/documents/purohits/$(newPid))
          && uidIs(docGet(/databases/$(database)/documents/purohits/$(newPid), 'uid', ''));
      }

      function validJyotishAttach() {
        let newRoles = tkNewGet('roles', {});
        let oldRoles = tkOldGet('roles', {});
        let newJid = newRoles.get('jyotishId', '');
        return newJid != ''
          && newJid != oldRoles.get('jyotishId', '')
          && diffKeysOnly(newRoles, oldRoles, ['jyotishId'])
          && exists(/databases/$(database)/documents/jyotishProfiles/$(newJid))
          && uidIs(docGet(/databases/$(database)/documents/jyotishProfiles/$(newJid), 'uid', ''));
      }
    }

    match /sanataniProfiles/{uid}/private/self {
      allow read, write: if loggedUidIs(uid);
    }

    match /prathamSevaConfig/{configId} {
      allow read: if isLoggedIn();
      allow create, update: if isSuperAdmin()
        && tkNewGet('defaultFreeSevas', -1) >= 0
        && tkNewGet('defaultFreeSevas', 51) <= 50;
      allow delete: if false;
    }

    function applicationCreateOk(idField) {
      return loggedUidIs(reqUid())
        && tkNewGet(idField, '') != ''
        && reqStatus() == 'PENDING'
        && tkNewGet('tier', '') == ''
        && tkNewGet('freeSevasRemaining', 0) == 0
        && tkNewGet('boostUntil', '') == ''
        && tkNewGet('reviewedBy', '') == ''
        && tkNewGet('reviewNote', '') == '';
    }
    match /purohitApplications/{appId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(resUid()));
      allow create: if applicationCreateOk('purohitId');
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    function bookingTransitionOk() {
      let from = resStatus();
      let to = reqStatus();
      return (from == 'OPEN' && to in ['ASSIGNED', 'CANCELLED'])
        || (from == 'ASSIGNED' && to in ['IN_PROGRESS', 'CANCELLED'])

        || (from == 'IN_PROGRESS' && to in ['COMPLETED', 'CANCELLED'])
        || (from == 'COMPLETED' && to in ['DAKSHINA_RELEASED'])
        || (from == to);
    }
    function bookingImmutableOk() {
      return tkNewGet('devoteeUid', '') == tkOldGet('devoteeUid', '')
        && tkNewGet('id', '') == tkOldGet('id', '')
        && tkNewGet('createdAt', 0) == tkOldGet('createdAt', 0)
        && reqReferredBy() == tkOldGet('referredBy', {});
    }
    function isGigParty() {
      return isLoggedIn()
        && (uidIs(tkOldGet('devoteeUid', ''))
          || uidIs(tkOldGet('assignedPurohitUid', '')));
    }
    function gigTransitionOk() {
      return bookingTransitionOk();
    }
    function gigImmutableOk() {
      return bookingImmutableOk();
    }
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('devoteeUid', ''))
        && reqStatus() == 'OPEN'
        && gigReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && gigTransitionOk() && gigImmutableOk()
          && (isGigParty()

            || (resStatus() == 'OPEN'
              && reqStatus() == 'ASSIGNED'
              && uidIs(tkNewGet('assignedPurohitUid', '')))));
      allow delete: if false;
    }

    match /endorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(R_TRUSTEE_PAIR()))
        && reqOrgId() != ''
        && tkNewGet('orgName', '') != ''
        && tkNewGet('purohitId', '') != ''
        && reqText() != '';
      allow update, delete: if isSuperAdmin();
    }

    function reviewPartyOk() {
      let gigPath = /databases/$(database)/documents/gigs/$(tkNewGet('gigId', ''));
      return exists(gigPath)
        && docGet(gigPath, 'status', '') in ORDER_DONE()
        && (uidIs(docGet(gigPath, 'devoteeUid', ''))
          || uidIs(docGet(gigPath, 'assignedPurohitUid', '')));
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('reviewerUid', ''))
        && tkNewGet('gigId', '') != ''
        && reqRating() >= 1
        && reqRating() <= 5
        && reviewPartyOk();
      allow update, delete: if false;
    }

    match /purohitInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('purohitUid', ''))
            || roleIn(R_TRUSTEE_PAIR())));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(R_TRUSTEE_PAIR())
          && reqOrgId() != ''
          && tkNewGet('orgName', '') != ''
          && tkNewGet('purohitId', '') != ''
          && tkNewGet('purohitUid', '') != ''
          && reqStatus() == 'PENDING');
      allow update: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('purohitUid', ''))
          && tkDiff(KEYS_STATUS_ONLY())
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }

    function contactKeyFrozen(f) {
      return !reqKeys().hasAny([f])
        || tkNewGet(f, '') == tkOldGet(f, '');
    }
    function jyotishProfileOwnedByCaller(jid) {
      return exists(/databases/$(database)/documents/jyotishProfiles/$(jid))
        && uidIs(docGet(/databases/$(database)/documents/jyotishProfiles/$(jid), 'uid', ''));
    }

    match /jyotishProfiles/{jyotishId} {
      allow read: if true;

      allow create: if loggedUidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('ratingAggregate', 0) == 0
        && reqRatingCount() == 0
        && tkNewGet('completedConsultations', 0) == 0

        && request.resource.data.get('endorsementCount', 0) == 0
        && !reqKeys().hasAny(['phone', 'email']);
      allow update: if isSuperAdmin()
        || (loggedUidIs(resUid())

          && !diffKeys()
            .hasAny(['uid', 'id', 'verificationTier', 'ratingAggregate', 'ratingCount',

              'endorsementCount', 'lastEndorsementId'])

          && contactKeyFrozen('phone')
          && contactKeyFrozen('email')

          && (tkNewGet('completedConsultations', 0) == tkOldGet('completedConsultations', 0)
            || p1CompletedConsultationOk()))

        || (isLoggedIn()
          && diffKeys()
            .hasOnly(RATING_KEYS())
          && p1JyotishRatingOk(jyotishId))

        || (isLoggedIn()
          && diffKeys()
            .hasOnly(['endorsementCount', 'lastEndorsementId', 'updatedAt'])
          && p1JyotishEndorsementOk(jyotishId))

        || (loggedUidIs(resUid())
          && diffKeys()
            .hasOnly(['verificationTier', 'updatedAt'])
          && jyotishTierClaimOk())

        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;

      match /private/self {
        allow read, write: if isLoggedIn() && jyotishProfileOwnedByCaller(jyotishId);
      }
    }

    match /jyotishAvailability/{jyotishId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn() && jyotishProfileOwnedByCaller(jyotishId));
    }

    match /jyotishApplications/{appId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(resUid()));
      allow create: if applicationCreateOk('jyotishId');
      allow delete: if false;
      allow update: if isSuperAdmin();
    }

    function isConsultationParty() {
      return isLoggedIn()
        && (uidIs(tkOldGet('devoteeUid', ''))
          || uidIs(tkOldGet('assignedJyotishUid', '')));
    }

    function consultationPartyById(cid) {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(cid);
      return isLoggedIn()
        && exists(cpath)
        && (uidIs(docGet(cpath, 'devoteeUid', ''))
          || uidIs(docGet(cpath, 'assignedJyotishUid', '')));
    }
    function consultationTransitionOk() {
      return bookingTransitionOk();
    }
    function consultationImmutableOk() {
      return bookingImmutableOk();
    }

    function callerOwnsJyotishProfile(jid) {
      return jid != '' && jyotishProfileOwnedByCaller(jid);
    }

    function callerHasJyotishProfile() {
      let spath = /databases/$(database)/documents/sanataniProfiles/$(request.auth.uid);
      return exists(spath)
        && docGet(spath, 'roles', {}).get('jyotishId', '') != '';
    }
    match /jyotishConsultations/{consultationId} {

      allow read: if isSuperAdmin() || isConsultationParty();
      allow create: if loggedUidIs(tkNewGet('devoteeUid', ''))
        && reqStatus() == 'OPEN'
        && consultationReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && consultationTransitionOk() && consultationImmutableOk()
          && (isConsultationParty()

            || (resStatus() == 'OPEN'
              && tkOldGet('assignedJyotishUid', '') == ''
              && reqStatus() == 'ASSIGNED'
              && uidIs(tkNewGet('assignedJyotishUid', ''))
              && callerOwnsJyotishProfile(tkNewGet('assignedJyotishId', '')))));
      allow delete: if false;

      match /messages/{messageId} {
        function isMsgParty() {
          return consultationPartyById(consultationId);
        }
        allow read: if isMsgParty() || isSuperAdmin();
        allow create: if isMsgParty()
          && uidIs(tkNewGet('senderUid', ''))
          && reqText() != '';
        allow update, delete: if false;
      }

      match /remedies/{remedyId} {
        function isRemedyParty() {
          return consultationPartyById(consultationId);
        }
        allow read: if isRemedyParty() || isSuperAdmin();
        allow create: if isRemedyParty()
          && uidIs(tkNewGet('jyotishUid', ''))
          && tkNewGet('consultationId', '') == consultationId
          && tkNewGet('devoteeUid', '') == docGet(/databases/$(database)/documents/jyotishConsultations/$(consultationId), 'devoteeUid', '')
          && tkNewGet('ritualName', '') != ''
          && tkNewGet('remedyText', '') != ''
          && reqStatus() == 'PENDING';
        allow update: if isSuperAdmin()
          || (isRemedyParty()
            && resStatus() == 'PENDING'
            && reqStatus() in ['BOOKED', 'DISMISSED']
            && tkDiff(['status', 'bookedGigId']));
        allow delete: if false;
      }
    }

    function TENDER_KEYS() {
      return ['id', 'consultationType', 'topicSummary', 'mode', 'city',
        'language', 'preferredDate', 'budgetMin', 'budgetMax',
        'devoteeUid', 'devoteeName', 'status', 'createdAt'];
    }
    function tenderShapeOk() {
      return reqKeys().hasOnly(TENDER_KEYS())
        && tkNewGet('consultationType', '') != ''
        && tkNewGet('topicSummary', '').size() <= 200
        && reqStatus() == 'OPEN';
    }
    function tenderAcceptedByCaller(consultationId) {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(consultationId);
      return uidIs(docGet(cpath, 'assignedJyotishUid', ''))
        && docGet(cpath, 'status', '') != 'OPEN';
    }
    match /jyotishTenders/{consultationId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resStatus() == 'OPEN' && callerHasJyotishProfile());
      allow create: if loggedUidIs(tkNewGet('devoteeUid', ''))
        && tenderShapeOk();
      allow update: if false;
      allow delete: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('devoteeUid', '')))
        || (isLoggedIn() && tenderAcceptedByCaller(consultationId));
    }

    match /jyotishEndorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(R_TRUSTEE_PAIR()))
        && reqOrgId() != ''
        && tkNewGet('orgName', '') != ''
        && tkNewGet('jyotishId', '') != ''
        && reqText() != '';
      allow update, delete: if isSuperAdmin();
    }

    function consultationReviewPartyOk() {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(tkNewGet('consultationId', ''));
      return exists(cpath)
        && docGet(cpath, 'status', '') in ORDER_DONE()
        && (uidIs(docGet(cpath, 'devoteeUid', ''))
          || uidIs(docGet(cpath, 'assignedJyotishUid', '')));
    }
    match /jyotishReviews/{reviewId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('reviewerUid', ''))
        && tkNewGet('consultationId', '') != ''
        && reqRating() >= 1
        && reqRating() <= 5

        && reviewId == tkNewGet('consultationId', '')
          + '_' + request.auth.uid
          + '_' + tkNewGet('reviewerKind', '')
        && consultationReviewPartyOk();
      allow update, delete: if false;
    }

    match /jyotishInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('jyotishUid', ''))
            || roleIn(R_TRUSTEE_PAIR())));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(R_TRUSTEE_PAIR())
          && reqOrgId() != ''
          && tkNewGet('orgName', '') != ''
          && tkNewGet('jyotishId', '') != ''
          && tkNewGet('jyotishUid', '') != ''
          && reqStatus() == 'PENDING');
      allow update: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('jyotishUid', ''))
          && tkDiff(KEYS_STATUS_ONLY())
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }

    function remedyAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', '')))
        && uidIs(docGet(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', '')), 'devoteeUid', ''))
        && docGet(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', '')), 'jyotishUid', '') == reqReferredBy().get('referrerUid', '')
        && docGet(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', '')), 'status', '') == 'PENDING';
    }
    function gigReferralAnchorOk() {
      return !('referredBy' in reqData())
        || (reqReferredBy().get('direction', '') == 'jyotish-to-purohit'
          && reqReferredBy().get('referrerUid', '') != ''
          && reqReferredBy().get('remedyId', '') != ''
          && reqReferredBy().get('consultationId', '') != ''
          && reqReferredBy().get('ritualName', '') != ''
          && remedyAnchorOk());
    }

    function referralAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')))
        && docGet(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')), 'fromKind', '') == 'purohit'
        && docGet(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')), 'toKind', '') == 'jyotish'
        && docGet(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')), 'fromUid', '') == reqReferredBy().get('referrerUid', '')
        && uidIs(docGet(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')), 'devoteeUid', ''));
    }
    function consultationReferralAnchorOk() {
      return !('referredBy' in reqData())
        || (reqReferredBy().get('direction', '') == 'purohit-to-jyotish'
          && reqReferredBy().get('referrerUid', '') != ''
          && reqReferredBy().get('referralId', '') != ''
          && referralAnchorOk());
    }

    function attributionGigOk() {
      return reqOrderType() == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(reqOrderId()))
        && uidIs(reqGigDoc().data.get('devoteeUid', ''))
        && reqGigDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqGigDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function attributionConsultationOk() {
      return reqOrderType() == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(reqOrderId()))
        && uidIs(reqConsultDoc().data.get('devoteeUid', ''))
        && reqConsultDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqConsultDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function attributionOrderOk() {
      return attributionGigOk() || attributionConsultationOk();
    }
    function attributionTerminalOk() {
      return (reqOrderType() == 'gig'
          && reqGigDoc().data.get('status', '') == 'DAKSHINA_RELEASED')
        || (reqOrderType() == 'consultation'
          && reqConsultDoc().data.get('status', '') == 'DAKSHINA_RELEASED');
    }

    function attributionPartyOk() {
      return (reqOrderType() == 'gig'
          && (uidIs(reqGigDoc().data.get('devoteeUid', ''))
            || uidIs(reqGigDoc().data.get('assignedPurohitUid', ''))))
        || (reqOrderType() == 'consultation'
          && (uidIs(reqConsultDoc().data.get('devoteeUid', ''))
            || uidIs(reqConsultDoc().data.get('assignedJyotishUid', ''))));
    }

    function creditGigOk() {
      return reqOrderType() == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(reqOrderId()))
        && reqGigDoc().data.get('status', '') == 'DAKSHINA_RELEASED'
        && (uidIs(reqGigDoc().data.get('devoteeUid', ''))
          || uidIs(reqGigDoc().data.get('assignedPurohitUid', '')))
        && reqGigDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqGigDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function creditConsultationOk() {
      return reqOrderType() == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(reqOrderId()))
        && reqConsultDoc().data.get('status', '') == 'DAKSHINA_RELEASED'
        && (uidIs(reqConsultDoc().data.get('devoteeUid', ''))
          || uidIs(reqConsultDoc().data.get('assignedJyotishUid', '')))
        && reqConsultDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqConsultDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function creditOrderOk() {
      return creditGigOk() || creditConsultationOk();
    }
    function gigSevaValue() {
      return reqGigDoc().data.get('dakshinaAgreed', 0) > 0
        ? reqGigDoc().data.get('dakshinaAgreed', 0)
        : reqGigDoc().data.get('budgetMax', 0);
    }
    function consultationSevaValue() {
      return reqConsultDoc().data.get('dakshinaAgreed', 0) > 0
        ? reqConsultDoc().data.get('dakshinaAgreed', 0)
        : reqConsultDoc().data.get('budgetMax', 0);
    }
    function creditSevaValueOk() {
      return (reqOrderType() == 'gig'
          && tkNewGet('sevaValue', -1) == gigSevaValue())
        || (reqOrderType() == 'consultation'
          && tkNewGet('sevaValue', -1) == consultationSevaValue());
    }
    function creditRoundingOk() {
      return tkNewGet('creditAmount', 0) * 10000 >= tkNewGet('sevaValue', 0) * tkNewGet('referralBps', 0) - 5000
        && tkNewGet('creditAmount', 0) * 10000 <= tkNewGet('sevaValue', 0) * tkNewGet('referralBps', 0) + 5000;
    }
    function creditMathOk() {
      return tkNewGet('referralBps', 0) > 0
        && tkNewGet('referralBps', 0) <= 5000
        && tkNewGet('creditAmount', 0) > 0
        && tkNewGet('creditAmount', 0) <= tkNewGet('platformCommission', 0)
        && tkNewGet('platformCommission', 0) <= tkNewGet('sevaValue', 0)
        && creditSevaValueOk()
        && creditRoundingOk();
    }
    function creditOrderParty() {
      return (tkOldGet('orderType', '') == 'gig'
          && (uidIs(docGet(/databases/$(database)/documents/gigs/$(tkOldGet('orderId', '')), 'devoteeUid', ''))
            || uidIs(docGet(/databases/$(database)/documents/gigs/$(tkOldGet('orderId', '')), 'assignedPurohitUid', ''))))
        || (tkOldGet('orderType', '') == 'consultation'
          && (uidIs(docGet(/databases/$(database)/documents/jyotishConsultations/$(tkOldGet('orderId', '')), 'devoteeUid', ''))
            || uidIs(docGet(/databases/$(database)/documents/jyotishConsultations/$(tkOldGet('orderId', '')), 'assignedJyotishUid', ''))));
    }

    function referralCreditDocOk(uid) {
      return reqLastReferralCreditId() != ''
        && reqLastReferralCreditId() != tkOldGet('lastReferralCreditId', '')
        && exists(/databases/$(database)/documents/referralCredits/$(reqLastReferralCreditId()))
        && reqCreditDoc().data.get('referrerUid', '') == uid
        && reqCreditDoc().data.get('status', '') == 'SETTLED'
        && tkNewGet('balance', -1) == tkOldGet('balance', 0) + reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalReceived', -1) == tkOldGet('totalReceived', 0) + reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalToppedUp', -1) == tkOldGet('totalToppedUp', 0)
        && tkNewGet('totalSpent', -1) == tkOldGet('totalSpent', 0)
        && tkDiff(['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastReferralCreditId', 'currency', 'uid']);
    }
    function referralWalletCreditOk(uid) {
      return referralCreditDocOk(uid);
    }
    function referralWalletCreditCreateOk(uid) {
      return reqLastReferralCreditId() != ''
        && reqUid() == uid
        && exists(/databases/$(database)/documents/referralCredits/$(reqLastReferralCreditId()))
        && reqCreditDoc().data.get('referrerUid', '') == uid
        && reqCreditDoc().data.get('status', '') == 'SETTLED'
        && tkNewGet('balance', -1) == reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalReceived', -1) == reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalToppedUp', -1) == 0
        && tkNewGet('totalSpent', -1) == 0;
    }

    match /jyotishReferrals/{referralId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('fromUid', ''))
        && tkNewGet('toRoleId', '') != ''
        && tkNewGet('toTier', '') != ''
        && tkNewGet('toTier', '') != 'REGISTERED'
        && tkNewGet('reason', '') != '';
      allow update, delete: if isSuperAdmin();
    }

    match /referralAttributions/{orderId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('devoteeUid', ''))
            || uidIs(tkOldGet('referrerUid', ''))));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('devoteeUid', ''))
        && reqOrderType() in ['gig', 'consultation']
        && reqStatus() == 'OPEN'
        && tkNewGet('referrerUid', '') != ''
        && attributionOrderOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resStatus() == 'OPEN'
          && reqStatus() in ['SETTLED', 'SKIPPED_NO_VALUE']
          && tkDiff(['status', 'settledAt', 'creditId'])
          && attributionTerminalOk()
          && attributionPartyOk());
      allow delete: if false;
    }

    match /referralClaims/{orderId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('sharerUid', '')));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('bookerUid', ''))
        && tkNewGet('sharerUid', '') != ''
        && tkNewGet('sharerUid', '') != request.auth.uid
        && tkNewGet('sharerSanId', '') != ''
        && tkNewGet('providerName', '') != ''
        && tkNewGet('createdAt', 0) is number
        && reqKeys().hasOnly(
          ['orderId', 'sharerUid', 'sharerSanId', 'bookerUid', 'providerName', 'createdAt'])
        && exists(/databases/$(database)/documents/marketplaceOrders/$(orderId))
        && uidIs(docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'clientUid', ''))
        && docGet(/databases/$(database)/documents/marketplaceOrders/$(orderId), 'referredBy', '') == tkNewGet('sharerSanId', '');
      allow update, delete: if false;
    }

    match /referralCredits/{creditId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('referrerUid', '')))
        || (isLoggedIn() && creditOrderParty());
      allow create: if isLoggedIn()
        && creditId == 'rc_' + reqOrderId()
        && reqOrderId() != ''
        && reqStatus() == 'SETTLED'
        && tkNewGet('direction', '') in ['jyotish-to-purohit', 'purohit-to-jyotish']
        && creditOrderOk()
        && creditMathOk();
      allow update: if isSuperAdmin()
        && resStatus() == 'SETTLED'
        && reqStatus() == 'REVERSED'
        && tkDiff(['status', 'reversedAt', 'reversalReason']);
      allow delete: if false;
    }

    function sangamAuthorTierOk() {
      let kind = tkNewGet('authorKind', '');
      let tier = tkNewGet('authorTier', '');
      let roleId = tkNewGet('authorRoleId', '');
      return (kind == 'devotee' && (tier == '' || tier == null))
        || (kind == 'org' && (tier == '' || tier == null))
        || (kind == 'purohit' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/purohits/$(roleId))
          && uidIs(docGet(/databases/$(database)/documents/purohits/$(roleId), 'uid', ''))
          && tier == docGet(/databases/$(database)/documents/purohits/$(roleId), 'verificationTier', ''))
        || (kind == 'jyotish' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/jyotishProfiles/$(roleId))
          && uidIs(docGet(/databases/$(database)/documents/jyotishProfiles/$(roleId), 'uid', ''))
          && tier == docGet(/databases/$(database)/documents/jyotishProfiles/$(roleId), 'verificationTier', ''));
    }

    function serviceCardOk() {
      let kind = tkNewGet('kind', '');
      let authorKind = tkNewGet('authorKind', '');
      let card = tkNewGet('serviceCard', {});

      return kind != 'service_card'
        || ((authorKind == 'purohit' || authorKind == 'jyotish')
          && card != null
          && card.get('devotionalText', '').size() >= 30
          && card.get('serviceLine', '') != ''
          && card.get('dakshina', 0) > 0
          && uidIs(card.get('providerUid', ''))
          && card.get('providerTier', '') in ['REGISTERED', 'VERIFIED', 'TRUSTED']);
    }

    function sangamPagePostOk() {
      let official = tkNewGet('isOfficialPagePost', false);
      let orgId = reqOrgId();
      return official == false || official == null
        || (orgId != '' && orgId != null && isOrgTrustee(orgId));
    }

    match /sangamPosts/{postId} {
      allow read: if true;
      allow create: if loggedUidIs(reqAuthorUid())
        && reqKeys().hasOnly(
          ['authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorRoleId', 'authorTier',
           'orgId', 'orgName', 'isOfficialPagePost', 'kind', 'text', 'imageUrl', 'shlokaRef',
           'seva', 'serviceCard', 'eventRef', 'sharedFrom', 'createdAt', 'ashirvadCount', 'commentCount',
           'shareCount', 'visibility', 'status',

           'providerUid', 'providerName', 'festival', 'anonymized'])
        && tkNewGet('ashirvadCount', -1) == 0
        && tkNewGet('commentCount', -1) == 0
        && tkNewGet('shareCount', -1) == 0
        && reqStatus() == 'active'
        && tkNewGet('visibility', '') == 'public'
        && reqText() != ''
        && sangamAuthorTierOk()
        && sangamPagePostOk()
        && serviceCardOk();
      allow update: if isSuperAdmin()
        || (loggedUidIs(resAuthorUid())
          && tkDiff(['text', 'imageUrl', 'updatedAt'])
          && reqAuthorUid() == resAuthorUid())

        || (isLoggedIn()
          && bumpToggleOk('commentCount'))

        || (isLoggedIn()
          && bumpToggleOk('ashirvadCount'))
        || (isLoggedIn()
          && bumpToggleOk('shareCount'));
      allow delete: if isSuperAdmin()
        || (loggedUidIs(resAuthorUid()));
    }

    match /sangamPosts/{postId}/ashirvad/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    match /sangamPosts/{postId}/volunteers/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    match /sangamComments/{commentId} {
      allow read: if true;
      allow create: if loggedUidIs(reqAuthorUid())
        && tkNewGet('postId', '') != ''
        && reqKeys().hasOnly(
          ['postId', 'authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorTier', 'text', 'createdAt'])
        && reqText() != ''
        && sangamAuthorTierOk();
      allow update, delete: if isSuperAdmin()
        || (loggedUidIs(resAuthorUid()));
    }

    match /sangamCircles/{circleId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('creatorUid', ''))
        && reqName() != ''
        && reqKeys().hasOnly(
          ['name', 'topic', 'description', 'creatorUid', 'creatorName', 'memberCount', 'createdAt']);
      allow update: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('creatorUid', ''))
          && tkDiff(['name', 'topic', 'description', 'updatedAt']))

        || (isLoggedIn()
          && bumpToggleOk('memberCount'));
      allow delete: if isSuperAdmin();
    }

    match /sangamCircles/{circleId}/members/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    match /sangamEvents/{eventId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('creatorUid', ''))
        && reqTitle() != ''
        && (reqOrgId() == ''
          || tkNewGet('orgId', null) == null
          || isOrgTrustee(reqOrgId()))

        && (tkNewGet('isOfficial', false) != true
          || (reqOrgId() != ''
              && isOrgTrustee(reqOrgId())))
        && reqKeys().hasOnly(
          ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'orgId', 'orgName',
           'isOfficial', 'creatorUid', 'creatorName', 'rsvpCount', 'createdAt',

           'capacity', 'recurrence']);
      allow update: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('creatorUid', ''))
          && diffKeysOnly(reqData(), resource.data,
            ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'updatedAt',

             'capacity', 'recurrence']))

        || (isLoggedIn()
          && tkDiff(['rsvpCount'])
          && tkNewGet('rsvpCount', -1) >= 0
          && ((reqRsvpCount() == tkOldGet('rsvpCount', 0) + 1
                && !exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && afterDocGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', 'going') == 'going'
                && rsvpWithinCap())
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) - 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && docGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', 'going') == 'going')
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) + 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && docGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', 'going') in ['interested', 'waitlisted']
                && afterDocGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', '') == 'going'
                && rsvpWithinCap())
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) - 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && docGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', 'going') == 'going'
                && afterDocGet(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid), 'state', '') in ['interested', 'waitlisted'])));

      allow delete: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('creatorUid', '')));
    }

    match /sangamEvents/{eventId}/rsvps/{uid} {
      allow read: if true;

      allow create: if isSelf(uid)
        && tkNewGet('state', 'going') in ['going', 'interested', 'waitlisted'];
      allow update: if isSelf(uid)
        && tkDiff(['state', 'at'])
        && tkNewGet('state', '') in ['going', 'interested', 'waitlisted'];
      allow delete: if isSelf(uid);
    }

    match /sangamFollows/{followId} {
      allow read: if true;
      allow create: if loggedUidIs(tkNewGet('followerUid', ''))
        && reqKeys().hasOnly(
          ['followerUid', 'targetType', 'targetId', 'targetName', 'createdAt']);
      allow update: if false;
      allow delete: if loggedUidIs(tkOldGet('followerUid', ''));
    }

    match /sangamReports/{reportId} {
      allow read: if isSuperAdmin() || isOwner()
        || (loggedUidIs(tkOldGet('reporterUid', '')));
      allow create: if loggedUidIs(tkNewGet('reporterUid', ''))
        && tkNewGet('targetId', '') != ''
        && reqKeys().hasOnly(
          ['reporterUid', 'reporterName', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt'])
        && reqStatus() == 'open';
      allow update, delete: if isSuperAdmin() || isOwner();
    }

    match /orgGlance/{workspaceId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId)
          && reqWorkspaceId() == workspaceId);
      allow delete: if false;
    }

    match /orgPages/{orgId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (
        isOrgTrustee(orgId)
        && reqKeys().hasOnly(
          ['orgId', 'name', 'type', 'city', 'state', 'country', 'about',
           'tagline', 'logoUrl', 'coverUrl', 'publicSlug', 'addressLine',
           'pincode', 'phone', 'website', 'darshanTimings', 'galleryUrls',
           'upcomingEvents', 'autoShareEvents', 'registrationNo', 'eightyGRegistered',
           'eightyGURN', 'twelveARegistered', 'verified', 'pinnedAarti',
           'aartiSchedules', 'updatedAt'])
        && reqOrgId() == orgId

        && (resource == null
          ? tkNewGet('verified', false) == false
          : tkNewGet('verified', false) == tkOldGet('verified', false))
      );
      allow delete: if isSuperAdmin();
    }

    match /orgPages/{orgId}/sevaCards/{cardId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        || (isOrgTrustee(orgId)
          && reqKeys().hasOnly([
            'title', 'amount', 'currency', 'outcomeCopy', 'goalTarget',
            'raisedTotal', 'active', 'sortOrder',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && reqTitle() != ''
          && reqAmount() is number
          && reqAmount() > 0);
      allow delete: if isSuperAdmin() || isOrgTrustee(orgId);
    }

    match /orgBroadcasts/{broadcastId} {
      allow read: if true;
      allow create: if isOrgTrustee(reqOrgId())
        && reqKeys().hasOnly(
          ['orgId', 'orgName', 'title', 'body', 'createdBy', 'createdByName',
           'audienceCount', 'createdAt', 'audience', 'audienceRole'])
        && uidIs(tkNewGet('createdBy', ''))
        && reqTitle() != ''
        && tkNewGet('audienceCount', 0) is number
        && tkNewGet('createdAt', 0) is number
        && tkNewGet('audience', 'followers') in ['followers', 'members', 'staff']
        && (tkNewGet('audienceRole', '') == ''
          || tkNewGet('audience', '') == 'staff');
      allow update: if false;
      allow delete: if isSuperAdmin()
        || isOrgTrustee(tkOldGet('orgId', ''));
    }

    match /platformNotices/{noticeId} {
      allow read: if isLoggedIn();
      allow create: if isSuperAdmin()
        && reqKeys().hasOnly(
          ['title', 'body', 'kind', 'createdAt', 'expiresAt', 'active'])
        && reqTitle() != ''
        && tkNewGet('kind', '') in ['info', 'important']
        && tkNewGet('createdAt', 0) is number
        && tkNewGet('expiresAt', 0) is number;
      allow update: if isSuperAdmin()
        && diffKeysOnly(reqData(), resource.data, ['active']);
      allow delete: if isSuperAdmin();
    }

    function familyLinkMapOnlySelfChanged(beforeMap, afterMap) {
      return diffKeysOnly(afterMap, beforeMap, [request.auth.uid]);
    }

    function familyLinkInviteContentOk(invite) {
      return invite != null
        && uidIs(invite.get('fromUid', ''))
        && invite.get('status', '') == 'pending'
        && invite.keys().hasOnly(
          ['fromUid', 'fromName', 'fromPhoto', 'fromSanId', 'status', 'createdAt']);
    }

    function familyLinkCrossUpdateOk() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = reqData();
      let topChanged = after.diff(before).affectedKeys();
      let scoped = topChanged.hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites'])
        && familyLinkMapOnlySelfChanged(
          before.get('consents', {}), after.get('consents', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('incomingInvites', {}), after.get('incomingInvites', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('outgoingInvites', {}), after.get('outgoingInvites', {}))
        && after.get('linkedUids', []).toSet()
          .difference(before.get('linkedUids', []).toSet()).hasOnly([me])
        && before.get('linkedUids', []).toSet()
          .difference(after.get('linkedUids', []).toSet()).hasOnly([me]);

      let onlyInvite = topChanged.hasOnly(['incomingInvites'])
        && familyLinkInviteContentOk(after.get('incomingInvites', {}).get(me, null));

      let accept = before.get('outgoingInvites', {}).get(me, {}).get('status', '') == 'pending'
        && (me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, {}).get('granted', false) == true;

      let withdraw = (before.get('outgoingInvites', {}).get(me, null) != null
          || (me in before.get('linkedUids', [])))
        && !(me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, null) == null;
      return scoped && (onlyInvite || accept || withdraw);
    }
    match /familyLinks/{docUid} {
      allow read: if isLoggedIn()
        && (request.auth.uid == docUid
          || (resource != null && request.auth.uid in tkOldGet('linkedUids', [])));
      allow create, update: if isSelf(docUid)
        && reqKeys().hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites']);
      allow delete: if isSelf(docUid);

      allow create: if isLoggedIn() && request.auth.uid != docUid
        && reqKeys().hasOnly(['incomingInvites'])
        && tkNewGet('incomingInvites', {}).keys().hasOnly([request.auth.uid])
        && familyLinkInviteContentOk(
          tkNewGet('incomingInvites', {}).get(request.auth.uid, null));

      allow update: if isLoggedIn() && request.auth.uid != docUid
        && familyLinkCrossUpdateOk();
    }

    match /qrCodes/{region} {
      allow read: if true;
      allow create, update: if isOwner()
        && tkNewGet('region', '') == region
        && reqKeys().hasOnly(
          ['imageData', 'region', 'uploadedAt', 'uploadedBy'])
        && tkNewGet('imageData', '').matches('^data:image/(png|jpeg|webp);base64,');
      allow delete: if isOwner();
    }

    match /vdaAliases/{aliasId} {
      allow read: if isLoggedIn();
      allow create: if loggedUidIs(reqUid())
        && tkNewGet('alias', '') == aliasId
        && reqKeys().hasOnly(['alias', 'uid', 'sanId', 'createdAt']);

      allow update: if false;
      allow delete: if loggedUidIs(resUid());
    }

    match /followers/{orgId}/users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
        && reqUid() == uid;
      allow update: if false;
      allow delete: if isSelf(uid);
    }

    match /joinRequests/{requestId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(tkOldGet('userUid', '')))
        || (isLoggedIn() && isOrgTrustee(tkOldGet('orgId', '')));
      allow create: if loggedUidIs(tkNewGet('userUid', ''))
        && reqOrgId() != ''
        && reqStatus() == 'PENDING';
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('orgId', ''))
          && diffKeys()
            .hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt'])
          && reqStatus() in ['APPROVED', 'REJECTED'])
        || (loggedUidIs(tkOldGet('userUid', ''))
          && resStatus() == 'REJECTED'
          && reqStatus() == 'PENDING'
          && diffKeys()
            .hasOnly(['status', 'message', 'createdAt']));
      allow delete: if false;
    }

    function inviteMatchesMe() {
      return isLoggedIn() && (
        uidIs(tkOldGet('invitedUid', '')) ||
        (request.auth.token.email != null
          && tkOldGet('invitedEmail', '') == request.auth.token.email) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && docGet(/databases/$(database)/documents/users/$(request.auth.uid), 'phone', '') != ''
          && docGet(/databases/$(database)/documents/users/$(request.auth.uid), 'phone', '')
            == tkOldGet('invitedPhone', ''))
      );
    }
    match /orgInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && (inviteMatchesMe()
          || isOrgTrustee(tkOldGet('orgId', ''))));
      allow create: if isLoggedIn()
        && reqOrgId() != ''
        && reqStatus() == 'PENDING'
        && tkNewGet('expiresAt', 0) > request.time.toMillis()
        && reqRole() != ''
        && grantableRole(reqOrgId(), reqRole());
      allow update: if isSuperAdmin()
        || (isLoggedIn() && inviteMatchesMe()
          && resStatus() == 'PENDING'
          && tkOldGet('expiresAt', 0) > request.time.toMillis()
          && tkDiff(['status', 'decidedAt'])
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }

    function inviteAcceptOk(inviteId, workspaceId, role) {
      let ipath = /databases/$(database)/documents/orgInvites/$(inviteId);
      return inviteId != '' && exists(ipath)
        && docGet(ipath, 'status', '') == 'ACCEPTED'
        && docGet(ipath, 'expiresAt', 0) > request.time.toMillis()
        && docGet(ipath, 'orgId', '') == workspaceId
        && docGet(ipath, 'role', '') == role
        && (uidIs(docGet(ipath, 'invitedUid', ''))
          || (request.auth.token.email != null
            && docGet(ipath, 'invitedEmail', '') == request.auth.token.email));
    }
    match /workspaceMembers/{memberId} {
      allow read: if isSuperAdmin()
        || (loggedUidIs(resUid()))
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', '')));
      allow create: if isLoggedIn()
        && reqWorkspaceId() != ''
        && reqUid() != ''
        && reqRole() != ''
        && (

          (isOrgTrustee(reqWorkspaceId())
            && grantableRole(reqWorkspaceId(),
              reqRole()))

          || (uidIs(reqUid())
            && inviteAcceptOk(
              tkNewGet('viaInviteId', ''),
              reqWorkspaceId(),
              reqRole()))

          || (uidIs(reqUid())
            && reqRole() == 'Trustee'
            && uidIs(docData(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).createdBy))
        );
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', ''))
          && grantableRole(tkOldGet('workspaceId', ''),
            reqRole()));
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', '')));
    }

    match /notifications/{uid} {
      allow read, write: if false;

      match /items/{itemId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqKeys().hasAll([
            'id', 'uid', 'kind', 'priority', 'title', 'body', 'dedupeKey', 'createdAt'
          ]);
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid;
        allow delete: if false;
      }

      match /pushRequests/{reqId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.toUser == uid
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }

      match /prefs {
        allow read, write: if isSelf(uid);
      }
    }

    match /appGrowthScans/{scanId} {
      allow create: if reqKeys().hasOnly(['campaignId', 'platform', 'ts'])
        && (tkNewGet('campaignId', null) == null
          || (tkNewGet('campaignId', '') is string
            && tkNewGet('campaignId', '').size() <= 64))
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthInstalls/{installId} {
      allow create: if reqKeys().hasOnly(['campaignId', 'platform', 'ts'])
        && (tkNewGet('campaignId', null) == null
          || (tkNewGet('campaignId', '') is string
            && tkNewGet('campaignId', '').size() <= 64))
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthWaitlist/{entryId} {
      allow create: if reqKeys().hasOnly(['platform', 'ts'])
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthCampaigns/{campaignId} {
      allow get: if true;
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }
    match /appGrowth/{docId} {
      allow get: if docId == 'config';
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    match /p2pRequests/{reqId} {
      allow read: if isLoggedIn()
        && (uidIs(tkOldGet('senderId', ''))
          || uidIs(tkOldGet('receiverId', '')));
      allow create: if loggedUidIs(tkNewGet('senderId', ''))
        && reqStatus() == 'pending';
      allow update: if isLoggedIn()
        && (uidIs(tkOldGet('senderId', ''))
          || uidIs(tkOldGet('receiverId', '')))
        && diffKeys()
          .hasOnly(['status', 'updatedAt', 'paidRef', 'paidVia', 'paidAt', 'settledAt', 'supersededBy'])
        && (
          (uidIs(tkOldGet('receiverId', ''))
            && resStatus() == 'pending'
            && reqStatus() in ['accepted', 'declined', 'countered'])
          || (uidIs(tkOldGet('senderId', ''))
            && resStatus() == 'accepted'
            && reqStatus() == 'paid')
          || (uidIs(tkOldGet('receiverId', ''))
            && resStatus() == 'paid'
            && reqStatus() == 'settled')
          || (uidIs(tkOldGet('senderId', ''))
            && resStatus() == 'pending'
            && reqStatus() == 'cancelled'));
      allow delete: if false;
    }

    match /campusMaps/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && (
        hasRole(orgId, R_TRUSTEE())
        || isOwner()
      );
      allow delete: if false;
    }

    match /zoneReports/{reportId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && reqOrgId() != ''
        && uidIs(tkNewGet('reportedBy', ''))
        && reqKeys().hasOnly(['id', 'orgId', 'zoneId',
          'zoneName', 'type', 'note', 'reportedBy', 'reporterName',
          'createdAt', 'expiresAt', 'serverAt'])
        && (hasRole(reqOrgId(),
              ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Sevadar',
               'SEVADAR', 'Coordinator', 'COORDINATOR'])
            || isOwner());
      allow update, delete: if false;
    }

match /fileVault/{fileId} {
      allow read: if isLoggedIn()
        && (tkOldGet('visibility', 'private') == 'public'
          || uidIs(tkOldGet('ownerUid', ''))
          || (tkOldGet('visibility', '') == 'crisis'
            && isTenantMember(tkOldGet('tenantId', null))));
      allow create: if loggedUidIs(tkNewGet('ownerUid', ''))
        && reqKeys().hasOnly(['data', 'contentType', 'fileName',
          'size', 'hash', 'category', 'visibility', 'ownerUid', 'createdAt',
          'localOnly', 'chunkCount', 'tenantId'])
        && (

          (tkNewGet('chunkCount', 0) == 0
            && tkNewGet('localOnly', false) != true
            && tkNewGet('size', 99999999) <= 1048576)

          || (tkNewGet('chunkCount', 0) > 0
            && tkNewGet('chunkCount', 9999) <= 28
            && !reqKeys().hasAny(['data'])
            && tkNewGet('size', 99999999) <= 10485760)

          || tkNewGet('localOnly', false) == true);
      allow update: if false;
      allow delete: if loggedUidIs(tkOldGet('ownerUid', ''));

      match /chunks/{n} {
        allow read: if isLoggedIn()
          && (tkOldGet('visibility', 'private') == 'public'
            || uidIs(tkOldGet('ownerUid', ''))
            || (tkOldGet('visibility', '') == 'crisis'
              && isTenantMember(tkOldGet('tenantId', null))));
        allow create: if loggedUidIs(tkNewGet('ownerUid', ''))
          && tkNewGet('visibility', '') in ['public', 'crisis']
          && tkNewGet('data', '').size() <= 512000
          && tkNewGet('i', -1) >= 0
          && reqKeys().hasOnly(
            ['i', 'data', 'ownerUid', 'visibility', 'tenantId']);
        allow update: if false;
        allow delete: if loggedUidIs(tkOldGet('ownerUid', ''));
      }
    }

    match /translationSuggestions/{suggestionId} {
      allow create: if loggedUidIs(reqUid())
        && reqStatus() == 'pending'
        && reqKeys().hasOnly(['lang', 'key', 'currentText',
          'suggestedText', 'uid', 'sanataniId', 'status', 'createdAt',
          'region', 'termKey'])
        && tkNewGet('lang', '') in
          ['en', 'hi', 'bn', 'sa', 'ta', 'te', 'mr', 'gu', 'kn', 'ml']
        && tkNewGet('key', '').size() > 0
        && tkNewGet('key', '').size() <= 200
        && tkNewGet('suggestedText', '').size() > 0
        && tkNewGet('suggestedText', '').size() <= 2000
        && tkNewGet('currentText', '').size() <= 2000
        && isRegionId(tkNewGet('region', ''))
        && (tkNewGet('termKey', '') == ''
          || (tkNewGet('termKey', '').size() <= 40
            && tkNewGet('termKey', '').matches('^[a-zA-Z]+$')));

      allow read: if isLoggedIn()
        && (uidIs(resUid()) || isOwner());

      allow update: if isOwner()
        && reqStatus() in ['approved', 'rejected'];
      allow delete: if isOwner();
    }

    match /tirthaVisits/{uid} {
      allow read, write: if false;

      match /visits/{visitId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && tkNewGet('templeName', '').size() > 0
          && tkNewGet('templeName', '').size() <= 120
          && reqKeys().hasOnly(TIRTHA_VISIT_KEYS());
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid
          && tkNewGet('templeName', '').size() > 0
          && tkNewGet('templeName', '').size() <= 120
          && reqKeys().hasOnly(TIRTHA_VISIT_KEYS());
        allow delete: if isSelf(uid);
      }
    }

    match /tirthaYatras/{uid} {
      allow read, write: if false;

      match /yatras/{yatraId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqName().size() > 0
          && reqName().size() <= 80
          && reqKeys().hasOnly(TIRTHA_YATRA_KEYS());
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqName().size() > 0
          && reqName().size() <= 80
          && reqKeys().hasOnly(TIRTHA_YATRA_KEYS());
        allow delete: if isSelf(uid);
      }
    }

    match /translationOverrides/{lang} {

      allow read: if true;

      allow create, update: if isOwner()
        && request.resource.data.size() <= 2000;
      allow delete: if false;
    }

    match /qrScanEvents/{eventId} {

      allow create: if isLoggedIn()
        && reqKeys().hasOnly([
          'qrId', 'qrType', 'scannerHash', 'outcome', 'scannedAt', 'amount', 'currency'
        ])
        && tkNewGet('qrType', '') == 'p2p'
        && tkNewGet('outcome', '') in [
          'parsed', 'invalid', 'expired', 'payment_completed', 'payment_failed'
        ]
        && tkNewGet('scannerHash', '').matches('^[0-9a-f]{64}$');

      allow read: if isOwner();
      allow update, delete: if false;
    }

    match /qrScanStats/{qrId} {

      allow create: if isLoggedIn()
        && tkNewGet('qrId', '') == qrId
        && reqKeys().hasOnly([
          'qrId', 'qrType', 'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'firstSeenAt', 'receiverId'
        ]);

      allow update: if isLoggedIn()
        && tkDiff([
          'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'receiverId'
        ])
        && tkNewGet('totalScans', 0) >= tkOldGet('totalScans', 0)
        && tkNewGet('qrId', '') == tkOldGet('qrId', '')
        && tkNewGet('qrType', '') == tkOldGet('qrType', '');

      allow read: if isOwner();
      allow delete: if false;
    }

  }
}