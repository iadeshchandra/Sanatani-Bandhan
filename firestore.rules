rules_version = '2';

/**
 * Sanatani Bandhan â Hardened Firestore Security Rules.
 * DENY-BY-DEFAULT, tenant isolation. Identity: Firebase Auth (custom claims
 * tenantId/role/roles[], falling back to users/{uid}). DEMO_* = public-read
 * sandboxes. Financial ledgers append-only; sensitive writes field-allowlisted.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Identity & role helpers
    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    // True for anonymous (demo) sessions â used to gate real-workspace creation.
    function isAnonymous() {
      return isLoggedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Platform SuperAdmin: explicit claim, canonical role claim, or the
    function isSuperAdmin() {
      return isLoggedIn() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role in ['SuperAdmin', 'SUPER_ADMIN'] ||
        (request.auth.token.roles is list &&
          request.auth.token.roles.hasAny(['SuperAdmin', 'SUPER_ADMIN'])) ||
        (exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.get('active', true) != false)
      );
    }

    // Platform owner: the canonical human owner UID. Used for Spark-native
    function isOwner() {
      return isLoggedIn() && request.auth.uid == 'sxIGHmvpYUTqPnpI1bLFT1O1cA62';
    }

    // Effective tenant: custom claim wins, else the users/{uid} document.
    function effTenant() {
      return request.auth == null ? null :
        (request.auth.token.tenantId != null ? request.auth.token.tenantId :
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('workspaceId', null) : null));
    }

    // Role check: single `role` claim, `roles[]` claim, or users-doc fallback.
    function roleIn(roles) {
      return request.auth != null && (
        request.auth.token.role in roles ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(roles)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) in roles)
      );
    }

    function isDemoWs(id) {
      return id != null && id.matches('^DEMO_.*');
    }

    // Regional vocabulary ids (src/i18n/regionalTerms.ts). Devotee
    // suggestions may omit the field entirely ('' = not regional).
    function isRegionId(v) {
      return v == '' || v in ['tamil-nadu', 'karnataka', 'andhra-telangana',
        'kerala', 'maharashtra', 'gujarat', 'west-bengal', 'bangladesh',
        'hindi-belt', 'punjab', 'odisha', 'assam', 'northeast',
        'global-diaspora', 'other'];
    }

    // Task contract: tenant member = logged in AND (own tenant claim |
    function wsMemberPath(tenantId) {
      return /databases/$(database)/documents/workspaceMembers/$(tenantId + '_' + request.auth.uid);
    }
    function isWsMember(tenantId) {
      return isLoggedIn() && tenantId != null && exists(wsMemberPath(tenantId));
    }
    function wsMemberRoleIn(tenantId, roles) {
      return isWsMember(tenantId)
        && get(wsMemberPath(tenantId)).data.get('role', null) in roles;
    }
    function isTenantMember(tenantId) {
      return isLoggedIn() && tenantId != null && (
        isSuperAdmin() ||
        tenantId == effTenant() ||
        effTenant() == '*' ||
        isWsMember(tenantId)
      );
    }

    // Task contract: role check scoped to the tenant. SuperAdmin bypasses
    function hasRole(tenantId, roles) {
      return isSuperAdmin()
        || (isTenantMember(tenantId) && (roleIn(roles) || wsMemberRoleIn(tenantId, roles)));
    }

    // Organisation Trustee for a specific org (used by membership flows):
    function isOrgTrustee(orgId) {
      return isLoggedIn() && orgId != null && orgId != '' && (
        isSuperAdmin() ||
        (isTenantMember(orgId) && (
          roleIn(['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']) ||
          wsMemberRoleIn(orgId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'])
        ))
      );
    }

    // Chat privacy (2026-10-19): extract the orgId from an org-type chat doc.
    // New docs carry an explicit `orgId` field; legacy org chats carry it as
    // participants[1] (see getOrCreateOrgChat: participants [userUid, orgId]).
    // Returns '' for anything else — callers MUST check type == 'org' first.
    function chatOrgId(chatData) {
      return chatData.get('orgId', '') != '' ? chatData.get('orgId', '') :
        (chatData.get('participants', null) is list &&
         chatData.get('participants', []).size() == 2 ?
         chatData.get('participants', [])[1] : '');
    }

    // Trustee chat access, scoped (2026-10-19 privacy fix): a trustee may
    // access ONLY org-type support threads belonging to their own org.
    // Previously any trustee could read every private 1:1 chat.
    // SuperAdmin keeps emergency access via the separate isSuperAdmin branch.
    function isChatOrgTrustee(chatData) {
      return chatData.get('type', '') == 'org' &&
        isOrgTrustee(chatOrgId(chatData));
    }

    // Role-grant matrix for invites / member adds. A Trustee may grant
    function grantableRole(orgId, targetRole) {
      return isSuperAdmin() || (
        isOrgTrustee(orgId) &&
        !(targetRole in ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']) &&
        targetRole in ['Priest', 'PRIEST', 'PUROHIT', 'Accountant', 'ACCOUNTANT',
          'Sevadar', 'SEVADAR', 'Devotee', 'DEVOTEE', 'Member', 'MEMBER',
          'CSO', 'Manager', 'MANAGER']
      );
    }

    // DEMO sandboxes: public reads; writes need an authenticated session.
    function demoPublicRead(wsId) {
      return isDemoWs(wsId) && (request.auth == null || effTenant() == wsId || isSuperAdmin());
    }
    function demoWriteOk(wsId) {
      return isLoggedIn() && isDemoWs(wsId);
    }

    // Workspace id carried on root-collection documents (fail closed if absent).
    function docWs() {
      return resource.data.get('workspaceId', null);
    }
    function newDocWs() {
      return request.resource.data.get('workspaceId', null);
    }
    function wsImmutable() {
      return request.resource.data.get('workspaceId', null) == resource.data.get('workspaceId', null);
    }

    // Pillar 2 â public RSVP counter bump on festival_events. A signed-in
    function slotBookedSane(oldM, newM) {
      return newM.diff(oldM).addedKeys().size() == 0
          && newM.diff(oldM).removedKeys().size() == 0
          && newM.diff(oldM).changedKeys().size() <= 1
          && (
            newM.diff(oldM).changedKeys().size() == 0
            || (
              (oldM.get(newM.diff(oldM).changedKeys()[0], 0) is number)
              && (newM.get(newM.diff(oldM).changedKeys()[0], 0) is number)
              && newM.get(newM.diff(oldM).changedKeys()[0], 0) >= oldM.get(newM.diff(oldM).changedKeys()[0], 0)
              && newM.get(newM.diff(oldM).changedKeys()[0], 0) <= oldM.get(newM.diff(oldM).changedKeys()[0], 0) + 20
            )
          );
    }
    function publicCounterBump() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rsvpHeadcount', 'slotBooked', 'updatedAt'])
        && (resource.data.get('rsvpHeadcount', 0) is number)
        && (request.resource.data.get('rsvpHeadcount', 0) is number)
        && request.resource.data.get('rsvpHeadcount', 0) >= resource.data.get('rsvpHeadcount', 0)
        && request.resource.data.get('rsvpHeadcount', 0) <= resource.data.get('rsvpHeadcount', 0) + 20
        && slotBookedSane(resource.data.get('slotBooked', {}),
                           request.resource.data.get('slotBooked', {}));
    }

    // Canonical role sets (canonical + legacy variants from ROLE_MIGRATION_MAP).
    function R_FINANCE() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Accountant', 'ACCOUNTANT'];
    }
    function R_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }
    function R_RITUAL() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Priest', 'PRIEST', 'PUROHIT', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR'];
    }
    function R_ANY_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER',
              'Accountant', 'ACCOUNTANT', 'Priest', 'PRIEST', 'PUROHIT', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }

    // 2. Platform admin registry (server-managed via Admin SDK only)
    match /platform_admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /platform_leads/{leadId} {
      allow create: if true; // public lead-capture form
      allow read, update: if isSuperAdmin() || isOwner();
      allow delete: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // 3. User profiles â owner or SuperAdmin only.
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin() || isOwner());
      allow create: if isLoggedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId',
          // Step 8: soft-ban fields are owner-write-only
          'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
        && (
          // DEMO sandbox: may self-claim a demo workspace + starter role
          isDemoWs(request.resource.data.get('workspaceId', null))
          // Standard registration: no privilege or tenant claims at all
          || !request.resource.data.keys().hasAny(['role', 'workspaceId', 'defaultWorkspaceId', 'membership'])
        );
      allow update: if isSuperAdmin() || (
        isLoggedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId', 'role', 'workspaceId', 'defaultWorkspaceId', 'membership',
              // Step 8: soft-ban fields are owner-write-only
              'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
      )
        // Step 8: owner-only soft-ban writes — suspension fields and nothing else
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['suspended', 'suspendReason', 'suspendedAt', 'suspendedBy', 'updatedAt']));
      allow delete: if false;
    }

    // FCM device tokens for push delivery. Each user manages only their own
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // 4. Tenant partitions
    match /tenants/{tenantId} {
      allow read: if true; // public discovery
      allow create: if isSuperAdmin();
      allow update: if hasRole(tenantId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'])
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'city', 'state', 'country', 'type', 'logoUrl', 'tagline', 'updatedAt']);
      allow delete: if isSuperAdmin();

      // Sensitive tenant fields (bank details, tax ids, keys) â restricted.
      match /private/{docId} {
        allow read, write: if hasRole(tenantId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      }

      // Curated public profile mirror for discovery clients.
      match /publicProfile/{docId} {
        allow read: if true;
        allow write: if hasRole(tenantId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      }

      // Tenant-scoped financial ledger (path-param tenant).
      match /treasury/{docId} {
        allow read: if demoPublicRead(tenantId) || hasRole(tenantId, R_FINANCE());
        allow create: if demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE());
        allow update: if (demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE()));
        allow delete: if false; // append-only fiduciary ledger
      }

      match /devotees/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create, update: if demoWriteOk(tenantId) || hasRole(tenantId, R_STAFF());
        allow delete: if hasRole(tenantId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      }

      match /yatranet_alerts/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create: if demoWriteOk(tenantId) || isTenantMember(tenantId);
        allow update, delete: if hasRole(tenantId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      }
    }

    // 5. Workspace documents (client-managed workspaces collection)
    match /workspaces/{workspaceId} {
      // NOTE: adminPinHash may only ever be written via the server
      allow read: if isTenantMember(workspaceId) || isOwner();
      // Anonymous (demo) sessions cannot create real workspaces â must sign in
      allow create: if isLoggedIn() && !isAnonymous()
        && !request.resource.data.keys().hasAny(['adminPinHash', 'adminPin']);
      // Owner (Spark-native console) may change plan + limits-bypass fields only â never pins.
      allow update: if (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planId', 'limitsBypassed', 'updatedAt']))
        || ((demoWriteOk(workspaceId) || hasRole(workspaceId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminPinHash', 'adminPin']));
      allow delete: if isSuperAdmin();
    }

    // 6. Root collections (keyed by `workspaceId` field) â deny by default

    // Financial ledger â append-only. Demo workspaces are blocked from writing
    match /treasury/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_FINANCE())
        || (isTenantMember(docWs()) && resource.data.get('devoteeId', '') == request.auth.uid);
      allow create: if hasRole(newDocWs(), R_FINANCE());
      allow update: if hasRole(docWs(), R_FINANCE()) && wsImmutable();
      allow delete: if false;
    }

    match /treasury_ledgers/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_FINANCE())
        || (isTenantMember(docWs()) && resource.data.get('devoteeId', '') == request.auth.uid);
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_FINANCE())
        || (isTenantMember(docWs()) && resource.data.get('donorId', '') == request.auth.uid);
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())
        || (isTenantMember(newDocWs()) && request.resource.data.get('donorId', '') == request.auth.uid
            && request.resource.data.get('status', '') == 'pledged'));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /tax_receipts/{receiptId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_FINANCE())
        || (isTenantMember(docWs()) && resource.data.get('donorId', '') == request.auth.uid);
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    // Devotee PII â read: any tenant member; write: staff roles only
    match /devotees/{devoteeId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || resource.data.get('userId', '') == request.auth.uid || devoteeId == request.auth.uid;
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())
        || (isTenantMember(newDocWs()) && request.resource.data.get('userId', '') == request.auth.uid));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_STAFF())
        || (isTenantMember(docWs()) && resource.data.get('userId', '') == request.auth.uid)) && wsImmutable();
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /households/{householdId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /puja_bookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && request.resource.data.get('devoteeId', '') == request.auth.uid));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /poojaBookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && request.resource.data.get('devoteeId', '') == request.auth.uid));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // Pillar 2 â Festival war-room (market domination).
    match /festival_plans/{planId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF()))
        && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /festival_events/{eventId} {
      allow read: if resource.data.get('published', false) == true
        || demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if demoWriteOk(newDocWs())
        || hasRole(newDocWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER']);
      allow update: if demoWriteOk(docWs())
        || hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER'])
        || (isLoggedIn() && wsImmutable() && publicCounterBump());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    match /festival_rsvps/{rsvpId} {
      allow read: if isTenantMember(docWs())
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('workspaceId', '') != ''
        && request.resource.data.get('eventId', '') != ''
        && request.resource.data.get('name', '').size() >= 2
        && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('headcount', 0) >= 1
        && request.resource.data.get('headcount', 0) <= 20
        && request.resource.data.keys().hasOnly(
             ['eventId', 'workspaceId', 'uid', 'name', 'headcount', 'slotId', 'createdAt']);
      allow update: if (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headcount', 'slotId']))
        || hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      allow delete: if (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid)
        || hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // Inventory & assets
    match /inventory_items/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /inventory/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /fixed_assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // Goshala / Dharamshala operations
    match /cows/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /gaushala_cattle/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }
    match /dharamshala_rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // One-time QR login pairing tokens â bearer-token pattern (Spark-plan,
    match /qrPairTokens/{tokenId} {
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['memberId', 'workspaceId', 'role', 'expiresAt'])
        && request.resource.data.role in ['Devotee', 'Sevadar', 'Priest', 'Accountant', 'Trustee']
        && (demoWriteOk(request.resource.data.get('workspaceId', null))
            || hasRole(request.resource.data.get('workspaceId', null), R_ANY_STAFF()))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(600, 's');
      allow get, delete: if request.time < resource.data.expiresAt;
      allow list, update: if false;
    }

    // Generic operational collections (annadanam, campaigns, check-ins...)
    match /{collection}/{docId} {
      allow read: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns',
          'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins']
        && (demoPublicRead(docWs()) || isTenantMember(docWs()));
      allow create: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns',
          'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins']
        && (demoWriteOk(newDocWs()) || (isTenantMember(newDocWs()) && roleIn(R_ANY_STAFF())));
      allow update: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns',
          'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins']
        && (demoWriteOk(docWs()) || (isTenantMember(docWs()) && roleIn(R_ANY_STAFF()))) && wsImmutable();
      allow delete: if collection in ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns',
          'resolutions', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins']
        && hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // Audit logs â append-only, actor-bound. Owner gets full read + write
    match /audit_logs/{logId} {
      allow read: if isOwner() || demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE());
      allow create: if (isOwner() && request.resource.data.get('actorUid', '') == request.auth.uid)
        || ((demoWriteOk(newDocWs()) || isTenantMember(newDocWs()))
          && request.resource.data.get('actorId', '') == request.auth.uid);
      allow update, delete: if false;
    }

    // Verification applications â owner-reviewed, never client-writable beyond apply.
    match /verificationApplications/{appId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isLoggedIn()
        && request.resource.data.get('applicantUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    // Moderation reports â reporter can file, only owner sees and acts.
    match /moderationReports/{reportId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isLoggedIn()
        && request.resource.data.get('reporterUid', '') == request.auth.uid;
      allow update: if isOwner();
      allow delete: if false;
    }

    // Moderation hide directives â read-only for clients, enforced in UI.
    match /moderationHides/{hideId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Reminder queue â owner-triggered scheduled jobs write here; clients read own.
    match /reminderQueue/{reminderId} {
      allow read: if isLoggedIn()
        && resource.data.get('targetUid', '') == request.auth.uid;
      allow create, update, delete: if false; // scheduler writes via Admin SDK only
    }

    // ---- Manual billing (bKash / Nagad / UPI / PhonePe) ----
    match /paymentMethods/{methodId} {
      allow read: if true;
      allow create, update, delete: if isOwner(); // owner writes via Admin SDK only
    }

    // Payment claims: any authenticated member files their own claim; only the
    match /paymentClaims/{claimId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && resource.data.get('applicantUid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('applicantUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    // Subscriptions: readable by owner or workspace members; owner activates
    match /subscriptions/{workspaceId} {
      allow read: if isSuperAdmin() || isOwner() || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // ---- Messaging ----
    match /messages/{messageId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && resource.data.get('targetUid', '') == request.auth.uid);
      allow create: if isOwner();
      allow update: if isLoggedIn()
        && resource.data.get('targetUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }

    // Campaigns, scheduled messages, templates: owner-only reads; owner writes
    match /messageCampaigns/{campaignId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /scheduledMessages/{schedId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /messageTemplates/{templateId} {
      allow read: if isSuperAdmin() || isOwner();
      // Owner manages templates from the Console 3.0 Content Manager.
      allow create, update, delete: if isOwner();
    }
    // ---- Console 3.0: commission, content, settings, support ----

    // Commission rules: public read so the future marketplace UI can show
    match /commissionRules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Platform config (commission tier rates etc): public read so booking
    match /platformConfig/{configId} {
      allow read: if configId != 'public';
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // API Keys — GodMode "API Keys" tab (owner-managed third-party keys).
    // Two tiers by design: client-safe keys are published to the 'public'
    // doc below (readable by signed-in clients — anything on a phone is
    // visible in the network tab); server-only secrets stay owner-only and
    // can never reach a client on the current plan (no backend).
    match /platformConfig/apiKeys/{keyId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }
    // Published subset: ONLY client-safe && enabled keys, written by the
    // owner via "Publish to app". Authenticated read; owner-only write.
    match /platformConfig/public {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // Geo payment regions: owner-configured payment rails (BD / IN / INTL +
    // any custom regions added from GodMode → Geo Payments). Every signed-in
    // user reads this to pick payment rails; reads that fail or miss fall
    // back to the hardcoded defaults client-side. Writes are owner-only.
    match /geoPaymentConfig/config {
      allow read: if isLoggedIn();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(
          ['regions', 'defaultRegion', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('regions', []) is list
        && request.resource.data.get('regions', []).size() >= 1
        && request.resource.data.get('regions', []).size() <= 50
        && request.resource.data.get('defaultRegion', '') is string;
      allow delete: if false;
    }
    // Append-only audit: who changed which key, when. Values never logged.
    match /platformConfig/apiKeysAudit/{auditId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    // Marketplace transactions: owner-only. Written by the future booking
    match /marketplaceTransactions/{txnId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // Payouts: providers request via their own doc (future), owner decides.
    match /payouts/{payoutId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && resource.data.get('providerUid', '') == request.auth.uid);
      allow create: if isOwner()
        || (isLoggedIn()
          && request.resource.data.get('providerUid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'requested');
      allow update: if isOwner()
        || (isLoggedIn()
          && resource.data.get('providerUid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'requested');
      allow delete: if false;
    }
    // Announcements: active ones are public so the app can render banners.
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Site content (landing page KV): public read, owner writes.
    match /siteContent/{key} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Feature flags: logged-in clients read (the app gates modules on these);
    match /featureFlags/{flagId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isOwner();
    }
    // Plans: public read so pricing pages stay in sync; owner edits.
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Payment methods: public read so billing pages can render them;
    match /marketplaceGigs/{gigId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('providerUid', '') == request.auth.uid
        && request.resource.data.get('active', true) == true;
      allow update: if isOwner()
        || (isLoggedIn()
          && resource.data.get('providerUid', '') == request.auth.uid
          && request.resource.data.get('providerUid', '') == request.auth.uid)
        // Step 7 (gig ratings): a devotee submitting blessings may nudge ONLY
        // avgRating + ratingCount (+ updatedAt), ratingCount exactly +1,
        // avgRating within 1-5, providerUid untouched. The gigRatings doc
        // (auditable, one per order) is the source of truth.
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avgRating', 'ratingCount', 'updatedAt'])
          && request.resource.data.get('providerUid', '') == resource.data.get('providerUid', '')
          && request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0) + 1
          && request.resource.data.get('avgRating', 0) >= 1
          && request.resource.data.get('avgRating', 0) <= 5);
      allow delete: if isOwner();
    }
    // gigRatings: one blessing per completed order (doc ID = orderId).
    // Public read (trust display); create restricted to the order's client
    // on a completed order; immutable after (no update/delete).
    match /gigRatings/{orderId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('clientUid', '') == request.auth.uid
        && request.resource.data.get('rating', 0) >= 1
        && request.resource.data.get('rating', 0) <= 5
        && request.resource.data.keys().hasOnly(
          ['gigId', 'orderId', 'clientUid', 'providerUid', 'rating', 'review', 'createdAt'])
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.status == 'completed'
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.clientUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Orders: client creates (clientUid must match); provider + client read
    match /marketplaceOrders/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          resource.data.get('clientUid', '') == request.auth.uid
          || resource.data.get('providerUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && request.resource.data.get('clientUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending_payment';
      allow update: if isOwner()
        || (isLoggedIn()
          && request.resource.data.get('commissionPercent', 0) == resource.data.get('commissionPercent', 0)
          && request.resource.data.get('commissionAmount', 0) == resource.data.get('commissionAmount', 0)
          && request.resource.data.get('providerNet', 0) == resource.data.get('providerNet', 0)
          && (
          // Provider: accept / decline / progress; 'completed' only from a live status
          (resource.data.get('providerUid', '') == request.auth.uid
            && request.resource.data.get('status', '') in ['accepted', 'cancelled', 'in_progress', 'completed']
            && (request.resource.data.get('status', '') != 'completed'
              || resource.data.get('status', '') in ['paid', 'accepted', 'in_progress']))
          // Provider (pay-after-task): task done, now awaiting the platform commission
          || (resource.data.get('providerUid', '') == request.auth.uid
            && resource.data.get('payAfterTask', false) == true
            && request.resource.data.get('status', '') == 'awaiting_commission'
            && resource.data.get('status', '') in ['paid', 'accepted', 'in_progress'])
          // Provider (Rail-2): dispute a payment proof â back to pending_payment
          || (resource.data.get('providerUid', '') == request.auth.uid
            && resource.data.get('rail', '') == 'rail2'
            && request.resource.data.get('status', '') == 'pending_payment'
            && request.resource.data.get('rail2Proof', {}).get('disputed', false) == true)
          // Client: confirm completion (only from a live status), or cancel
          || (resource.data.get('clientUid', '') == request.auth.uid
            && request.resource.data.get('status', '') in ['completed', 'cancelled']
            && (request.resource.data.get('status', '') != 'completed'
              || resource.data.get('status', '') in ['paid', 'accepted', 'in_progress']))
          // Client (wallet): pay from wallet â pending_payment becomes paid.
          || (resource.data.get('clientUid', '') == request.auth.uid
            && resource.data.get('payWithWallet', false) == true
            && resource.data.get('status', '') == 'pending_payment'
            && request.resource.data.get('status', '') == 'paid'
            && request.resource.data.get('escrowHeld', 0) == resource.data.get('amountGross', 0))
          // Client (Rail-2): submit payment proof â pending_payment becomes paid
          || (resource.data.get('clientUid', '') == request.auth.uid
            && resource.data.get('rail', '') == 'rail2'
            && resource.data.get('status', '') == 'pending_payment'
            && request.resource.data.get('status', '') == 'paid'
            && request.resource.data.get('rail2Proof', {}).get('trxId', '') != '')
          // AUDIT FIX #4 (2026-10-19): Provider (Rail-1): confirm direct
          // payment received (bKash/Nagad/UPI/cash moved outside the app) --
          // pending_payment becomes paid. Rail-1 had no paid path at all.
          || (resource.data.get('providerUid', '') == request.auth.uid
            && resource.data.get('status', '') == 'pending_payment'
            && request.resource.data.get('status', '') == 'paid'
            && resource.data.get('rail', '') == 'rail1'
            && resource.data.get('payWithWallet', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paymentNote', 'updatedAt']))
          // PHASE 3 â dispute freeze: an order party moves an ACTIVE order to
          || (isLoggedIn()
            && (resource.data.get('providerUid', '') == request.auth.uid
              || resource.data.get('clientUid', '') == request.auth.uid)
            && resource.data.get('status', '') in ['paid', 'accepted', 'in_progress']
            && request.resource.data.get('status', '') == 'commission_held'
            && request.resource.data.get('commissionHold', {}).get('frozenByUid', '') == request.auth.uid)
          // openDispute(): an order party flags an ACTIVE order 'disputed'.
          // The dispute record itself lives in marketplaceDisputes (ruled
          // separately); on the order only status + updatedAt may change here.
          || (isLoggedIn()
            && (resource.data.get('providerUid', '') == request.auth.uid
              || resource.data.get('clientUid', '') == request.auth.uid)
            && resource.data.get('status', '') in ['paid', 'accepted', 'in_progress']
            && request.resource.data.get('status', '') == 'disputed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))));
      allow delete: if false;
    }
    // Commission freeze requests (Phase 3): dispute on a COMPLETED order,
    match /commissionFreezeRequests/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && request.resource.data.get('orderId', '') == orderId
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'requested'
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('status', '') == 'completed'
        && (get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid);
      allow update: if isOwner();
      allow delete: if false;
    }
    // Rail-2 provider sequence counter (unique TrxID reference numbering).
    match /rail2Sequences/{providerUid} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn()
        && request.resource.data.keys().hasOnly(['seq', 'updatedAt'])
        && request.resource.data.get('seq', 0) is int;
    }
    // Disputes: either party on the order may open; owner resolves.
    match /marketplaceDisputes/{disputeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          resource.data.get('raisedByUid', '') == request.auth.uid
          || resource.data.get('providerUid', '') == request.auth.uid
          || resource.data.get('clientUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && request.resource.data.get('raisedByUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Commission overrides: public read (marketplace shows "platform fee X%");
    match /commissionOverrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Platform config (maintenance mode etc.): public read of the main doc.

    // ---- Marketplace anti-bypass + provider payments ----
    match /providerPaymentMethods/{mId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('providerUid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('providerUid', '') == request.auth.uid
        && request.resource.data.get('status', '') in ['pending', 'platform_assigned'];
      allow update: if isOwner();
      allow delete: if false;
    }
    // Provider â owner inquiries: provider creates + reads own; owner manages.
    match /providerInquiries/{inqId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('providerUid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('providerUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Bypass flags: the sender's own client creates the flag when a message
    match /bypassFlags/{flagId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if isLoggedIn()
        && request.resource.data.get('senderUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Bypass keyword patterns: public read (clients need them to scan);
    match /bypassKeywords/{kwId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Provider strikes: owner-only writes; provider reads own (transparency).
    match /providerStrikes/{strikeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('providerUid', '') == request.auth.uid);
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // ---- Rail-2: platform dues (Layer 6) ----
    match /platformDues/{dueId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('providerUid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('providerUid', '') ==
           get(/databases/$(database)/documents/marketplaceOrders/$(request.resource.data.get('orderId', ''))).data.get('providerUid', '')
        && get(/databases/$(database)/documents/marketplaceOrders/$(request.resource.data.get('orderId', ''))).data.get('rail', '') == 'rail2';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Provider marketplace profile (dues suspension flags): owner writes,
    match /marketplaceProviders/{providerUid} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && providerUid == request.auth.uid);
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // ---- Platform wallet + escrow top-up system ----
    function walletDebitOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastDebitOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let gross = get(opath).data.get('amountGross', 0);
      return data.diff(old).affectedKeys().hasOnly(['balance', 'totalSpent', 'updatedAt', 'lastDebitOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastDebitOrderId', '')
        && exists(opath)
        && get(opath).data.get('clientUid', '') == request.auth.uid
        && get(opath).data.get('payWithWallet', false) == true
        && get(opath).data.get('status', '') == 'pending_payment'
        && gross > 0
        && data.get('balance', -1) == old.get('balance', 0) - gross
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + gross;
    }
    // P2P "Pay from Seva Wallet" (atomic client debit): the sender settles
    // an ACCEPTED money request with a real debit of their OWN wallet.
    // Anchored to the live p2pRequests doc â same idempotency pattern as
    // walletDebitOk: lastDebitP2PRequestId must change, so a replay or a
    // double-tap can never debit twice. Rules get() reads committed state,
    // so the transaction's own requestâ'paid' flip is invisible here; the
    // request leg is validated by the p2pRequests match below.
    function p2pSettlementDebitOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let requestId = data.get('lastDebitP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let amount = get(rpath).data.get('amount', 0);
      return data.diff(old).affectedKeys().hasOnly(['balance', 'totalSpent', 'updatedAt', 'lastDebitP2PRequestId', 'currency'])
        && requestId != '' && requestId != old.get('lastDebitP2PRequestId', '')
        && exists(rpath)
        && get(rpath).data.get('senderId', '') == request.auth.uid
        && get(rpath).data.get('senderId', '') == uid
        && get(rpath).data.get('status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == old.get('balance', 0) - amount
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + amount;
    }
    // P2P settlement credit (receiver side): the sender's transaction
    // credits wallets/{receiverUid} via blind merge-set + increment().
    // Anchored to the live p2pRequests doc — receiver-bound, exact
    // amount, currency pinned, one credit per request
    // (lastCreditP2PRequestId). Mirrors p2pSettlementDebitOk.
    function p2pSettlementCreditOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = get(rpath).data;
      let amount = rdata.get('amount', 0);
      return data.diff(old).affectedKeys().hasOnly(
          ['uid', 'balance', 'currency', 'totalToppedUp', 'totalSpent',
           'totalReceived', 'lastCreditP2PRequestId', 'updatedAt'])
        && requestId != '' && requestId != old.get('lastCreditP2PRequestId', '')
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && rdata.get('senderId', '') == request.auth.uid
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('currency', '') == old.get('currency', '')
        && data.get('balance', -1) == old.get('balance', 0) + amount
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + amount
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }
    // Create-path for the P2P receiver credit: the wallet doc may not
    // exist yet when the first settlement arrives.
    function p2pSettlementCreditCreateOk(uid) {
      let data = request.resource.data;
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = get(rpath).data;
      let amount = rdata.get('amount', 0);
      return requestId != ''
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && rdata.get('senderId', '') == request.auth.uid
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == amount
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('totalReceived', -1) == amount
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    function walletCreditOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = get(opath).data.get('providerNet', 0);
      return data.diff(old).affectedKeys().hasOnly(['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastCreditOrderId', 'currency', 'uid'])
        && orderId != '' && orderId != old.get('lastCreditOrderId', '')
        && exists(opath)
        && get(opath).data.get('providerUid', '') == uid
        && (get(opath).data.get('clientUid', '') == request.auth.uid
          || get(opath).data.get('providerUid', '') == request.auth.uid)
        && get(opath).data.get('status', '') in ['paid', 'accepted', 'in_progress']
        && net > 0
        && data.get('balance', -1) == old.get('balance', 0) + net
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + net
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }
    // PHASE 3 â provider commission debit, order-anchored.
    function commissionHoldOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let order = get(opath).data;
      let cap = order.get('commissionAmount', 0);
      let debit = old.get('balance', 0) - data.get('balance', 0);
      return data.diff(old).affectedKeys().hasOnly(['balance', 'totalSpent', 'updatedAt', 'lastCommissionOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && order.get('providerUid', '') == uid
        && order.get('providerUid', '') == request.auth.uid
        && order.get('status', '') in ['paid', 'accepted', 'in_progress']
        && cap > 0
        && debit > 0 && debit <= cap
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + debit;
    }
    // PHASE 3 â Pratham Seva counter advancement, order-anchored.
    function sevaProfileCompletionOk() {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let freeOld = old.get('freeSevasRemaining', 0);
      let freeNew = data.get('freeSevasRemaining', -1);
      return resource.data.get('uid', '') == request.auth.uid
        && data.diff(old).affectedKeys().hasOnly(['freeSevasRemaining', 'completedSevasSinceVerified', 'lastCommissionOrderId', 'updatedAt'])
        && data.get('completedSevasSinceVerified', -1) == old.get('completedSevasSinceVerified', 0) + 1
        && (freeNew == freeOld || (freeOld > 0 && freeNew == freeOld - 1))
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && get(opath).data.get('providerUid', '') == request.auth.uid
        && get(opath).data.get('status', '') in ['paid', 'accepted', 'in_progress'];
    }
    // Create-path for provider credit: the wallet doc may not exist yet when
    function walletCreditCreateOk(uid) {
      let data = request.resource.data;
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = get(opath).data.get('providerNet', 0);
      return orderId != ''
        && exists(opath)
        && get(opath).data.get('providerUid', '') == uid
        && (get(opath).data.get('clientUid', '') == request.auth.uid
          || get(opath).data.get('providerUid', '') == request.auth.uid)
        && get(opath).data.get('status', '') in ['paid', 'accepted', 'in_progress']
        && net > 0
        && data.get('balance', -1) == net
        && data.get('totalReceived', -1) == net
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    match /wallets/{uid} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uid == request.auth.uid);
      allow create: if isOwner()
        || (isLoggedIn() && uid == request.auth.uid
          && request.resource.data.get('balance', -1) == 0
          && request.resource.data.get('totalToppedUp', -1) == 0
          && request.resource.data.get('totalSpent', -1) == 0)
        || (isLoggedIn() && walletCreditCreateOk(uid))
        || (isLoggedIn() && p2pSettlementCreditCreateOk(uid))
        || (isLoggedIn() && referralWalletCreditCreateOk(uid));
      allow update: if isOwner()
        || (isLoggedIn() && uid == request.auth.uid && walletDebitOk(uid))
        || (isLoggedIn() && uid == request.auth.uid && p2pSettlementDebitOk(uid))
        || (isLoggedIn() && uid == request.auth.uid && commissionHoldOk(uid))
        || (isLoggedIn() && walletCreditOk(uid))
        || (isLoggedIn() && p2pSettlementCreditOk(uid))
        || (isLoggedIn() && referralWalletCreditOk(uid));
      allow delete: if false;
    }
    // Wallet transactions: append-only ledger. Clients record their own
    match /walletTransactions/{txnId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isOwner()
        || (isLoggedIn()
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('type', '') in ['spend', 'topup_request']
          && request.resource.data.get('amount', 0) > 0)
        || (isLoggedIn()
          && request.resource.data.get('type', '') in ['receive', 'commission']
          && request.resource.data.get('orderId', '') != ''
          && (get(/databases/$(database)/documents/marketplaceOrders/$(request.resource.data.get('orderId', ''))).data.get('clientUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/marketplaceOrders/$(request.resource.data.get('orderId', ''))).data.get('providerUid', '') == request.auth.uid))
        // Seva Pro Phase 4: referral guidance credit, anchored to the validated credit doc.
        || (isLoggedIn()
          && request.resource.data.get('type', '') == 'referral_credit'
          && request.resource.data.get('uid', '') != ''
          && request.resource.data.get('creditId', '') != ''
          && request.resource.data.get('amount', 0) > 0
          && exists(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', '')))
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('referrerUid', '') == request.resource.data.get('uid', '')
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('status', '') == 'SETTLED'
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('creditAmount', 0) == request.resource.data.get('amount', 0))
        // P2P settlement receiver receipt: the sender's transaction writes
        // the receiver's audit-trail doc. Anchored to the live p2pRequests
        // doc — sender-bound, receiver-bound, exact amount, still accepted.
        || (isLoggedIn()
          && request.resource.data.get('type', '') == 'p2p_receive'
          && request.resource.data.get('requestId', '') != ''
          && request.resource.data.get('amount', 0) > 0
          && request.resource.data.get('uid', '') != request.auth.uid
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('senderId', '') == request.auth.uid
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('receiverId', '') == request.resource.data.get('uid', '')
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('amount', 0) == request.resource.data.get('amount', 0)
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('currency', '') == request.resource.data.get('currency', '')
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('status', '') == 'accepted');
      allow update, delete: if false;
    }
    // Top-up claims: user files (pending only); owner approves â credits
    match /topupClaims/{claimId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('amount', 0) > 0
        && request.resource.data.get('currency', '') in ['BDT', 'INR', 'USD'];
      allow update: if isOwner();
      allow delete: if false;
    }
    // Commission payments (Path B: post-task direct pay, commission to
    match /commissionPayments/{payId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          resource.data.get('paidByUid', '') == request.auth.uid
          || resource.data.get('clientUid', '') == request.auth.uid
          || resource.data.get('providerUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && request.resource.data.get('paidByUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('amount', 0) > 0
        && request.resource.data.get('orderId', '') != '';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Platform revenue ledger: one doc per completed order, amount pinned to
    match /platformRevenue/{orderId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if isLoggedIn()
        && request.resource.data.get('orderId', '') == orderId
        && request.resource.data.get('recordedBy', '') == request.auth.uid
        && request.resource.data.get('amount', -1) >= 0
        && request.resource.data.get('amount', -1) <=
             get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('commissionAmount', -1)
        && (get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid);
      allow update: if isOwner();
      allow delete: if false;
    }

    // Crisis events â Tier 1 SOS (sender cancel, coordinator ack/resolve, response fan-out).
    match /crisis_events/{eventId} {
      function parent() {
        return get(/databases/$(database)/documents/crisis_events/$(eventId)).data;
      }
      function isCrisisCoord(ws) {
        return isLoggedIn() && ws != null
          && exists(/databases/$(database)/documents/crisisCoordinators/$(ws + '_' + request.auth.uid));
      }
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || (isLoggedIn() && resource.data.get('senderUid', '') == request.auth.uid)
        // Notified responder: someone in this event's `notified` subcollection
        // (family circle / nearby Sanatani / coordinator pinged by fan-out).
        // ACTIVE-ONLY: the moment the SOS resolves, their read access ends —
        // the responder map can never render a resolved victim's location.
        || (isLoggedIn() && resource.data.get('status', '') == 'active'
          && exists(/databases/$(database)/documents/crisis_events/$(eventId)/notified/$(request.auth.uid)));
      allow create: if isLoggedIn()
        && request.resource.data.get('senderUid', '') == request.auth.uid
        && (demoWriteOk(newDocWs()) || isTenantMember(newDocWs()) || newDocWs() == null);
      allow update: if (demoWriteOk(docWs())
          || hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'])
          // Sender: "I'm safe" â cancel own SOS.
          || (isLoggedIn() && resource.data.get('senderUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'resolvedAt', 'outcomeNote', 'updatedAt'])
            && request.resource.data.get('status', '') in ['cancelled', 'resolved'])
          // Sender: attach the voice-note vault URL after the audio upload
          // finishes (uploadVoiceNote / flushVoiceOutbox). Field-pinned to
          // the pointer alone — no other sender field may change here.
          || (isLoggedIn() && resource.data.get('senderUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['voiceNoteUrl', 'updatedAt']))
          // Coordinator edge: ack (-> acknowledged) and resolve (-> resolved).
          || (isCrisisCoord(docWs())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'ackCount',
                'resolvedAt', 'outcomeNote', 'updatedAt'])
            && request.resource.data.get('status', '') in ['acknowledged', 'resolved'])
          // Coordinator edge: assign sevadars (assignSevadars) — appends to
          // the assignments array, bumps responderCount, flips
          // active -> responding. Assignments stay a list so a bad write
          // fails closed instead of corrupting the roster.
          || (isCrisisCoord(docWs())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['assignments', 'status', 'responderCount', 'updatedAt'])
            && request.resource.data.get('status', '')
              in ['active', 'responding', 'acknowledged']
            && request.resource.data.get('assignments', []) is list)
          // Tenant member: best-effort ack bump from ackSOS; only -> acknowledged.
          || (isTenantMember(docWs())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'ackCount', 'responderCount', 'updatedAt'])
            && request.resource.data.get('status', '') == 'acknowledged'))
        && wsImmutable();
      allow delete: if hasRole(docWs(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
      match /responses/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (isLoggedIn() && parent().get('senderUid', '') == request.auth.uid);
        allow create, update: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.get('uid', '') == uid
          && request.resource.data.get('status', '') in ['coming', 'arrived'];
        allow delete: if false;
      }
      // Nearby-ping fan-out: sender's client writes one doc per nearby uid
      // (fanOutToNearby); a responder's own client may also self-register.
      match /notified/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (isLoggedIn() && parent().get('senderUid', '') == request.auth.uid);
        allow create: if isLoggedIn()
          && request.resource.data.get('uid', '') == uid
          && request.resource.data.keys()
            .hasOnly(['uid', 'notifiedAt', 'distanceM'])
          && (
            // Responder self-register: their own client marks them notified.
            (request.auth.uid == uid
              && isTenantMember(parent().get('workspaceId', null)))
            // Sender fan-out: the sender's client writes one lightweight
            // ping doc per nearby uid so the active-only responder-read
            // carve-out above can grant them access.
            || parent().get('senderUid', '') == request.auth.uid
          );
        allow update, delete: if false;
      }
    }
    // Coordinator edge docs (crisisCoordinators/{orgId}_{uid}): trustee-managed.
    match /crisisCoordinators/{edgeId} {
      allow read: if isLoggedIn()
        && (resource.data.get('uid', '') == request.auth.uid
          || isTenantMember(resource.data.get('orgId', null)));
      allow create, update: if isOrgTrustee(request.resource.data.get('orgId', ''))
        && request.resource.data.get('uid', '') != ''
        && (resource == null
          || request.resource.data.get('orgId', '') == resource.data.get('orgId', ''))
        && edgeId == request.resource.data.get('orgId', '') + '_'
          + request.resource.data.get('uid', '');
      allow delete: if isOrgTrustee(resource.data.get('orgId', ''));
    }
    // Abuse counters (crisisAbuse/{uid}): self-only read/write.
    match /crisisAbuse/{uid} {
      allow read, write: if isLoggedIn() && request.auth.uid == uid;
    }
    match /emergencyContacts/{uid} {
      allow read, write: if isLoggedIn() && request.auth.uid == uid;
    }


    // Polls
    match /polls/{pollId} {
      allow read: if isLoggedIn();
      allow write: if hasRole(effTenant(), ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE']);
    }

    // YatraNet broadcasts â keyed by communityId.
    match /yatra_broadcasts/{bId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(resource.data.get('communityId', null)) && (request.auth == null || effTenant() == resource.data.get('communityId', null)))
        || isTenantMember(resource.data.get('communityId', null));
      allow create: if isLoggedIn() && (isDemoWs(request.resource.data.get('communityId', null))
        || isTenantMember(request.resource.data.get('communityId', null)));
      allow update: if isSuperAdmin() || (isTenantMember(resource.data.get('communityId', null))
        && request.resource.data.get('communityId', null) == resource.data.get('communityId', null));
      allow delete: if isSuperAdmin();
    }

    // Support threads
    match /global_support_threads/{tId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }
    match /global_support_replies/{rId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Chats â participant-gated.
    // Chats — 1:1 threads are participant-only. Trustees may access ONLY
    // org-type support threads of their own org (2026-10-19 privacy fix:
    // previously any trustee of any org could read every private chat).
    match /chats/{chatId} {
      allow read: if isSuperAdmin() || (isLoggedIn() && (
        (resource == null || (resource.data.get('participants', null) is list && request.auth.uid in resource.data.get('participants', []))) ||
        isChatOrgTrustee(resource.data)));
      allow create: if isSuperAdmin() || (isLoggedIn() && (
        (request.resource.data.get('participants', null) is list && request.auth.uid in request.resource.data.get('participants', [])) ||
        (request.resource.data.get('type', '') == 'org' &&
          request.resource.data.get('participants', null) is list &&
          request.resource.data.get('participants', []).size() == 2 &&
          isOrgTrustee(chatOrgId(request.resource.data)))));
      allow update: if isSuperAdmin() || (isLoggedIn() && (
        (resource.data.get('participants', null) is list && request.auth.uid in resource.data.get('participants', []) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])) ||
        (isChatOrgTrustee(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'type', 'orgId']))));
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])) ||
          isChatOrgTrustee(get(/databases/$(database)/documents/chats/$(chatId)).data)));
        allow create: if isSuperAdmin() || (isLoggedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []) &&
            request.resource.data.get('senderId', '') == request.auth.uid) ||
          isChatOrgTrustee(get(/databases/$(database)/documents/chats/$(chatId)).data)));
        allow update, delete: if false;
      }
    }

    // Upgrade requests
    match /upgrade_requests/{reqId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    // Live Darshan — public live-status cache. Any viewer can read whether
    // a temple is live. Writes are schema-pinned: the polling client (any
    // logged-in viewer) may only update the live-status fields; the orgId
    // must match the document ID. Self-correcting: a wrong "live" flag is
    // overwritten by the next honest poll.
    match /orgLiveStatus/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && request.resource.data.get('orgId', '') == orgId
        && request.resource.data.get('isLive', null) is bool
        && request.resource.data.get('updatedAt', null) is number
        && request.resource.data.keys().hasOnly([
          'orgId', 'isLive', 'videoId', 'title', 'startedAt',
          'updatedAt', 'nextPollAfter'
        ]);
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Sangam Watch — unified video feed. Shared videos are community
    // content: public read, authenticated create (schema-pinned), no edits
    // (delete + re-share). Deletes are author-or-admin; reports are a
    // counter any logged-in user may increment once per client.
    match /sangamVideos/{videoId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('youtubeId', '') is string
        && request.resource.data.get('youtubeId', '').size() == 11
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 1
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('sharedBy', '') == request.auth.uid
        && request.resource.data.get('category', '') in ['shared', 'seva_demo', 'live_event']
        && request.resource.data.keys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'duration', 'sharedBy',
          'sharedByName', 'sharedBySanId', 'caption', 'category',
          'providerUid', 'providerTier', 'createdAt', 'reportCount',
          'serverCreatedAt'
        ]);
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0) + 1;
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('sharedBy', '') == request.auth.uid);
    }

    // Sangam Stories — 24h disappearing moments. Ephemeral by design.
    // read: any authenticated user (community moments, like the feed).
    // create: author only, schema-pinned, expiresAt must be ~24h out.
    // update: reportCount increment only. delete: author or superadmin.
    // Expiry is lazy (queries filter expiresAt > now); a GodMode sweep
    // deletes long-expired docs.
    match /sangamStories/{storyId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.get('authorName', '') is string
        && request.resource.data.get('authorName', '').size() >= 1
        && request.resource.data.get('authorName', '').size() <= 60
        && request.resource.data.get('mediaType', '') in ['photo', 'text']
        && request.resource.data.get('expiresAt', 0) is number
        && request.resource.data.get('expiresAt', 0) > request.time.toMillis()
        && request.resource.data.get('expiresAt', 0) <= request.time.toMillis() + 25 * 60 * 60 * 1000
        && request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'authorSanId',
          'mediaType', 'mediaUrl', 'text', 'backgroundId', 'caption',
          'createdAt', 'expiresAt', 'reportCount'
        ]);
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0) + 1;
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('authorUid', '') == request.auth.uid);

      // View tracking: authors see a COUNT; viewer identities are private.
      // Write own uid only; read author-only.
      match /viewers/{uid} {
        allow read: if isSuperAdmin()
          || (isLoggedIn() && get(/databases/$(database)/documents/sangamStories/$(storyId)).data.get('authorUid', '') == request.auth.uid);
        allow write: if isLoggedIn() && uid == request.auth.uid;
      }
    }

    // Sangam Shorts — vertical sacred moments (YouTube Shorts embeds).
    // read: any authenticated user (community content, like the feed).
    // create: author only, schema-pinned (11-char youtubeId, title 1-120).
    // update: counter increments only (view/ashirvad/comment/share/report).
    // delete: author or superadmin. No edits — delete + re-share.
    match /sangamShorts/{shortId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.get('youtubeId', '') is string
        && request.resource.data.get('youtubeId', '').size() == 11
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 1
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.get('authorName', '') is string
        && request.resource.data.get('authorName', '').size() >= 1
        && request.resource.data.get('authorName', '').size() <= 60
        && request.resource.data.keys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'authorUid',
          'authorName', 'authorAvatar', 'authorSanId', 'caption',
          'duration', 'createdAt', 'viewCount', 'ashirvadCount',
          'commentCount', 'shareCount', 'reportCount',
          'serverCreatedAt'
        ]);
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewCount', 'ashirvadCount', 'commentCount', 'shareCount', 'reportCount'
        ]);
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('authorUid', '') == request.auth.uid);

      // Comments: community conversation on a short.
      // read: any authenticated user. create: author-only, schema-pinned.
      // delete: comment author or superadmin. No edits.
      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn()
          && request.resource.data.get('authorUid', '') == request.auth.uid
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() >= 1
          && request.resource.data.get('text', '').size() <= 300
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'text', 'createdAt', 'serverCreatedAt'
          ]);
        allow delete: if isSuperAdmin()
          || (isLoggedIn() && resource.data.get('authorUid', '') == request.auth.uid);
      }
    }

    // --- devoteeProfiles/{uid}: public devotee identity surface.
    // Public read (anyone can view a profile). Write = own uid only,
    // schema-pinned. NEVER exposes users/{uid} (self-read-only).
    match /devoteeProfiles/{uid} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() >= 1
        && request.resource.data.get('displayName', '').size() <= 80
        && request.resource.data.get('sanId', '') is string
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'sanId', 'avatarUrl', 'bio',
          'isPublic', 'followerCount', 'followingCount', 'updatedAt'
        ]);
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == uid);
    }

    // --- follows/{followerUid}/following/{targetUid}: asymmetric follow.
    // Read: follower themselves (or superadmin). Write: follower only, no self-follow.
    match /follows/{followerUid}/following/{targetUid} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == followerUid);
      allow create: if isLoggedIn()
        && request.auth.uid == followerUid
        && followerUid != targetUid
        && request.resource.data.keys().hasOnly(['followerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == followerUid);
    }

    // --- blocks/{blockerUid}/blocked/{targetUid}: user safety (Step 5).
    // Read: blocker themselves (or superadmin) — blocked users can NEVER
    // discover they were blocked. Write: blocker only, no self-block.
    match /blocks/{blockerUid}/blocked/{targetUid} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == blockerUid);
      allow create: if isLoggedIn()
        && request.auth.uid == blockerUid
        && blockerUid != targetUid
        && request.resource.data.keys().hasOnly(['blockerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == blockerUid);
    }

    // --- mutes/{muterUid}/muted/{targetUid}: user safety (Step 5).
    // Same privacy model as blocks. Mute hides posts; DMs still allowed.
    match /mutes/{muterUid}/muted/{targetUid} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == muterUid);
      allow create: if isLoggedIn()
        && request.auth.uid == muterUid
        && muterUid != targetUid
        && request.resource.data.keys().hasOnly(['muterUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && request.auth.uid == muterUid);
    }

    // Group chats — private by default, invite-code only. No public
    // discovery, no join-by-search. memberIds is the rules source of truth.
    match /chatGroups/{groupId} {      allow read: if isSuperAdmin() || (isLoggedIn() &&
        resource.data.get('memberIds', null) is list &&
        request.auth.uid in resource.data.get('memberIds', []));

      allow create: if isLoggedIn() &&
        request.resource.data.get('memberIds', null) is list &&
        request.auth.uid in request.resource.data.get('memberIds', []) &&
        request.resource.data.get('adminIds', null) is list &&
        request.auth.uid in request.resource.data.get('adminIds', []) &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('name', '').size() >= 2 &&
        request.resource.data.get('name', '').size() <= 60 &&
        request.resource.data.get('inviteCode', '') is string &&
        request.resource.data.get('inviteCode', '').size() == 8 &&
        request.resource.data.get('createdBy', '') == request.auth.uid;

      // Lane A (any member): thread-summary + presence fields only.
      // Lane B (admin): member management + rename + invite rotation.
      allow update: if isSuperAdmin() || (isLoggedIn() &&
        resource.data.get('memberIds', null) is list &&
        request.auth.uid in resource.data.get('memberIds', []) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
             'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy']
          ) ||
          (request.auth.uid in resource.data.get('adminIds', []) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
               'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy',
               'name', 'description', 'memberIds', 'adminIds', 'memberInfo', 'inviteCode']
            ) &&
            request.resource.data.get('memberIds', null) is list &&
            request.resource.data.get('adminIds', null) is list &&
            request.resource.data.get('createdBy', '') == resource.data.get('createdBy', ''))
        ));

      // Delete: admin, or the last member leaving (group dissolves).
      allow delete: if isSuperAdmin() || (isLoggedIn() &&
        resource.data.get('memberIds', null) is list &&
        request.auth.uid in resource.data.get('memberIds', []) && (
          request.auth.uid in resource.data.get('adminIds', []) ||
          resource.data.get('memberIds', []).size() == 1));

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []));
        allow create: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []) &&
          request.resource.data.get('senderId', '') == request.auth.uid &&
          (request.resource.data.get('kind', '') != 'system' ||
            request.resource.data.get('systemKind', '') in
              ['created', 'joined', 'left', 'added', 'removed', 'renamed', 'promoted']));
        // Unsend: own message, within 5 minutes. No edits, ever.
        allow delete: if isSuperAdmin() || (isLoggedIn() &&
          resource.data.get('senderId', '') == request.auth.uid &&
          request.time.toMillis() - resource.data.get('createdAt', 0) < 5 * 60 * 1000);
        allow update: if false;
      }

      match /members/{uid} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []));
        // Create: self-join via code (uid == auth.uid) or admin adding.
        allow create: if isSuperAdmin() || (isLoggedIn() &&
          request.resource.data.get('uid', '') == uid &&
          (uid == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', [])));
        // Role change: admin only, role field only.
        allow update: if isSuperAdmin() || (isLoggedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
        // Delete: self (leaving) or admin (removing).
        allow delete: if isSuperAdmin() || (isLoggedIn() &&
          (uid == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', [])));
      }
    }

    // Community subcollections (social feed, vivah, sadhana...)
    match /communities/{communityId}/{collectionName}/{docId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(communityId) && (request.auth == null || effTenant() == communityId))
        || isTenantMember(communityId);
      allow write: if isLoggedIn() && (isDemoWs(communityId) || isTenantMember(communityId));
    }

    // Purohit One â independent purohit identity + verification + marketplace

    // --- purohits/{purohitId}: public read (marketplace); owner + admin write.
    match /purohits/{purohitId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('verificationTier', '') == 'REGISTERED'
        && request.resource.data.get('ratingAggregate', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0
        && request.resource.data.get('completedGigs', 0) == 0;
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('id', '') == resource.data.get('id', '')
          && request.resource.data.get('verificationTier', '') == resource.data.get('verificationTier', ''))
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingAggregate', 'ratingCount', 'completedGigs', 'updatedAt'])
          && request.resource.data.get('ratingAggregate', 0) >= 0
          && request.resource.data.get('ratingAggregate', 0) <= 5
          && request.resource.data.get('ratingCount', 0) >= 0
          && request.resource.data.get('ratingCount', 0) <= 100000
          && request.resource.data.get('completedGigs', 0) >= 0
          && request.resource.data.get('completedGigs', 0) <= 100000)
        // PHASE 3 â Pratham Seva counter advancement (order-anchored).
        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;
    }

    // --- purohits availability: public read; owner write.
    match /purohitAvailability/{purohitId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn()
          && exists(/databases/$(database)/documents/purohits/$(purohitId))
          && get(/databases/$(database)/documents/purohits/$(purohitId)).data.get('uid', '') == request.auth.uid);
    }

    // Solo Sanatani â Universal Sanatani ID spine (sanataniProfiles/{uid})
    match /sanataniProfiles/{uid} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uid == request.auth.uid
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('verificationTier', '') == 'REGISTERED'
        && request.resource.data.get('roles', {}) == {};
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uid == request.auth.uid
          && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('id', '') == resource.data.get('id', '')
          && request.resource.data.get('verificationTier', '') == resource.data.get('verificationTier', '')
          && (
            request.resource.data.get('roles', {}) == resource.data.get('roles', {})
            || validPurohitAttach()
            || validJyotishAttach()
          ));
      allow delete: if false;

      // A purohitId may be attached only when the referenced `purohits`
      function validPurohitAttach() {
        let newRoles = request.resource.data.get('roles', {});
        let oldRoles = resource.data.get('roles', {});
        let newPid = newRoles.get('purohitId', '');
        return newPid != ''
          && newPid != oldRoles.get('purohitId', '')
          && newRoles.diff(oldRoles).affectedKeys().hasOnly(['purohitId'])
          && exists(/databases/$(database)/documents/purohits/$(newPid))
          && get(/databases/$(database)/documents/purohits/$(newPid)).data.get('uid', '') == request.auth.uid;
      }

      // A jyotishId may be attached only when the referenced
      function validJyotishAttach() {
        let newRoles = request.resource.data.get('roles', {});
        let oldRoles = resource.data.get('roles', {});
        let newJid = newRoles.get('jyotishId', '');
        return newJid != ''
          && newJid != oldRoles.get('jyotishId', '')
          && newRoles.diff(oldRoles).affectedKeys().hasOnly(['jyotishId'])
          && exists(/databases/$(database)/documents/jyotishProfiles/$(newJid))
          && get(/databases/$(database)/documents/jyotishProfiles/$(newJid)).data.get('uid', '') == request.auth.uid;
      }
    }

    // Solo Sanatani â private profile fields (gotra and future sensitive
    match /sanataniProfiles/{uid}/private/self {
      allow read, write: if isLoggedIn() && uid == request.auth.uid;
    }

// ------------------------- Section A: program config ----------------------
    match /prathamSevaConfig/{configId} {
      allow read: if isLoggedIn();
      allow create, update: if isSuperAdmin()
        && request.resource.data.get('defaultFreeSevas', -1) >= 0
        && request.resource.data.get('defaultFreeSevas', 51) <= 50;
      allow delete: if false;
    }

// ----------------- Section B: purohitApplications (REPLACES) --------------
    match /purohitApplications/{appId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('purohitId', '') != ''
        && request.resource.data.get('status', '') == 'PENDING'
        && request.resource.data.get('tier', '') == ''
        && request.resource.data.get('freeSevasRemaining', 0) == 0
        && request.resource.data.get('boostUntil', '') == ''
        && request.resource.data.get('reviewedBy', '') == ''
        && request.resource.data.get('reviewNote', '') == '';
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // --- gigs: public read (marketplace); signed-in devotees post;
    function isGigParty() {
      return isLoggedIn()
        && (resource.data.get('devoteeUid', '') == request.auth.uid
          || resource.data.get('assignedPurohitUid', '') == request.auth.uid);
    }
    function gigTransitionOk() {
      let from = resource.data.get('status', '');
      let to = request.resource.data.get('status', '');
      return (from == 'OPEN' && to in ['ASSIGNED', 'CANCELLED'])
        || (from == 'ASSIGNED' && to in ['IN_PROGRESS', 'CANCELLED'])
        || (from == 'IN_PROGRESS' && to in ['COMPLETED'])
        || (from == 'COMPLETED' && to in ['DAKSHINA_RELEASED'])
        || (from == to);
    }
    function gigImmutableOk() {
      return request.resource.data.get('devoteeUid', '') == resource.data.get('devoteeUid', '')
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && request.resource.data.get('referredBy', {}) == resource.data.get('referredBy', {});
    }
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('devoteeUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'OPEN'
        && gigReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && gigTransitionOk() && gigImmutableOk()
          && (isGigParty()
            // Accept flow: any verified-path purohit may claim an OPEN gig;
            || (resource.data.get('status', '') == 'OPEN'
              && request.resource.data.get('status', '') == 'ASSIGNED'
              && request.resource.data.get('assignedPurohitUid', '') == request.auth.uid)));
      allow delete: if false;
    }

    // --- endorsements: public read; Trustees (any real org) may endorse.
    match /endorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(['Trustee', 'TRUSTEE']))
        && request.resource.data.get('orgId', '') != ''
        && request.resource.data.get('orgName', '') != ''
        && request.resource.data.get('purohitId', '') != ''
        && request.resource.data.get('text', '') != '';
      allow update, delete: if isSuperAdmin();
    }

    // --- reviews: public read; deterministic ids (one rating per party per
    function reviewPartyOk() {
      let gigPath = /databases/$(database)/documents/gigs/$(request.resource.data.get('gigId', ''));
      return exists(gigPath)
        && get(gigPath).data.get('status', '') in ['COMPLETED', 'DAKSHINA_RELEASED']
        && (get(gigPath).data.get('devoteeUid', '') == request.auth.uid
          || get(gigPath).data.get('assignedPurohitUid', '') == request.auth.uid);
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('reviewerUid', '') == request.auth.uid
        && request.resource.data.get('gigId', '') != ''
        && request.resource.data.get('rating', 0) >= 1
        && request.resource.data.get('rating', 0) <= 5
        && reviewPartyOk();
      allow update, delete: if false;
    }

    // --- purohitInvites: org â purohit staff invites. Readable by the invited
    match /purohitInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (resource.data.get('purohitUid', '') == request.auth.uid
            || roleIn(['Trustee', 'TRUSTEE'])));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(['Trustee', 'TRUSTEE'])
          && request.resource.data.get('orgId', '') != ''
          && request.resource.data.get('orgName', '') != ''
          && request.resource.data.get('purohitId', '') != ''
          && request.resource.data.get('purohitUid', '') != ''
          && request.resource.data.get('status', '') == 'PENDING');
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resource.data.get('purohitUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.get('status', '') in ['ACCEPTED', 'DECLINED']);
      allow delete: if false;
    }

    // Jyotish One â independent jyotishi identity + verification +

    // --- jyotishProfiles/{jyotishId}: public read (marketplace); owner +
    match /jyotishProfiles/{jyotishId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('verificationTier', '') == 'REGISTERED'
        && request.resource.data.get('ratingAggregate', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0
        && request.resource.data.get('completedConsultations', 0) == 0;
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('id', '') == resource.data.get('id', '')
          && request.resource.data.get('verificationTier', '') == resource.data.get('verificationTier', ''))
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingAggregate', 'ratingCount', 'completedConsultations', 'updatedAt'])
          && request.resource.data.get('ratingAggregate', 0) >= 0
          && request.resource.data.get('ratingAggregate', 0) <= 5
          && request.resource.data.get('ratingCount', 0) >= 0
          && request.resource.data.get('ratingCount', 0) <= 100000
          && request.resource.data.get('completedConsultations', 0) >= 0
          && request.resource.data.get('completedConsultations', 0) <= 100000)
        // PHASE 3 â Pratham Seva counter advancement (order-anchored).
        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;
    }

    // --- jyotishAvailability: public read; owner write.
    match /jyotishAvailability/{jyotishId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn()
          && exists(/databases/$(database)/documents/jyotishProfiles/$(jyotishId))
          && get(/databases/$(database)/documents/jyotishProfiles/$(jyotishId)).data.get('uid', '') == request.auth.uid);
    }

// ----------------- Section C: jyotishApplications (REPLACES) --------------
    match /jyotishApplications/{appId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('jyotishId', '') != ''
        && request.resource.data.get('status', '') == 'PENDING'
        && request.resource.data.get('tier', '') == ''
        && request.resource.data.get('freeSevasRemaining', 0) == 0
        && request.resource.data.get('boostUntil', '') == ''
        && request.resource.data.get('reviewedBy', '') == ''
        && request.resource.data.get('reviewNote', '') == '';
      allow delete: if false;
      allow update: if isSuperAdmin();
    }

    // --- jyotishConsultations: public read (marketplace); signed-in
    function isConsultationParty() {
      return isLoggedIn()
        && (resource.data.get('devoteeUid', '') == request.auth.uid
          || resource.data.get('assignedJyotishUid', '') == request.auth.uid);
    }
    function consultationTransitionOk() {
      let from = resource.data.get('status', '');
      let to = request.resource.data.get('status', '');
      return (from == 'OPEN' && to in ['ASSIGNED', 'CANCELLED'])
        || (from == 'ASSIGNED' && to in ['IN_PROGRESS', 'CANCELLED'])
        || (from == 'IN_PROGRESS' && to in ['COMPLETED'])
        || (from == 'COMPLETED' && to in ['DAKSHINA_RELEASED'])
        || (from == to);
    }
    function consultationImmutableOk() {
      return request.resource.data.get('devoteeUid', '') == resource.data.get('devoteeUid', '')
        && request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && request.resource.data.get('referredBy', {}) == resource.data.get('referredBy', {});
    }
    match /jyotishConsultations/{consultationId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('devoteeUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'OPEN'
        && consultationReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && consultationTransitionOk() && consultationImmutableOk()
          && (isConsultationParty()
            // Accept flow: any jyotishi may claim an OPEN consultation;
            || (resource.data.get('status', '') == 'OPEN'
              && request.resource.data.get('status', '') == 'ASSIGNED'
              && request.resource.data.get('assignedJyotishUid', '') == request.auth.uid)));
      allow delete: if false;

      // --- messages subcollection: only the two parties read/write.
      match /messages/{messageId} {
        function isMsgParty() {
          let cpath = /databases/$(database)/documents/jyotishConsultations/$(consultationId);
          return isLoggedIn()
            && exists(cpath)
            && (get(cpath).data.get('devoteeUid', '') == request.auth.uid
              || get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid);
        }
        allow read: if isMsgParty() || isSuperAdmin();
        allow create: if isMsgParty()
          && request.resource.data.get('senderUid', '') == request.auth.uid
          && request.resource.data.get('text', '') != '';
        allow update, delete: if false;
      }

      // --- remedies subcollection (Seva Pro Phase 4): the assigned jyotish
      match /remedies/{remedyId} {
        function isRemedyParty() {
          return (isLoggedIn()
            && exists(/databases/$(database)/documents/jyotishConsultations/$(consultationId))
            && (get(/databases/$(database)/documents/jyotishConsultations/$(consultationId)).data.get('devoteeUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/jyotishConsultations/$(consultationId)).data.get('assignedJyotishUid', '') == request.auth.uid));
        }
        allow read: if isRemedyParty() || isSuperAdmin();
        allow create: if isRemedyParty()
          && request.resource.data.get('jyotishUid', '') == request.auth.uid
          && request.resource.data.get('consultationId', '') == consultationId
          && request.resource.data.get('devoteeUid', '') == get(/databases/$(database)/documents/jyotishConsultations/$(consultationId)).data.get('devoteeUid', '')
          && request.resource.data.get('ritualName', '') != ''
          && request.resource.data.get('remedyText', '') != ''
          && request.resource.data.get('status', '') == 'PENDING';
        allow update: if isSuperAdmin()
          || (isRemedyParty()
            && resource.data.get('status', '') == 'PENDING'
            && request.resource.data.get('status', '') in ['BOOKED', 'DISMISSED']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedGigId']));
        allow delete: if false;
      }
    }

    // --- jyotishEndorsements: public read; Trustees (any real org) endorse.
    match /jyotishEndorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(['Trustee', 'TRUSTEE']))
        && request.resource.data.get('orgId', '') != ''
        && request.resource.data.get('orgName', '') != ''
        && request.resource.data.get('jyotishId', '') != ''
        && request.resource.data.get('text', '') != '';
      allow update, delete: if isSuperAdmin();
    }

    // --- jyotishReviews: public read; deterministic ids (one rating per
    function consultationReviewPartyOk() {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('consultationId', ''));
      return exists(cpath)
        && get(cpath).data.get('status', '') in ['COMPLETED', 'DAKSHINA_RELEASED']
        && (get(cpath).data.get('devoteeUid', '') == request.auth.uid
          || get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid);
    }
    match /jyotishReviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('reviewerUid', '') == request.auth.uid
        && request.resource.data.get('consultationId', '') != ''
        && request.resource.data.get('rating', 0) >= 1
        && request.resource.data.get('rating', 0) <= 5
        && consultationReviewPartyOk();
      allow update, delete: if false;
    }

    // --- jyotishInvites: org â jyotishi staff invites. Readable by the
    match /jyotishInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (resource.data.get('jyotishUid', '') == request.auth.uid
            || roleIn(['Trustee', 'TRUSTEE'])));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(['Trustee', 'TRUSTEE'])
          && request.resource.data.get('orgId', '') != ''
          && request.resource.data.get('orgName', '') != ''
          && request.resource.data.get('jyotishId', '') != ''
          && request.resource.data.get('jyotishUid', '') != ''
          && request.resource.data.get('status', '') == 'PENDING');
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resource.data.get('jyotishUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.get('status', '') in ['ACCEPTED', 'DECLINED']);
      allow delete: if false;
    }


    // ================= Seva Pro Phase 4 â referral pipeline =================

    // --- referredBy anchoring on gig create (jyotish -> purohit) ---
    function remedyAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('referredBy', {}).get('consultationId', ''))/remedies/$(request.resource.data.get('referredBy', {}).get('remedyId', '')))
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('referredBy', {}).get('consultationId', ''))/remedies/$(request.resource.data.get('referredBy', {}).get('remedyId', ''))).data.get('devoteeUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('referredBy', {}).get('consultationId', ''))/remedies/$(request.resource.data.get('referredBy', {}).get('remedyId', ''))).data.get('jyotishUid', '') == request.resource.data.get('referredBy', {}).get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('referredBy', {}).get('consultationId', ''))/remedies/$(request.resource.data.get('referredBy', {}).get('remedyId', ''))).data.get('status', '') == 'PENDING';
    }
    function gigReferralAnchorOk() {
      return !('referredBy' in request.resource.data)
        || (request.resource.data.get('referredBy', {}).get('direction', '') == 'jyotish-to-purohit'
          && request.resource.data.get('referredBy', {}).get('referrerUid', '') != ''
          && request.resource.data.get('referredBy', {}).get('remedyId', '') != ''
          && request.resource.data.get('referredBy', {}).get('consultationId', '') != ''
          && request.resource.data.get('referredBy', {}).get('ritualName', '') != ''
          && remedyAnchorOk());
    }

    // --- referredBy anchoring on consultation create (purohit -> jyotish) ---
    function referralAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishReferrals/$(request.resource.data.get('referredBy', {}).get('referralId', '')))
        && get(/databases/$(database)/documents/jyotishReferrals/$(request.resource.data.get('referredBy', {}).get('referralId', ''))).data.get('fromKind', '') == 'purohit'
        && get(/databases/$(database)/documents/jyotishReferrals/$(request.resource.data.get('referredBy', {}).get('referralId', ''))).data.get('toKind', '') == 'jyotish'
        && get(/databases/$(database)/documents/jyotishReferrals/$(request.resource.data.get('referredBy', {}).get('referralId', ''))).data.get('fromUid', '') == request.resource.data.get('referredBy', {}).get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishReferrals/$(request.resource.data.get('referredBy', {}).get('referralId', ''))).data.get('devoteeUid', '') == request.auth.uid;
    }
    function consultationReferralAnchorOk() {
      return !('referredBy' in request.resource.data)
        || (request.resource.data.get('referredBy', {}).get('direction', '') == 'purohit-to-jyotish'
          && request.resource.data.get('referredBy', {}).get('referrerUid', '') != ''
          && request.resource.data.get('referredBy', {}).get('referralId', '') != ''
          && referralAnchorOk());
    }

    // --- referralAttributions/{orderId} ---
    function attributionGigOk() {
      return request.resource.data.get('orderType', '') == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', '')))
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('referrerUid', '') == request.resource.data.get('referrerUid', '')
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('direction', '') == request.resource.data.get('direction', '');
    }
    function attributionConsultationOk() {
      return request.resource.data.get('orderType', '') == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', '')))
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('referrerUid', '') == request.resource.data.get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('direction', '') == request.resource.data.get('direction', '');
    }
    function attributionOrderOk() {
      return attributionGigOk() || attributionConsultationOk();
    }
    function attributionTerminalOk() {
      return (request.resource.data.get('orderType', '') == 'gig'
          && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('status', '') == 'DAKSHINA_RELEASED')
        || (request.resource.data.get('orderType', '') == 'consultation'
          && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('status', '') == 'DAKSHINA_RELEASED');
    }
    // Only an order party may move the attribution (prevents griefing the
    function attributionPartyOk() {
      return (request.resource.data.get('orderType', '') == 'gig'
          && (get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('assignedPurohitUid', '') == request.auth.uid))
        || (request.resource.data.get('orderType', '') == 'consultation'
          && (get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('assignedJyotishUid', '') == request.auth.uid));
    }

    // --- referralCredits/rc_{orderId} ---
    function creditGigOk() {
      return request.resource.data.get('orderType', '') == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', '')))
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('status', '') == 'DAKSHINA_RELEASED'
        && (get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('assignedPurohitUid', '') == request.auth.uid)
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('referrerUid', '') == request.resource.data.get('referrerUid', '')
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('direction', '') == request.resource.data.get('direction', '');
    }
    function creditConsultationOk() {
      return request.resource.data.get('orderType', '') == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', '')))
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('status', '') == 'DAKSHINA_RELEASED'
        && (get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('assignedJyotishUid', '') == request.auth.uid)
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('referrerUid', '') == request.resource.data.get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('referredBy', {}).get('direction', '') == request.resource.data.get('direction', '');
    }
    function creditOrderOk() {
      return creditGigOk() || creditConsultationOk();
    }
    function gigSevaValue() {
      return get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('dakshinaAgreed', 0) > 0
        ? get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('dakshinaAgreed', 0)
        : get(/databases/$(database)/documents/gigs/$(request.resource.data.get('orderId', ''))).data.get('budgetMax', 0);
    }
    function consultationSevaValue() {
      return get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('dakshinaAgreed', 0) > 0
        ? get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('dakshinaAgreed', 0)
        : get(/databases/$(database)/documents/jyotishConsultations/$(request.resource.data.get('orderId', ''))).data.get('budgetMax', 0);
    }
    function creditSevaValueOk() {
      return (request.resource.data.get('orderType', '') == 'gig'
          && request.resource.data.get('sevaValue', -1) == gigSevaValue())
        || (request.resource.data.get('orderType', '') == 'consultation'
          && request.resource.data.get('sevaValue', -1) == consultationSevaValue());
    }
    function creditRoundingOk() {
      return request.resource.data.get('creditAmount', 0) * 10000 >= request.resource.data.get('sevaValue', 0) * request.resource.data.get('referralBps', 0) - 5000
        && request.resource.data.get('creditAmount', 0) * 10000 <= request.resource.data.get('sevaValue', 0) * request.resource.data.get('referralBps', 0) + 5000;
    }
    function creditMathOk() {
      return request.resource.data.get('referralBps', 0) > 0
        && request.resource.data.get('referralBps', 0) <= 5000
        && request.resource.data.get('creditAmount', 0) > 0
        && request.resource.data.get('creditAmount', 0) <= request.resource.data.get('platformCommission', 0)
        && request.resource.data.get('platformCommission', 0) <= request.resource.data.get('sevaValue', 0)
        && creditSevaValueOk()
        && creditRoundingOk();
    }
    function creditOrderParty() {
      return (resource.data.get('orderType', '') == 'gig'
          && (get(/databases/$(database)/documents/gigs/$(resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/gigs/$(resource.data.get('orderId', ''))).data.get('assignedPurohitUid', '') == request.auth.uid))
        || (resource.data.get('orderType', '') == 'consultation'
          && (get(/databases/$(database)/documents/jyotishConsultations/$(resource.data.get('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/jyotishConsultations/$(resource.data.get('orderId', ''))).data.get('assignedJyotishUid', '') == request.auth.uid));
    }

    // --- wallet credit anchored to a validated referral credit doc ---
    function referralCreditDocOk(uid) {
      return request.resource.data.get('lastReferralCreditId', '') != ''
        && request.resource.data.get('lastReferralCreditId', '') != resource.data.get('lastReferralCreditId', '')
        && exists(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', '')))
        && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('referrerUid', '') == uid
        && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('status', '') == 'SETTLED'
        && request.resource.data.get('balance', -1) == resource.data.get('balance', 0) + get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('creditAmount', 0)
        && request.resource.data.get('totalReceived', -1) == resource.data.get('totalReceived', 0) + get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('creditAmount', 0)
        && request.resource.data.get('totalToppedUp', -1) == resource.data.get('totalToppedUp', 0)
        && request.resource.data.get('totalSpent', -1) == resource.data.get('totalSpent', 0)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastReferralCreditId', 'currency', 'uid']);
    }
    function referralWalletCreditOk(uid) {
      return referralCreditDocOk(uid);
    }
    function referralWalletCreditCreateOk(uid) {
      return request.resource.data.get('lastReferralCreditId', '') != ''
        && request.resource.data.get('uid', '') == uid
        && exists(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', '')))
        && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('referrerUid', '') == uid
        && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('status', '') == 'SETTLED'
        && request.resource.data.get('balance', -1) == get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('creditAmount', 0)
        && request.resource.data.get('totalReceived', -1) == get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('lastReferralCreditId', ''))).data.get('creditAmount', 0)
        && request.resource.data.get('totalToppedUp', -1) == 0
        && request.resource.data.get('totalSpent', -1) == 0;
    }
    // =============== end Seva Pro Phase 4 helpers ===============


    // --- jyotishReferrals: cross-referrals jyotish â purohit. Public read
    match /jyotishReferrals/{referralId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('toRoleId', '') != ''
        && request.resource.data.get('toTier', '') != ''
        && request.resource.data.get('toTier', '') != 'REGISTERED'
        && request.resource.data.get('reason', '') != '';
      allow update, delete: if isSuperAdmin();
    }


    // --- referralAttributions/{orderId}: one row per referred order.
    match /referralAttributions/{orderId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (resource.data.get('devoteeUid', '') == request.auth.uid
            || resource.data.get('referrerUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && request.resource.data.get('orderId', '') == orderId
        && request.resource.data.get('devoteeUid', '') == request.auth.uid
        && request.resource.data.get('orderType', '') in ['gig', 'consultation']
        && request.resource.data.get('status', '') == 'OPEN'
        && request.resource.data.get('referrerUid', '') != ''
        && attributionOrderOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resource.data.get('status', '') == 'OPEN'
          && request.resource.data.get('status', '') in ['SETTLED', 'SKIPPED_NO_VALUE']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settledAt', 'creditId'])
          && attributionTerminalOk()
          && attributionPartyOk());
      allow delete: if false;
    }

    // --- referralCredits/{creditId}: settled guidance credits.
    match /referralCredits/{creditId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('referrerUid', '') == request.auth.uid)
        || (isLoggedIn() && creditOrderParty());
      allow create: if isLoggedIn()
        && creditId == 'rc_' + request.resource.data.get('orderId', '')
        && request.resource.data.get('orderId', '') != ''
        && request.resource.data.get('status', '') == 'SETTLED'
        && request.resource.data.get('direction', '') in ['jyotish-to-purohit', 'purohit-to-jyotish']
        && creditOrderOk()
        && creditMathOk();
      allow update: if isSuperAdmin()
        && resource.data.get('status', '') == 'SETTLED'
        && request.resource.data.get('status', '') == 'REVERSED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedAt', 'reversalReason']);
      allow delete: if false;
    }


    // NOTE: no catch-all allow â default deny.

    // Sangam â the Sanatani social layer (personal view)

    // Badge validation: devotee/org authors carry no tier; purohit/jyotish
    function sangamAuthorTierOk() {
      let kind = request.resource.data.get('authorKind', '');
      let tier = request.resource.data.get('authorTier', '');
      let roleId = request.resource.data.get('authorRoleId', '');
      return (kind == 'devotee' && (tier == '' || tier == null))
        || (kind == 'org' && (tier == '' || tier == null))
        || (kind == 'purohit' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/purohits/$(roleId))
          && get(/databases/$(database)/documents/purohits/$(roleId)).data.get('uid', '') == request.auth.uid
          && tier == get(/databases/$(database)/documents/purohits/$(roleId)).data.get('verificationTier', ''))
        || (kind == 'jyotish' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/jyotishProfiles/$(roleId))
          && get(/databases/$(database)/documents/jyotishProfiles/$(roleId)).data.get('uid', '') == request.auth.uid
          && tier == get(/databases/$(database)/documents/jyotishProfiles/$(roleId)).data.get('verificationTier', ''));
    }

    // Seva Bazar service_card: the editorial bar, enforced server-side.
    // Only providers (purohit/jyotish) may post them; the devotional text
    // (≥30 chars) and honest dakshina are non-negotiable. Cheap-signal
    // language is a client + moderation concern; the rules hold the shape.
    // NOTE: the 1-card/72h/provider spam line is enforced client-side in the
    // composer; true server-side rate limiting needs a Cloud Function
    // (Blaze-gated — unavailable on the $0 plan).
    function serviceCardOk() {
      let kind = request.resource.data.get('kind', '');
      let authorKind = request.resource.data.get('authorKind', '');
      let card = request.resource.data.get('serviceCard', {});
      // NOTE: Firestore Rules functions have no imperative `if` — the
      // early-return is expressed as a ternary/or-chain instead.
      return kind != 'service_card'
        || ((authorKind == 'purohit' || authorKind == 'jyotish')
          && card != null
          && card.get('devotionalText', '').size() >= 30
          && card.get('serviceLine', '') != ''
          && card.get('dakshina', 0) > 0
          && card.get('providerUid', '') == request.auth.uid
          && card.get('providerTier', '') in ['REGISTERED', 'VERIFIED', 'TRUSTED']);
    }

    // Official page posts: only a trustee of that org may post as the page.
    function sangamPagePostOk() {
      let official = request.resource.data.get('isOfficialPagePost', false);
      let orgId = request.resource.data.get('orgId', '');
      return official == false || official == null
        || (orgId != '' && orgId != null && isOrgTrustee(orgId));
    }

    // --- sangamPosts: public read (the community feed); author create;
    // service_card (Seva Bazar): provider-only, editorial bar enforced.
    match /sangamPosts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorRoleId', 'authorTier',
           'orgId', 'orgName', 'isOfficialPagePost', 'kind', 'text', 'imageUrl', 'shlokaRef',
           'seva', 'serviceCard', 'eventRef', 'sharedFrom', 'createdAt', 'ashirvadCount', 'commentCount',
           'shareCount', 'visibility', 'status',
           // Phase 3+4: gratitude (providerUid/providerName), festival moments (festival),
           // consultation answers (anonymized)
           'providerUid', 'providerName', 'festival', 'anonymized'])
        && request.resource.data.get('ashirvadCount', -1) == 0
        && request.resource.data.get('commentCount', -1) == 0
        && request.resource.data.get('shareCount', -1) == 0
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('visibility', '') == 'public'
        && request.resource.data.get('text', '') != ''
        && sangamAuthorTierOk()
        && sangamPagePostOk()
        && serviceCardOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('authorUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrl', 'updatedAt'])
          && request.resource.data.get('authorUid', '') == resource.data.get('authorUid', ''))
        // Step 4 (comment multi-device sync): any signed-in user may nudge
        // commentCount by exactly ±1 (never below 0) and touch nothing else.
        // This lets commenters keep the count honest on posts they don't own.
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.get('commentCount', -1) >= 0
          && (request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1
              || request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) - 1))
        // Audit Fix #1: same ±1 pattern for ashirvadCount and shareCount —
        // any signed-in user may nudge exactly ±1 (never below 0), nothing else.
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ashirvadCount'])
          && request.resource.data.get('ashirvadCount', -1) >= 0
          && (request.resource.data.get('ashirvadCount', 0) == resource.data.get('ashirvadCount', 0) + 1
              || request.resource.data.get('ashirvadCount', 0) == resource.data.get('ashirvadCount', 0) - 1))
        || (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
          && request.resource.data.get('shareCount', -1) >= 0
          && (request.resource.data.get('shareCount', 0) == resource.data.get('shareCount', 0) + 1
              || request.resource.data.get('shareCount', 0) == resource.data.get('shareCount', 0) - 1));
      allow delete: if isSuperAdmin();
    }

    // --- sangamPosts/{postId}/ashirvad/{uid}: one Ashirvad per user (toggle).
    match /sangamPosts/{postId}/ashirvad/{uid} {
      allow read: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // --- sangamPosts/{postId}/volunteers/{uid}: seva volunteering (toggle).
    match /sangamPosts/{postId}/volunteers/{uid} {
      allow read: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // --- sangamComments: public read; signed-in create (author pinned,
    match /sangamComments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.get('postId', '') != ''
        && request.resource.data.keys().hasOnly(
          ['postId', 'authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorTier', 'text', 'createdAt'])
        && request.resource.data.get('text', '') != ''
        && sangamAuthorTierOk();
      allow update, delete: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('authorUid', '') == request.auth.uid);
    }

    // --- sangamCircles: public read; signed-in create; creator/admin update.
    match /sangamCircles/{circleId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('creatorUid', '') == request.auth.uid
        && request.resource.data.get('name', '') != ''
        && request.resource.data.keys().hasOnly(
          ['name', 'topic', 'description', 'creatorUid', 'creatorName', 'memberCount', 'createdAt']);
      allow update: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('creatorUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['name', 'topic', 'description', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // --- sangamCircles/{circleId}/members/{uid}: join/leave (toggle).
    match /sangamCircles/{circleId}/members/{uid} {
      allow read: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // --- sangamEvents: public read; signed-in create (org events need
    match /sangamEvents/{eventId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('creatorUid', '') == request.auth.uid
        && request.resource.data.get('title', '') != ''
        && (request.resource.data.get('orgId', '') == ''
          || request.resource.data.get('orgId', null) == null
          || isOrgTrustee(request.resource.data.get('orgId', '')))
        && request.resource.data.keys().hasOnly(
          ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'orgId', 'orgName',
           'isOfficial', 'creatorUid', 'creatorName', 'rsvpCount', 'createdAt']);
      allow update: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('creatorUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'updatedAt']));
      // QUEUED FIX #1 (flagged): creators may delete their own events so
      // trustees can "unshare" an org event bridged to Sangam.
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('creatorUid', '') == request.auth.uid);
    }

    // --- sangamEvents/{eventId}/rsvps/{uid}: RSVP (toggle).
    match /sangamEvents/{eventId}/rsvps/{uid} {
      allow read: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // --- sangamFollows/{followerUid}_{targetType}_{targetId}: public read;
    match /sangamFollows/{followId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('followerUid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['followerUid', 'targetType', 'targetId', 'targetName', 'createdAt']);
      allow update: if false;
      allow delete: if isLoggedIn() && resource.data.get('followerUid', '') == request.auth.uid;
    }

    // --- sangamReports: reporter create; reporter+admin read; admin triage.
    match /sangamReports/{reportId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('reporterUid', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('reporterUid', '') == request.auth.uid
        && request.resource.data.get('targetId', '') != ''
        && request.resource.data.keys().hasOnly(
          ['reporterUid', 'reporterName', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.get('status', '') == 'open';
      allow update, delete: if isSuperAdmin();
    }

    // Membership sprint â Organisation Membership System

    // --- orgGlance/{workspaceId}: per-org glance summaries for the Solo
    match /orgGlance/{workspaceId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId)
          && request.resource.data.get('workspaceId', '') == workspaceId);
      allow delete: if false;
    }

    // --- orgPages/{orgId}: public read (discovery + public org page).
    match /orgPages/{orgId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (
        isOrgTrustee(orgId)
        && request.resource.data.keys().hasOnly(
          ['orgId', 'name', 'type', 'city', 'state', 'country', 'about',
           'tagline', 'logoUrl', 'coverUrl', 'publicSlug', 'addressLine',
           'pincode', 'phone', 'website', 'darshanTimings', 'galleryUrls',
           'upcomingEvents', 'autoShareEvents', 'registrationNo', 'eightyGRegistered',
           'eightyGURN', 'twelveARegistered', 'verified', 'pinnedAarti',
           'aartiSchedules', 'updatedAt'])
        && request.resource.data.get('orgId', '') == orgId
      );
      allow delete: if isSuperAdmin();
    }

    // --- orgPages/{orgId}/sevaCards/{cardId}: tangible giving cards (Phase 2).
    // Public read (giving cards are public information); trustee write.
    // Devotees tap a card → Phase 1's express dana sheet opens prefilled.
    match /orgPages/{orgId}/sevaCards/{cardId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        || (isOrgTrustee(orgId)
          && request.resource.data.keys().hasOnly([
            'title', 'amount', 'currency', 'outcomeCopy', 'goalTarget',
            'raisedTotal', 'active', 'sortOrder',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && request.resource.data.get('title', '') != ''
          && request.resource.data.get('amount', 0) is number
          && request.resource.data.get('amount', 0) > 0);
      allow delete: if isSuperAdmin() || isOrgTrustee(orgId);
    }

    // --- familyLinks/{uid}: family safety circles (crisis module). ---
    // Each user's doc holds linkedUids, consents, incomingInvites, outgoingInvites.
    // Read: own doc, or a linked member's doc (consent-gated SOS history view).
    //   A denied read means "no consent" — callers treat it as an empty list.
    // Write own doc: top-level fields pinned. Cross-user writes are parties-only:
    //   sending an invite writes incomingInvites.{ownUid} (pending) on the
    //   target's doc; accept/decline/revoke touch only self-scoped keys and are
    //   anchored to a pending invite or an existing link, so a stranger can
    //   never forge a family link to read someone's SOS history.
    // Only the writer's own key may differ inside one of the link maps.
    function familyLinkMapOnlySelfChanged(beforeMap, afterMap) {
      return afterMap.diff(beforeMap).affectedKeys().hasOnly([request.auth.uid]);
    }
    // A well-formed pending invite FROM the writer (no one can invite as another).
    function familyLinkInviteContentOk(invite) {
      return invite != null
        && invite.get('fromUid', '') == request.auth.uid
        && invite.get('status', '') == 'pending'
        && invite.keys().hasOnly(
          ['fromUid', 'fromName', 'fromPhoto', 'fromSanId', 'status', 'createdAt']);
    }
    // Cross-user update on someone else's familyLinks doc. Three legitimate
    // shapes: (1) send/resend my pending invite, (2) accept their invite to me
    // (gain link + consent), (3) decline/revoke (remove my keys). Anything else
    // — including granting myself a link without their invite — is denied.
    function familyLinkCrossUpdateOk() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let topChanged = after.diff(before).affectedKeys();
      let scoped = topChanged.hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites'])
        && familyLinkMapOnlySelfChanged(
          before.get('consents', {}), after.get('consents', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('incomingInvites', {}), after.get('incomingInvites', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('outgoingInvites', {}), after.get('outgoingInvites', {}))
        && after.get('linkedUids', []).toSet()
          .difference(before.get('linkedUids', []).toSet()).hasOnly([me])
        && before.get('linkedUids', []).toSet()
          .difference(after.get('linkedUids', []).toSet()).hasOnly([me]);
      // (1) send/resend: only my incoming invite changes, and it is well-formed.
      let onlyInvite = topChanged.hasOnly(['incomingInvites'])
        && familyLinkInviteContentOk(after.get('incomingInvites', {}).get(me, null));
      // (2) accept: THEY invited me (pending outgoing invite on their doc).
      let accept = before.get('outgoingInvites', {}).get(me, {}).get('status', '') == 'pending'
        && (me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, {}).get('granted', false) == true;
      // (3) decline/revoke: I remove my keys, anchored to their pending invite
      // or to an existing link. Never grants anything.
      let withdraw = (before.get('outgoingInvites', {}).get(me, null) != null
          || (me in before.get('linkedUids', [])))
        && !(me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, null) == null;
      return scoped && (onlyInvite || accept || withdraw);
    }
    match /familyLinks/{docUid} {
      allow read: if isLoggedIn()
        && (request.auth.uid == docUid
          || (resource != null && request.auth.uid in resource.data.get('linkedUids', [])));
      allow create, update: if isLoggedIn() && request.auth.uid == docUid
        && request.resource.data.keys().hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites']);
      allow delete: if isLoggedIn() && request.auth.uid == docUid;
      // Invite send → the TARGET's doc (create on first invite).
      allow create: if isLoggedIn() && request.auth.uid != docUid
        && request.resource.data.keys().hasOnly(['incomingInvites'])
        && request.resource.data.get('incomingInvites', {}).keys().hasOnly([request.auth.uid])
        && familyLinkInviteContentOk(
          request.resource.data.get('incomingInvites', {}).get(request.auth.uid, null));
      // Invite resend / accept / decline / revoke → the other party's doc.
      allow update: if isLoggedIn() && request.auth.uid != docUid
        && familyLinkCrossUpdateOk();
    }

    // --- qrCodes/{region}: owner-uploaded regional payment QRs. ---
    // GodMode → Geo Payments → QR Codes. Public read: payers must see the QR
    // at checkout (paymentMethods.ts). Owner-only write/delete, content pinned
    // to image data URLs so the collection can never become a file dump.
    match /qrCodes/{region} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.get('region', '') == region
        && request.resource.data.keys().hasOnly(
          ['imageData', 'region', 'uploadedAt', 'uploadedBy'])
        && request.resource.data.get('imageData', '').matches('^data:image/(png|jpeg|webp);base64,');
      allow delete: if isOwner();
    }

    // --- vdaAliases/{alias}: speakable devotee-ID claims (Phase 2).
    // Doc id IS the normalized alias (`aarav@kashi`); first-write-wins.
    // SAN-XXXXXX stays canonical — this is the friendly layer on top.
    match /vdaAliases/{aliasId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('alias', '') == aliasId
        && request.resource.data.keys().hasOnly(['alias', 'uid', 'sanId', 'createdAt']);
      // Releasing = delete; only the owning uid may release. No updates ever.
      allow update: if false;
      allow delete: if isLoggedIn()
        && resource.data.get('uid', '') == request.auth.uid;
    }

    // --- followers/{orgId}/users/{uid}: public read (counts); owner write.
    match /followers/{orgId}/users/{uid} {
      allow read: if true;
      allow create: if isLoggedIn() && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid;
      allow update: if false;
      allow delete: if isLoggedIn() && request.auth.uid == uid;
    }

    // --- joinRequests/{orgId}_{uid}: deterministic id = one pending per
    match /joinRequests/{requestId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('userUid', '') == request.auth.uid)
        || (isLoggedIn() && isOrgTrustee(resource.data.get('orgId', '')));
      allow create: if isLoggedIn()
        && request.resource.data.get('userUid', '') == request.auth.uid
        && request.resource.data.get('orgId', '') != ''
        && request.resource.data.get('status', '') == 'PENDING';
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(resource.data.get('orgId', ''))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt'])
          && request.resource.data.get('status', '') in ['APPROVED', 'REJECTED'])
        || (isLoggedIn() && resource.data.get('userUid', '') == request.auth.uid
          && resource.data.get('status', '') == 'REJECTED'
          && request.resource.data.get('status', '') == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'message', 'createdAt']));
      allow delete: if false;
    }

    // --- orgInvites/{inviteId}: org â user invitations.
    function inviteMatchesMe() {
      return isLoggedIn() && (
        resource.data.get('invitedUid', '') == request.auth.uid ||
        (request.auth.token.email != null
          && resource.data.get('invitedEmail', '') == request.auth.token.email) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '') != ''
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '')
            == resource.data.get('invitedPhone', ''))
      );
    }
    match /orgInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && (inviteMatchesMe()
          || isOrgTrustee(resource.data.get('orgId', ''))));
      allow create: if isLoggedIn()
        && request.resource.data.get('orgId', '') != ''
        && request.resource.data.get('status', '') == 'PENDING'
        && request.resource.data.get('expiresAt', 0) > request.time.toMillis()
        && request.resource.data.get('role', '') != ''
        && grantableRole(request.resource.data.get('orgId', ''), request.resource.data.get('role', ''));
      allow update: if isSuperAdmin()
        || (isLoggedIn() && inviteMatchesMe()
          && resource.data.get('status', '') == 'PENDING'
          && resource.data.get('expiresAt', 0) > request.time.toMillis()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.get('status', '') in ['ACCEPTED', 'DECLINED']);
      allow delete: if false;
    }

    // --- workspaceMembers/{workspaceId}_{uid}: the rules-enforced membership
    function inviteAcceptOk(inviteId, workspaceId, role) {
      let ipath = /databases/$(database)/documents/orgInvites/$(inviteId);
      return inviteId != '' && exists(ipath)
        && get(ipath).data.get('status', '') == 'ACCEPTED'
        && get(ipath).data.get('expiresAt', 0) > request.time.toMillis()
        && get(ipath).data.get('orgId', '') == workspaceId
        && get(ipath).data.get('role', '') == role
        && (get(ipath).data.get('invitedUid', '') == request.auth.uid
          || (request.auth.token.email != null
            && get(ipath).data.get('invitedEmail', '') == request.auth.token.email));
    }
    match /workspaceMembers/{memberId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid)
        || (isLoggedIn() && isOrgTrustee(resource.data.get('workspaceId', '')));
      allow create: if isLoggedIn()
        && request.resource.data.get('workspaceId', '') != ''
        && request.resource.data.get('uid', '') != ''
        && request.resource.data.get('role', '') != ''
        && (
          // (a) Trustee grants for another user (join approval / direct add)
          (isOrgTrustee(request.resource.data.get('workspaceId', ''))
            && grantableRole(request.resource.data.get('workspaceId', ''),
              request.resource.data.get('role', '')))
          // (b) Self-accept of an invite: the invite must name me, be
          || (request.resource.data.get('uid', '') == request.auth.uid
            && inviteAcceptOk(
              request.resource.data.get('viaInviteId', ''),
              request.resource.data.get('workspaceId', ''),
              request.resource.data.get('role', '')))
          // (c) Workspace creator self-provisions as the first Trustee.
          || (request.resource.data.get('uid', '') == request.auth.uid
            && request.resource.data.get('role', '') == 'Trustee'
            && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.createdBy == request.auth.uid)
        );
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(resource.data.get('workspaceId', ''))
          && grantableRole(resource.data.get('workspaceId', ''),
            request.resource.data.get('role', '')));
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(resource.data.get('workspaceId', '')));
    }

    // NotificationCenter collections (Phase 3 merge of
    match /notifications/{uid} {
      allow read, write: if false;

      // --- In-app notification center --------------------
      match /items/{itemId} {
        allow read: if isLoggedIn() && request.auth.uid == uid;
        allow create: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasAll([
            'id', 'uid', 'kind', 'priority', 'title', 'body', 'dedupeKey', 'createdAt'
          ]);
        allow update: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow delete: if false;
      }

      match /pushRequests/{reqId} {
        allow read: if isLoggedIn() && request.auth.uid == uid;
        allow create: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.toUser == uid
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }

      // --- Owner-only preferences ------------------------
      match /prefs {
        allow read, write: if isLoggedIn() && request.auth.uid == uid;
      }
    }

    // App Growth funnel (/get-app QR smart link). The landing page is
    // PUBLIC, so scan/install/waitlist logging must be anonymously
    // writable â but tightly validated: exact key allow-list, bounded
    // campaign ids, server timestamps only. Reads are owner-only
    // (GodMode Analytics tab). Campaign + config docs are publicly
    // readable (the landing page renders them); writes are owner-only.
    match /appGrowthScans/{scanId} {
      allow create: if request.resource.data.keys().hasOnly(['campaignId', 'platform', 'ts'])
        && (request.resource.data.get('campaignId', null) == null
          || (request.resource.data.get('campaignId', '') is string
            && request.resource.data.get('campaignId', '').size() <= 64))
        && request.resource.data.get('platform', '') in ['android', 'ios', 'desktop', 'unknown']
        && request.resource.data.get('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthInstalls/{installId} {
      allow create: if request.resource.data.keys().hasOnly(['campaignId', 'platform', 'ts'])
        && (request.resource.data.get('campaignId', null) == null
          || (request.resource.data.get('campaignId', '') is string
            && request.resource.data.get('campaignId', '').size() <= 64))
        && request.resource.data.get('platform', '') in ['android', 'ios', 'desktop', 'unknown']
        && request.resource.data.get('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthWaitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['platform', 'ts'])
        && request.resource.data.get('platform', '') in ['android', 'ios', 'desktop', 'unknown']
        && request.resource.data.get('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthCampaigns/{campaignId} {
      allow get: if true;
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }
    match /appGrowth/{docId} {
      allow get: if docId == 'config';
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    // P2P money requests (chat-embedded): parties-only, strict state machine, no delete.
    match /p2pRequests/{reqId} {
      allow read: if isLoggedIn()
        && (resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isLoggedIn()
        && (resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'paidRef', 'paidVia', 'paidAt', 'settledAt', 'supersededBy'])
        && (
          (resource.data.get('receiverId', '') == request.auth.uid
            && resource.data.get('status', '') == 'pending'
            && request.resource.data.get('status', '') in ['accepted', 'declined', 'countered'])
          || (resource.data.get('senderId', '') == request.auth.uid
            && resource.data.get('status', '') == 'accepted'
            && request.resource.data.get('status', '') == 'paid')
          || (resource.data.get('receiverId', '') == request.auth.uid
            && resource.data.get('status', '') == 'paid'
            && request.resource.data.get('status', '') == 'settled')
          || (resource.data.get('senderId', '') == request.auth.uid
            && resource.data.get('status', '') == 'pending'
            && request.resource.data.get('status', '') == 'cancelled'));
      allow delete: if false;
    }

    // File Vault (zero-cost Storage replacement: Firestore + IndexedDB).
        // Campus maps — public temple layouts (Phase 1: builder + visitor view).
    // Read is public: a temple map is public information. Write is org-admin
    // only (trustee/superadmin of that workspace). No personal data here.
    match /campusMaps/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && (
        hasRole(orgId, ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'])
        || isOwner()
      );
      allow delete: if false;
    }
    // Sevadar live reports — "human sensors" for campus conditions.
    // Read is public (live conditions are public information).
    // Write: sevadar+ of that workspace (role-gated). Reports EXPIRE
    // (expiresAt); no delete needed — clients filter expired, cleanup
    // removes them. Never per-user tracking data here.
    match /zoneReports/{reportId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.get('orgId', '') != ''
        && request.resource.data.get('reportedBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'orgId', 'zoneId',
          'zoneName', 'type', 'note', 'reportedBy', 'reporterName',
          'createdAt', 'expiresAt', 'serverAt'])
        && (hasRole(request.resource.data.get('orgId', ''),
              ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Sevadar',
               'SEVADAR', 'Coordinator', 'COORDINATOR'])
            || isOwner());
      allow update, delete: if false;
    }

match /fileVault/{fileId} {
      allow read: if isLoggedIn()
        && (resource.data.get('visibility', 'private') == 'public'
          || resource.data.get('ownerUid', '') == request.auth.uid
          || (resource.data.get('visibility', '') == 'crisis'
            && isTenantMember(resource.data.get('tenantId', null))));
      allow create: if isLoggedIn()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'contentType', 'fileName',
          'size', 'hash', 'category', 'visibility', 'ownerUid', 'createdAt',
          'localOnly', 'chunkCount', 'tenantId'])
        && (
          // Single-doc upload: the whole file is inline — `size` (the declared
          // byte count) stays ≤ 1 MiB, and Firestore's own document cap bounds
          // the actual bytes anyway.
          (request.resource.data.get('chunkCount', 0) == 0
            && request.resource.data.get('localOnly', false) != true
            && request.resource.data.get('size', 99999999) <= 1048576)
          // Chunked upload: metadata only — bytes live in /chunks, so no
          // inline `data` key; the declared total may reach 10 MiB across
          // ≤ 28 chunks (500 KB base64 each, mirroring VAULT_CHUNK_B64).
          || (request.resource.data.get('chunkCount', 0) > 0
            && request.resource.data.get('chunkCount', 9999) <= 28
            && !request.resource.data.keys().hasAny(['data'])
            && request.resource.data.get('size', 99999999) <= 10485760)
          // Private files: bytes never leave this device — Firestore holds
          // only a tiny metadata pointer, so `size` may exceed 1 MiB.
          || request.resource.data.get('localOnly', false) == true);
      allow update: if false;
      allow delete: if isLoggedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid;
      // Chunks carry denormalized gating fields: authorized from the chunk doc alone.
      match /chunks/{n} {
        allow read: if isLoggedIn()
          && (resource.data.get('visibility', 'private') == 'public'
            || resource.data.get('ownerUid', '') == request.auth.uid
            || (resource.data.get('visibility', '') == 'crisis'
              && isTenantMember(resource.data.get('tenantId', null))));
        allow create: if isLoggedIn()
          && request.resource.data.get('ownerUid', '') == request.auth.uid
          && request.resource.data.get('visibility', '') in ['public', 'crisis']
          && request.resource.data.get('data', '').size() <= 512000
          && request.resource.data.get('i', -1) >= 0
          && request.resource.data.keys().hasOnly(
            ['i', 'data', 'ownerUid', 'visibility', 'tenantId']);
        allow update: if false;
        allow delete: if isLoggedIn()
          && resource.data.get('ownerUid', '') == request.auth.uid;
      }
    }

    /* ── Translation Quality System ────────────────────────────────────
     * Devotees suggest better wording for draft strings
     * (`translationSuggestions`); owner-approved corrections ship as
     * runtime overrides (`translationOverrides/{lang}`) — live in the app
     * without a redeploy. UI strings ship in the client bundle anyway, so
     * override reads are public; writes are owner-only.
     * Regional vocabulary suggestions may carry `region` (a RegionId) and
     * `termKey` (e.g. 'temple'); the approved text lands verbatim under
     * `regional.{region}.{termKey}` in the override doc.
     */
    match /translationSuggestions/{suggestionId} {
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.keys().hasOnly(['lang', 'key', 'currentText',
          'suggestedText', 'uid', 'sanataniId', 'status', 'createdAt',
          'region', 'termKey'])
        && request.resource.data.get('lang', '') in
          ['en', 'hi', 'bn', 'sa', 'ta', 'te', 'mr', 'gu', 'kn', 'ml']
        && request.resource.data.get('key', '').size() > 0
        && request.resource.data.get('key', '').size() <= 200
        && request.resource.data.get('suggestedText', '').size() > 0
        && request.resource.data.get('suggestedText', '').size() <= 2000
        && request.resource.data.get('currentText', '').size() <= 2000
        && isRegionId(request.resource.data.get('region', ''))
        && (request.resource.data.get('termKey', '') == ''
          || (request.resource.data.get('termKey', '').size() <= 40
            && request.resource.data.get('termKey', '').matches('^[a-zA-Z]+$')));
      // A devotee may read their own suggestions; the owner reads the queue.
      allow read: if isLoggedIn()
        && (resource.data.get('uid', '') == request.auth.uid || isOwner());
      // Owner triage: approve or reject. Records are kept, never edited.
      allow update: if isOwner()
        && request.resource.data.get('status', '') in ['approved', 'rejected'];
      allow delete: if isOwner();
    }


    /* =====================================================================
     * TIRTHA DIARY (Map Phase 2) — personal pilgrimage journal.
     * ---------------------------------------------------------------------
     * PRIVACY LAW, ENFORCED AT THE DATABASE LEVEL:
     *  - Owner-only: {uid} MUST equal request.auth.uid on every op.
     *  - No public reads. No family/org reads. No sharing at the rules
     *    level — there is no share path in this phase.
     *  - Writes are schema-pinned: visits and yatras carry only the
     *    fields the client needs; uid is immutable after create.
     *  - Deletes are always allowed for the owner ("forget in one tap").
     * ===================================================================== */
    match /tirthaVisits/{uid} {
      allow read, write: if false; // no collection-level access

      match /visits/{visitId} {
        allow read: if isLoggedIn() && request.auth.uid == uid;
        allow create: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.get('templeName', '').size() > 0
          && request.resource.data.get('templeName', '').size() <= 120
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'templeName', 'orgId', 'visitedAt', 'note',
            'darshanKind', 'photoVaultUrl', 'yatraId', 'createdAt'
          ]);
        allow update: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.get('templeName', '').size() > 0
          && request.resource.data.get('templeName', '').size() <= 120
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'templeName', 'orgId', 'visitedAt', 'note',
            'darshanKind', 'photoVaultUrl', 'yatraId', 'createdAt'
          ]);
        allow delete: if isLoggedIn() && request.auth.uid == uid;
      }
    }

    match /tirthaYatras/{uid} {
      allow read, write: if false; // no collection-level access

      match /yatras/{yatraId} {
        allow read: if isLoggedIn() && request.auth.uid == uid;
        allow create: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('name', '').size() <= 80
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'name', 'reflection', 'coverVaultUrl', 'createdAt'
          ]);
        allow update: if isLoggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('name', '').size() <= 80
          && request.resource.data.keys().hasOnly([
            'id', 'uid', 'name', 'reflection', 'coverVaultUrl', 'createdAt'
          ]);
        allow delete: if isLoggedIn() && request.auth.uid == uid;
      }
    }

    match /translationOverrides/{lang} {
      // UI strings are public by nature — they ship in the client bundle.
      allow read: if true;
      // Owner-only corrections; the per-language map stays bounded.
      allow create, update: if isOwner()
        && request.resource.data.size() <= 2000;
      allow delete: if false;
    }

    // --- QR Intelligence Phase 1: aggregate scan analytics. ---
    // Privacy law: only the SHA-256 scanner hash leaves the device — the raw
    // uid is never written. Phase 1 is aggregate-only; the dashboard reads
    // qrScanStats, never the raw event stream.
    match /qrScanEvents/{eventId} {
      // Any signed-in user may append their own scan event. Append-only.
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasOnly([
          'qrId', 'qrType', 'scannerHash', 'outcome', 'scannedAt', 'amount', 'currency'
        ])
        && request.resource.data.get('qrType', '') == 'p2p'
        && request.resource.data.get('outcome', '') in [
          'parsed', 'invalid', 'expired', 'payment_completed', 'payment_failed'
        ]
        && request.resource.data.get('scannerHash', '').matches('^[0-9a-f]{64}$');
      // Owner-only reads — no per-user browsing, even of hashes.
      allow read: if isOwner();
      allow update, delete: if false;
    }

    match /qrScanStats/{qrId} {
      // Any signed-in user may create the aggregate doc for a QR they scanned.
      allow create: if isLoggedIn()
        && request.resource.data.get('qrId', '') == qrId
        && request.resource.data.keys().hasOnly([
          'qrId', 'qrType', 'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'firstSeenAt', 'receiverId'
        ]);
      // Any signed-in user may fold a scan into the counters. Counters only
      // move forward; identity and type are immutable after creation.
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'receiverId'
        ])
        && request.resource.data.get('totalScans', 0) >= resource.data.get('totalScans', 0)
        && request.resource.data.get('qrId', '') == resource.data.get('qrId', '')
        && request.resource.data.get('qrType', '') == resource.data.get('qrType', '');
      // Owner-only reads — aggregates contain no PII, but owner-only is safer.
      allow read: if isOwner();
      allow delete: if false;
    }

  }
}