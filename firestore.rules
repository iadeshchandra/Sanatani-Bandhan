rules_version = '2';

/**
 * Sanatani Bandhan â Hardened Firestore Security Rules.
 * DENY-BY-DEFAULT, tenant isolation. Identity: Firebase Auth (custom claims
 * tenantId/role/roles[], falling back to users/{uid}). DEMO_* = public-read
 * sandboxes. Financial ledgers append-only; sensitive writes field-allowlisted.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Identity & role helpers
    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    // True for anonymous (demo) sessions â used to gate real-workspace creation.
    function isAnonymous() {
      return isLoggedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Platform SuperAdmin: explicit claim, canonical role claim, or the
    function isSuperAdmin() {
      return isLoggedIn() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role in ['SuperAdmin', 'SUPER_ADMIN'] ||
        (request.auth.token.roles is list &&
          request.auth.token.roles.hasAny(['SuperAdmin', 'SUPER_ADMIN'])) ||
        (exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.get('active', true) != false)
      );
    }

    // Platform owner: the canonical human owner UID. Used for Spark-native
    function isOwner() {
      return isSelf('sxIGHmvpYUTqPnpI1bLFT1O1cA62');
    }

    // Effective tenant: custom claim wins, else the users/{uid} document.
    function effTenant() {
      return request.auth == null ? null :
        (request.auth.token.tenantId != null ? request.auth.token.tenantId :
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('workspaceId', null) : null));
    }

    // Role check: single `role` claim, `roles[]` claim, or users-doc fallback.
    function roleIn(roles) {
      return request.auth != null && (
        request.auth.token.role in roles ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(roles)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) in roles)
      );
    }

    function isDemoWs(id) {
      return id != null && id.matches('^DEMO_.*');
    }

    // Regional vocabulary ids (src/i18n/regionalTerms.ts). Devotee
    // suggestions may omit the field entirely ('' = not regional).
    function isRegionId(v) {
      return v == '' || v in ['tamil-nadu', 'karnataka', 'andhra-telangana',
        'kerala', 'maharashtra', 'gujarat', 'west-bengal', 'bangladesh',
        'hindi-belt', 'punjab', 'odisha', 'assam', 'northeast',
        'global-diaspora', 'other'];
    }

    // Task contract: tenant member = logged in AND (own tenant claim |
    function wsMemberPath(tenantId) {
      return /databases/$(database)/documents/workspaceMembers/$(tenantId + '_' + request.auth.uid);
    }
    function isWsMember(tenantId) {
      return isLoggedIn() && tenantId != null && exists(wsMemberPath(tenantId));
    }
    function wsMemberRoleIn(tenantId, roles) {
      return isWsMember(tenantId)
        && get(wsMemberPath(tenantId)).data.get('role', null) in roles;
    }
    function isTenantMember(tenantId) {
      return isLoggedIn() && tenantId != null && (
        isSuperAdmin() ||
        tenantId == effTenant() ||
        effTenant() == '*' ||
        isWsMember(tenantId)
      );
    }

    // Task contract: role check scoped to the tenant. SuperAdmin bypasses
    function hasRole(tenantId, roles) {
      return isSuperAdmin()
        || (isTenantMember(tenantId) && (roleIn(roles) || wsMemberRoleIn(tenantId, roles)));
    }

    // Organisation Trustee for a specific org (used by membership flows):
    function isOrgTrustee(orgId) {
      return isLoggedIn() && orgId != null && orgId != '' && (
        isSuperAdmin() ||
        (isTenantMember(orgId) && (
          roleIn(R_TRUSTEE()) ||
          wsMemberRoleIn(orgId, R_TRUSTEE())
        ))
      );
    }

    // Chat privacy (2026-10-19): extract the orgId from an org-type chat doc.
    // New docs carry an explicit `orgId` field; legacy org chats carry it as
    // participants[1] (see getOrCreateOrgChat: participants [userUid, orgId]).
    // Returns '' for anything else — callers MUST check type == 'org' first.
    function chatOrgId(chatData) {
      return chatData.get('orgId', '') != '' ? chatData.get('orgId', '') :
        (chatData.get('participants', null) is list &&
         chatData.get('participants', []).size() == 2 ?
         chatData.get('participants', [])[1] : '');
    }

    // Trustee chat access, scoped (2026-10-19 privacy fix): a trustee may
    // access ONLY org-type support threads belonging to their own org.
    // Previously any trustee could read every private 1:1 chat.
    // SuperAdmin keeps emergency access via the separate isSuperAdmin branch.
    function isChatOrgTrustee(chatData) {
      return chatData.get('type', '') == 'org' &&
        isOrgTrustee(chatOrgId(chatData));
    }

    // Role-grant matrix for invites / member adds. A Trustee may grant
    function grantableRole(orgId, targetRole) {
      return isSuperAdmin() || (
        isOrgTrustee(orgId) &&
        !(targetRole in R_TRUSTEE()) &&
        targetRole in ['Priest', 'PRIEST', 'PUROHIT', 'Accountant', 'ACCOUNTANT',
          'Sevadar', 'SEVADAR', 'Devotee', 'DEVOTEE', 'Member', 'MEMBER',
          'CSO', 'Manager', 'MANAGER', 'Auditor', 'AUDITOR']
      );
    }

    // DEMO sandboxes: public reads; writes need an authenticated session.
    function demoPublicRead(wsId) {
      return isDemoWs(wsId) && (request.auth == null || effTenant() == wsId || isSuperAdmin());
    }
    function demoWriteOk(wsId) {
      return isLoggedIn() && isDemoWs(wsId);
    }

    // Workspace id carried on root-collection documents (fail closed if absent).
    function docWs() {
      return tkOldGet('workspaceId', null);
    }
    function newDocWs() {
      return tkNewGet('workspaceId', null);
    }
    function wsImmutable() {
      return newDocWs() == docWs();
    }

    // EVENTS + POLLS P0 (2026-10-24) — public festival counters are
    // ANCHORED to the caller's own RSVP doc, festival_rsvps/{eventId}__{uid},
    // written in the SAME batch/transaction. The counter may move up OR
    // down, by exactly the RSVP's headcount delta — never on its own.
    // This replaces the old publicCounterBump, which let any signed-in
    // user raise the counters with no RSVP at all (and never lower them).
    function festRsvpPath(eventId) {
      return /databases/$(database)/documents/festival_rsvps/$(eventId + '__' + request.auth.uid);
    }
    function festBooked(data, slotId) {
      return data.get('slotBooked', {}).get(slotId, 0);
    }
    // The involved slots move by exactly their share of the RSVP delta,
    // and never below zero.
    function festSlotMoveOk(oldData, newData, slotBefore, slotAfter, hcBefore, hcAfter) {
      return slotBefore == slotAfter
        ? (slotAfter == ''
            || (festBooked(newData, slotAfter) == festBooked(oldData, slotAfter) + (hcAfter - hcBefore)
                && festBooked(newData, slotAfter) >= 0))
        : (festBooked(newData, slotBefore) == festBooked(oldData, slotBefore) - hcBefore
            && festBooked(newData, slotBefore) >= 0
            && festBooked(newData, slotAfter) == festBooked(oldData, slotAfter) + hcAfter);
    }
    // Capacity: a slot that gains heads may not pass the capacity the
    // trustee published (slotCaps, stamped onto the event doc from
    // darshanSlots at publish time). Docs published before this batch
    // carry no slotCaps map — for them the counters stay anchored and
    // the booking transaction itself refuses over-capacity bookings.
    function festSlotCapacityOk(oldData, newData, slotAfter) {
      return slotAfter == ''
        || !('slotCaps' in newData)
        || festBooked(newData, slotAfter) <= festBooked(oldData, slotAfter)
        || festBooked(newData, slotAfter) <= newData.get('slotCaps', {}).get(slotAfter, 0);
    }
    // EVENTS P1 — a waitlisted RSVP holds a place in the queue only:
    // its EFFECTIVE headcount for the public counters is 0 until the
    // devotee claims a freed place (status → 'confirmed'). Pre-P1
    // RSVPs carry no status and are confirmed by definition. Every
    // counter check below runs on effective headcounts, so create /
    // edit / cancel / join-queue / claim all obey one law.
    function festEffHc(data) {
      return data.get('status', 'confirmed') == 'waitlisted' ? 0 : data.get('headcount', 0);
    }
    // One slot's waitlist queue (uid → joinedAt) may change only by
    // the caller's own uid joining (+1) or leaving (−1); entries are
    // never edited in place and nobody else's place may move.
    function festWlSlotOk(oldWl, newWl, slotId, uid, delta) {
      let o = oldWl.get(slotId, {});
      let n = newWl.get(slotId, {});
      return delta == 1
        ? (n.diff(o).addedKeys().hasOnly([uid])
            && n.diff(o).removedKeys().size() == 0
            && n.diff(o).changedKeys().size() == 0
            && n.size() == o.size() + 1)
        : delta == -1
          ? (n.diff(o).removedKeys().hasOnly([uid])
              && n.diff(o).addedKeys().size() == 0
              && n.diff(o).changedKeys().size() == 0
              && n.size() + 1 == o.size())
          : n == o;
    }
    // The whole waitlist map: only the caller's involved slots may
    // change, each exactly by the caller's own transition. (Queue
    // ORDER is guarded by the claiming transaction's own re-read;
    // capacity — the safety property — is enforced here, in
    // festSlotCapacityOk, so an out-of-order claim can never
    // overbook a darshan slot.)
    function festWaitlistOk(oldData, newData, slotBefore, slotAfter, uid, wasWl, isWl) {
      let oldWl = oldData.get('slotWaitlist', {});
      let newWl = newData.get('slotWaitlist', {});
      let dBefore = (wasWl && slotBefore != '' ? -1 : 0) + (isWl && slotAfter == slotBefore && slotBefore != '' ? 1 : 0);
      let dAfter = slotAfter != slotBefore ? (isWl && slotAfter != '' ? 1 : 0) : dBefore;
      return diffKeysOnly(newWl, oldWl, [slotBefore, slotAfter])
        && festWlSlotOk(oldWl, newWl, slotBefore, uid, slotBefore == slotAfter ? dAfter : dBefore)
        && (slotAfter == slotBefore || festWlSlotOk(oldWl, newWl, slotAfter, uid, dAfter));
    }
    function anchoredFestivalCounter(eventId) {
      let rp = festRsvpPath(eventId);
      let had = exists(rp);
      let has = existsAfter(rp);
      let hcBefore = had ? festEffHc(get(rp).data) : 0;
      let hcAfter = has ? festEffHc(getAfter(rp).data) : 0;
      let slotBefore = had ? get(rp).data.get('slotId', '') : '';
      let slotAfter = has ? getAfter(rp).data.get('slotId', '') : '';
      let wasWl = had && get(rp).data.get('status', 'confirmed') == 'waitlisted';
      let isWl = has && getAfter(rp).data.get('status', 'confirmed') == 'waitlisted';
      return (had || has)
        && diffKeys()
             .hasOnly(['rsvpHeadcount', 'slotBooked', 'slotWaitlist', 'updatedAt'])
        && tkNewGet('rsvpHeadcount', 0)
             == tkOldGet('rsvpHeadcount', 0) + (hcAfter - hcBefore)
        && tkNewGet('rsvpHeadcount', 0) >= 0
        && tkNewGet('slotBooked', {}).diff(tkOldGet('slotBooked', {}))
             .affectedKeys().hasOnly([slotBefore, slotAfter])
        && festSlotMoveOk(resource.data, request.resource.data, slotBefore, slotAfter, hcBefore, hcAfter)
        && festSlotCapacityOk(resource.data, request.resource.data, slotAfter)
        && festWaitlistOk(resource.data, request.resource.data, slotBefore, slotAfter, request.auth.uid, wasWl, isWl);
    }

    // EVENTS E2 — seva-pass ticketing anchors (event_tickets). The
    // money formulas mirror src/lib/eventTickets.ts line-for-line;
    // the two change together or not at all. Every cross-document
    // witness inside a purchase/cancel batch is read with getAfter:
    // the ticket, the counter move and the wallet move commit
    // together, so committed-state get() would see none of them.
    // Compiled-size diet (EVENTS E2, 2026-11-21): shared field-read
    // and clause-head shapes for the ticketing code below, in the
    // round-3 getter idiom. Every helper is a verbatim shape match
    // for the inline form it replaces (full-expansion proof in the
    // batch NOTES): tkDiff is diffKeysOnly on the request/resource
    // pair; tkNewGet/tkOldGet are the two doc-side field reads;
    // tk*Of(m) are one-key reads on an arbitrary map; tkStaffVenue
    // and tkBuyerGuard are the two repeated allow-clause heads.
    function tkDiff(keys) {
      return diffKeysOnly(request.resource.data, resource.data, keys);
    }
    function tkNewGet(k, dv) {
      return request.resource.data.get(k, dv);
    }
    function tkOldGet(k, dv) {
      return resource.data.get(k, dv);
    }
    function tkStateOf(m) {
      return m.get('paymentState', '');
    }
    function tkBuyerOf(m) {
      return m.get('buyerUid', '');
    }
    function tkFestOf(m) {
      return m.get('festivalId', '');
    }
    function tkTierOf(m) {
      return m.get('tierId', '');
    }
    function tkWsOf(m) {
      return m.get('workspaceId', '');
    }
    function tkTrStateOf(m) {
      return m.get('transferState', '');
    }
    function tkPlanCfg(m) {
      return m.get('ticketing', {});
    }
    function tkTotalOf(m) {
      return m.get('amounts', {}).get('total', 0);
    }
    function tkUseCount(m, code) {
      return m.get('discountUses', {}).get(code, 0);
    }
    function tkAfterData(tp) {
      return getAfter(tp).data;
    }
    function tkLadMin(lad, i) {
      return lad[i].get('minDaysBefore', 0);
    }
    function tkLadPct(lad, i) {
      return lad[i].get('percent', 0);
    }
    function tkPlanRes() {
      return get(/databases/$(database)/documents/festival_plans/$(resource.data.get('festivalId', ''))).data;
    }
    function tkStaffVenue() {
      return hasRole(docWs(), R_ANY_STAFF())
        && resource.data.get('paymentState', '') == 'pay-at-venue';
    }
    function tkBuyerGuard() {
      return isLoggedIn() && uidIs(resource.data.get('buyerUid', ''));
    }
    function tkIsTransferTo() {
      return uidIs(resource.data.get('transferToUid', ''));
    }
    function ticketPath(ticketId) {
      return /databases/$(database)/documents/event_tickets/$(ticketId);
    }
    function tkEffQty(data) {
      return data.get('paymentState', '') in ['paid-wallet', 'pay-at-venue', 'comp']
        ? data.get('qty', 0) : 0;
    }
    // The tierSold anchor: the published event doc's sold map may
    // move only by the witness ticket's effective-qty delta, only
    // on that ticket's tier, never past the published tierCaps.
    function anchoredTierCounter(eventId) {
      let tid = tkNewGet('tierAnchorTicketId', '');
      let tp = ticketPath(tid);
      let had = exists(tp);
      let has = existsAfter(tp);
      let qBefore = had ? tkEffQty(get(tp).data) : 0;
      let qAfter = has ? tkEffQty(tkAfterData(tp)) : 0;
      let tierId = has ? tkTierOf(tkAfterData(tp))
        : (had ? tkTierOf(get(tp).data) : '');
      let soldBefore = tkOldGet('tierSold', {});
      let soldAfter = tkNewGet('tierSold', {});
      return tid != ''
        && (had || has)
        && (has ? tkFestOf(tkAfterData(tp)) == eventId
                : tkFestOf(get(tp).data) == eventId)
        && diffKeys().hasOnly(['tierSold', 'tierAnchorTicketId', 'updatedAt'])
        && diffKeysOnly(soldAfter, soldBefore, [tierId])
        && soldAfter.get(tierId, 0) == soldBefore.get(tierId, 0) + (qAfter - qBefore)
        && soldAfter.get(tierId, 0) >= 0
        && (!('tierCaps' in request.resource.data)
            || !(tierId in tkNewGet('tierCaps', {}))
            || soldAfter.get(tierId, 0) <= tkNewGet('tierCaps', {}).get(tierId, 0));
    }
    // The itemised quote, recomputed from the plan's stamped maps
    // (festival_plans carries the prices — the public event doc
    // never carries discount codes, only their hashed terms).
    // Split into helpers because a rules function may declare at
    // most 10 variables — tkAmountsOk assembles their results only.
    function tkUnitPrice(tk, tierId) {
      let early = tk.get('tierEarly', {}).get(tierId, {});
      return (early.size() > 0 && request.time.toMillis() <= early.get('untilMs', 0))
        ? early.get('price', 0) : tk.get('tierPrices', {}).get(tierId, -1);
    }
    function tkDisc(tk, code, price) {
      let cm = tk.get('codeMap', {}).get(code, {});
      let v = cm.get('value', 0);
      let k = cm.get('kind', '');
      return code == '' ? 0
        : k == 'flat' ? (v < price ? v : price)
        : k == 'percent' ? (price * v) / 100
        : k == 'full' ? price : -1;
    }
    function tkCodeOk(tk, code) {
      let cm = tk.get('codeMap', {}).get(code, {});
      return cm.size() > 0
        && (!('maxUses' in cm)
            || tkUseCount(tk, code) < cm.get('maxUses', 0));
    }
    function tkAmountsOk(d, ev, plan) {
      let tk = tkPlanCfg(plan);
      let code = d.get('discountCode', '');
      let price = tkUnitPrice(tk, tkTierOf(d)) * d.get('qty', 0);
      let disc = tkDisc(tk, code, price);
      let fee = (price - disc) * 5 / 100;
      let gst = d.get('currency', '') == 'INR' ? fee * 18 / 100 : 0;
      let total = (price - disc) + (ev.get('ticketFeeBearer', 'organiser') == 'buyer' ? fee + gst : 0);
      let a = d.get('amounts', {});
      return tk.get('tierPrices', {}).get(tkTierOf(d), -1) >= 0
        && disc >= 0 && disc <= price
        && a.get('price', -1) == price
        && a.get('discount', -1) == disc
        && a.get('fee', -1) == fee
        && a.get('gst', -1) == gst
        && a.get('total', -1) == total
        && ((total <= 0 && tkStateOf(d) == 'comp')
            || (total > 0 && tkStateOf(d) in ['paid-wallet', 'pay-at-venue']))
        && (code == '' || tkCodeOk(tk, code));
    }
    // Create shape: household linkage (attendance passes name their
    // party RSVP — the buyer's own doc; add-ons carry neither names
    // nor an RSVP), per-booking cap from the plan's stamped map.
    function tkCreateShapeOk(d, plan) {
      let tk = tkPlanCfg(plan);
      let kind = tk.get('tierKinds', {}).get(tkTierOf(d), '');
      let qty = d.get('qty', 0);
      return kind != ''
        && qty >= 1
        && qty <= tk.get('tierMax', {}).get(tkTierOf(d), 6)
        && qty <= 20
        && d.get('attendees', []) is list
        && d.get('currency', '') in ['INR', 'BDT', 'USD']
        && d.get('buyerName', '').size() >= 1
        && (kind == 'addon'
            ? (d.get('attendees', []).size() == 0 && !('rsvpId' in d))
            : (d.get('attendees', []).size() == qty
               && d.get('rsvpId', '') == tkFestOf(d) + '__' + request.auth.uid));
    }
    // The refund percent for a buyer cancel, from the plan ladder
    // (derived sorted desc, at most 5 rungs, terminal 0-day row) —
    // walked by bounded index, the rules language has no loops. An
    // organiser-cancelled festival refunds 100%, fee included.
    function tkRefundPct(plan, ev) {
      let lad = tkPlanCfg(plan).get('refundLadder', []);
      let days = (tkPlanCfg(plan).get('startMs', 0) - request.time.toMillis()) / 86400000;
      return ev.get('festivalCancelled', false) == true ? 100
        : lad.size() == 0 ? 0
        : days >= tkLadMin(lad, 0) ? tkLadPct(lad, 0)
        : lad.size() > 1 && days >= tkLadMin(lad, 1) ? tkLadPct(lad, 1)
        : lad.size() > 2 && days >= tkLadMin(lad, 2) ? tkLadPct(lad, 2)
        : lad.size() > 3 && days >= tkLadMin(lad, 3) ? tkLadPct(lad, 3)
        : lad.size() > 4 && days >= tkLadMin(lad, 4) ? tkLadPct(lad, 4)
        : tkLadPct(lad, lad.size() - 1);
    }
    // Buyer cancel: the only money-moving ticket update a buyer may
    // make — wallet passes refund exactly the ladder's share of the
    // total (with the wallet credit + tier release in the same
    // batch, each anchored on this ticket); everything else simply
    // releases the place.
    function tkBuyerCancelOk() {
      let plan = tkPlanRes();
      let ev = get(/databases/$(database)/documents/festival_events/$(tkFestOf(resource.data))).data;
      let pct = tkRefundPct(plan, ev);
      let due = (tkTotalOf(resource.data) * pct) / 100;
      let ns = tkStateOf(request.resource.data);
      return tkDiff(['paymentState', 'refundAmount', 'refundedAt', 'updatedAt'])
        && ((ns == 'refunded'
             && tkStateOf(resource.data) == 'paid-wallet'
             && due > 0
             && tkNewGet('refundAmount', 0) == due)
          || (ns == 'cancelled'
              && (tkStateOf(resource.data) != 'paid-wallet' || due == 0)));
    }
    // Transfer accept: the recipient becomes the buyer in the same
    // transaction that rebinds the RSVP; the festival must not have
    // begun (the plan's stamped start is the cutoff).
    function tkAcceptOk() {
      let plan = tkPlanRes();
      return tkTrStateOf(resource.data) == 'offered'
        && tkIsTransferTo()
        && tkBuyerOf(request.resource.data) == request.auth.uid
        && tkNewGet('transferFromUid', '') == tkBuyerOf(resource.data)
        && !('transferToUid' in request.resource.data)
        && !('transferState' in request.resource.data)
        && tkDiff(['buyerUid', 'buyerName', 'transferFromUid', 'transferredAt',
             'transferToUid', 'transferToName', 'transferState', 'offeredAt', 'rsvpId', 'updatedAt'])
        && request.time.toMillis() < tkPlanCfg(plan).get('startMs', 0);
    }
    // Wallet debit for a pass purchase — the marketplace debit's
    // twin, anchored on the ticket (getAfter: same batch).
    function tkWalletDebitOk() {
      let data = request.resource.data;
      let old = resource.data;
      let tid = data.get('lastDebitTicketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      let total = tkTotalOf(tk);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitTicketId', 'currency'])
        && tid != '' && tid != old.get('lastDebitTicketId', '')
        && existsAfter(tp)
        && tkBuyerOf(tk) == request.auth.uid
        && tkStateOf(tk) == 'paid-wallet'
        && total > 0
        && data.get('balance', -1) == old.get('balance', 0) - total
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + total;
    }
    // Wallet refund credit — anchored on the refunded ticket.
    function tkWalletRefundOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let tid = data.get('lastRefundTicketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      let amt = tk.get('refundAmount', 0);
      return diffKeysOnly(data, old, ['balance', 'totalReceived', 'updatedAt', 'lastRefundTicketId', 'currency'])
        && tid != '' && tid != old.get('lastRefundTicketId', '')
        && existsAfter(tp)
        && tkBuyerOf(tk) == uid
        && tkStateOf(tk) == 'refunded'
        && amt > 0
        && data.get('balance', -1) == old.get('balance', 0) + amt
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + amt;
    }
    // Discount-use increment: a purchase batch may raise exactly
    // its own code's use count by one, under the code's cap,
    // witnessed by the batch's own tier-anchor ticket.
    function anchoredDiscountUse(planId) {
      let oldTk = tkPlanCfg(resource.data);
      let newTk = tkPlanCfg(request.resource.data);
      let evAfter = getAfter(/databases/$(database)/documents/festival_events/$(planId)).data;
      let tp = ticketPath(evAfter.get('tierAnchorTicketId', ''));
      let tk = tkAfterData(tp);
      let code = tk.get('discountCode', '');
      let cm = oldTk.get('codeMap', {}).get(code, {});
      return code != ''
        && !exists(tp) && existsAfter(tp)
        && tkFestOf(tk) == planId
        && tkBuyerOf(tk) == request.auth.uid
        && tkDiff(['ticketing'])
        && diffKeysOnly(newTk, oldTk, ['discountUses'])
        && diffKeysOnly(newTk.get('discountUses', {}), oldTk.get('discountUses', {}), [code])
        && tkUseCount(newTk, code) == tkUseCount(oldTk, code) + 1
        && (!('maxUses' in cm) || tkUseCount(newTk, code) <= cm.get('maxUses', 0));
    }
    // EVENTS E8 — the pass-release gate (the TTD pattern): when
    // the published event doc stamps a release moment
    // (ticketReleaseAtMs, epoch ms — the stamped-clock idiom), no
    // pass purchase may commit before it. The stamp is read from
    // the event doc tkCreateOk already fetches, so the gate costs
    // no extra read. Absent (pre-E8 docs) or 0 = no gate: the E2
    // path, unchanged. Mirrors lib/eventTickets' passesOpen.
    function tkReleaseOpen(ev) {
      return ev.get('ticketReleaseAtMs', 0) <= 0
        || request.time.toMillis() >= ev.get('ticketReleaseAtMs', 0);
    }
    // Ticket create: buyer-self only, pinned field shape, the
    // workspace agreeing on all three docs, shape + amounts checked
    // against the plan's stamped maps (tkCreateShapeOk/tkAmountsOk).
    function tkCreateOk() {
      let d = request.resource.data;
      let ev = get(/databases/$(database)/documents/festival_events/$(tkFestOf(d))).data;
      let plan = get(/databases/$(database)/documents/festival_plans/$(tkFestOf(d))).data;
      return uidIs(tkBuyerOf(d))
        && tkWsOf(d) != ''
        && tkFestOf(d) != ''
        && tkWsOf(ev) == tkWsOf(d)
        && tkWsOf(plan) == tkWsOf(d)
        && d.keys().hasOnly(
             ['workspaceId', 'festivalId', 'tierId', 'tierName', 'buyerUid', 'buyerName',
              'attendees', 'qty', 'amounts', 'currency', 'discountCode', 'paymentState',
              'rsvpId', 'createdAt'])
        && tkCreateShapeOk(d, plan)
        && tkAmountsOk(d, ev, plan)
        && tkReleaseOpen(ev);
    }
    // The refund ledger line's anchor (walletTransactions create).
    function tkRefundLedgerOk() {
      let tk = getAfter(ticketPath(reqOrderId())).data;
      return reqOrderId() != ''
        && reqAmount() > 0
        && tkBuyerOf(tk) == request.auth.uid
        && tkStateOf(tk) == 'refunded'
        && tk.get('refundAmount', 0) == reqAmount();
    }
    // The giver's RSVP delete inside a transfer-accept transaction,
    // witnessed by the rebound ticket's after-state.
    function festRsvpTransferDeleteOk() {
      let tid = tkOldGet('ticketId', '');
      let tp = ticketPath(tid);
      let tk = tkAfterData(tp);
      return tid != ''
        && existsAfter(tp)
        && tkBuyerOf(tk) == request.auth.uid
        && tk.get('transferFromUid', '') == resUid()
        && tkFestOf(tk) == tkOldGet('eventId', '');
    }

    // Canonical role sets (canonical + legacy variants from ROLE_MIGRATION_MAP).
    function R_FINANCE() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Accountant', 'ACCOUNTANT'];
    }
    // Blueprint B: finance + the read-only Auditor — the oversight
    // READ set. The Auditor appears in read clauses only, never in
    // a create/update/delete set: read-only is enforced here in
    // the rules, not merely by hiding buttons in the UI.
    function R_OVERSIGHT() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Accountant', 'ACCOUNTANT', 'Auditor', 'AUDITOR'];
    }
    function R_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }
    function R_RITUAL() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Priest', 'PRIEST', 'PUROHIT', 'Manager', 'MANAGER', 'Sevadar', 'SEVADAR'];
    }
    function R_ANY_STAFF() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER',
              'Accountant', 'ACCOUNTANT', 'Priest', 'PRIEST', 'PUROHIT', 'Sevadar', 'SEVADAR', 'VOLUNTEER'];
    }

    // Compiled-size diet (2026-10-27): shared literal sets. The compiled
    // ruleset must stay under Firebase's 256,000-byte executable cap; a
    // literal list is compiled at every use site, a function body once.
    // Each helper returns exactly the list it replaces - no rule changes
    // meaning; verified by inverse expansion against the previous file.
    function R_TRUSTEE() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE'];
    }
    function R_BOARD() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER'];
    }
    function R_TRUSTEE_PAIR() {
      return ['Trustee', 'TRUSTEE'];
    }
    function ORDER_ACTIVE() {
      return ['paid', 'accepted', 'in_progress'];
    }
    function ORDER_DONE() {
      return ['COMPLETED', 'DAKSHINA_RELEASED'];
    }
    function DECISION_STATES() {
      return ['ACCEPTED', 'DECLINED'];
    }
    function PLATFORMS() {
      return ['android', 'ios', 'desktop', 'unknown'];
    }
    function KEYS_STATUS_ONLY() {
      return ['status', 'updatedAt'];
    }
    function UTSAV_COLLECTIONS() {
      return ['families', 'guests', 'annadanam', 'gurukulStudents', 'campaigns', 'shifts', 'checkIns', 'festivals', 'residentPujas', 'pitruRecords', 'check_ins'];
    }

    // Compiled-size diet, round 2 (2026-10-28): shared expression shapes.
    // bumpToggleOk / bumpUpOk pin the counter patterns used across the
    // social and events blocks: exactly one counter moves by exactly one
    // step (toggle: +-1, never below 0; up: +1 only), nothing else changes.
    function bumpToggleOk(field) {
      return diffKeys().hasOnly([field])
        && tkNewGet(field, -1) >= 0
        && (tkNewGet(field, 0) == tkOldGet(field, 0) + 1
            || tkNewGet(field, 0) == tkOldGet(field, 0) - 1);
    }
    function bumpUpOk(field) {
      return diffKeys().hasOnly([field])
        && tkNewGet(field, 0) == tkOldGet(field, 0) + 1;
    }
    // diffKeysOnly: the affected-keys guard, factored - the diff chain is
    // identical at dozens of sites; only the two maps and the key list vary.
    function diffKeysOnly(newData, oldData, keys) {
      return newData.diff(oldData).affectedKeys().hasOnly(keys);
    }
    // diffKeys: the request-vs-resource affected-keys set itself, for
    // branches that test it with hasAny/hasOnly directly (JY-FIX-B
    // compiled-size factoring — the expansion is token-identical to
    // the inline chain it replaces).
    function diffKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // E5 diet round 4: the incoming doc's key set, for the many
    // keys().hasOnly / hasAll guards (expansion token-identical).
    function reqKeys() {
      return request.resource.data.keys();
    }
    // Compiled-size diet, round 3 (2026-11-01): shared field-read and
    // identity shapes - the docWs()/newDocWs() pattern applied
    // systematically. Each getter replaces an identical literal
    // .get('field', default) chain; isSelf / uidIs factor the two
    // uid-equality shapes; the req*Doc() helpers factor the
    // cross-document lookups keyed by the incoming document. Every
    // expansion is token-identical to the inline form it replaces
    // (full-expansion proof: staging diet3 NOTES).
    function isSelf(x) {
      return isLoggedIn() && request.auth.uid == x;
    }
    function uidIs(x) {
      return x == request.auth.uid;
    }
    function reqGigDoc() {
      return get(/databases/$(database)/documents/gigs/$(tkNewGet('orderId', '')));
    }
    function reqConsultDoc() {
      return get(/databases/$(database)/documents/jyotishConsultations/$(tkNewGet('orderId', '')));
    }
    function reqCreditDoc() {
      return get(/databases/$(database)/documents/referralCredits/$(tkNewGet('lastReferralCreditId', '')));
    }
    function reqStatus() {
      return tkNewGet('status', '');
    }
    function reqOrderId() {
      return tkNewGet('orderId', '');
    }
    function reqUid() {
      return tkNewGet('uid', '');
    }
    function reqReferredBy() {
      return tkNewGet('referredBy', {});
    }
    function reqOrgId() {
      return tkNewGet('orgId', '');
    }
    function reqText() {
      return tkNewGet('text', '');
    }
    function reqOrderType() {
      return tkNewGet('orderType', '');
    }
    function reqName() {
      return tkNewGet('name', '');
    }
    function reqWorkspaceId() {
      return tkNewGet('workspaceId', '');
    }
    function reqTitle() {
      return tkNewGet('title', '');
    }
    function reqAmount() {
      return tkNewGet('amount', 0);
    }
    function reqRole() {
      return tkNewGet('role', '');
    }
    function reqOptions() {
      return tkNewGet('options', {});
    }
    function reqProviderUid() {
      return tkNewGet('providerUid', '');
    }
    function reqRatingCount() {
      return tkNewGet('ratingCount', 0);
    }
    function reqVerificationTier() {
      return tkNewGet('verificationTier', '');
    }
    function reqAuthorUid() {
      return tkNewGet('authorUid', '');
    }
    function reqAuthorName() {
      return tkNewGet('authorName', '');
    }
    function reqRating() {
      return tkNewGet('rating', 0);
    }
    function reqOptionIds() {
      return tkNewGet('optionIds', []);
    }
    function reqLastReferralCreditId() {
      return tkNewGet('lastReferralCreditId', '');
    }
    function reqRsvpCount() {
      return tkNewGet('rsvpCount', 0);
    }
    function resStatus() {
      return tkOldGet('status', '');
    }
    function resProviderUid() {
      return tkOldGet('providerUid', '');
    }
    function resUid() {
      return tkOldGet('uid', '');
    }
    function resClientUid() {
      return tkOldGet('clientUid', '');
    }
    function resAuthorUid() {
      return tkOldGet('authorUid', '');
    }
    function resExpiresAtTs() {
      return tkOldGet('expiresAtTs', null);
    }
    // rsvpWithinCap: an RSVP +1 respects capacity - allowed when the event
    // has no capacity set, a non-positive capacity (treated as unset), or
    // room still remains under the cap.
    function rsvpWithinCap() {
      return !('capacity' in resource.data) || tkOldGet('capacity', 0) <= 0
        || reqRsvpCount() <= tkOldGet('capacity', 0);
    }
    function DECISION_KEYS() {
      return ['status', 'decidedBy', 'decidedByName', 'decidedAt', 'note'];
    }
    function RATING_KEYS() {
      return ['ratingAggregate', 'ratingCount', 'lastReviewId', 'updatedAt'];
    }
    function TIRTHA_VISIT_KEYS() {
      return ['id', 'uid', 'templeName', 'orgId', 'visitedAt', 'note', 'darshanKind', 'photoVaultUrl', 'yatraId', 'createdAt'];
    }
    function TIRTHA_YATRA_KEYS() {
      return ['id', 'uid', 'name', 'reflection', 'coverVaultUrl', 'createdAt'];
    }

    // 2. Platform admin registry (server-managed via Admin SDK only)
    match /platform_admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Delegated platform admins (QUEUED #21) — client-managed registry.
    // DISTINCT from /platform_admins: a doc here NEVER confers
    // isSuperAdmin(); it only gates the GodMode console UI.
    match /platformAdmins/{adminUid} {
      allow read: if isOwner()
        || (isSelf(adminUid));
      allow create, update: if isOwner()
        && reqKeys().hasOnly(
          ['uid', 'email', 'displayName', 'role', 'active',
           'grantedBy', 'grantedAt', 'updatedAt'])
        && reqUid() == adminUid
        && reqRole() in ['admin', 'moderator']
        && uidIs(tkNewGet('grantedBy', ''));
      allow delete: if isOwner();
    }

    match /platform_leads/{leadId} {
      allow create: if true; // public lead-capture form
      allow read, update: if isSuperAdmin() || isOwner();
      allow delete: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }

    // 3. User profiles â owner or SuperAdmin only.
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isSuperAdmin() || isOwner());
      allow create: if isSelf(userId)
        && !reqKeys().hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId',
          // Step 8: soft-ban fields are owner-write-only
          'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
        && (
          // DEMO sandbox: may self-claim a demo workspace + starter role
          isDemoWs(newDocWs())
          // Standard registration: no privilege or tenant claims at all
          || !reqKeys().hasAny(['role', 'workspaceId', 'defaultWorkspaceId', 'membership'])
        );
      allow update: if isSuperAdmin() || (
        isSelf(userId)
        && !diffKeys()
            .hasAny(['admin', 'isGlobalAdmin', 'status', 'tenantId', 'role', 'workspaceId', 'defaultWorkspaceId', 'membership',
              // Step 8: soft-ban fields are owner-write-only
              'suspended', 'suspendReason', 'suspendedAt', 'suspendedBy'])
      )
        // Step 8: owner-only soft-ban writes — suspension fields and nothing else
        || (isOwner()
          && diffKeys()
              .hasOnly(['suspended', 'suspendReason', 'suspendedAt', 'suspendedBy', 'updatedAt']));
      allow delete: if false;
    }

    // FCM device tokens for push delivery. Each user manages only their own
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isSelf(userId);
    }

    // 4. Tenant partitions
    match /tenants/{tenantId} {
      allow read: if true; // public discovery
      allow create: if isSuperAdmin();
      allow update: if hasRole(tenantId, R_TRUSTEE())
        && diffKeys()
            .hasOnly(['name', 'city', 'state', 'country', 'type', 'logoUrl', 'tagline', 'updatedAt']);
      allow delete: if isSuperAdmin();

      // Sensitive tenant fields (bank details, tax ids, keys) â restricted.
      match /private/{docId} {
        allow read, write: if hasRole(tenantId, R_TRUSTEE());
      }

      // Curated public profile mirror for discovery clients.
      match /publicProfile/{docId} {
        allow read: if true;
        allow write: if hasRole(tenantId, R_TRUSTEE());
      }

      // Tenant-scoped financial ledger (path-param tenant).
      match /treasury/{docId} {
        allow read: if demoPublicRead(tenantId) || hasRole(tenantId, R_OVERSIGHT());
        allow create: if demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE());
        allow update: if (demoWriteOk(tenantId) || hasRole(tenantId, R_FINANCE()));
        allow delete: if false; // append-only fiduciary ledger
      }

      match /devotees/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create, update: if demoWriteOk(tenantId) || hasRole(tenantId, R_STAFF());
        allow delete: if hasRole(tenantId, R_TRUSTEE());
      }

      match /yatranet_alerts/{docId} {
        allow read: if demoPublicRead(tenantId) || isTenantMember(tenantId);
        allow create: if demoWriteOk(tenantId) || isTenantMember(tenantId);
        allow update, delete: if hasRole(tenantId, R_TRUSTEE());
      }
    }

    // 5. Workspace documents (client-managed workspaces collection)
    match /workspaces/{workspaceId} {
      // NOTE: adminPinHash may only ever be written via the server
      allow read: if isTenantMember(workspaceId) || isOwner();
      // Anonymous (demo) sessions cannot create real workspaces â must sign in
      allow create: if isLoggedIn() && !isAnonymous()
        && !reqKeys().hasAny(['adminPinHash', 'adminPin']);
      // Owner (Spark-native console) may change plan + limits-bypass fields only â never pins.
      allow update: if (isOwner()
          && diffKeysOnly(request.resource.data, resource.data, ['planId', 'limitsBypassed', 'updatedAt']))
        || ((demoWriteOk(workspaceId) || hasRole(workspaceId, R_TRUSTEE()))
          && !diffKeys().hasAny(['adminPinHash', 'adminPin']));
      allow delete: if isSuperAdmin();
    }

    // 6. Root collections (keyed by `workspaceId` field) â deny by default

    // Financial ledger â append-only. Demo workspaces are blocked from writing
    match /treasury/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('devoteeId', '')));
      allow create: if hasRole(newDocWs(), R_FINANCE());
      allow update: if hasRole(docWs(), R_FINANCE()) && wsImmutable();
      allow delete: if false;
    }

    match /treasury_ledgers/{docId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('devoteeId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('donorId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('donorId', ''))
            && reqStatus() == 'pledged'));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /tax_receipts/{receiptId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('donorId', '')));
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE())) && wsImmutable();
      allow delete: if false;
    }

    // SECURITY P1 — receiptCounters/{workspaceId}_{series}_{year}:
    // the server anchor for receipt numbering (Finding 5). One doc per
    // workspace + series + year holding the highest official receipt
    // sequence issued. Finance roles (or demo writers in a demo
    // workspace) seed it once from the known maximum and advance it;
    // the counter may only ever move FORWARD, so two devices claiming
    // inside transactions can never be handed the same number. Nobody
    // may delete a counter -- the sequence is part of the audit record.
    match /receiptCounters/{counterId} {
      allow read: if resource == null
        || hasRole(tkOldGet('workspaceId', ''), R_OVERSIGHT());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE()))
        && reqWorkspaceId() != ''
        && counterId == reqWorkspaceId() + '_' + tkNewGet('series', '') + '_' + string(tkNewGet('year', 0))
        && tkNewGet('series', '') in ['SB-80G', 'SB-CHANDA']
        && tkNewGet('seq', -1) >= 0;
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_FINANCE()))
        && wsImmutable()
        && tkNewGet('series', '') == tkOldGet('series', '')
        && tkNewGet('year', 0) == tkOldGet('year', 0)
        && tkNewGet('seq', 0) > tkOldGet('seq', 0);
      allow delete: if false;
    }

    // Devotee PII â read: any tenant member; write: staff roles only
    match /devotees/{devoteeId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || uidIs(tkOldGet('userId', '')) || uidIs(devoteeId);
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('userId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_STAFF())
        || (isTenantMember(docWs()) && uidIs(tkOldGet('userId', '')))) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /households/{householdId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /puja_bookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('devoteeId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /poojaBookings/{bookingId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_RITUAL())
        || (isTenantMember(newDocWs()) && uidIs(tkNewGet('devoteeId', ''))));
      allow update: if (demoWriteOk(docWs()) || hasRole(docWs(), R_RITUAL())) && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    // Pillar 2 â Festival war-room (market domination).
    match /festival_plans/{planId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF()))
        && (resource == null || wsImmutable());
      allow update: if ((demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF()))
          && wsImmutable())
        // EVENTS E2: a buyer's purchase batch may raise exactly its
        // own discount code's use count (anchoredDiscountUse) —
        // nothing else in the plan is reachable by a non-staff write.
        || (isLoggedIn() && anchoredDiscountUse(planId));
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /festival_events/{eventId} {
      allow read: if resource.data.get('published', false) == true
        || demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if demoWriteOk(newDocWs())
        || hasRole(newDocWs(), R_BOARD());
      allow update: if demoWriteOk(docWs())
        || hasRole(docWs(), R_BOARD())
        || (isLoggedIn() && wsImmutable() && anchoredFestivalCounter(eventId))
        // EVENTS E2: the tierSold anchor — sold counts move only
        // with a witness ticket's purchase / cancel (same batch).
        || (isLoggedIn() && wsImmutable() && anchoredTierCounter(eventId));
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    match /festival_rsvps/{rsvpId} {
      allow read: if isTenantMember(docWs())
        || (isLoggedIn() && uidIs(resUid()));
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && reqWorkspaceId() != ''
        && request.resource.data.get('eventId', '') != ''
        && reqName().size() >= 2
        && reqName().size() <= 80
        && request.resource.data.get('headcount', 0) >= 1
        && request.resource.data.get('headcount', 0) <= 20
        // EVENTS P1: optional waitlist status + day-wise choices.
        && request.resource.data.get('status', 'confirmed') in ['confirmed', 'waitlisted']
        && (!('days' in request.resource.data)
            || (request.resource.data.get('days', []) is list
                && request.resource.data.get('days', []).size() <= 14))
        && request.resource.data.keys().hasOnly(
             ['eventId', 'workspaceId', 'uid', 'name', 'headcount', 'slotId', 'createdAt',
              'status', 'days', 'ticketId'])
        // EVENTS P0: the doc id is derived ({eventId}__{uid}) so the
        // festival_events counter rule can find THIS RSVP as its anchor.
        && rsvpId == request.resource.data.get('eventId', '') + '__' + request.auth.uid;
      allow update: if (isLoggedIn() && uidIs(resUid())
          && diffKeysOnly(request.resource.data, resource.data, ['headcount', 'slotId', 'days', 'status'])
          // EVENTS P1: the owner may move status ONLY waitlisted →
          // confirmed (claiming a freed place — the counters move in
          // the same transaction, anchored on the event doc). Giving
          // up a confirmed place happens by deleting the RSVP, never
          // by a status flip the counters cannot see.
          && (request.resource.data.get('status', 'confirmed') == resource.data.get('status', 'confirmed')
              || (resource.data.get('status', 'confirmed') == 'waitlisted'
                  && reqStatus() == 'confirmed')))
        || hasRole(docWs(), R_TRUSTEE());
      allow delete: if (isLoggedIn() && uidIs(resUid()))
        || hasRole(docWs(), R_TRUSTEE())
        // EVENTS E2: inside a transfer-accept transaction the
        // RECIPIENT deletes the giver's party record — witnessed by
        // the rebound ticket (festRsvpTransferDeleteOk).
        || (isLoggedIn() && festRsvpTransferDeleteOk());
    }

    // EVENTS E2 — seva passes (NEW COLLECTION, flagged to the owner
    // in advance). One record per purchase: the buyer, every named
    // attendee, the itemised amounts and the payment state. Created
    // only by the buyer for themselves, with the quote recomputed
    // here from the plan's stamped maps; updates are the legal
    // one-way transitions only, each key-pinned; deletes denied —
    // a pass is cancelled or refunded, never erased.
    match /event_tickets/{ticketId} {
      allow read: if isLoggedIn()
        && (uidIs(resource.data.get('buyerUid', ''))
          || tkIsTransferTo()
          || hasRole(docWs(), R_ANY_STAFF()));
      allow create: if isLoggedIn() && tkCreateOk();
      // Buyer cancel / wallet refund (the ladder decides the amount).
      allow update: if tkBuyerGuard()
        && tkBuyerCancelOk();
      // Buyer offers a transfer (live passes only).
      allow update: if tkBuyerGuard()
        && tkStateOf(resource.data) in ['paid-wallet', 'pay-at-venue', 'comp']
        && tkTrStateOf(request.resource.data) == 'offered'
        && tkNewGet('transferToUid', '') != ''
        && tkNewGet('transferToUid', '') != tkBuyerOf(resource.data)
        && tkDiff(['transferToUid', 'transferToName', 'transferState', 'offeredAt', 'updatedAt']);
      // Buyer withdraws an offer / dismisses a decline.
      allow update: if tkBuyerGuard()
        && tkTrStateOf(resource.data) in ['offered', 'declined']
        && !('transferToUid' in request.resource.data)
        && tkDiff(['transferToUid', 'transferToName', 'transferState', 'offeredAt', 'updatedAt']);
      // Recipient declines.
      allow update: if isLoggedIn() && tkIsTransferTo()
        && tkTrStateOf(resource.data) == 'offered'
        && tkTrStateOf(request.resource.data) == 'declined'
        && tkDiff(['transferState', 'updatedAt']);
      // Recipient accepts (rebinds buyer + RSVP link, before the start).
      allow update: if isLoggedIn() && tkAcceptOk();
      // Staff mark pay-at-venue money received at the desk.
      allow update: if tkStaffVenue()
        && tkNewGet('venueReceived', false) == true
        && tkDiff(['venueReceived', 'receivedBy', 'receivedAt', 'updatedAt']);
      // Staff desk-refund of a RECEIVED venue payment (full total;
      // the treasury Expense posts through the app path).
      allow update: if tkStaffVenue()
        && tkOldGet('venueReceived', false) == true
        && tkStateOf(request.resource.data) == 'refunded'
        && tkNewGet('refundAmount', 0) == tkTotalOf(resource.data)
        && tkDiff(['paymentState', 'refundAmount', 'refundedAt', 'updatedAt']);
      // Staff desk-cancel of an UNRECEIVED venue pass.
      allow update: if tkStaffVenue()
        && tkOldGet('venueReceived', false) != true
        && tkStateOf(request.resource.data) == 'cancelled'
        && tkDiff(['paymentState', 'updatedAt']);
      // Staff treasury stamp (the real tx id, after posting income).
      allow update: if hasRole(docWs(), R_ANY_STAFF())
        && tkNewGet('treasuryTxId', '') != ''
        && tkDiff(['treasuryTxId', 'treasuryPostedAt', 'updatedAt']);
      allow delete: if false;
    }

    // EVENTS E5 — attendee feedback (NEW COLLECTION, flagged to the
    // owner in advance). One record per attendee per festival, id
    // {festivalId}__{authorUid}. Only a devotee the gate actually
    // checked in may write one — creation is witnessed by their own
    // festival_rsvps record (fbAttendedOk). Free text is visible
    // ONLY to the author and the org's staff; the public festival
    // page can only ever carry the aggregates the committee
    // publishes onto the festival_events doc (feedbackSummary — a
    // shape that cannot hold a name). Moderation is a state, never
    // a delete: the record is the trail.
    function fbRatingOk(v) {
      return v is int && v >= 1 && v <= 5;
    }
    function fbAspectsOk(m) {
      return m.keys().hasAll(['arrangements', 'prasad', 'darshanFlow', 'cleanliness'])
        && m.keys().hasOnly(['arrangements', 'prasad', 'darshanFlow', 'cleanliness'])
        && fbRatingOk(m.get('arrangements', 0))
        && fbRatingOk(m.get('prasad', 0))
        && fbRatingOk(m.get('darshanFlow', 0))
        && fbRatingOk(m.get('cleanliness', 0));
    }
    function fbAttendedOk(fid) {
      return exists(festRsvpPath(fid))
        && get(festRsvpPath(fid)).data.get('checkedIn', false) == true;
    }
    function fbTextOk() {
      return tkNewGet('text', '') is string && tkNewGet('text', '').size() <= 600;
    }
    function fbDayOk() {
      return !('attendedDay' in request.resource.data)
        || (tkNewGet('attendedDay', '') is string && tkNewGet('attendedDay', '').size() <= 10);
    }
    match /event_feedback/{feedbackId} {
      allow read: if (isLoggedIn() && uidIs(resAuthorUid()))
        || hasRole(docWs(), R_STAFF());
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('authorUid', ''))
        && feedbackId == tkNewGet('festivalId', '') + '__' + request.auth.uid
        && newDocWs() != null && newDocWs() != ''
        && tkNewGet('festivalId', '') != ''
        && tkNewGet('authorName', '').size() >= 2
        && tkNewGet('authorName', '').size() <= 80
        && tkNewGet('state', '') == 'visible'
        && !('orgResponse' in request.resource.data)
        && reqKeys().hasAll(['workspaceId', 'festivalId', 'authorUid', 'authorName',
             'aspects', 'overall', 'text', 'wouldReturn', 'createdAt', 'updatedAt', 'state'])
        && reqKeys().hasOnly(['workspaceId', 'festivalId', 'authorUid', 'authorName',
             'aspects', 'overall', 'text', 'wouldReturn', 'attendedDay',
             'createdAt', 'updatedAt', 'state'])
        && fbAspectsOk(tkNewGet('aspects', {}))
        && fbRatingOk(tkNewGet('overall', 0))
        && fbTextOk()
        && tkNewGet('wouldReturn', false) is bool
        && fbDayOk()
        && fbAttendedOk(tkNewGet('festivalId', ''));
      allow update: if (isLoggedIn() && uidIs(resAuthorUid())
          && tkOldGet('state', '') == 'visible'
          && diffKeysOnly(request.resource.data, resource.data,
               ['aspects', 'overall', 'text', 'wouldReturn', 'attendedDay', 'updatedAt'])
          && fbAspectsOk(tkNewGet('aspects', {}))
          && fbRatingOk(tkNewGet('overall', 0))
          && fbTextOk()
          && tkNewGet('wouldReturn', false) is bool
          && fbDayOk())
        || (hasRole(docWs(), R_STAFF())
          && diffKeysOnly(request.resource.data, resource.data,
               ['state', 'orgResponse', 'updatedAt'])
          && tkNewGet('state', '') in ['visible', 'hidden']
          && (!('orgResponse' in request.resource.data)
              || (tkNewGet('orgResponse', {}).keys().hasOnly(['text', 'at', 'byName'])
                  && tkNewGet('orgResponse', {}).get('text', '') is string
                  && tkNewGet('orgResponse', {}).get('text', '').size() <= 600)));
      allow delete: if false;
    }

    // EVENTS P1 — Utsav One team sharing. Until now the whole Utsav
    // committee plan lived in ONE device's localStorage; the War Room
    // proved the mirror pattern (festival_plans) and Utsav follows
    // it: one doc per workspace holding the store snapshot, newer
    // edit wins on both sides. Committee plans are working papers —
    // member-only reads; staff of THAT workspace write.
    // *** NEW COLLECTION: utsav_stores ***
    match /utsav_stores/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || isTenantMember(workspaceId);
      allow create, update: if (demoWriteOk(workspaceId) || hasRole(workspaceId, R_STAFF()))
        && reqWorkspaceId() == workspaceId
        && reqKeys().hasOnly(['workspaceId', 'state', 'updatedAt', 'updatedBy']);
      allow delete: if hasRole(workspaceId, R_TRUSTEE());
    }

    // Inventory & assets
    match /inventory_items/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /inventory/{itemId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_ANY_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /fixed_assets/{assetId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE()) || hasRole(docWs(), R_STAFF());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_FINANCE())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    // Goshala / Dharamshala operations
    match /cows/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /gaushala_cattle/{cattleId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }
    match /dharamshala_rooms/{roomId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create, update: if (demoWriteOk(newDocWs()) || hasRole(newDocWs(), R_STAFF())) && (resource == null || wsImmutable());
      allow delete: if hasRole(docWs(), R_TRUSTEE());
    }

    // One-time QR login pairing tokens â bearer-token pattern (Spark-plan,
    match /qrPairTokens/{tokenId} {
      allow create: if isLoggedIn()
        && reqKeys().hasAll(['memberId', 'workspaceId', 'role', 'expiresAt'])
        && request.resource.data.role in ['Devotee', 'Sevadar', 'Priest', 'Accountant', 'Trustee']
        && (demoWriteOk(newDocWs())
            || hasRole(newDocWs(), R_ANY_STAFF()))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(600, 's');
      allow get, delete: if request.time < resource.data.expiresAt;
      allow list, update: if false;
    }

    // Generic operational collections (annadanam, campaigns, check-ins...)
    match /{collection}/{docId} {
      allow read: if collection in UTSAV_COLLECTIONS()
        && (demoPublicRead(docWs()) || isTenantMember(docWs()));
      allow create: if collection in UTSAV_COLLECTIONS()
        && (demoWriteOk(newDocWs()) || (isTenantMember(newDocWs()) && roleIn(R_ANY_STAFF())));
      allow update: if collection in UTSAV_COLLECTIONS()
        && (demoWriteOk(docWs()) || (isTenantMember(docWs()) && roleIn(R_ANY_STAFF()))) && wsImmutable();
      allow delete: if collection in UTSAV_COLLECTIONS()
        && hasRole(docWs(), R_TRUSTEE());
    }

    // Audit logs â append-only, actor-bound. Owner gets full read + write
    match /audit_logs/{logId} {
      allow read: if isOwner() || demoPublicRead(docWs()) || hasRole(docWs(), R_FINANCE());
      allow create: if (isOwner() && uidIs(tkNewGet('actorUid', '')))
        || ((demoWriteOk(newDocWs()) || isTenantMember(newDocWs()))
          && uidIs(tkNewGet('actorId', '')));
      allow update, delete: if false;
    }

    // Verification applications â owner-reviewed, never client-writable beyond apply.
    match /verificationApplications/{appId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('applicantUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    // Moderation reports â reporter can file, only owner sees and acts.
    match /moderationReports/{reportId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('reporterUid', ''));
      allow update: if isOwner();
      allow delete: if false;
    }

    // Moderation hide directives â read-only for clients, enforced in UI.
    match /moderationHides/{hideId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Reminder queue -- scheduler writes via Admin SDK; recipients read
    // their own items and may mark them sent (status field only).
    match /reminderQueue/{reminderId} {
      // Field alignment (owner-approved 2026-10-20): the server scheduler
      // writes ownerUid (samskara/shraddha routes) while the client drain
      // keys targetUid -- an item belongs to the recipient when EITHER
      // field names them.
      allow read: if isLoggedIn()
        && (uidIs(tkOldGet('targetUid', ''))
          || uidIs(tkOldGet('ownerUid', '')));
      // The recipient may mark their own item sent -- the status field
      // only, set to 'sent'; nothing else may change.
      allow update: if isLoggedIn()
        && (uidIs(tkOldGet('targetUid', ''))
          || uidIs(tkOldGet('ownerUid', '')))
        && diffKeysOnly(request.resource.data, resource.data, ['status'])
        && reqStatus() == 'sent';
      allow create, delete: if false; // scheduler writes via Admin SDK only
    }

    // ---- Manual billing (bKash / Nagad / UPI / PhonePe) ----
    match /paymentMethods/{methodId} {
      allow read: if true;
      allow create, update, delete: if isOwner(); // owner writes via Admin SDK only
    }

    // Payment claims: any authenticated member files their own claim; only the
    match /paymentClaims/{claimId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && uidIs(tkOldGet('applicantUid', '')))
        // QUEUED #54 (owner-approved companion): the org's own finance
        // roles may read claims filed for their workspace, so Settings →
        // Billing history can list the org's claims (query
        // where('workspaceId','==',wsId)) alongside its upgrade requests.
        // hasRole ANDs tenant membership, so cross-org reads stay
        // impossible; claims with workspaceId 'personal' fail closed
        // (hasRole('personal', …) is false) and remain applicant-only.
        || (isLoggedIn() && hasRole(tkOldGet('workspaceId', ''), R_FINANCE()));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('applicantUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }

    // Subscriptions: readable by owner or workspace members; owner activates
    match /subscriptions/{workspaceId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isSelf(workspaceId))
        || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Workspace treasury summaries (QUEUED #40 design; owner-approved
    // 2026-10-22): one maintained aggregate doc per workspace so large
    // orgs get exact money totals without full-ledger reads. The doc
    // carries its own workspaceId field (newDocWs/wsImmutable pin it).
    // Finance roles of that workspace only — member-level read would
    // leak treasury totals; delete is never allowed.
    match /workspaceSummaries/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || hasRole(workspaceId, R_OVERSIGHT());
      allow create, update: if hasRole(newDocWs(), R_FINANCE()) && (resource == null || wsImmutable());
      allow delete: if false;
    }

    // Master audit stream (Blueprint A): append-only, hash-chained
    // auditEvents written by the data layer at every commit point
    // (treasury, devotees, bookings, inventory, settings, sample
    // purge, publish/unpublish). A member may only ever write events
    // AS THEMSELVES (actorUid == request.auth.uid — no impersonation),
    // and no one can update or delete an event: the stream is the
    // forensic record. Reads are finance/oversight roles of that
    // workspace (a member-level read would expose everyone's history).
    match /auditEvents/{eventId} {
      allow read: if demoPublicRead(docWs()) || hasRole(docWs(), R_OVERSIGHT());
      allow create: if (demoWriteOk(newDocWs()) || isTenantMember(newDocWs()))
        && uidIs(tkNewGet('actorUid', ''));
      allow update, delete: if false;
    }

    // Cash custody sync (owner-approved 2026-10-23): ONE maintained
    // state doc per workspace (boxes, sessions, the SHA-256 custody
    // chain, deposit slips, roster) written by the Cash Custody desk
    // so custody survives device loss and oversight can review from
    // a second device. The doc carries its own workspaceId field
    // (newDocWs/wsImmutable pin it) and the writer pins savedByUid
    // to themselves — no syncing a state copy as someone else.
    // Finance roles write; oversight roles read (R_OVERSIGHT
    // includes the read-only Auditor — visibility, never a write);
    // delete is never allowed: the custody record is evidence. The
    // client treats this copy as fail-open — the on-device copies
    // stay canonical whenever the cloud path is unavailable.
    match /cashCustodyStates/{workspaceId} {
      allow read: if demoPublicRead(workspaceId) || hasRole(workspaceId, R_OVERSIGHT());
      allow create, update: if hasRole(newDocWs(), R_FINANCE()) && (resource == null || wsImmutable()) && uidIs(tkNewGet('savedByUid', ''));
      allow delete: if false;
    }

    // Published monthly accounts (Blueprint A): the public
    // Transparency Board. A document exists ONLY because a finance
    // role published that month — unpublished months have no
    // document at all — so reads are public, like orgPages. Publish,
    // republish and unpublish (delete) are finance roles of that
    // workspace; update keeps the workspaceId pinned (wsImmutable).
    match /publishedAccounts/{docId} {
      allow read: if true;
      allow create: if hasRole(newDocWs(), R_FINANCE());
      allow update: if hasRole(docWs(), R_FINANCE()) && wsImmutable();
      allow delete: if hasRole(docWs(), R_FINANCE());
    }

    // Maker-checker approvals (Blueprint B): sensitive changes
    // (treasury payouts at/above the workspace threshold, payment
    // detail changes, gated role grants) are filed as PENDING
    // requests and take effect only after a DIFFERENT oversight
    // member decides. Separation of duties is encoded here, not
    // just in the client: the decision branch requires an
    // oversight role AND decidedBy == caller AND decidedBy !=
    // requestedBy, from PENDING, touching ONLY the decision
    // fields; the apply-marker branch may touch ONLY
    // appliedAt/applyError and cannot move the decision; the
    // maker alone may cancel their own PENDING request. Deletes
    // are never allowed — the request log is governance record,
    // and every step is mirrored into the hash-chained
    // auditEvents stream by the client.
    match /approvalRequests/{requestId} {
      allow read: if demoPublicRead(docWs())
        || hasRole(docWs(), R_OVERSIGHT())
        || (isLoggedIn() && uidIs(tkOldGet('requestedBy', '')));
      allow create: if isTenantMember(newDocWs())
        && uidIs(tkNewGet('requestedBy', ''))
        && reqStatus() == 'PENDING';
      allow update: if
        // Checker decision — oversight, not the maker, from
        // PENDING, decision fields only.
        (hasRole(docWs(), R_OVERSIGHT())
          && resStatus() == 'PENDING'
          && reqStatus() in ['APPROVED', 'REJECTED']
          && uidIs(tkNewGet('decidedBy', ''))
          && tkNewGet('decidedBy', '') != tkOldGet('requestedBy', '')
          && diffKeys()
            .hasOnly(DECISION_KEYS())
          && wsImmutable())
        // Apply marker — the approved change was applied (or
        // failed); the decision itself cannot move here.
        || (hasRole(docWs(), R_OVERSIGHT())
          && resStatus() == 'APPROVED'
          && reqStatus() == 'APPROVED'
          && diffKeys()
            .hasOnly(['appliedAt', 'applyError'])
          && wsImmutable())
        // Maker cancel — own request, still pending.
        || (isLoggedIn()
          && uidIs(tkOldGet('requestedBy', ''))
          && resStatus() == 'PENDING'
          && reqStatus() == 'CANCELLED'
          && diffKeys()
            .hasOnly(DECISION_KEYS())
          && wsImmutable());
      allow delete: if false;
    }

    // ---- Messaging ----
    match /messages/{messageId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && uidIs(tkOldGet('targetUid', '')));
      allow create: if isOwner();
      allow update: if isLoggedIn()
        && uidIs(tkOldGet('targetUid', ''))
        && diffKeysOnly(request.resource.data, resource.data, ['read', 'readAt']);
      allow delete: if false;
    }

    // Campaigns, scheduled messages, templates: owner-only reads; owner writes
    match /messageCampaigns/{campaignId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /scheduledMessages/{schedId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /messageTemplates/{templateId} {
      allow read: if isSuperAdmin() || isOwner();
      // Owner manages templates from the Console 3.0 Content Manager.
      allow create, update, delete: if isOwner();
    }
    // ---- Console 3.0: commission, content, settings, support ----

    // Commission rules: public read so the future marketplace UI can show
    match /commissionRules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Platform config (commission tier rates etc): public read so booking
    match /platformConfig/{configId} {
      allow read: if configId != 'public';
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // API Keys — GodMode "API Keys" tab (owner-managed third-party keys).
    // Two tiers by design: client-safe keys are published to the 'public'
    // doc below (readable by signed-in clients — anything on a phone is
    // visible in the network tab); server-only secrets stay owner-only and
    // can never reach a client on the current plan (no backend).
    match /platformConfig/apiKeys/{keyId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }
    // Published subset: ONLY client-safe && enabled keys, written by the
    // owner via "Publish to app". Authenticated read; owner-only write.
    match /platformConfig/public {
      allow read: if isLoggedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // Geo payment regions: owner-configured payment rails (BD / IN / INTL +
    // any custom regions added from GodMode → Geo Payments). Every signed-in
    // user reads this to pick payment rails; reads that fail or miss fall
    // back to the hardcoded defaults client-side. Writes are owner-only.
    match /geoPaymentConfig/config {
      allow read: if isLoggedIn();
      allow create, update: if isOwner()
        && reqKeys().hasOnly(
          ['regions', 'defaultRegion', 'updatedAt', 'updatedBy'])
        && tkNewGet('regions', []) is list
        && tkNewGet('regions', []).size() >= 1
        && tkNewGet('regions', []).size() <= 50
        && tkNewGet('defaultRegion', '') is string;
      allow delete: if false;
    }
    // Append-only audit: who changed which key, when. Values never logged.
    match /platformConfig/apiKeysAudit/{auditId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    // Marketplace transactions: owner-only. Written by the future booking
    match /marketplaceTransactions/{txnId} {
      allow read: if isSuperAdmin() || isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // Payouts: providers request via their own doc (future), owner decides.
    match /payouts/{payoutId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && uidIs(resProviderUid()));
      allow create: if isOwner()
        || (isLoggedIn()
          && uidIs(reqProviderUid())
          && reqStatus() == 'requested');
      allow update: if isOwner()
        || (isLoggedIn()
          && uidIs(resProviderUid())
          && reqStatus() == 'requested');
      allow delete: if false;
    }
    // Announcements: active ones are public so the app can render banners.
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Site content (landing page KV): public read, owner writes.
    match /siteContent/{key} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Feature flags: logged-in clients read (the app gates modules on these);
    match /featureFlags/{flagId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isOwner();
    }
    // Plans: public read so pricing pages stay in sync; owner edits.
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Payment methods: public read so billing pages can render them;
    match /marketplaceGigs/{gigId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(reqProviderUid())
        && tkNewGet('active', true) == true;
      allow update: if isOwner()
        || (isLoggedIn()
          && uidIs(resProviderUid())
          && uidIs(reqProviderUid())
          // SECURITY P1: the provider's own edits may not move the
          // rating aggregates -- those change only via the anchored
          // blessing branch below.
          && tkNewGet('avgRating', 0) == tkOldGet('avgRating', 0)
          && reqRatingCount() == tkOldGet('ratingCount', 0))
        // Step 7 (gig ratings) -- SECURITY P1 anchored form (see
        // p1GigRatingOk): a devotee's blessing may nudge the aggregate
        // ONLY when the same transaction creates the gigRatings doc
        // named by lastRatedOrderId, for this gig, by this caller,
        // with ratingCount exactly +1 and the average stepped by that
        // rating. The gigRatings doc (auditable, one per order) is the
        // source of truth.
        || (isLoggedIn()
          && diffKeysOnly(request.resource.data, resource.data, ['avgRating', 'ratingCount', 'updatedAt', 'lastRatedOrderId'])
          && reqProviderUid() == resProviderUid()
          && tkNewGet('avgRating', 0) >= 1
          && tkNewGet('avgRating', 0) <= 5
          && p1GigRatingOk(gigId));
      allow delete: if isOwner();
    }
    // gigRatings: one blessing per completed order (doc ID = orderId).
    // Public read (trust display); create restricted to the order's client
    // on a completed order; immutable after (no update/delete).
    match /gigRatings/{orderId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('clientUid', ''))
        && reqRating() >= 1
        && reqRating() <= 5
        && reqKeys().hasOnly(
          ['gigId', 'orderId', 'clientUid', 'providerUid', 'rating', 'review', 'createdAt'])
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.status == 'completed'
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.clientUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Orders: client creates (clientUid must match); provider + client read
    match /marketplaceOrders/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(resClientUid())
          || uidIs(resProviderUid())));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('clientUid', ''))
        && reqStatus() == 'pending_payment';
      allow update: if isOwner()
        || (isLoggedIn()
          && tkNewGet('commissionPercent', 0) == tkOldGet('commissionPercent', 0)
          && tkNewGet('commissionAmount', 0) == tkOldGet('commissionAmount', 0)
          && tkNewGet('providerNet', 0) == tkOldGet('providerNet', 0)
          && (
          // Provider: accept / decline / progress; 'completed' only from a live status
          (uidIs(resProviderUid())
            && reqStatus() in ['accepted', 'cancelled', 'in_progress', 'completed']
            && (reqStatus() != 'completed'
              || resStatus() in ORDER_ACTIVE()))
          // Provider (pay-after-task): task done, now awaiting the platform commission
          || (uidIs(resProviderUid())
            && tkOldGet('payAfterTask', false) == true
            && reqStatus() == 'awaiting_commission'
            && resStatus() in ORDER_ACTIVE())
          // Provider (Rail-2): dispute a payment proof â back to pending_payment
          || (uidIs(resProviderUid())
            && tkOldGet('rail', '') == 'rail2'
            && reqStatus() == 'pending_payment'
            && tkNewGet('rail2Proof', {}).get('disputed', false) == true)
          // Client: confirm completion (only from a live status), or cancel
          || (uidIs(resClientUid())
            && reqStatus() in ['completed', 'cancelled']
            && (reqStatus() != 'completed'
              || resStatus() in ORDER_ACTIVE()))
          // Client (wallet): pay from wallet â pending_payment becomes paid.
          || (uidIs(resClientUid())
            && tkOldGet('payWithWallet', false) == true
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkNewGet('escrowHeld', 0) == tkOldGet('amountGross', 0))
          // Client (Rail-2): submit payment proof â pending_payment becomes paid
          || (uidIs(resClientUid())
            && tkOldGet('rail', '') == 'rail2'
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkNewGet('rail2Proof', {}).get('trxId', '') != '')
          // AUDIT FIX #4 (2026-10-19): Provider (Rail-1): confirm direct
          // payment received (bKash/Nagad/UPI/cash moved outside the app) --
          // pending_payment becomes paid. Rail-1 had no paid path at all.
          || (uidIs(resProviderUid())
            && resStatus() == 'pending_payment'
            && reqStatus() == 'paid'
            && tkOldGet('rail', '') == 'rail1'
            && tkOldGet('payWithWallet', false) == false
            && diffKeysOnly(request.resource.data, resource.data, ['status', 'paidAt', 'paymentNote', 'updatedAt']))
          // PHASE 3 â dispute freeze: an order party moves an ACTIVE order to
          || (isLoggedIn()
            && (uidIs(resProviderUid())
              || uidIs(resClientUid()))
            && resStatus() in ORDER_ACTIVE()
            && reqStatus() == 'commission_held'
            && tkNewGet('commissionHold', {}).get('frozenByUid', '') == request.auth.uid)
          // openDispute(): an order party flags an ACTIVE order 'disputed'.
          // The dispute record itself lives in marketplaceDisputes (ruled
          // separately); on the order only status + updatedAt may change here.
          || (isLoggedIn()
            && (uidIs(resProviderUid())
              || uidIs(resClientUid()))
            && resStatus() in ORDER_ACTIVE()
            && reqStatus() == 'disputed'
            && diffKeysOnly(request.resource.data, resource.data, KEYS_STATUS_ONLY()))));
      allow delete: if false;
    }
    // Commission freeze requests (Phase 3): dispute on a COMPLETED order,
    match /commissionFreezeRequests/{orderId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('requestedBy', ''))
        && reqStatus() == 'requested'
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('status', '') == 'completed'
        && (get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid);
      allow update: if isOwner();
      allow delete: if false;
    }
    // Rail-2 provider sequence counter (unique TrxID reference numbering).
    match /rail2Sequences/{providerUid} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn()
        && reqKeys().hasOnly(['seq', 'updatedAt'])
        && tkNewGet('seq', 0) is int;
    }
    // Disputes: either party on the order may open; owner resolves.
    match /marketplaceDisputes/{disputeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(tkOldGet('raisedByUid', ''))
          || uidIs(resProviderUid())
          || uidIs(resClientUid())));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('raisedByUid', ''))
        && reqStatus() == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Commission overrides: public read (marketplace shows "platform fee X%");
    match /commissionOverrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Platform config (maintenance mode etc.): public read of the main doc.

    // ---- Marketplace anti-bypass + provider payments ----
    match /providerPaymentMethods/{mId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resProviderUid()));
      allow create: if isLoggedIn()
        && uidIs(reqProviderUid())
        && reqStatus() in ['pending', 'platform_assigned'];
      allow update: if isOwner();
      allow delete: if false;
    }
    // Provider â owner inquiries: provider creates + reads own; owner manages.
    match /providerInquiries/{inqId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resProviderUid()));
      allow create: if isLoggedIn()
        && uidIs(reqProviderUid())
        && reqStatus() == 'open';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Bypass flags: the sender's own client creates the flag when a message
    match /bypassFlags/{flagId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('senderUid', ''))
        && reqStatus() == 'pending';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Bypass keyword patterns: public read (clients need them to scan);
    match /bypassKeywords/{kwId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    // Provider strikes: owner-only writes; provider reads own (transparency).
    match /providerStrikes/{strikeId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resProviderUid()));
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // ---- Rail-2: platform dues (Layer 6) ----
    match /platformDues/{dueId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resProviderUid()));
      allow create: if isLoggedIn()
        && reqStatus() == 'pending'
        && reqProviderUid() ==
           get(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId())).data.get('providerUid', '')
        && get(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId())).data.get('rail', '') == 'rail2';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Provider marketplace profile (dues suspension flags): owner writes,
    match /marketplaceProviders/{providerUid} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(providerUid));
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // ---- Platform wallet + escrow top-up system ----
    function walletDebitOk() {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastDebitOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let gross = get(opath).data.get('amountGross', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastDebitOrderId', '')
        && exists(opath)
        && get(opath).data.get('clientUid', '') == request.auth.uid
        && get(opath).data.get('payWithWallet', false) == true
        && get(opath).data.get('status', '') == 'pending_payment'
        && gross > 0
        && data.get('balance', -1) == old.get('balance', 0) - gross
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + gross;
    }
    // P2P "Pay from Seva Wallet" (atomic client debit): the sender settles
    // an ACCEPTED money request with a real debit of their OWN wallet.
    // Anchored to the live p2pRequests doc â same idempotency pattern as
    // walletDebitOk: lastDebitP2PRequestId must change, so a replay or a
    // double-tap can never debit twice. Rules get() reads committed state,
    // so the transaction's own requestâ'paid' flip is invisible here; the
    // request leg is validated by the p2pRequests match below.
    function p2pSettlementDebitOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let requestId = data.get('lastDebitP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let amount = get(rpath).data.get('amount', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastDebitP2PRequestId', 'currency'])
        && requestId != '' && requestId != old.get('lastDebitP2PRequestId', '')
        && exists(rpath)
        && get(rpath).data.get('senderId', '') == request.auth.uid
        && get(rpath).data.get('senderId', '') == uid
        && get(rpath).data.get('status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == old.get('balance', 0) - amount
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + amount;
    }
    // P2P settlement credit (receiver side): the sender's transaction
    // credits wallets/{receiverUid} via blind merge-set + increment().
    // Anchored to the live p2pRequests doc — receiver-bound, exact
    // amount, currency pinned, one credit per request
    // (lastCreditP2PRequestId). Mirrors p2pSettlementDebitOk.
    function p2pSettlementCreditOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = get(rpath).data;
      let amount = rdata.get('amount', 0);
      return diffKeysOnly(data, old, 
          ['uid', 'balance', 'currency', 'totalToppedUp', 'totalSpent',
           'totalReceived', 'lastCreditP2PRequestId', 'updatedAt'])
        && requestId != '' && requestId != old.get('lastCreditP2PRequestId', '')
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && uidIs(rdata.get('senderId', ''))
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('currency', '') == old.get('currency', '')
        && data.get('balance', -1) == old.get('balance', 0) + amount
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + amount
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }
    // Create-path for the P2P receiver credit: the wallet doc may not
    // exist yet when the first settlement arrives.
    function p2pSettlementCreditCreateOk(uid) {
      let data = request.resource.data;
      let requestId = data.get('lastCreditP2PRequestId', '');
      let rpath = /databases/$(database)/documents/p2pRequests/$(requestId);
      let rdata = get(rpath).data;
      let amount = rdata.get('amount', 0);
      return requestId != ''
        && exists(rpath)
        && rdata.get('receiverId', '') == uid
        && uidIs(rdata.get('senderId', ''))
        && rdata.get('status', '') == 'accepted'
        && amount > 0
        && data.get('balance', -1) == amount
        && data.get('currency', '') == rdata.get('currency', '')
        && data.get('totalReceived', -1) == amount
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    function walletCreditOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = get(opath).data.get('providerNet', 0);
      return diffKeysOnly(data, old, ['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastCreditOrderId', 'currency', 'uid'])
        && orderId != '' && orderId != old.get('lastCreditOrderId', '')
        && exists(opath)
        && get(opath).data.get('providerUid', '') == uid
        && (get(opath).data.get('clientUid', '') == request.auth.uid
          || get(opath).data.get('providerUid', '') == request.auth.uid)
        && get(opath).data.get('status', '') in ORDER_ACTIVE()
        && net > 0
        && data.get('balance', -1) == old.get('balance', 0) + net
        && data.get('totalReceived', -1) == old.get('totalReceived', 0) + net
        && data.get('totalToppedUp', -1) == old.get('totalToppedUp', 0)
        && data.get('totalSpent', -1) == old.get('totalSpent', 0);
    }
    // PHASE 3 â provider commission debit, order-anchored.
    function commissionHoldOk(uid) {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let order = get(opath).data;
      let cap = order.get('commissionAmount', 0);
      let debit = old.get('balance', 0) - data.get('balance', 0);
      return diffKeysOnly(data, old, ['balance', 'totalSpent', 'updatedAt', 'lastCommissionOrderId', 'currency'])
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && order.get('providerUid', '') == uid
        && uidIs(order.get('providerUid', ''))
        && order.get('status', '') in ORDER_ACTIVE()
        && cap > 0
        && debit > 0 && debit <= cap
        && data.get('balance', -1) >= 0
        && data.get('totalSpent', -1) == old.get('totalSpent', 0) + debit;
    }
    // PHASE 3 â Pratham Seva counter advancement, order-anchored.
    function sevaProfileCompletionOk() {
      let data = request.resource.data;
      let old = resource.data;
      let orderId = data.get('lastCommissionOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let freeOld = old.get('freeSevasRemaining', 0);
      let freeNew = data.get('freeSevasRemaining', -1);
      return uidIs(resUid())
        && diffKeysOnly(data, old, ['freeSevasRemaining', 'completedSevasSinceVerified', 'lastCommissionOrderId', 'updatedAt'])
        && data.get('completedSevasSinceVerified', -1) == old.get('completedSevasSinceVerified', 0) + 1
        && (freeNew == freeOld || (freeOld > 0 && freeNew == freeOld - 1))
        && orderId != '' && orderId != old.get('lastCommissionOrderId', '')
        && exists(opath)
        && get(opath).data.get('providerUid', '') == request.auth.uid
        && get(opath).data.get('status', '') in ORDER_ACTIVE();
    }
    // SECURITY P1 -- anchored rating steps (Finding 1). A rating
    // aggregate may move ONLY as the second half of a real rating: the
    // same batch/transaction creates the rating doc named by the
    // anchor field; that doc belongs to the caller and to this
    // gig/profile; the count rises by exactly 1; the anchor must name
    // a NEW rating; and the new average must be the old sum plus that
    // rating (tolerance covers the 1-dp rounding drift). Mirrors the
    // order-anchored precedent of sevaProfileCompletionOk above.
    function p1GigRatingOk(gigId) {
      let rid = tkNewGet('lastRatedOrderId', '');
      let rpath = /databases/$(database)/documents/gigRatings/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('avgRating', 0) * newCount;
      let oldSum = tkOldGet('avgRating', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastRatedOrderId', '')
        && existsAfter(rpath)
        && getAfter(rpath).data.get('gigId', '') == gigId
        && getAfter(rpath).data.get('clientUid', '') == request.auth.uid
        && newCount == oldCount + 1
        && newSum >= oldSum + getAfter(rpath).data.get('rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + getAfter(rpath).data.get('rating', 0) + (0.06 * newCount + 0.1);
    }
    function p1PurohitRatingOk(purohitId) {
      let rid = tkNewGet('lastReviewId', '');
      let rpath = /databases/$(database)/documents/reviews/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('ratingAggregate', 0) * newCount;
      let oldSum = tkOldGet('ratingAggregate', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastReviewId', '')
        && existsAfter(rpath)
        && getAfter(rpath).data.get('reviewerUid', '') == request.auth.uid
        && getAfter(rpath).data.get('reviewerKind', '') == 'devotee'
        && get(/databases/$(database)/documents/gigs/$(getAfter(rpath).data.get('gigId', ''))).data.get('assignedPurohitId', '') == purohitId
        && newCount == oldCount + 1
        && newSum >= oldSum + getAfter(rpath).data.get('rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + getAfter(rpath).data.get('rating', 0) + (0.06 * newCount + 0.1);
    }
    function p1JyotishRatingOk(jyotishId) {
      let rid = tkNewGet('lastReviewId', '');
      let rpath = /databases/$(database)/documents/jyotishReviews/$(rid);
      let newCount = reqRatingCount();
      let oldCount = tkOldGet('ratingCount', 0);
      let newSum = tkNewGet('ratingAggregate', 0) * newCount;
      let oldSum = tkOldGet('ratingAggregate', 0) * oldCount;
      return rid != '' && rid != tkOldGet('lastReviewId', '')
        && existsAfter(rpath)
        && getAfter(rpath).data.get('reviewerUid', '') == request.auth.uid
        && getAfter(rpath).data.get('reviewerKind', '') == 'devotee'
        && get(/databases/$(database)/documents/jyotishConsultations/$(getAfter(rpath).data.get('consultationId', ''))).data.get('assignedJyotishId', '') == jyotishId
        && newCount == oldCount + 1
        && newSum >= oldSum + getAfter(rpath).data.get('rating', 0) - (0.06 * newCount + 0.1)
        && newSum <= oldSum + getAfter(rpath).data.get('rating', 0) + (0.06 * newCount + 0.1);
    }
    // JY-FIX-B (JY-04) -- anchored endorsement step: endorsementCount
    // may rise ONLY by exactly +1, naming (in lastEndorsementId) a NEW
    // endorsement doc for THIS profile, created in the same
    // transaction (endorseJyotish writes both atomically). Mirrors
    // p1JyotishRatingOk's shape. Without this anchor the tier-claim
    // branch below could be fed a self-inflated count.
    function p1JyotishEndorsementOk(jyotishId) {
      let eid = request.resource.data.get('lastEndorsementId', '');
      let epath = /databases/$(database)/documents/jyotishEndorsements/$(eid);
      return eid != '' && eid != resource.data.get('lastEndorsementId', '')
        && existsAfter(epath)
        && getAfter(epath).data.get('jyotishId', '') == jyotishId
        && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0) + 1;
    }
    // JY-FIX-B (JY-04) -- the tier claim: the target tier must be
    // EARNED by the doc's own anchored fields, mirroring the client
    // ladder (types/purohit.computeEffectiveTier, post-JY-05):
    // ORG_ENDORSED needs CREDENTIAL_VERIFIED + at least 1 anchored
    // endorsement; PLATFORM_VERIFIED additionally needs the merit bar
    // (at least 10 completed consultations at a 4.5+ aggregate — both
    // anchored fields themselves). A legacy 'VERIFIED' value (the
    // SevaPro dialect GodMode once stamped, = CREDENTIAL_VERIFIED)
    // may claim, which also heals the stored value to canonical.
    function jyotishTierClaimOk() {
      let from = tkOldGet('verificationTier', '');
      let to = reqVerificationTier();
      let endorsements = resource.data.get('endorsementCount', 0);
      let gigs = tkOldGet('completedConsultations', 0);
      let rating = tkOldGet('ratingAggregate', 0);
      return (to == 'ORG_ENDORSED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'VERIFIED')
          && endorsements >= 1)
        || (to == 'PLATFORM_VERIFIED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'ORG_ENDORSED' || from == 'VERIFIED')
          && endorsements >= 1 && gigs >= 10 && rating >= 4.5);
    }
    // PUROHIT-PARITY (mirrors JY-FIX-B / JY-04 above) -- anchored
    // endorsement step for purohits: endorsementCount may rise ONLY by
    // exactly +1, naming (in lastEndorsementId) a NEW endorsement doc
    // for THIS profile, created in the same transaction
    // (endorsePurohit writes both atomically). The endorsement docs
    // live in the top-level `endorsements` collection (the purohit
    // twin of jyotishEndorsements). Mirrors p1JyotishEndorsementOk.
    function p1PurohitEndorsementOk(purohitId) {
      let eid = request.resource.data.get('lastEndorsementId', '');
      let epath = /databases/$(database)/documents/endorsements/$(eid);
      return eid != '' && eid != resource.data.get('lastEndorsementId', '')
        && existsAfter(epath)
        && getAfter(epath).data.get('purohitId', '') == purohitId
        && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0) + 1;
    }
    // PUROHIT-PARITY -- the purohit tier claim: the target tier must
    // be EARNED by the doc's own anchored fields, mirroring the client
    // ladder (types/purohit.computeEffectiveTier, post-JY-05):
    // ORG_ENDORSED needs CREDENTIAL_VERIFIED + at least 1 anchored
    // endorsement; PLATFORM_VERIFIED additionally needs the merit bar
    // (at least 10 completed gigs at a 4.5+ aggregate — both anchored
    // fields themselves). A legacy 'VERIFIED' value (the SevaPro
    // dialect GodMode once stamped, = CREDENTIAL_VERIFIED) may claim,
    // which also heals the stored value to canonical. Mirrors
    // jyotishTierClaimOk with the purohit merit field (completedGigs).
    function purohitTierClaimOk() {
      let from = tkOldGet('verificationTier', '');
      let to = reqVerificationTier();
      let endorsements = resource.data.get('endorsementCount', 0);
      let gigs = resource.data.get('completedGigs', 0);
      let rating = tkOldGet('ratingAggregate', 0);
      return (to == 'ORG_ENDORSED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'VERIFIED')
          && endorsements >= 1)
        || (to == 'PLATFORM_VERIFIED'
          && (from == 'CREDENTIAL_VERIFIED' || from == 'ORG_ENDORSED' || from == 'VERIFIED')
          && endorsements >= 1 && gigs >= 10 && rating >= 4.5);
    }
    // SECURITY P1 -- completed-count anchors: the owner's own +1 is
    // legal only when it names (in lastCompletedGigId /
    // lastCompletedConsultationId) a NEWLY cited engagement that is
    // really theirs and really COMPLETED.
    function p1CompletedGigOk() {
      let gid = tkNewGet('lastCompletedGigId', '');
      let gpath = /databases/$(database)/documents/gigs/$(gid);
      return request.resource.data.get('completedGigs', 0) == resource.data.get('completedGigs', 0) + 1
        && gid != '' && gid != tkOldGet('lastCompletedGigId', '')
        && exists(gpath)
        && get(gpath).data.get('assignedPurohitUid', '') == request.auth.uid
        && get(gpath).data.get('status', '') in ORDER_DONE();
    }
    function p1CompletedConsultationOk() {
      let cid = tkNewGet('lastCompletedConsultationId', '');
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(cid);
      return tkNewGet('completedConsultations', 0) == tkOldGet('completedConsultations', 0) + 1
        && cid != '' && cid != tkOldGet('lastCompletedConsultationId', '')
        && exists(cpath)
        && get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid
        && get(cpath).data.get('status', '') in ORDER_DONE();
    }
    // Create-path for provider credit: the wallet doc may not exist yet when
    function walletCreditCreateOk(uid) {
      let data = request.resource.data;
      let orderId = data.get('lastCreditOrderId', '');
      let opath = /databases/$(database)/documents/marketplaceOrders/$(orderId);
      let net = get(opath).data.get('providerNet', 0);
      return orderId != ''
        && exists(opath)
        && get(opath).data.get('providerUid', '') == uid
        && (get(opath).data.get('clientUid', '') == request.auth.uid
          || get(opath).data.get('providerUid', '') == request.auth.uid)
        && get(opath).data.get('status', '') in ORDER_ACTIVE()
        && net > 0
        && data.get('balance', -1) == net
        && data.get('totalReceived', -1) == net
        && data.get('totalToppedUp', -1) == 0
        && data.get('totalSpent', -1) == 0;
    }
    match /wallets/{uid} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(uid));
      allow create: if isOwner()
        || (isLoggedIn() && uidIs(uid)
          && request.resource.data.get('balance', -1) == 0
          && request.resource.data.get('totalToppedUp', -1) == 0
          && request.resource.data.get('totalSpent', -1) == 0)
        || (isLoggedIn() && walletCreditCreateOk(uid))
        || (isLoggedIn() && p2pSettlementCreditCreateOk(uid))
        || (isLoggedIn() && referralWalletCreditCreateOk(uid));
      allow update: if isOwner()
        || (isLoggedIn() && uidIs(uid) && walletDebitOk())
        || (isLoggedIn() && uidIs(uid) && p2pSettlementDebitOk(uid))
        || (isLoggedIn() && uidIs(uid) && commissionHoldOk(uid))
        || (isLoggedIn() && walletCreditOk(uid))
        || (isLoggedIn() && p2pSettlementCreditOk(uid))
        || (isLoggedIn() && referralWalletCreditOk(uid))
        // EVENTS E2: seva-pass purchase debit + refund credit,
        // each anchored on its ticket (same batch, getAfter).
        || (isLoggedIn() && uidIs(uid) && tkWalletDebitOk())
        || (isLoggedIn() && uidIs(uid) && tkWalletRefundOk(uid));
      allow delete: if false;
    }
    // Wallet transactions: append-only ledger. Clients record their own
    match /walletTransactions/{txnId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resUid()));
      allow create: if isOwner()
        || (isLoggedIn()
          && uidIs(reqUid())
          && request.resource.data.get('type', '') in ['spend', 'topup_request']
          && reqAmount() > 0)
        || (isLoggedIn()
          && request.resource.data.get('type', '') in ['receive', 'commission']
          && reqOrderId() != ''
          && (get(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId())).data.get('clientUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/marketplaceOrders/$(reqOrderId())).data.get('providerUid', '') == request.auth.uid))
        // Seva Pro Phase 4: referral guidance credit, anchored to the validated credit doc.
        || (isLoggedIn()
          && request.resource.data.get('type', '') == 'referral_credit'
          && reqUid() != ''
          && request.resource.data.get('creditId', '') != ''
          && reqAmount() > 0
          && exists(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', '')))
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('referrerUid', '') == reqUid()
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('status', '') == 'SETTLED'
          && get(/databases/$(database)/documents/referralCredits/$(request.resource.data.get('creditId', ''))).data.get('creditAmount', 0) == reqAmount())
        // P2P settlement receiver receipt: the sender's transaction writes
        // the receiver's audit-trail doc. Anchored to the live p2pRequests
        // doc — sender-bound, receiver-bound, exact amount, still accepted.
        || (isLoggedIn()
          && request.resource.data.get('type', '') == 'p2p_receive'
          && request.resource.data.get('requestId', '') != ''
          && reqAmount() > 0
          && reqUid() != request.auth.uid
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('senderId', '') == request.auth.uid
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('receiverId', '') == reqUid()
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('amount', 0) == reqAmount()
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('currency', '') == request.resource.data.get('currency', '')
          && get(/databases/$(database)/documents/p2pRequests/$(request.resource.data.get('requestId', ''))).data.get('status', '') == 'accepted')
        // EVENTS E2: the refund ledger line of a seva-pass cancel —
        // anchored to the refunded ticket (tkRefundLedgerOk).
        || (isLoggedIn()
          && uidIs(reqUid())
          && request.resource.data.get('type', '') == 'refund'
          && tkRefundLedgerOk());
      allow update, delete: if false;
    }
    // Top-up claims: user files (pending only); owner approves â credits
    match /topupClaims/{claimId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && uidIs(resUid()));
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && reqStatus() == 'pending'
        && reqAmount() > 0
        && tkNewGet('currency', '') in ['BDT', 'INR', 'USD'];
      allow update: if isOwner();
      allow delete: if false;
    }
    // Commission payments (Path B: post-task direct pay, commission to
    match /commissionPayments/{payId} {
      allow read: if isOwner() || isSuperAdmin()
        || (isLoggedIn() && (
          uidIs(tkOldGet('paidByUid', ''))
          || uidIs(resClientUid())
          || uidIs(resProviderUid())));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('paidByUid', ''))
        && reqStatus() == 'pending'
        && reqAmount() > 0
        && reqOrderId() != '';
      allow update: if isOwner();
      allow delete: if false;
    }
    // Platform revenue ledger: one doc per completed order, amount pinned to
    match /platformRevenue/{orderId} {
      allow read: if isOwner() || isSuperAdmin();
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('recordedBy', ''))
        && tkNewGet('amount', -1) >= 0
        && tkNewGet('amount', -1) <=
             get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('commissionAmount', -1)
        && (get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('providerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid);
      allow update: if isOwner();
      allow delete: if false;
    }

    // Crisis events â Tier 1 SOS (sender cancel, coordinator ack/resolve, response fan-out).
    match /crisis_events/{eventId} {
      function parent() {
        return get(/databases/$(database)/documents/crisis_events/$(eventId)).data;
      }
      function isCrisisCoord(ws) {
        return isLoggedIn() && ws != null
          && exists(/databases/$(database)/documents/crisisCoordinators/$(ws + '_' + request.auth.uid));
      }
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs())
        || (isLoggedIn() && uidIs(tkOldGet('senderUid', '')))
        // Notified responder: someone in this event's `notified` subcollection
        // (family circle / nearby Sanatani / coordinator pinged by fan-out).
        // ACTIVE-ONLY: the moment the SOS resolves, their read access ends —
        // the responder map can never render a resolved victim's location.
        || (isLoggedIn() && resStatus() == 'active'
          && exists(/databases/$(database)/documents/crisis_events/$(eventId)/notified/$(request.auth.uid)));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('senderUid', ''))
        && (demoWriteOk(newDocWs()) || isTenantMember(newDocWs()) || newDocWs() == null);
      allow update: if (demoWriteOk(docWs())
          || hasRole(docWs(), R_TRUSTEE())
          // Sender: "I'm safe" â cancel own SOS.
          || (isLoggedIn() && uidIs(tkOldGet('senderUid', ''))
            && diffKeys()
              .hasOnly(['status', 'resolvedAt', 'outcomeNote', 'updatedAt'])
            && reqStatus() in ['cancelled', 'resolved'])
          // Sender: attach the voice-note vault URL after the audio upload
          // finishes (uploadVoiceNote / flushVoiceOutbox). Field-pinned to
          // the pointer alone — no other sender field may change here.
          || (isLoggedIn() && uidIs(tkOldGet('senderUid', ''))
            && diffKeys()
              .hasOnly(['voiceNoteUrl', 'updatedAt']))
          // Coordinator edge: ack (-> acknowledged) and resolve (-> resolved).
          || (isCrisisCoord(docWs())
            && diffKeys()
              .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'ackCount',
                'resolvedAt', 'outcomeNote', 'updatedAt'])
            && reqStatus() in ['acknowledged', 'resolved'])
          // Coordinator edge: assign sevadars (assignSevadars) — appends to
          // the assignments array, bumps responderCount, flips
          // active -> responding. Assignments stay a list so a bad write
          // fails closed instead of corrupting the roster.
          || (isCrisisCoord(docWs())
            && diffKeys()
              .hasOnly(['assignments', 'status', 'responderCount', 'updatedAt'])
            && reqStatus()
              in ['active', 'responding', 'acknowledged']
            && tkNewGet('assignments', []) is list)
          // Tenant member: best-effort ack bump from ackSOS; only -> acknowledged.
          || (isTenantMember(docWs())
            && diffKeys()
              .hasOnly(['status', 'ackCount', 'responderCount', 'updatedAt'])
            && reqStatus() == 'acknowledged'))
        && wsImmutable();
      allow delete: if hasRole(docWs(), R_TRUSTEE());
      match /responses/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (isLoggedIn() && parent().get('senderUid', '') == request.auth.uid);
        allow create, update: if isSelf(uid)
          && reqUid() == uid
          && reqStatus() in ['coming', 'arrived'];
        allow delete: if false;
      }
      // Nearby-ping fan-out: sender's client writes one doc per nearby uid
      // (fanOutToNearby); a responder's own client may also self-register.
      match /notified/{uid} {
        allow read: if isTenantMember(parent().get('workspaceId', null))
          || (isLoggedIn() && parent().get('senderUid', '') == request.auth.uid);
        allow create: if isLoggedIn()
          && reqUid() == uid
          && reqKeys()
            .hasOnly(['uid', 'notifiedAt', 'distanceM'])
          && (
            // Responder self-register: their own client marks them notified.
            (request.auth.uid == uid
              && isTenantMember(parent().get('workspaceId', null)))
            // Sender fan-out: the sender's client writes one lightweight
            // ping doc per nearby uid so the active-only responder-read
            // carve-out above can grant them access.
            || parent().get('senderUid', '') == request.auth.uid
          );
        allow update, delete: if false;
      }
    }
    // Coordinator edge docs (crisisCoordinators/{orgId}_{uid}): trustee-managed.
    match /crisisCoordinators/{edgeId} {
      allow read: if isLoggedIn()
        && (uidIs(resUid())
          || isTenantMember(tkOldGet('orgId', null)));
      allow create, update: if isOrgTrustee(reqOrgId())
        && reqUid() != ''
        && (resource == null
          || reqOrgId() == tkOldGet('orgId', ''))
        && edgeId == reqOrgId() + '_'
          + reqUid();
      allow delete: if isOrgTrustee(tkOldGet('orgId', ''));
    }
    // Abuse counters (crisisAbuse/{uid}): self-only read/write.
    match /crisisAbuse/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /emergencyContacts/{uid} {
      allow read, write: if isSelf(uid);
    }


    // EVENTS + POLLS P0 (2026-10-24) — the ballot box. A poll doc
    // carries ONLY counts (options[].votes + totalVotes). Each ballot
    // lives in polls/{pollId}/votes/{uid}: one doc per voter, written
    // only by that voter, never edited or deleted. Poll counts may
    // move ONLY in the same batch as the caller's NEW ballot doc
    // (anchored increment — the SECURITY P1 ratings pattern). The old
    // block read `allow write: if hasRole(effTenant(), [Trustee])` —
    // the caller's OWN tenant, never the poll's: ordinary members'
    // votes were rules-denied while any trustee anywhere could
    // rewrite any org's polls, and every signed-in user could read
    // every poll including the full votedUsers map.
    function pollWs(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data.get('workspaceId', null);
    }
    function pollAudience(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data.get('targetAudience', 'ALL_MEMBERS');
    }
    function pollCommittee(ws) {
      return hasRole(ws, R_BOARD());
    }
    // Votes already counted on a poll doc: the explicit total under
    // the ballot-box model, else the legacy votedUsers map size
    // (read-compat for polls created before this batch; those maps
    // are frozen — no write path below touches them any more).
    function pollBaseTotal(data) {
      return data.get('totalVotes', data.get('votedUsers', {}).size());
    }
    function pollKindOf(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data.get('kind', 'choice');
    }
    function pollBallotOk(pollId) {
      let pdata = get(/databases/$(database)/documents/polls/$(pollId)).data;
      let kind = pdata.get('kind', 'choice');
      return (isTenantMember(pdata.get('workspaceId', null)) || demoWriteOk(pdata.get('workspaceId', null)))
        && pdata.get('status', '') == 'ACTIVE'
        && (pdata.get('targetAudience', 'ALL_MEMBERS') != 'MANAGERS'
            || pollCommittee(pdata.get('workspaceId', null)))
        && (pdata.get('expiresAtTs', null) == null || request.time < pdata.get('expiresAtTs', null))
        // EVENTS P1: the ballot's shape follows the poll's own shape.
        && ((kind == 'choice'
              && (tkNewGet('optionId', '') in pdata.get('options', {}).keys())
              && reqKeys().hasOnly(['optionId', 'votedAt']))
          || (kind == 'multi'
              && reqOptionIds() is list
              && reqOptionIds().size() >= 1
              && reqOptionIds().size() <= 5
              && pdata.get('options', {}).keys().hasAll(reqOptionIds())
              && (!('abstain' in reqOptionIds())
                  || reqOptionIds().size() == 1)
              && reqKeys().hasOnly(['optionIds', 'votedAt']))
          || (kind == 'text'
              && reqText() is string
              && reqText().size() >= 1
              && reqText().size() <= 280
              && reqKeys().hasOnly(['text', 'votedAt'])));
    }
    function pollVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let oldOpts = tkOldGet('options', {});
      let newOpts = reqOptions();
      // Every getAfter access sits to the RIGHT of existsAfter(vp) in
      // the && chain (the SECURITY P1 helper pattern): for writes that
      // carry no ballot — conclude, notes — this function must return
      // false cleanly, never error.
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && (getAfter(vp).data.get('optionId', '') in oldOpts.keys())
        && newOpts.diff(oldOpts).addedKeys().size() == 0
        && newOpts.diff(oldOpts).removedKeys().size() == 0
        && newOpts.diff(oldOpts).changedKeys().hasOnly([getAfter(vp).data.get('optionId', '')])
        && newOpts.get(getAfter(vp).data.get('optionId', ''), {}).get('votes', 0)
             == oldOpts.get(getAfter(vp).data.get('optionId', ''), {}).get('votes', 0) + 1
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && diffKeys()
             .hasOnly(['options', 'totalVotes', 'updatedAt']);
    }
    // EVENTS P1 — multi-select anchor: EVERY chosen option rises by
    // exactly one, totalVotes rises by exactly one (one voter, one
    // ballot — a multi-pick is still a single voice), and nothing
    // else on the poll may move. Bounded-index checks stand in for a
    // loop (rules cannot iterate); ballot validity (1–5 real
    // options) is pollBallotOk's job. Every getAfter access sits to
    // the RIGHT of existsAfter(vp), the house pattern from
    // pollVoteAnchorOk, so ballot-less writes fail cleanly.
    function pollMultiDeltaOk(oldOpts, newOpts, id) {
      return newOpts.get(id, {}).get('votes', 0) == oldOpts.get(id, {}).get('votes', 0) + 1;
    }
    function pollMultiVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let oldOpts = tkOldGet('options', {});
      let newOpts = reqOptions();
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && tkOldGet('kind', 'choice') == 'multi'
        && getAfter(vp).data.get('optionIds', []) is list
        && getAfter(vp).data.get('optionIds', []).size() >= 1
        && getAfter(vp).data.get('optionIds', []).size() <= 5
        && newOpts.diff(oldOpts).addedKeys().size() == 0
        && newOpts.diff(oldOpts).removedKeys().size() == 0
        && newOpts.diff(oldOpts).changedKeys().size() == getAfter(vp).data.get('optionIds', []).size()
        && newOpts.diff(oldOpts).changedKeys().hasOnly(getAfter(vp).data.get('optionIds', []))
        && (getAfter(vp).data.get('optionIds', []).size() < 1 || pollMultiDeltaOk(oldOpts, newOpts, getAfter(vp).data.get('optionIds', [])[0]))
        && (getAfter(vp).data.get('optionIds', []).size() < 2 || pollMultiDeltaOk(oldOpts, newOpts, getAfter(vp).data.get('optionIds', [])[1]))
        && (getAfter(vp).data.get('optionIds', []).size() < 3 || pollMultiDeltaOk(oldOpts, newOpts, getAfter(vp).data.get('optionIds', [])[2]))
        && (getAfter(vp).data.get('optionIds', []).size() < 4 || pollMultiDeltaOk(oldOpts, newOpts, getAfter(vp).data.get('optionIds', [])[3]))
        && (getAfter(vp).data.get('optionIds', []).size() < 5 || pollMultiDeltaOk(oldOpts, newOpts, getAfter(vp).data.get('optionIds', [])[4]))
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && diffKeysOnly(request.resource.data, resource.data, ['options', 'totalVotes', 'updatedAt']);
    }
    // EVENTS P1 — free-text anchor: a text ballot moves ONLY the
    // turnout counter; the options map must stay identical (a text
    // poll has no option counts to inflate).
    function pollTextVoteAnchorOk(pollId) {
      let vp = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      return !exists(vp) && existsAfter(vp)
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && tkOldGet('kind', 'choice') == 'text'
        && getAfter(vp).data.get('text', '') is string
        && getAfter(vp).data.get('text', '').size() >= 1
        && getAfter(vp).data.get('text', '').size() <= 280
        && reqOptions() == tkOldGet('options', {})
        && tkNewGet('totalVotes', 0) == pollBaseTotal(resource.data) + 1
        && diffKeysOnly(request.resource.data, resource.data, ['totalVotes', 'updatedAt']);
    }
    // EVENTS P1 — edit-before-first-vote: the committee (guarded by
    // the caller, like pollManageOk) may repair a launched poll ONLY
    // while no ballot exists — pollBaseTotal == 0 is the count of
    // record. The shape (kind), the audience and the workspace are
    // NOT editable here; relaunch for those.
    function pollEditOk() {
      return resStatus() == 'ACTIVE'
        && reqStatus() == 'ACTIVE'
        && pollBaseTotal(resource.data) == 0
        && diffKeys()
             .hasOnly(['title', 'description', 'options', 'expiresAt', 'expiresAtTs', 'resultVisibility', 'updatedAt'])
        && tkNewGet('resultVisibility', 'afterVote') in ['live', 'afterVote', 'afterClose', 'committee']
        && (tkOldGet('kind', 'choice') == 'text'
            || (reqOptions().size() >= 2
                && reqOptions().size() <= 5));
    }
    // Committee management: conclude (early or at deadline) and the
    // official note. Nothing else on the doc may change here.
    function pollManageOk() {
      return diffKeys()
               .hasOnly(['status', 'adminNote', 'updatedAt'])
        && (reqStatus() == resStatus()
            || (resStatus() == 'ACTIVE'
                && reqStatus() == 'CONCLUDED'));
    }
    // Deadline truth no longer waits for a manager's visit: ANY member
    // of the poll's workspace may land the conclusion once the stored
    // deadline timestamp has passed (status flip only, nothing else).
    function pollAutoConcludeOk() {
      return diffKeys()
               .hasOnly(KEYS_STATUS_ONLY())
        && resStatus() == 'ACTIVE'
        && reqStatus() == 'CONCLUDED'
        && resExpiresAtTs() != null
        && request.time >= resExpiresAtTs();
    }

    // Polls — scoped to the poll's OWN workspace (see ballot-box note).
    match /polls/{pollId} {
      allow read: if demoPublicRead(docWs()) || isSuperAdmin()
        || (isTenantMember(docWs())
            && (tkOldGet('targetAudience', 'ALL_MEMBERS') != 'MANAGERS'
                || pollCommittee(docWs())));
      allow create: if demoWriteOk(newDocWs())
        || (pollCommittee(newDocWs())
            && reqStatus() == 'ACTIVE'
            && tkNewGet('totalVotes', 0) == 0
            && tkNewGet('votedUsers', {}).size() == 0
            && tkNewGet('targetAudience', '') in ['ALL_MEMBERS', 'MANAGERS']
            // EVENTS P1: text polls carry no options at all; choice
            // and multi keep the P0 2–5 law (an abstain entry counts
            // toward the five).
            && (tkNewGet('kind', 'choice') == 'text'
                ? reqOptions().size() == 0
                : (reqOptions().size() >= 2
                   && reqOptions().size() <= 5))
            // EVENTS P1: the shape and the result-visibility rule are
            // chosen AT LAUNCH. No update path below ever lists kind
            // as writable again, and resultVisibility may move only
            // through pollEditOk (zero ballots cast).
            && tkNewGet('kind', 'choice') in ['choice', 'multi', 'text']
            && tkNewGet('resultVisibility', 'afterVote') in ['live', 'afterVote', 'afterClose', 'committee']
            && reqKeys().hasOnly(
                 ['workspaceId', 'title', 'description', 'targetAudience', 'status',
                  'createdAt', 'createdBy', 'expiresAt', 'expiresAtTs', 'options',
                  'totalVotes', 'votedUsers', 'kind', 'resultVisibility']));
      allow update: if ((demoWriteOk(docWs()) || isTenantMember(docWs()))
            && wsImmutable() && pollVoteAnchorOk(pollId))
        || ((demoWriteOk(docWs()) || isTenantMember(docWs()))
            && wsImmutable() && pollMultiVoteAnchorOk(pollId))
        || ((demoWriteOk(docWs()) || isTenantMember(docWs()))
            && wsImmutable() && pollTextVoteAnchorOk(pollId))
        || (pollCommittee(docWs()) && wsImmutable() && pollEditOk())
        || (pollCommittee(docWs()) && wsImmutable() && pollManageOk())
        || (isTenantMember(docWs()) && wsImmutable() && pollAutoConcludeOk());
      // Decided history is archive-only: a poll may be deleted ONLY
      // while no ballot has ever been cast on it.
      allow delete: if pollCommittee(docWs()) && pollBaseTotal(resource.data) == 0;

      // One private ballot per voter. ALL_MEMBERS ballots are secret —
      // only the voter can read their own. Committee (MANAGERS) polls
      // are named votes by design: the committee may read the ballots
      // (the deliberate, logged reveal in the desk).
      match /votes/{voterUid} {
        allow read: if isLoggedIn() && (voterUid == request.auth.uid
          || isSuperAdmin()
          || (pollAudience(pollId) == 'MANAGERS' && pollCommittee(pollWs(pollId)))
          // EVENTS P1: free-text responses are an ANNOUNCED suggestion
          // box — the committee of the poll's own workspace may read
          // them (the create form says so in plain words; a secret
          // ballot remains a choice poll, whose named reveal stays
          // committee-gated exactly as in P0).
          || (pollKindOf(pollId) == 'text' && pollCommittee(pollWs(pollId))));
        allow create: if uidIs(voterUid) && pollBallotOk(pollId);
        allow update, delete: if false;
      }
    }

    // MARGDARSHAN (J0 candidate, 2026-10-31) — Your Voice: the public
    // suggestion board (blueprint s5.3). NOT YET LIVE — this block is
    // staged for the owner's complete-file review and ships with
    // batch J3, together with the board UI. Read/engage law (owner,
    // 2026-10-31): anyone may READ a visible suggestion with no
    // sign-in; engagement (file, support, edit) requires sign-in.
    // Hidden (moderated) suggestions are NEVER publicly readable —
    // the read path below serves hidden == false, the author reading
    // their own, or the SuperAdmin only. supporterCount is an
    // ANCHORED counter (the polls ballot-box pattern): it may move
    // ONLY in the same batch as the caller's own supporters/{uid}
    // doc appearing (support, +1) or vanishing (withdraw, -1) —
    // never by a direct write, never below zero.
    function SUGG_KINDS() {
      return ['feature', 'problem', 'praise', 'manual-gap'];
    }
    function SUGG_STATUSES() {
      return ['received', 'under-review', 'planned', 'in-progress',
        'shipped', 'not-now', 'duplicate'];
    }
    // One parameterized anchor for both directions (the compiled-size
    // law: the two shapes differ only in the exists/existsAfter sense
    // and the sign of the step, so they share one body).
    function suggAnchorOk(suggId, up) {
      let sp = /databases/$(database)/documents/suggestions/$(suggId)/supporters/$(request.auth.uid);
      return (up ? (!exists(sp) && existsAfter(sp))
                 : (exists(sp) && !existsAfter(sp)))
        && tkOldGet('hidden', false) == false
        && tkNewGet('supporterCount', 0)
             == tkOldGet('supporterCount', 0) + (up ? 1 : -1)
        && tkNewGet('supporterCount', 0) >= 0
        && diffKeysOnly(request.resource.data, resource.data,
             ['supporterCount', 'updatedAt']);
    }
    function suggVisible(suggId) {
      return get(/databases/$(database)/documents/suggestions/$(suggId)).data
        .get('hidden', false) == false;
    }
    // The deskId shape, shared by create and the author-edit path
    // (a suggestion may concern no desk at all — deskId null).
    function suggDeskIdOk() {
      return tkNewGet('deskId', null) == null
        || (tkNewGet('deskId', '') is string
            && tkNewGet('deskId', '').size() <= 64);
    }
    function suggTitleBodyOk() {
      return tkNewGet('title', '') is string
        && tkNewGet('title', '').size() >= 1
        && tkNewGet('title', '').size() <= 140
        && tkNewGet('body', '') is string
        && tkNewGet('body', '').size() >= 1
        && tkNewGet('body', '').size() <= 2000;
    }

    match /suggestions/{suggId} {
      // Public read of visible suggestions (read/engage law); hidden
      // ones answer only to their author and the SuperAdmin. List
      // queries from signed-out clients must filter hidden == false.
      allow read: if tkOldGet('hidden', false) == false
        || isSuperAdmin()
        || (isLoggedIn() && tkOldGet('authorId', '') == request.auth.uid);
      allow create: if isLoggedIn()
        && tkNewGet('authorId', '') == request.auth.uid
        && tkNewGet('status', '') == 'received'
        && tkNewGet('supporterCount', -1) == 0
        && tkNewGet('hidden', true) == false
        && tkNewGet('kind', '') in SUGG_KINDS()
        && suggTitleBodyOk()
        && tkNewGet('authorName', '') is string
        && tkNewGet('authorName', '').size() >= 1
        && tkNewGet('authorName', '').size() <= 80
        && tkNewGet('language', '') is string
        && tkNewGet('language', '').size() <= 8
        && suggDeskIdOk()
        && tkNewGet('officialReplies', []).size() == 0
        && tkNewGet('statusHistory', []).size() <= 1
        && tkNewGet('shippedVersion', null) == null
        && tkNewGet('duplicateOf', null) == null
        && request.resource.data.keys().hasOnly(
             ['authorId', 'authorName', 'kind', 'deskId', 'title', 'body',
              'language', 'status', 'statusHistory', 'officialReplies',
              'supporterCount', 'hidden', 'createdAt', 'updatedAt',
              'shippedVersion', 'duplicateOf']);
      allow update: if (isLoggedIn()
            && tkOldGet('authorId', '') == request.auth.uid
            && tkOldGet('status', '') == 'received'
            && tkNewGet('status', '') == 'received'
            && diffKeysOnly(request.resource.data, resource.data,
                 ['title', 'body', 'deskId', 'kind', 'updatedAt'])
            && tkNewGet('kind', '') in SUGG_KINDS()
            && suggTitleBodyOk()
            && suggDeskIdOk())
        || (isLoggedIn() && suggAnchorOk(suggId, true))
        || (isLoggedIn() && suggAnchorOk(suggId, false))
        || (isSuperAdmin()
            && diffKeysOnly(request.resource.data, resource.data,
                 ['status', 'statusHistory', 'officialReplies', 'hidden',
                  'duplicateOf', 'shippedVersion', 'updatedAt'])
            && tkNewGet('status', '') in SUGG_STATUSES()
            && tkNewGet('officialReplies', []).size() <= 50
            && tkNewGet('statusHistory', []).size() <= 50);
      // Polls pattern: a suggestion with supporters is archive —
      // its author deletes only while nobody has supported it.
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && tkOldGet('authorId', '') == request.auth.uid
            && tkOldGet('supporterCount', 0) == 0);

      // One doc per supporter (the ballot box): existence = support.
      // The doc itself stores no counter — only the anchor above may
      // move the parent's supporterCount, in the same batch.
      match /supporters/{supporterUid} {
        allow read: if isSuperAdmin()
          || (isLoggedIn() && supporterUid == request.auth.uid);
        allow create: if isLoggedIn() && supporterUid == request.auth.uid
          && suggVisible(suggId)
          && reqKeys().hasOnly(['supportedAt']);
        allow update: if false;
        allow delete: if isLoggedIn() && supporterUid == request.auth.uid;
      }
    }

    // EVENTS + POLLS P0 (2026-10-24) — Trustee resolutions. Until this
    // batch, resolutions rode the generic operational block: any staff
    // member could rewrite the vote counters directly, the voters were
    // never recorded, quorumMet was a display flag nobody computed,
    // and nothing ever wrote Passed/Rejected. Now: votes land in a
    // `voters` map ON the doc, written ONLY together with the matching
    // count change and ONLY by the voter adding their own uid;
    // conclusion is a one-way transition whose quorum + outcome the
    // rules recompute from the stored board size and counts; decided
    // resolutions are archive-only. ('resolutions' was removed from
    // the generic block's lists — matching allow blocks are OR-ed, so
    // these strict rules only bind once the generic path is gone.)
    function resBoardRoles() {
      return ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Manager', 'MANAGER'];
    }
    // Quorum = strictly more than half the board has voted. When no
    // board roster exists (boardSize 0 — the roster was never kept),
    // the floor is two distinct voters (proposer + one more). This
    // formula is mirrored in src/lib/resolutionLogic.ts — keep both
    // in lockstep.
    function resQuorumOk(data) {
      let cast = data.get('votesInFavor', 0) + data.get('votesAgainst', 0);
      let board = data.get('boardSize', 0);
      return board > 0 ? (cast * 2 > board) : (cast >= 2);
    }
    function resOutcomeOk(data) {
      return resQuorumOk(data) == data.get('quorumMet', false)
        && (data.get('quorumMet', false) == false
            ? data.get('status', '') == 'Deferred'
            : (data.get('votesInFavor', 0) > data.get('votesAgainst', 0)
                ? data.get('status', '') == 'Passed'
                : data.get('status', '') == 'Rejected'));
    }
    function resCreateCountsOk() {
      let v = tkNewGet('voters', {});
      return tkNewGet('votesAgainst', 0) == 0
        && tkNewGet('votesInFavor', 0) <= 1
        && v.size() <= 1
        && (v.size() == 0 || tkNewGet('votesInFavor', 0) == 1)
        && tkNewGet('quorumMet', false) == false
        && (tkNewGet('proposedByUid', '') == ''
            || uidIs(tkNewGet('proposedByUid', '')));
    }
    function resVoteOk() {
      let uid = request.auth.uid;
      let oldV = tkOldGet('voters', {});
      let newV = tkNewGet('voters', {});
      let choice = newV.get(uid, '');
      return resStatus() == 'Pending Review'
        && !(uid in oldV.keys())
        && (choice == 'favor' || choice == 'against')
        && newV.size() == oldV.size() + 1
        && newV.diff(oldV).addedKeys().hasOnly([uid])
        && newV.diff(oldV).changedKeys().size() == 0
        && newV.diff(oldV).removedKeys().size() == 0
        && tkNewGet('votesInFavor', 0)
             == tkOldGet('votesInFavor', 0) + (choice == 'favor' ? 1 : 0)
        && tkNewGet('votesAgainst', 0)
             == tkOldGet('votesAgainst', 0) + (choice == 'against' ? 1 : 0)
        && diffKeys()
             .hasOnly(['voters', 'votesInFavor', 'votesAgainst', 'updatedAt'])
        && (resExpiresAtTs() == null
            || request.time < resExpiresAtTs());
    }
    function resConcludeOk() {
      return resStatus() == 'Pending Review'
        && reqStatus() in ['Passed', 'Rejected', 'Deferred']
        && diffKeys()
             .hasOnly(['status', 'quorumMet', 'details', 'concludedAt', 'updatedAt'])
        && tkNewGet('votesInFavor', 0) == tkOldGet('votesInFavor', 0)
        && tkNewGet('votesAgainst', 0) == tkOldGet('votesAgainst', 0)
        && tkNewGet('boardSize', 0) == tkOldGet('boardSize', 0)
        && resOutcomeOk(request.resource.data)
        && ((resExpiresAtTs() != null
              && request.time >= resExpiresAtTs())
            || (tkOldGet('boardSize', 0) > 0
                && tkOldGet('votesInFavor', 0) + tkOldGet('votesAgainst', 0)
                     >= tkOldGet('boardSize', 0))
            || resExpiresAtTs() == null);
    }
    function resEditOk() {
      return resStatus() == 'Pending Review'
        && reqStatus() == 'Pending Review'
        && diffKeys()
             .hasOnly(['title', 'description', 'details', 'secondedBy', 'bannerUrl', 'updatedAt']);
    }

    match /resolutions/{resId} {
      allow read: if demoPublicRead(docWs()) || isTenantMember(docWs());
      allow create: if demoWriteOk(newDocWs())
        || (isTenantMember(newDocWs()) && roleIn(R_ANY_STAFF())
            && reqStatus() == 'Pending Review'
            && resCreateCountsOk());
      allow update: if (demoWriteOk(docWs()) && wsImmutable())
        || (isTenantMember(docWs()) && wsImmutable() && hasRole(docWs(), resBoardRoles()) && resVoteOk())
        || (isTenantMember(docWs()) && wsImmutable() && resConcludeOk())
        || (isTenantMember(docWs()) && wsImmutable() && roleIn(R_ANY_STAFF()) && resEditOk());
      // Archive-only once decided; deletion only for never-voted
      // drafts (the proposer's automatic vote is the one allowed mark).
      allow delete: if hasRole(docWs(), R_TRUSTEE())
        && resStatus() == 'Pending Review'
        && tkOldGet('votesInFavor', 0) + tkOldGet('votesAgainst', 0) <= 1
        && tkOldGet('voters', {}).size() <= 1;
    }

    // YatraNet broadcasts â keyed by communityId.
    match /yatra_broadcasts/{bId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(tkOldGet('communityId', null)) && (request.auth == null || effTenant() == tkOldGet('communityId', null)))
        || isTenantMember(tkOldGet('communityId', null));
      allow create: if isLoggedIn() && (isDemoWs(tkNewGet('communityId', null))
        || isTenantMember(tkNewGet('communityId', null)));
      allow update: if isSuperAdmin() || (isTenantMember(tkOldGet('communityId', null))
        && tkNewGet('communityId', null) == tkOldGet('communityId', null));
      allow delete: if isSuperAdmin();
    }

    // Support threads
    match /global_support_threads/{tId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }
    match /global_support_replies/{rId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Chats â participant-gated.
    // Chats — 1:1 threads are participant-only. Trustees may access ONLY
    // org-type support threads of their own org (2026-10-19 privacy fix:
    // previously any trustee of any org could read every private chat).
    match /chats/{chatId} {
      allow read: if isSuperAdmin() || (isLoggedIn() && (
        (resource == null || (tkOldGet('participants', null) is list && request.auth.uid in tkOldGet('participants', []))) ||
        isChatOrgTrustee(resource.data)));
      allow create: if isSuperAdmin() || (isLoggedIn() && (
        (tkNewGet('participants', null) is list && request.auth.uid in tkNewGet('participants', [])) ||
        (tkNewGet('type', '') == 'org' &&
          tkNewGet('participants', null) is list &&
          tkNewGet('participants', []).size() == 2 &&
          isOrgTrustee(chatOrgId(request.resource.data)))));
      allow update: if isSuperAdmin() || (isLoggedIn() && (
        (tkOldGet('participants', null) is list && request.auth.uid in tkOldGet('participants', []) &&
          !diffKeys().hasAny(['participants'])) ||
        (isChatOrgTrustee(resource.data) &&
          !diffKeys().hasAny(['participants', 'type', 'orgId']))));
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])) ||
          isChatOrgTrustee(get(/databases/$(database)/documents/chats/$(chatId)).data)));
        allow create: if isSuperAdmin() || (isLoggedIn() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', null) is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []) &&
            tkNewGet('senderId', '') == request.auth.uid) ||
          isChatOrgTrustee(get(/databases/$(database)/documents/chats/$(chatId)).data)));
        allow update, delete: if false;
      }
    }

    // Upgrade requests
    match /upgrade_requests/{reqId} {
      // QUEUED #54 (owner-approved): create tightened from any-logged-in —
      // a request must name the filer's OWN tenant (previously any
      // signed-in user could file against any communityId, spamming the
      // owner's stats). Demo sandboxes file against their DEMO_ id and
      // demo personas hold no membership edge, so the demo term mirrors
      // the yatra_broadcasts create shape and keeps demo submission open.
      allow create: if isLoggedIn() && (isSuperAdmin()
        || isTenantMember(tkNewGet('communityId', ''))
        || isDemoWs(tkNewGet('communityId', null)));
      // QUEUED #54 (owner-approved): the submitting org's own finance
      // roles may read back its requests — Settings → Billing history
      // queries where('communityId','==',workspaceId), and the previous
      // SuperAdmin-only read denied every trustee their own history
      // ("Missing or insufficient permissions", even for an empty list).
      // Docs carry payer contact + sender numbers, so read is scoped to
      // the owning tenant's finance roles (hasRole ANDs tenant
      // membership, so a trustee of org A cannot read org B's requests).
      // Pattern mirrors yatra_broadcasts (communityId-keyed member read).
      // Demo carve-out mirrors yatra_broadcasts: demo personas hold no
      // tenant membership, so DEMO_ workspaces' requests stay readable
      // to any signed-in demo session.
      allow read: if isSuperAdmin()
        || hasRole(tkOldGet('communityId', ''), R_FINANCE())
        || (isDemoWs(tkOldGet('communityId', null)) && isLoggedIn());
      allow update, delete: if isSuperAdmin();
    }

    // Live Darshan — public live-status cache. Any viewer can read whether
    // a temple is live. Writes are schema-pinned: the polling client (any
    // logged-in viewer) may only update the live-status fields; the orgId
    // must match the document ID. Self-correcting: a wrong "live" flag is
    // overwritten by the next honest poll.
    match /orgLiveStatus/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && reqOrgId() == orgId
        && tkNewGet('isLive', null) is bool
        && tkNewGet('updatedAt', null) is number
        && reqKeys().hasOnly([
          'orgId', 'isLive', 'videoId', 'title', 'startedAt',
          'updatedAt', 'nextPollAfter'
        ]);
      allow delete: if isSuperAdmin() || isOwner();
    }

    // Sangam Watch — unified video feed. Shared videos are community
    // content: public read, authenticated create (schema-pinned), no edits
    // (delete + re-share). Deletes are author-or-admin; reports are a
    // counter any logged-in user may increment once per client.
    match /sangamVideos/{videoId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && tkNewGet('youtubeId', '') is string
        && tkNewGet('youtubeId', '').size() == 11
        && reqTitle() is string
        && reqTitle().size() >= 1
        && reqTitle().size() <= 120
        && uidIs(tkNewGet('sharedBy', ''))
        && tkNewGet('category', '') in ['shared', 'seva_demo', 'live_event']
        && reqKeys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'duration', 'sharedBy',
          'sharedByName', 'sharedBySanId', 'caption', 'category',
          'providerUid', 'providerTier', 'createdAt', 'reportCount',
          'serverCreatedAt'
        ]);
      allow update: if isLoggedIn()
        && bumpUpOk('reportCount');
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('sharedBy', '')));
    }

    // Sangam Stories — 24h disappearing moments. Ephemeral by design.
    // read: any authenticated user (community moments, like the feed).
    // create: author only, schema-pinned, expiresAt must be ~24h out.
    // update: reportCount increment only. delete: author or superadmin.
    // Expiry is lazy (queries filter expiresAt > now); a GodMode sweep
    // deletes long-expired docs.
    match /sangamStories/{storyId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && uidIs(reqAuthorUid())
        && reqAuthorName() is string
        && reqAuthorName().size() >= 1
        && reqAuthorName().size() <= 60
        && tkNewGet('mediaType', '') in ['photo', 'text']
        && tkNewGet('expiresAt', 0) is number
        && tkNewGet('expiresAt', 0) > request.time.toMillis()
        && tkNewGet('expiresAt', 0) <= request.time.toMillis() + 25 * 60 * 60 * 1000
        && reqKeys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'authorSanId',
          'mediaType', 'mediaUrl', 'text', 'backgroundId', 'caption',
          'createdAt', 'expiresAt', 'reportCount'
        ]);
      allow update: if isLoggedIn()
        && bumpUpOk('reportCount');
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resAuthorUid()));

      // View tracking: authors see a COUNT; viewer identities are private.
      // Write own uid only; read author-only.
      match /viewers/{uid} {
        allow read: if isSuperAdmin()
          || (isLoggedIn() && get(/databases/$(database)/documents/sangamStories/$(storyId)).data.get('authorUid', '') == request.auth.uid);
        allow write: if isLoggedIn() && uidIs(uid);
      }
    }

    // Sangam Shorts — vertical sacred moments (YouTube Shorts embeds).
    // read: any authenticated user (community content, like the feed).
    // create: author only, schema-pinned (11-char youtubeId, title 1-120).
    // update: counter increments only (view/ashirvad/comment/share/report).
    // delete: author or superadmin. No edits — delete + re-share.
    match /sangamShorts/{shortId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && tkNewGet('youtubeId', '') is string
        && tkNewGet('youtubeId', '').size() == 11
        && reqTitle() is string
        && reqTitle().size() >= 1
        && reqTitle().size() <= 120
        && uidIs(reqAuthorUid())
        && reqAuthorName() is string
        && reqAuthorName().size() >= 1
        && reqAuthorName().size() <= 60
        && reqKeys().hasOnly([
          'youtubeId', 'title', 'thumbnailUrl', 'authorUid',
          'authorName', 'authorAvatar', 'authorSanId', 'caption',
          'duration', 'createdAt', 'viewCount', 'ashirvadCount',
          'commentCount', 'shareCount', 'reportCount',
          'serverCreatedAt'
        ]);
      // Counters pinned (owner-approved 2026-10-20): one update touches
      // exactly ONE counter and moves it by exactly one step -- the same
      // pattern that guards sangamPosts. Views and reports only rise;
      // toggles may fall but never below 0.
      allow update: if isLoggedIn() && (
        (bumpUpOk('viewCount'))
        || (bumpToggleOk('ashirvadCount'))
        || (bumpToggleOk('commentCount'))
        || (bumpToggleOk('shareCount'))
        || (bumpUpOk('reportCount'))
      );
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resAuthorUid()));

      // Comments: community conversation on a short.
      // read: any authenticated user. create: author-only, schema-pinned.
      // delete: comment author or superadmin. No edits.
      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn()
          && uidIs(reqAuthorUid())
          && reqText() is string
          && reqText().size() >= 1
          && reqText().size() <= 300
          && reqKeys().hasOnly([
            'authorUid', 'authorName', 'text', 'createdAt', 'serverCreatedAt'
          ]);
        allow delete: if isSuperAdmin()
          || (isLoggedIn() && uidIs(resAuthorUid()));
      }
    }

    // --- devoteeProfiles/{uid}: public devotee identity surface.
    // Public read (anyone can view a profile). Write = own uid only,
    // schema-pinned. NEVER exposes users/{uid} (self-read-only).
    match /devoteeProfiles/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && reqUid() == uid
        && tkNewGet('displayName', '') is string
        && tkNewGet('displayName', '').size() >= 1
        && tkNewGet('displayName', '').size() <= 80
        && tkNewGet('sanId', '') is string
        && reqKeys().hasOnly([
          'uid', 'displayName', 'sanId', 'avatarUrl', 'bio',
          'isPublic', 'followerCount', 'followingCount', 'updatedAt'
        ]);
      allow delete: if isSuperAdmin()
        || (isSelf(uid));
    }

    // --- follows/{followerUid}/following/{targetUid}: asymmetric follow.
    // Read: follower themselves (or superadmin). Write: follower only, no self-follow.
    match /follows/{followerUid}/following/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(followerUid));
      allow create: if isLoggedIn()
        && request.auth.uid == followerUid
        && followerUid != targetUid
        && reqKeys().hasOnly(['followerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(followerUid));
    }

    // --- blocks/{blockerUid}/blocked/{targetUid}: user safety (Step 5).
    // Read: blocker themselves (or superadmin) — blocked users can NEVER
    // discover they were blocked. Write: blocker only, no self-block.
    match /blocks/{blockerUid}/blocked/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(blockerUid));
      allow create: if isLoggedIn()
        && request.auth.uid == blockerUid
        && blockerUid != targetUid
        && reqKeys().hasOnly(['blockerUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(blockerUid));
    }

    // --- mutes/{muterUid}/muted/{targetUid}: user safety (Step 5).
    // Same privacy model as blocks. Mute hides posts; DMs still allowed.
    match /mutes/{muterUid}/muted/{targetUid} {
      allow read: if isSuperAdmin()
        || (isSelf(muterUid));
      allow create: if isLoggedIn()
        && request.auth.uid == muterUid
        && muterUid != targetUid
        && reqKeys().hasOnly(['muterUid', 'targetUid', 'createdAt']);
      allow delete: if isSuperAdmin()
        || (isSelf(muterUid));
    }

    // Group chats — private by default, invite-code only. No public
    // discovery, no join-by-search. memberIds is the rules source of truth.
    match /chatGroups/{groupId} {      allow read: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []));

      allow create: if isLoggedIn() &&
        tkNewGet('memberIds', null) is list &&
        request.auth.uid in tkNewGet('memberIds', []) &&
        tkNewGet('adminIds', null) is list &&
        request.auth.uid in tkNewGet('adminIds', []) &&
        reqName() is string &&
        reqName().size() >= 2 &&
        reqName().size() <= 60 &&
        tkNewGet('inviteCode', '') is string &&
        tkNewGet('inviteCode', '').size() == 8 &&
        tkNewGet('createdBy', '') == request.auth.uid;

      // Lane A (any member): thread-summary + presence fields only.
      // Lane B (admin): member management + rename + invite rotation.
      allow update: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []) && (
          diffKeysOnly(request.resource.data, resource.data, 
            ['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
             'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy']
          ) ||
          (request.auth.uid in tkOldGet('adminIds', []) &&
            diffKeysOnly(request.resource.data, resource.data, 
              ['lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts',
               'lastReadAt', 'lastDeliveredAt', 'typing', 'archivedBy',
               'name', 'description', 'memberIds', 'adminIds', 'memberInfo', 'inviteCode']
            ) &&
            tkNewGet('memberIds', null) is list &&
            tkNewGet('adminIds', null) is list &&
            tkNewGet('createdBy', '') == tkOldGet('createdBy', ''))
        ));

      // Delete: admin, or the last member leaving (group dissolves).
      allow delete: if isSuperAdmin() || (isLoggedIn() &&
        tkOldGet('memberIds', null) is list &&
        request.auth.uid in tkOldGet('memberIds', []) && (
          request.auth.uid in tkOldGet('adminIds', []) ||
          tkOldGet('memberIds', []).size() == 1));

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []));
        allow create: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []) &&
          tkNewGet('senderId', '') == request.auth.uid &&
          (tkNewGet('kind', '') != 'system' ||
            tkNewGet('systemKind', '') in
              ['created', 'joined', 'left', 'added', 'removed', 'renamed', 'promoted']));
        // Unsend: own message, within 5 minutes. No edits, ever.
        allow delete: if isSuperAdmin() || (isLoggedIn() &&
          tkOldGet('senderId', '') == request.auth.uid &&
          request.time.toMillis() - tkOldGet('createdAt', 0) < 5 * 60 * 1000);
        allow update: if false;
      }

      match /members/{uid} {
        allow read: if isSuperAdmin() || (isLoggedIn() &&
          get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', null) is list &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('memberIds', []));
        // Create: self-join via code (uid == auth.uid) or admin adding.
        allow create: if isSuperAdmin() || (isLoggedIn() &&
          reqUid() == uid &&
          (uid == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', [])));
        // Role change: admin only, role field only.
        allow update: if isSuperAdmin() || (isLoggedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', []) &&
          diffKeysOnly(request.resource.data, resource.data, ['role']));
        // Delete: self (leaving) or admin (removing).
        allow delete: if isSuperAdmin() || (isLoggedIn() &&
          (uid == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.get('adminIds', [])));
      }
    }

    // Community subcollections (social feed, vivah, sadhana...)
    match /communities/{communityId}/{collectionName}/{docId} {
      allow read: if isSuperAdmin()
        || (isDemoWs(communityId) && (request.auth == null || effTenant() == communityId))
        || isTenantMember(communityId);
      allow write: if isLoggedIn() && (isDemoWs(communityId) || isTenantMember(communityId));
    }

    // Purohit One â independent purohit identity + verification + marketplace

    // --- purohits/{purohitId}: public read (marketplace); owner + admin write.
    match /purohits/{purohitId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('ratingAggregate', 0) == 0
        && reqRatingCount() == 0
        && request.resource.data.get('completedGigs', 0) == 0
        // PUROHIT-PARITY: a profile is also born with ZERO anchored
        // endorsements — the claim branch reads this field, so it must
        // not be self-granted at birth (mirrors jyotishProfiles).
        && request.resource.data.get('endorsementCount', 0) == 0;
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uidIs(resUid())
          && uidIs(reqUid())
          && tkNewGet('id', '') == tkOldGet('id', '')
          && reqVerificationTier() == tkOldGet('verificationTier', '')
          // PUROHIT-PARITY: the endorsement anchors are pinned here
          // too — they move ONLY via the anchored endorsement branch
          // below, never on the owner's plain say-so (mirrors the
          // jyotishProfiles owner-branch anchor pins).
          && request.resource.data.get('endorsementCount', 0) == resource.data.get('endorsementCount', 0)
          && request.resource.data.get('lastEndorsementId', '') == resource.data.get('lastEndorsementId', '')
          // SECURITY P1: the rating aggregate never moves on the
          // owner's own say-so -- only via the anchored review branch
          // below. completedGigs may stay, or rise by exactly 1
          // anchored to a gig the owner just completed.
          && tkNewGet('ratingAggregate', 0) == tkOldGet('ratingAggregate', 0)
          && reqRatingCount() == tkOldGet('ratingCount', 0)
          && (request.resource.data.get('completedGigs', 0) == resource.data.get('completedGigs', 0)
            || p1CompletedGigOk()))
        // SECURITY P1 -- anchored rating step (see p1PurohitRatingOk).
        // The old branch let ANY signed-in user set ratingAggregate /
        // ratingCount / completedGigs to any in-range value -- a fake
        // 5.0 average in a single write.
        || (isLoggedIn()
          && diffKeys()
            .hasOnly(RATING_KEYS())
          && p1PurohitRatingOk(purohitId))
        // PUROHIT-PARITY -- anchored endorsement step (see
        // p1PurohitEndorsementOk): the endorsement counter moves only
        // with the endorsement doc itself, in one transaction.
        || (isLoggedIn()
          && diffKeys()
            .hasOnly(['endorsementCount', 'lastEndorsementId', 'updatedAt'])
          && p1PurohitEndorsementOk(purohitId))
        // PUROHIT-PARITY -- the tier CLAIM: before this branch, NO
        // rules path let the owner advance their own verificationTier
        // (the owner branch pins it), so claimTierAdvancement failed
        // silently for every purohit — the JY-04 defect, one system
        // over. The owner may now write ONLY verificationTier
        // (+ updatedAt), and only to a step the doc's own anchored
        // fields have earned (purohitTierClaimOk). Legacy note:
        // endorsements recorded before this branch existed are not in
        // the anchored count (rules cannot count a collection); an
        // affected purohit's claim stays denied until their next
        // (anchored) endorsement or a GodMode manual tier set.
        || (isLoggedIn()
          && uidIs(resUid())
          && diffKeys()
            .hasOnly(['verificationTier', 'updatedAt'])
          && purohitTierClaimOk())
        // PHASE 3 â Pratham Seva counter advancement (order-anchored).
        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;
    }

    // --- purohits availability: public read; owner write.
    match /purohitAvailability/{purohitId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn()
          && exists(/databases/$(database)/documents/purohits/$(purohitId))
          && get(/databases/$(database)/documents/purohits/$(purohitId)).data.get('uid', '') == request.auth.uid);
    }

    // Solo Sanatani â Universal Sanatani ID spine (sanataniProfiles/{uid})
    match /sanataniProfiles/{uid} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(uid)
        && uidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('roles', {}) == {};
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uidIs(uid)
          && uidIs(resUid())
          && uidIs(reqUid())
          && tkNewGet('id', '') == tkOldGet('id', '')
          && reqVerificationTier() == tkOldGet('verificationTier', '')
          && (
            tkNewGet('roles', {}) == tkOldGet('roles', {})
            || validPurohitAttach()
            || validJyotishAttach()
          ));
      allow delete: if false;

      // A purohitId may be attached only when the referenced `purohits`
      function validPurohitAttach() {
        let newRoles = tkNewGet('roles', {});
        let oldRoles = tkOldGet('roles', {});
        let newPid = newRoles.get('purohitId', '');
        return newPid != ''
          && newPid != oldRoles.get('purohitId', '')
          && diffKeysOnly(newRoles, oldRoles, ['purohitId'])
          && exists(/databases/$(database)/documents/purohits/$(newPid))
          && get(/databases/$(database)/documents/purohits/$(newPid)).data.get('uid', '') == request.auth.uid;
      }

      // A jyotishId may be attached only when the referenced
      function validJyotishAttach() {
        let newRoles = tkNewGet('roles', {});
        let oldRoles = tkOldGet('roles', {});
        let newJid = newRoles.get('jyotishId', '');
        return newJid != ''
          && newJid != oldRoles.get('jyotishId', '')
          && diffKeysOnly(newRoles, oldRoles, ['jyotishId'])
          && exists(/databases/$(database)/documents/jyotishProfiles/$(newJid))
          && get(/databases/$(database)/documents/jyotishProfiles/$(newJid)).data.get('uid', '') == request.auth.uid;
      }
    }

    // Solo Sanatani â private profile fields (gotra and future sensitive
    match /sanataniProfiles/{uid}/private/self {
      allow read, write: if isLoggedIn() && uidIs(uid);
    }

// ------------------------- Section A: program config ----------------------
    match /prathamSevaConfig/{configId} {
      allow read: if isLoggedIn();
      allow create, update: if isSuperAdmin()
        && tkNewGet('defaultFreeSevas', -1) >= 0
        && tkNewGet('defaultFreeSevas', 51) <= 50;
      allow delete: if false;
    }

// ----------------- Section B: purohitApplications (REPLACES) --------------
    // JY-FIX-B factoring: purohitApplications and jyotishApplications
    // share ONE create shape (the Pratham Seva application is born
    // PENDING with every reward/review field empty); only the profile
    // id field name differs, passed as idField. Token-identical
    // expansion at both call sites.
    function applicationCreateOk(idField) {
      return isLoggedIn()
        && uidIs(reqUid())
        && tkNewGet(idField, '') != ''
        && reqStatus() == 'PENDING'
        && tkNewGet('tier', '') == ''
        && tkNewGet('freeSevasRemaining', 0) == 0
        && tkNewGet('boostUntil', '') == ''
        && tkNewGet('reviewedBy', '') == ''
        && tkNewGet('reviewNote', '') == '';
    }
    match /purohitApplications/{appId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resUid()));
      allow create: if applicationCreateOk('purohitId');
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // --- gigs: public read (marketplace); signed-in devotees post;
    // JY-FIX-B compiled-size factoring: gigs and consultations share
    // ONE status machine and ONE immutability shape (the two systems
    // are mirrors by design). The shared bodies live here; the
    // per-system names below delegate, token-identical in expansion.
    function bookingTransitionOk() {
      let from = resStatus();
      let to = reqStatus();
      return (from == 'OPEN' && to in ['ASSIGNED', 'CANCELLED'])
        || (from == 'ASSIGNED' && to in ['IN_PROGRESS', 'CANCELLED'])
        // JY-13: IN_PROGRESS → CANCELLED is legitimate — a devotee
        // may withdraw a request that has started. BOTH clients offer
        // it (PurohitContext AND JyotishContext advance maps) while
        // the rules denied it — a guaranteed error, fixed here. The
        // update branches still require a PARTY, so this stays
        // party-scoped.
        || (from == 'IN_PROGRESS' && to in ['COMPLETED', 'CANCELLED'])
        || (from == 'COMPLETED' && to in ['DAKSHINA_RELEASED'])
        || (from == to);
    }
    function bookingImmutableOk() {
      return tkNewGet('devoteeUid', '') == tkOldGet('devoteeUid', '')
        && tkNewGet('id', '') == tkOldGet('id', '')
        && tkNewGet('createdAt', 0) == tkOldGet('createdAt', 0)
        && reqReferredBy() == tkOldGet('referredBy', {});
    }
    function isGigParty() {
      return isLoggedIn()
        && (uidIs(tkOldGet('devoteeUid', ''))
          || uidIs(tkOldGet('assignedPurohitUid', '')));
    }
    function gigTransitionOk() {
      return bookingTransitionOk();
    }
    function gigImmutableOk() {
      return bookingImmutableOk();
    }
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('devoteeUid', ''))
        && reqStatus() == 'OPEN'
        && gigReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && gigTransitionOk() && gigImmutableOk()
          && (isGigParty()
            // Accept flow: any verified-path purohit may claim an OPEN gig;
            || (resStatus() == 'OPEN'
              && reqStatus() == 'ASSIGNED'
              && uidIs(tkNewGet('assignedPurohitUid', '')))));
      allow delete: if false;
    }

    // --- endorsements: public read; Trustees (any real org) may endorse.
    match /endorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(R_TRUSTEE_PAIR()))
        && reqOrgId() != ''
        && tkNewGet('orgName', '') != ''
        && tkNewGet('purohitId', '') != ''
        && reqText() != '';
      allow update, delete: if isSuperAdmin();
    }

    // --- reviews: public read; deterministic ids (one rating per party per
    function reviewPartyOk() {
      let gigPath = /databases/$(database)/documents/gigs/$(tkNewGet('gigId', ''));
      return exists(gigPath)
        && get(gigPath).data.get('status', '') in ORDER_DONE()
        && (get(gigPath).data.get('devoteeUid', '') == request.auth.uid
          || get(gigPath).data.get('assignedPurohitUid', '') == request.auth.uid);
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('reviewerUid', ''))
        && tkNewGet('gigId', '') != ''
        && reqRating() >= 1
        && reqRating() <= 5
        && reviewPartyOk();
      allow update, delete: if false;
    }

    // --- purohitInvites: org â purohit staff invites. Readable by the invited
    match /purohitInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('purohitUid', ''))
            || roleIn(R_TRUSTEE_PAIR())));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(R_TRUSTEE_PAIR())
          && reqOrgId() != ''
          && tkNewGet('orgName', '') != ''
          && tkNewGet('purohitId', '') != ''
          && tkNewGet('purohitUid', '') != ''
          && reqStatus() == 'PENDING');
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uidIs(tkOldGet('purohitUid', ''))
          && diffKeysOnly(request.resource.data, resource.data, KEYS_STATUS_ONLY())
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }

    // Jyotish One â independent jyotishi identity + verification +

    // JY-02 helpers (shared by the profiles / consultations / tenders
    // blocks below): contact-key freeze for public profile docs, and
    // the jyotish-profile ownership anchor.
    function contactKeyFrozen(f) {
      return !reqKeys().hasAny([f])
        || tkNewGet(f, '') == tkOldGet(f, '');
    }
    function jyotishProfileOwnedByCaller(jid) {
      return exists(/databases/$(database)/documents/jyotishProfiles/$(jid))
        && get(/databases/$(database)/documents/jyotishProfiles/$(jid)).data.get('uid', '') == request.auth.uid;
    }

    // --- jyotishProfiles/{jyotishId}: public read (marketplace); owner +
    match /jyotishProfiles/{jyotishId} {
      allow read: if true;
      // JY-02: the public profile doc is born WITHOUT contact fields —
      // phone/email live only in the owner-only private/self subdoc
      // below (mirrors sanataniProfiles/{uid}/private/self).
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && reqVerificationTier() == 'REGISTERED'
        && tkNewGet('ratingAggregate', 0) == 0
        && reqRatingCount() == 0
        && tkNewGet('completedConsultations', 0) == 0
        // JY-FIX-B (JY-04): a profile is also born with ZERO anchored
        // endorsements — the claim branch reads this field, so it must
        // not be self-granted at birth.
        && request.resource.data.get('endorsementCount', 0) == 0
        && !reqKeys().hasAny(['phone', 'email']);
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uidIs(resUid())
          // uid / id / tier / rating aggregates pinned by diff: none may
          // be added, removed or changed on this branch (the factored
          // form of the five field-equalities this branch used before).
          && !diffKeys()
            .hasAny(['uid', 'id', 'verificationTier', 'ratingAggregate', 'ratingCount',
              // JY-FIX-B (JY-04): the endorsement anchors are pinned
              // here too — they move ONLY via the anchored endorsement
              // branch below, never on the owner's plain say-so.
              'endorsementCount', 'lastEndorsementId'])
          // JY-02: legacy contact fields on the public doc are frozen —
          // they may stay untouched or be REMOVED (the client migrates
          // them into private/self), never changed or re-added.
          && contactKeyFrozen('phone')
          && contactKeyFrozen('email')
          // SECURITY P1: the rating aggregate never moves on the
          // owner's own say-so -- only via the anchored review branch
          // below. completedConsultations may stay, or rise by exactly
          // 1 anchored to a consultation the owner just completed.
          && (tkNewGet('completedConsultations', 0) == tkOldGet('completedConsultations', 0)
            || p1CompletedConsultationOk()))
        // SECURITY P1 -- anchored rating step (see p1JyotishRatingOk).
        // The old branch let ANY signed-in user set ratingAggregate /
        // ratingCount / completedConsultations to any in-range value.
        || (isLoggedIn()
          && diffKeys()
            .hasOnly(RATING_KEYS())
          && p1JyotishRatingOk(jyotishId))
        // JY-FIX-B (JY-04) -- anchored endorsement step (see
        // p1JyotishEndorsementOk): the endorsement counter moves only
        // with the endorsement doc itself, in one transaction.
        || (isLoggedIn()
          && diffKeys()
            .hasOnly(['endorsementCount', 'lastEndorsementId', 'updatedAt'])
          && p1JyotishEndorsementOk(jyotishId))
        // JY-FIX-B (JY-04) -- the tier CLAIM: before this branch, NO
        // rules path let the owner advance their own verificationTier
        // (the owner branch pins it), so claimTierAdvancement failed
        // silently for every jyotishi. The owner may now write ONLY
        // verificationTier (+ updatedAt), and only to a step the doc's
        // own anchored fields have earned (jyotishTierClaimOk).
        || (isLoggedIn()
          && uidIs(resUid())
          && diffKeys()
            .hasOnly(['verificationTier', 'updatedAt'])
          && jyotishTierClaimOk())
        // PHASE 3 â Pratham Seva counter advancement (order-anchored).
        || (isLoggedIn() && sevaProfileCompletionOk());
      allow delete: if false;

      // JY-02 — jyotishi contact fields (phone/email): owner-only,
      // mirroring sanataniProfiles/{uid}/private/self.
      match /private/self {
        allow read, write: if isLoggedIn() && jyotishProfileOwnedByCaller(jyotishId);
      }
    }

    // --- jyotishAvailability: public read; owner write.
    match /jyotishAvailability/{jyotishId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isLoggedIn() && jyotishProfileOwnedByCaller(jyotishId));
    }

// ----------------- Section C: jyotishApplications (REPLACES) --------------
    match /jyotishApplications/{appId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resUid()));
      allow create: if applicationCreateOk('jyotishId');
      allow delete: if false;
      allow update: if isSuperAdmin();
    }

    // --- jyotishConsultations: public read (marketplace); signed-in
    function isConsultationParty() {
      return isLoggedIn()
        && (uidIs(tkOldGet('devoteeUid', ''))
          || uidIs(tkOldGet('assignedJyotishUid', '')));
    }
    // JY-FIX-B factoring: the same party check BY ID, for the nested
    // messages/remedies matches whose resource is the child doc.
    function consultationPartyById(cid) {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(cid);
      return isLoggedIn()
        && exists(cpath)
        && (get(cpath).data.get('devoteeUid', '') == request.auth.uid
          || get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid);
    }
    function consultationTransitionOk() {
      return bookingTransitionOk();
    }
    function consultationImmutableOk() {
      return bookingImmutableOk();
    }
    // JY-10: true when `jid` names a real jyotish profile owned by the
    // caller (the same anchor validJyotishAttach uses on the spine).
    function callerOwnsJyotishProfile(jid) {
      return jid != '' && jyotishProfileOwnedByCaller(jid);
    }
    // JY-02: true when the caller holds a jyotishi identity. The spine
    // check suffices: roles.jyotishId could only have been attached by
    // validJyotishAttach, which itself proved profile ownership then.
    function callerHasJyotishProfile() {
      let spath = /databases/$(database)/documents/sanataniProfiles/$(request.auth.uid);
      return exists(spath)
        && get(spath).data.get('roles', {}).get('jyotishId', '') != '';
    }
    match /jyotishConsultations/{consultationId} {
      // JY-02: party-scoped read — the doc carries birth date/time/place,
      // partner birth details, devotee phone and private notes. The open
      // board reads the PII-free jyotishTenders projection instead.
      allow read: if isSuperAdmin() || isConsultationParty();
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('devoteeUid', ''))
        && reqStatus() == 'OPEN'
        && consultationReferralAnchorOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && consultationTransitionOk() && consultationImmutableOk()
          && (isConsultationParty()
            // Accept flow: a jyotishi may claim an UNASSIGNED open
            // consultation only as themself — JY-10: the claimed
            // assignedJyotishId must be a real profile THEY own.
            || (resStatus() == 'OPEN'
              && tkOldGet('assignedJyotishUid', '') == ''
              && reqStatus() == 'ASSIGNED'
              && uidIs(tkNewGet('assignedJyotishUid', ''))
              && callerOwnsJyotishProfile(tkNewGet('assignedJyotishId', '')))));
      allow delete: if false;

      // --- messages subcollection: only the two parties read/write.
      match /messages/{messageId} {
        function isMsgParty() {
          return consultationPartyById(consultationId);
        }
        allow read: if isMsgParty() || isSuperAdmin();
        allow create: if isMsgParty()
          && uidIs(tkNewGet('senderUid', ''))
          && reqText() != '';
        allow update, delete: if false;
      }

      // --- remedies subcollection (Seva Pro Phase 4): the assigned jyotish
      match /remedies/{remedyId} {
        function isRemedyParty() {
          return consultationPartyById(consultationId);
        }
        allow read: if isRemedyParty() || isSuperAdmin();
        allow create: if isRemedyParty()
          && uidIs(tkNewGet('jyotishUid', ''))
          && tkNewGet('consultationId', '') == consultationId
          && tkNewGet('devoteeUid', '') == get(/databases/$(database)/documents/jyotishConsultations/$(consultationId)).data.get('devoteeUid', '')
          && tkNewGet('ritualName', '') != ''
          && tkNewGet('remedyText', '') != ''
          && reqStatus() == 'PENDING';
        allow update: if isSuperAdmin()
          || (isRemedyParty()
            && resStatus() == 'PENDING'
            && reqStatus() in ['BOOKED', 'DISMISSED']
            && diffKeysOnly(request.resource.data, resource.data, ['status', 'bookedGigId']));
        allow delete: if false;
      }
    }

    // --- jyotishTenders/{consultationId}: JY-02 — the PII-free open-
    // board projection of a consultation (same doc id). Carries ONLY
    // category, the devotee's public one-line summary, budget, language
    // and timing. The key whitelist in tenderShapeOk is the guarantee:
    // birth fields, phone and notes cannot exist here at all.
    function TENDER_KEYS() {
      return ['id', 'consultationType', 'topicSummary', 'mode', 'city',
        'language', 'preferredDate', 'budgetMin', 'budgetMax',
        'devoteeUid', 'devoteeName', 'status', 'createdAt'];
    }
    function tenderShapeOk() {
      return reqKeys().hasOnly(TENDER_KEYS())
        && tkNewGet('consultationType', '') != ''
        && tkNewGet('topicSummary', '').size() <= 200
        && reqStatus() == 'OPEN';
    }
    function tenderAcceptedByCaller(consultationId) {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(consultationId);
      return get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid
        && get(cpath).data.get('status', '') != 'OPEN';
    }
    match /jyotishTenders/{consultationId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && resStatus() == 'OPEN' && callerHasJyotishProfile());
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('devoteeUid', ''))
        && tenderShapeOk();
      allow update: if false;
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('devoteeUid', '')))
        || (isLoggedIn() && tenderAcceptedByCaller(consultationId));
    }

    // --- jyotishEndorsements: public read; Trustees (any real org) endorse.
    match /jyotishEndorsements/{endorsementId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && (isSuperAdmin() || roleIn(R_TRUSTEE_PAIR()))
        && reqOrgId() != ''
        && tkNewGet('orgName', '') != ''
        && tkNewGet('jyotishId', '') != ''
        && reqText() != '';
      allow update, delete: if isSuperAdmin();
    }

    // --- jyotishReviews: public read; deterministic ids (one rating per
    function consultationReviewPartyOk() {
      let cpath = /databases/$(database)/documents/jyotishConsultations/$(tkNewGet('consultationId', ''));
      return exists(cpath)
        && get(cpath).data.get('status', '') in ORDER_DONE()
        && (get(cpath).data.get('devoteeUid', '') == request.auth.uid
          || get(cpath).data.get('assignedJyotishUid', '') == request.auth.uid);
    }
    match /jyotishReviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('reviewerUid', ''))
        && tkNewGet('consultationId', '') != ''
        && reqRating() >= 1
        && reqRating() <= 5
        // JY-FIX-B (JY-09): the doc id is PINNED to the deterministic
        // form the client already writes —
        // {consultationId}_{reviewerUid}_{reviewerKind} — the polls
        // ballot-box pattern. Without the pin, a crafted client could
        // file a SECOND review for the same consultation under a fresh
        // id and move the anchored rating aggregate twice.
        && reviewId == tkNewGet('consultationId', '')
          + '_' + request.auth.uid
          + '_' + tkNewGet('reviewerKind', '')
        && consultationReviewPartyOk();
      allow update, delete: if false;
    }

    // --- jyotishInvites: org â jyotishi staff invites. Readable by the
    match /jyotishInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('jyotishUid', ''))
            || roleIn(R_TRUSTEE_PAIR())));
      allow create: if isSuperAdmin()
        || (isLoggedIn() && roleIn(R_TRUSTEE_PAIR())
          && reqOrgId() != ''
          && tkNewGet('orgName', '') != ''
          && tkNewGet('jyotishId', '') != ''
          && tkNewGet('jyotishUid', '') != ''
          && reqStatus() == 'PENDING');
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && uidIs(tkOldGet('jyotishUid', ''))
          && diffKeysOnly(request.resource.data, resource.data, KEYS_STATUS_ONLY())
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }


    // ================= Seva Pro Phase 4 â referral pipeline =================

    // --- referredBy anchoring on gig create (jyotish -> purohit) ---
    function remedyAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', '')))
        && get(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', ''))).data.get('devoteeUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', ''))).data.get('jyotishUid', '') == reqReferredBy().get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishConsultations/$(reqReferredBy().get('consultationId', ''))/remedies/$(reqReferredBy().get('remedyId', ''))).data.get('status', '') == 'PENDING';
    }
    function gigReferralAnchorOk() {
      return !('referredBy' in request.resource.data)
        || (reqReferredBy().get('direction', '') == 'jyotish-to-purohit'
          && reqReferredBy().get('referrerUid', '') != ''
          && reqReferredBy().get('remedyId', '') != ''
          && reqReferredBy().get('consultationId', '') != ''
          && reqReferredBy().get('ritualName', '') != ''
          && remedyAnchorOk());
    }

    // --- referredBy anchoring on consultation create (purohit -> jyotish) ---
    function referralAnchorOk() {
      return exists(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', '')))
        && get(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', ''))).data.get('fromKind', '') == 'purohit'
        && get(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', ''))).data.get('toKind', '') == 'jyotish'
        && get(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', ''))).data.get('fromUid', '') == reqReferredBy().get('referrerUid', '')
        && get(/databases/$(database)/documents/jyotishReferrals/$(reqReferredBy().get('referralId', ''))).data.get('devoteeUid', '') == request.auth.uid;
    }
    function consultationReferralAnchorOk() {
      return !('referredBy' in request.resource.data)
        || (reqReferredBy().get('direction', '') == 'purohit-to-jyotish'
          && reqReferredBy().get('referrerUid', '') != ''
          && reqReferredBy().get('referralId', '') != ''
          && referralAnchorOk());
    }

    // --- referralAttributions/{orderId} ---
    function attributionGigOk() {
      return reqOrderType() == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(reqOrderId()))
        && reqGigDoc().data.get('devoteeUid', '') == request.auth.uid
        && reqGigDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqGigDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function attributionConsultationOk() {
      return reqOrderType() == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(reqOrderId()))
        && reqConsultDoc().data.get('devoteeUid', '') == request.auth.uid
        && reqConsultDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqConsultDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function attributionOrderOk() {
      return attributionGigOk() || attributionConsultationOk();
    }
    function attributionTerminalOk() {
      return (reqOrderType() == 'gig'
          && reqGigDoc().data.get('status', '') == 'DAKSHINA_RELEASED')
        || (reqOrderType() == 'consultation'
          && reqConsultDoc().data.get('status', '') == 'DAKSHINA_RELEASED');
    }
    // Only an order party may move the attribution (prevents griefing the
    function attributionPartyOk() {
      return (reqOrderType() == 'gig'
          && (reqGigDoc().data.get('devoteeUid', '') == request.auth.uid
            || reqGigDoc().data.get('assignedPurohitUid', '') == request.auth.uid))
        || (reqOrderType() == 'consultation'
          && (reqConsultDoc().data.get('devoteeUid', '') == request.auth.uid
            || reqConsultDoc().data.get('assignedJyotishUid', '') == request.auth.uid));
    }

    // --- referralCredits/rc_{orderId} ---
    function creditGigOk() {
      return reqOrderType() == 'gig'
        && exists(/databases/$(database)/documents/gigs/$(reqOrderId()))
        && reqGigDoc().data.get('status', '') == 'DAKSHINA_RELEASED'
        && (reqGigDoc().data.get('devoteeUid', '') == request.auth.uid
          || reqGigDoc().data.get('assignedPurohitUid', '') == request.auth.uid)
        && reqGigDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqGigDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function creditConsultationOk() {
      return reqOrderType() == 'consultation'
        && exists(/databases/$(database)/documents/jyotishConsultations/$(reqOrderId()))
        && reqConsultDoc().data.get('status', '') == 'DAKSHINA_RELEASED'
        && (reqConsultDoc().data.get('devoteeUid', '') == request.auth.uid
          || reqConsultDoc().data.get('assignedJyotishUid', '') == request.auth.uid)
        && reqConsultDoc().data.get('referredBy', {}).get('referrerUid', '') == tkNewGet('referrerUid', '')
        && reqConsultDoc().data.get('referredBy', {}).get('direction', '') == tkNewGet('direction', '');
    }
    function creditOrderOk() {
      return creditGigOk() || creditConsultationOk();
    }
    function gigSevaValue() {
      return reqGigDoc().data.get('dakshinaAgreed', 0) > 0
        ? reqGigDoc().data.get('dakshinaAgreed', 0)
        : reqGigDoc().data.get('budgetMax', 0);
    }
    function consultationSevaValue() {
      return reqConsultDoc().data.get('dakshinaAgreed', 0) > 0
        ? reqConsultDoc().data.get('dakshinaAgreed', 0)
        : reqConsultDoc().data.get('budgetMax', 0);
    }
    function creditSevaValueOk() {
      return (reqOrderType() == 'gig'
          && tkNewGet('sevaValue', -1) == gigSevaValue())
        || (reqOrderType() == 'consultation'
          && tkNewGet('sevaValue', -1) == consultationSevaValue());
    }
    function creditRoundingOk() {
      return tkNewGet('creditAmount', 0) * 10000 >= tkNewGet('sevaValue', 0) * tkNewGet('referralBps', 0) - 5000
        && tkNewGet('creditAmount', 0) * 10000 <= tkNewGet('sevaValue', 0) * tkNewGet('referralBps', 0) + 5000;
    }
    function creditMathOk() {
      return tkNewGet('referralBps', 0) > 0
        && tkNewGet('referralBps', 0) <= 5000
        && tkNewGet('creditAmount', 0) > 0
        && tkNewGet('creditAmount', 0) <= tkNewGet('platformCommission', 0)
        && tkNewGet('platformCommission', 0) <= tkNewGet('sevaValue', 0)
        && creditSevaValueOk()
        && creditRoundingOk();
    }
    function creditOrderParty() {
      return (tkOldGet('orderType', '') == 'gig'
          && (get(/databases/$(database)/documents/gigs/$(tkOldGet('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/gigs/$(tkOldGet('orderId', ''))).data.get('assignedPurohitUid', '') == request.auth.uid))
        || (tkOldGet('orderType', '') == 'consultation'
          && (get(/databases/$(database)/documents/jyotishConsultations/$(tkOldGet('orderId', ''))).data.get('devoteeUid', '') == request.auth.uid
            || get(/databases/$(database)/documents/jyotishConsultations/$(tkOldGet('orderId', ''))).data.get('assignedJyotishUid', '') == request.auth.uid));
    }

    // --- wallet credit anchored to a validated referral credit doc ---
    function referralCreditDocOk(uid) {
      return reqLastReferralCreditId() != ''
        && reqLastReferralCreditId() != tkOldGet('lastReferralCreditId', '')
        && exists(/databases/$(database)/documents/referralCredits/$(reqLastReferralCreditId()))
        && reqCreditDoc().data.get('referrerUid', '') == uid
        && reqCreditDoc().data.get('status', '') == 'SETTLED'
        && tkNewGet('balance', -1) == tkOldGet('balance', 0) + reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalReceived', -1) == tkOldGet('totalReceived', 0) + reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalToppedUp', -1) == tkOldGet('totalToppedUp', 0)
        && tkNewGet('totalSpent', -1) == tkOldGet('totalSpent', 0)
        && diffKeysOnly(request.resource.data, resource.data, ['balance', 'totalReceived', 'totalToppedUp', 'totalSpent', 'updatedAt', 'lastReferralCreditId', 'currency', 'uid']);
    }
    function referralWalletCreditOk(uid) {
      return referralCreditDocOk(uid);
    }
    function referralWalletCreditCreateOk(uid) {
      return reqLastReferralCreditId() != ''
        && reqUid() == uid
        && exists(/databases/$(database)/documents/referralCredits/$(reqLastReferralCreditId()))
        && reqCreditDoc().data.get('referrerUid', '') == uid
        && reqCreditDoc().data.get('status', '') == 'SETTLED'
        && tkNewGet('balance', -1) == reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalReceived', -1) == reqCreditDoc().data.get('creditAmount', 0)
        && tkNewGet('totalToppedUp', -1) == 0
        && tkNewGet('totalSpent', -1) == 0;
    }
    // =============== end Seva Pro Phase 4 helpers ===============


    // --- jyotishReferrals: cross-referrals jyotish â purohit. Public read
    match /jyotishReferrals/{referralId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('fromUid', ''))
        && tkNewGet('toRoleId', '') != ''
        && tkNewGet('toTier', '') != ''
        && tkNewGet('toTier', '') != 'REGISTERED'
        && tkNewGet('reason', '') != '';
      allow update, delete: if isSuperAdmin();
    }


    // --- referralAttributions/{orderId}: one row per referred order.
    match /referralAttributions/{orderId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn()
          && (uidIs(tkOldGet('devoteeUid', ''))
            || uidIs(tkOldGet('referrerUid', ''))));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('devoteeUid', ''))
        && reqOrderType() in ['gig', 'consultation']
        && reqStatus() == 'OPEN'
        && tkNewGet('referrerUid', '') != ''
        && attributionOrderOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn()
          && resStatus() == 'OPEN'
          && reqStatus() in ['SETTLED', 'SKIPPED_NO_VALUE']
          && diffKeysOnly(request.resource.data, resource.data, ['status', 'settledAt', 'creditId'])
          && attributionTerminalOk()
          && attributionPartyOk());
      allow delete: if false;
    }

    // --- referralClaims/{orderId}: share-referral thanks claims (QUEUED #25).
    // One row per referred order, written by the BOOKER's device; the sharer
    // reads their own claims and self-listens for the thanks bell. The create
    // rule is order-anchored (mirrors referralAttributions): no forged thanks.
    match /referralClaims/{orderId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('sharerUid', '')));
      allow create: if isLoggedIn()
        && reqOrderId() == orderId
        && uidIs(tkNewGet('bookerUid', ''))
        && tkNewGet('sharerUid', '') != ''
        && tkNewGet('sharerUid', '') != request.auth.uid
        && tkNewGet('sharerSanId', '') != ''
        && tkNewGet('providerName', '') != ''
        && tkNewGet('createdAt', 0) is number
        && reqKeys().hasOnly(
          ['orderId', 'sharerUid', 'sharerSanId', 'bookerUid', 'providerName', 'createdAt'])
        && exists(/databases/$(database)/documents/marketplaceOrders/$(orderId))
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('clientUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/marketplaceOrders/$(orderId)).data.get('referredBy', '') == tkNewGet('sharerSanId', '');
      allow update, delete: if false;
    }

    // --- referralCredits/{creditId}: settled guidance credits.
    match /referralCredits/{creditId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('referrerUid', '')))
        || (isLoggedIn() && creditOrderParty());
      allow create: if isLoggedIn()
        && creditId == 'rc_' + reqOrderId()
        && reqOrderId() != ''
        && reqStatus() == 'SETTLED'
        && tkNewGet('direction', '') in ['jyotish-to-purohit', 'purohit-to-jyotish']
        && creditOrderOk()
        && creditMathOk();
      allow update: if isSuperAdmin()
        && resStatus() == 'SETTLED'
        && reqStatus() == 'REVERSED'
        && diffKeysOnly(request.resource.data, resource.data, ['status', 'reversedAt', 'reversalReason']);
      allow delete: if false;
    }


    // NOTE: no catch-all allow â default deny.

    // Sangam â the Sanatani social layer (personal view)

    // Badge validation: devotee/org authors carry no tier; purohit/jyotish
    function sangamAuthorTierOk() {
      let kind = tkNewGet('authorKind', '');
      let tier = tkNewGet('authorTier', '');
      let roleId = tkNewGet('authorRoleId', '');
      return (kind == 'devotee' && (tier == '' || tier == null))
        || (kind == 'org' && (tier == '' || tier == null))
        || (kind == 'purohit' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/purohits/$(roleId))
          && get(/databases/$(database)/documents/purohits/$(roleId)).data.get('uid', '') == request.auth.uid
          && tier == get(/databases/$(database)/documents/purohits/$(roleId)).data.get('verificationTier', ''))
        || (kind == 'jyotish' && roleId != '' && roleId != null
          && exists(/databases/$(database)/documents/jyotishProfiles/$(roleId))
          && get(/databases/$(database)/documents/jyotishProfiles/$(roleId)).data.get('uid', '') == request.auth.uid
          && tier == get(/databases/$(database)/documents/jyotishProfiles/$(roleId)).data.get('verificationTier', ''));
    }

    // Seva Bazar service_card: the editorial bar, enforced server-side.
    // Only providers (purohit/jyotish) may post them; the devotional text
    // (≥30 chars) and honest dakshina are non-negotiable. Cheap-signal
    // language is a client + moderation concern; the rules hold the shape.
    // NOTE: the 1-card/72h/provider spam line is enforced client-side in the
    // composer; true server-side rate limiting needs a Cloud Function
    // (Blaze-gated — unavailable on the $0 plan).
    function serviceCardOk() {
      let kind = tkNewGet('kind', '');
      let authorKind = tkNewGet('authorKind', '');
      let card = tkNewGet('serviceCard', {});
      // NOTE: Firestore Rules functions have no imperative `if` — the
      // early-return is expressed as a ternary/or-chain instead.
      return kind != 'service_card'
        || ((authorKind == 'purohit' || authorKind == 'jyotish')
          && card != null
          && card.get('devotionalText', '').size() >= 30
          && card.get('serviceLine', '') != ''
          && card.get('dakshina', 0) > 0
          && uidIs(card.get('providerUid', ''))
          && card.get('providerTier', '') in ['REGISTERED', 'VERIFIED', 'TRUSTED']);
    }

    // Official page posts: only a trustee of that org may post as the page.
    function sangamPagePostOk() {
      let official = tkNewGet('isOfficialPagePost', false);
      let orgId = reqOrgId();
      return official == false || official == null
        || (orgId != '' && orgId != null && isOrgTrustee(orgId));
    }

    // --- sangamPosts: public read (the community feed); author create;
    // service_card (Seva Bazar): provider-only, editorial bar enforced.
    match /sangamPosts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(reqAuthorUid())
        && reqKeys().hasOnly(
          ['authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorRoleId', 'authorTier',
           'orgId', 'orgName', 'isOfficialPagePost', 'kind', 'text', 'imageUrl', 'shlokaRef',
           'seva', 'serviceCard', 'eventRef', 'sharedFrom', 'createdAt', 'ashirvadCount', 'commentCount',
           'shareCount', 'visibility', 'status',
           // Phase 3+4: gratitude (providerUid/providerName), festival moments (festival),
           // consultation answers (anonymized)
           'providerUid', 'providerName', 'festival', 'anonymized'])
        && tkNewGet('ashirvadCount', -1) == 0
        && tkNewGet('commentCount', -1) == 0
        && tkNewGet('shareCount', -1) == 0
        && reqStatus() == 'active'
        && tkNewGet('visibility', '') == 'public'
        && reqText() != ''
        && sangamAuthorTierOk()
        && sangamPagePostOk()
        && serviceCardOk();
      allow update: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resAuthorUid())
          && diffKeysOnly(request.resource.data, resource.data, ['text', 'imageUrl', 'updatedAt'])
          && reqAuthorUid() == resAuthorUid())
        // Step 4 (comment multi-device sync): any signed-in user may nudge
        // commentCount by exactly ±1 (never below 0) and touch nothing else.
        // This lets commenters keep the count honest on posts they don't own.
        || (isLoggedIn()
          && bumpToggleOk('commentCount'))
        // Audit Fix #1: same ±1 pattern for ashirvadCount and shareCount —
        // any signed-in user may nudge exactly ±1 (never below 0), nothing else.
        || (isLoggedIn()
          && bumpToggleOk('ashirvadCount'))
        || (isLoggedIn()
          && bumpToggleOk('shareCount'));
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resAuthorUid()));
    }

    // --- sangamPosts/{postId}/ashirvad/{uid}: one Ashirvad per user (toggle).
    match /sangamPosts/{postId}/ashirvad/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    // --- sangamPosts/{postId}/volunteers/{uid}: seva volunteering (toggle).
    match /sangamPosts/{postId}/volunteers/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    // --- sangamComments: public read; signed-in create (author pinned,
    match /sangamComments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(reqAuthorUid())
        && tkNewGet('postId', '') != ''
        && reqKeys().hasOnly(
          ['postId', 'authorUid', 'authorName', 'authorSanId', 'authorKind', 'authorTier', 'text', 'createdAt'])
        && reqText() != ''
        && sangamAuthorTierOk();
      allow update, delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resAuthorUid()));
    }

    // --- sangamCircles: public read; signed-in create; creator/admin update.
    match /sangamCircles/{circleId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('creatorUid', ''))
        && reqName() != ''
        && reqKeys().hasOnly(
          ['name', 'topic', 'description', 'creatorUid', 'creatorName', 'memberCount', 'createdAt']);
      allow update: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('creatorUid', ''))
          && diffKeysOnly(request.resource.data, resource.data, 
            ['name', 'topic', 'description', 'updatedAt']))
        // Member count path (owner-approved 2026-10-20): any signed-in
        // user may nudge memberCount by exactly +-1 (never below 0) and
        // touch nothing else -- mirrors the sangamPosts pattern.
        || (isLoggedIn()
          && bumpToggleOk('memberCount'));
      allow delete: if isSuperAdmin();
    }

    // --- sangamCircles/{circleId}/members/{uid}: join/leave (toggle).
    match /sangamCircles/{circleId}/members/{uid} {
      allow read: if true;
      allow create, delete: if isSelf(uid);
      allow update: if false;
    }

    // --- sangamEvents: public read; signed-in create (org events need
    match /sangamEvents/{eventId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('creatorUid', ''))
        && reqTitle() != ''
        && (reqOrgId() == ''
          || tkNewGet('orgId', null) == null
          || isOrgTrustee(reqOrgId()))
        // EVENTS P0 (L8): the official badge may not float free — an
        // official event must name its org AND be posted by that org's
        // own trustee.
        && (tkNewGet('isOfficial', false) != true
          || (reqOrgId() != ''
              && isOrgTrustee(reqOrgId())))
        && reqKeys().hasOnly(
          ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'orgId', 'orgName',
           'isOfficial', 'creatorUid', 'creatorName', 'rsvpCount', 'createdAt',
           // EVENTS P1: hall capacity + recurrence rule (lib/eventRecurrence).
           'capacity', 'recurrence']);
      allow update: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('creatorUid', ''))
          && diffKeysOnly(request.resource.data, resource.data, 
            ['title', 'kind', 'description', 'venue', 'startsAt', 'endsAt', 'updatedAt',
             // EVENTS P1: the creator may set the hall size and the
             // recurrence rule; occurrences derive from the rule, so
             // editing it rewrites the future on every surface.
             'capacity', 'recurrence']))
        // RSVP count path (EVENTS + POLLS P0, 2026-10-24): the count
        // moves by exactly +-1 ONLY in the same batch as the caller's
        // own rsvps/{uid} doc being created (+1) or deleted (-1) —
        // anchored, so the number can no longer be nudged on its own.
        // (Was: any signed-in user could move it freely, 2026-10-20.)
        // EVENTS P1 extends the count path below: 'going' is the only
        // counted state. Create/delete keep the P0 anchor — a fresh
        // record defaults to 'going', and a record holding another
        // state never moved the count, so its deletion must not move
        // it either (the state checks pin exactly that). Two new
        // flips move the count when an EXISTING record changes state
        // to or from 'going'. Every +1 path must respect the event's
        // capacity when one is set — a full event takes waitlist
        // joins, never a 101st 'going'.
        || (isLoggedIn()
          && diffKeysOnly(request.resource.data, resource.data, ['rsvpCount'])
          && tkNewGet('rsvpCount', -1) >= 0
          && ((reqRsvpCount() == tkOldGet('rsvpCount', 0) + 1
                && !exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', 'going') == 'going'
                && rsvpWithinCap())
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) - 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && get(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', 'going') == 'going')
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) + 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && get(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', 'going') in ['interested', 'waitlisted']
                && getAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', '') == 'going'
                && rsvpWithinCap())
              || (reqRsvpCount() == tkOldGet('rsvpCount', 0) - 1
                && exists(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid))
                && get(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', 'going') == 'going'
                && getAfter(/databases/$(database)/documents/sangamEvents/$(eventId)/rsvps/$(request.auth.uid)).data.get('state', '') in ['interested', 'waitlisted'])));
      // QUEUED FIX #1 (flagged): creators may delete their own events so
      // trustees can "unshare" an org event bridged to Sangam.
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('creatorUid', '')));
    }

    // --- sangamEvents/{eventId}/rsvps/{uid}: RSVP (toggle).
    match /sangamEvents/{eventId}/rsvps/{uid} {
      allow read: if true;
      // EVENTS P1: a record carries the member's state ('going' |
      // 'interested' | 'waitlisted'); pre-P1 records have no state
      // and read as 'going' everywhere (the counter anchor's default).
      // Flips are own-record only, state + join-time fields only; the
      // counted consequences live in the event doc's anchor above.
      allow create: if isSelf(uid)
        && tkNewGet('state', 'going') in ['going', 'interested', 'waitlisted'];
      allow update: if isSelf(uid)
        && diffKeysOnly(request.resource.data, resource.data, ['state', 'at'])
        && tkNewGet('state', '') in ['going', 'interested', 'waitlisted'];
      allow delete: if isSelf(uid);
    }

    // --- sangamFollows/{followerUid}_{targetType}_{targetId}: public read;
    match /sangamFollows/{followId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('followerUid', ''))
        && reqKeys().hasOnly(
          ['followerUid', 'targetType', 'targetId', 'targetName', 'createdAt']);
      allow update: if false;
      allow delete: if isLoggedIn() && uidIs(tkOldGet('followerUid', ''));
    }

    // --- sangamReports: reporter create; reporter+admin read; admin triage.
    match /sangamReports/{reportId} {
      allow read: if isSuperAdmin() || isOwner()
        || (isLoggedIn() && uidIs(tkOldGet('reporterUid', '')));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('reporterUid', ''))
        && tkNewGet('targetId', '') != ''
        && reqKeys().hasOnly(
          ['reporterUid', 'reporterName', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt'])
        && reqStatus() == 'open';
      allow update, delete: if isSuperAdmin() || isOwner();
    }

    // Membership sprint â Organisation Membership System

    // --- orgGlance/{workspaceId}: per-org glance summaries for the Solo
    match /orgGlance/{workspaceId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId));
      allow create, update: if isSuperAdmin()
        || (isLoggedIn() && isTenantMember(workspaceId)
          && reqWorkspaceId() == workspaceId);
      allow delete: if false;
    }

    // --- orgPages/{orgId}: public read (discovery + public org page).
    match /orgPages/{orgId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (
        isOrgTrustee(orgId)
        && reqKeys().hasOnly(
          ['orgId', 'name', 'type', 'city', 'state', 'country', 'about',
           'tagline', 'logoUrl', 'coverUrl', 'publicSlug', 'addressLine',
           'pincode', 'phone', 'website', 'darshanTimings', 'galleryUrls',
           'upcomingEvents', 'autoShareEvents', 'registrationNo', 'eightyGRegistered',
           'eightyGURN', 'twelveARegistered', 'verified', 'pinnedAarti',
           'aartiSchedules', 'updatedAt'])
        && reqOrgId() == orgId
        // SECURITY P1 (Finding 3): trustees may carry 'verified' (a
        // merged doc holds it, so it stays in the key whitelist) but
        // may never CHANGE it -- verification is granted only by the
        // platform owner (the SuperAdmin branch above). On create the
        // flag must be absent/false; on update it must be unchanged.
        && (resource == null
          ? tkNewGet('verified', false) == false
          : tkNewGet('verified', false) == tkOldGet('verified', false))
      );
      allow delete: if isSuperAdmin();
    }

    // --- orgPages/{orgId}/sevaCards/{cardId}: tangible giving cards (Phase 2).
    // Public read (giving cards are public information); trustee write.
    // Devotees tap a card → Phase 1's express dana sheet opens prefilled.
    match /orgPages/{orgId}/sevaCards/{cardId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        || (isOrgTrustee(orgId)
          && reqKeys().hasOnly([
            'title', 'amount', 'currency', 'outcomeCopy', 'goalTarget',
            'raisedTotal', 'active', 'sortOrder',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
          && reqTitle() != ''
          && reqAmount() is number
          && reqAmount() > 0);
      allow delete: if isSuperAdmin() || isOrgTrustee(orgId);
    }

    // --- orgBroadcasts/{broadcastId}: org announcements (QUEUED #14,
    // owner-approved 2026-10-20). Public read (announcements are public);
    // create only by a trustee of the org named in the doc, schema-pinned,
    // createdBy == caller, non-empty title; a broadcast is a sent letter --
    // no updates; delete by superadmin or the org's trustee.
    match /orgBroadcasts/{broadcastId} {
      allow read: if true;
      allow create: if isOrgTrustee(reqOrgId())
        && reqKeys().hasOnly(
          ['orgId', 'orgName', 'title', 'body', 'createdBy', 'createdByName',
           'audienceCount', 'createdAt'])
        && uidIs(tkNewGet('createdBy', ''))
        && reqTitle() != ''
        && tkNewGet('audienceCount', 0) is number
        && tkNewGet('createdAt', 0) is number;
      allow update: if false;
      allow delete: if isSuperAdmin()
        || isOrgTrustee(tkOldGet('orgId', ''));
    }

    // --- familyLinks/{uid}: family safety circles (crisis module). ---
    // Each user's doc holds linkedUids, consents, incomingInvites, outgoingInvites.
    // Read: own doc, or a linked member's doc (consent-gated SOS history view).
    //   A denied read means "no consent" — callers treat it as an empty list.
    // Write own doc: top-level fields pinned. Cross-user writes are parties-only:
    //   sending an invite writes incomingInvites.{ownUid} (pending) on the
    //   target's doc; accept/decline/revoke touch only self-scoped keys and are
    //   anchored to a pending invite or an existing link, so a stranger can
    //   never forge a family link to read someone's SOS history.
    // Only the writer's own key may differ inside one of the link maps.
    function familyLinkMapOnlySelfChanged(beforeMap, afterMap) {
      return diffKeysOnly(afterMap, beforeMap, [request.auth.uid]);
    }
    // A well-formed pending invite FROM the writer (no one can invite as another).
    function familyLinkInviteContentOk(invite) {
      return invite != null
        && uidIs(invite.get('fromUid', ''))
        && invite.get('status', '') == 'pending'
        && invite.keys().hasOnly(
          ['fromUid', 'fromName', 'fromPhoto', 'fromSanId', 'status', 'createdAt']);
    }
    // Cross-user update on someone else's familyLinks doc. Three legitimate
    // shapes: (1) send/resend my pending invite, (2) accept their invite to me
    // (gain link + consent), (3) decline/revoke (remove my keys). Anything else
    // — including granting myself a link without their invite — is denied.
    function familyLinkCrossUpdateOk() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let topChanged = after.diff(before).affectedKeys();
      let scoped = topChanged.hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites'])
        && familyLinkMapOnlySelfChanged(
          before.get('consents', {}), after.get('consents', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('incomingInvites', {}), after.get('incomingInvites', {}))
        && familyLinkMapOnlySelfChanged(
          before.get('outgoingInvites', {}), after.get('outgoingInvites', {}))
        && after.get('linkedUids', []).toSet()
          .difference(before.get('linkedUids', []).toSet()).hasOnly([me])
        && before.get('linkedUids', []).toSet()
          .difference(after.get('linkedUids', []).toSet()).hasOnly([me]);
      // (1) send/resend: only my incoming invite changes, and it is well-formed.
      let onlyInvite = topChanged.hasOnly(['incomingInvites'])
        && familyLinkInviteContentOk(after.get('incomingInvites', {}).get(me, null));
      // (2) accept: THEY invited me (pending outgoing invite on their doc).
      let accept = before.get('outgoingInvites', {}).get(me, {}).get('status', '') == 'pending'
        && (me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, {}).get('granted', false) == true;
      // (3) decline/revoke: I remove my keys, anchored to their pending invite
      // or to an existing link. Never grants anything.
      let withdraw = (before.get('outgoingInvites', {}).get(me, null) != null
          || (me in before.get('linkedUids', [])))
        && !(me in after.get('linkedUids', []))
        && after.get('consents', {}).get(me, null) == null;
      return scoped && (onlyInvite || accept || withdraw);
    }
    match /familyLinks/{docUid} {
      allow read: if isLoggedIn()
        && (request.auth.uid == docUid
          || (resource != null && request.auth.uid in tkOldGet('linkedUids', [])));
      allow create, update: if isSelf(docUid)
        && reqKeys().hasOnly(
          ['linkedUids', 'consents', 'incomingInvites', 'outgoingInvites']);
      allow delete: if isSelf(docUid);
      // Invite send → the TARGET's doc (create on first invite).
      allow create: if isLoggedIn() && request.auth.uid != docUid
        && reqKeys().hasOnly(['incomingInvites'])
        && tkNewGet('incomingInvites', {}).keys().hasOnly([request.auth.uid])
        && familyLinkInviteContentOk(
          tkNewGet('incomingInvites', {}).get(request.auth.uid, null));
      // Invite resend / accept / decline / revoke → the other party's doc.
      allow update: if isLoggedIn() && request.auth.uid != docUid
        && familyLinkCrossUpdateOk();
    }

    // --- qrCodes/{region}: owner-uploaded regional payment QRs. ---
    // GodMode → Geo Payments → QR Codes. Public read: payers must see the QR
    // at checkout (paymentMethods.ts). Owner-only write/delete, content pinned
    // to image data URLs so the collection can never become a file dump.
    match /qrCodes/{region} {
      allow read: if true;
      allow create, update: if isOwner()
        && tkNewGet('region', '') == region
        && reqKeys().hasOnly(
          ['imageData', 'region', 'uploadedAt', 'uploadedBy'])
        && tkNewGet('imageData', '').matches('^data:image/(png|jpeg|webp);base64,');
      allow delete: if isOwner();
    }

    // --- vdaAliases/{alias}: speakable devotee-ID claims (Phase 2).
    // Doc id IS the normalized alias (`aarav@kashi`); first-write-wins.
    // SAN-XXXXXX stays canonical — this is the friendly layer on top.
    match /vdaAliases/{aliasId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && tkNewGet('alias', '') == aliasId
        && reqKeys().hasOnly(['alias', 'uid', 'sanId', 'createdAt']);
      // Releasing = delete; only the owning uid may release. No updates ever.
      allow update: if false;
      allow delete: if isLoggedIn()
        && uidIs(resUid());
    }

    // --- followers/{orgId}/users/{uid}: public read (counts); owner write.
    match /followers/{orgId}/users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
        && reqUid() == uid;
      allow update: if false;
      allow delete: if isSelf(uid);
    }

    // --- joinRequests/{orgId}_{uid}: deterministic id = one pending per
    match /joinRequests/{requestId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(tkOldGet('userUid', '')))
        || (isLoggedIn() && isOrgTrustee(tkOldGet('orgId', '')));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('userUid', ''))
        && reqOrgId() != ''
        && reqStatus() == 'PENDING';
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('orgId', ''))
          && diffKeys()
            .hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt'])
          && reqStatus() in ['APPROVED', 'REJECTED'])
        || (isLoggedIn() && uidIs(tkOldGet('userUid', ''))
          && resStatus() == 'REJECTED'
          && reqStatus() == 'PENDING'
          && diffKeys()
            .hasOnly(['status', 'message', 'createdAt']));
      allow delete: if false;
    }

    // --- orgInvites/{inviteId}: org â user invitations.
    function inviteMatchesMe() {
      return isLoggedIn() && (
        uidIs(tkOldGet('invitedUid', '')) ||
        (request.auth.token.email != null
          && tkOldGet('invitedEmail', '') == request.auth.token.email) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '') != ''
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '')
            == tkOldGet('invitedPhone', ''))
      );
    }
    match /orgInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && (inviteMatchesMe()
          || isOrgTrustee(tkOldGet('orgId', ''))));
      allow create: if isLoggedIn()
        && reqOrgId() != ''
        && reqStatus() == 'PENDING'
        && tkNewGet('expiresAt', 0) > request.time.toMillis()
        && reqRole() != ''
        && grantableRole(reqOrgId(), reqRole());
      allow update: if isSuperAdmin()
        || (isLoggedIn() && inviteMatchesMe()
          && resStatus() == 'PENDING'
          && tkOldGet('expiresAt', 0) > request.time.toMillis()
          && diffKeysOnly(request.resource.data, resource.data, ['status', 'decidedAt'])
          && reqStatus() in DECISION_STATES());
      allow delete: if false;
    }

    // --- workspaceMembers/{workspaceId}_{uid}: the rules-enforced membership
    function inviteAcceptOk(inviteId, workspaceId, role) {
      let ipath = /databases/$(database)/documents/orgInvites/$(inviteId);
      return inviteId != '' && exists(ipath)
        && get(ipath).data.get('status', '') == 'ACCEPTED'
        && get(ipath).data.get('expiresAt', 0) > request.time.toMillis()
        && get(ipath).data.get('orgId', '') == workspaceId
        && get(ipath).data.get('role', '') == role
        && (get(ipath).data.get('invitedUid', '') == request.auth.uid
          || (request.auth.token.email != null
            && get(ipath).data.get('invitedEmail', '') == request.auth.token.email));
    }
    match /workspaceMembers/{memberId} {
      allow read: if isSuperAdmin()
        || (isLoggedIn() && uidIs(resUid()))
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', '')));
      allow create: if isLoggedIn()
        && reqWorkspaceId() != ''
        && reqUid() != ''
        && reqRole() != ''
        && (
          // (a) Trustee grants for another user (join approval / direct add)
          (isOrgTrustee(reqWorkspaceId())
            && grantableRole(reqWorkspaceId(),
              reqRole()))
          // (b) Self-accept of an invite: the invite must name me, be
          || (uidIs(reqUid())
            && inviteAcceptOk(
              tkNewGet('viaInviteId', ''),
              reqWorkspaceId(),
              reqRole()))
          // (c) Workspace creator self-provisions as the first Trustee.
          || (uidIs(reqUid())
            && reqRole() == 'Trustee'
            && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.createdBy == request.auth.uid)
        );
      allow update: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', ''))
          && grantableRole(tkOldGet('workspaceId', ''),
            reqRole()));
      allow delete: if isSuperAdmin()
        || (isLoggedIn() && isOrgTrustee(tkOldGet('workspaceId', '')));
    }

    // NotificationCenter collections (Phase 3 merge of
    match /notifications/{uid} {
      allow read, write: if false;

      // --- In-app notification center --------------------
      match /items/{itemId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqKeys().hasAll([
            'id', 'uid', 'kind', 'priority', 'title', 'body', 'dedupeKey', 'createdAt'
          ]);
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid;
        allow delete: if false;
      }

      match /pushRequests/{reqId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.toUser == uid
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }

      // --- Owner-only preferences ------------------------
      match /prefs {
        allow read, write: if isSelf(uid);
      }
    }

    // App Growth funnel (/get-app QR smart link). The landing page is
    // PUBLIC, so scan/install/waitlist logging must be anonymously
    // writable â but tightly validated: exact key allow-list, bounded
    // campaign ids, server timestamps only. Reads are owner-only
    // (GodMode Analytics tab). Campaign + config docs are publicly
    // readable (the landing page renders them); writes are owner-only.
    match /appGrowthScans/{scanId} {
      allow create: if reqKeys().hasOnly(['campaignId', 'platform', 'ts'])
        && (tkNewGet('campaignId', null) == null
          || (tkNewGet('campaignId', '') is string
            && tkNewGet('campaignId', '').size() <= 64))
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthInstalls/{installId} {
      allow create: if reqKeys().hasOnly(['campaignId', 'platform', 'ts'])
        && (tkNewGet('campaignId', null) == null
          || (tkNewGet('campaignId', '') is string
            && tkNewGet('campaignId', '').size() <= 64))
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthWaitlist/{entryId} {
      allow create: if reqKeys().hasOnly(['platform', 'ts'])
        && tkNewGet('platform', '') in PLATFORMS()
        && tkNewGet('ts', null) == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /appGrowthCampaigns/{campaignId} {
      allow get: if true;
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }
    match /appGrowth/{docId} {
      allow get: if docId == 'config';
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    // P2P money requests (chat-embedded): parties-only, strict state machine, no delete.
    match /p2pRequests/{reqId} {
      allow read: if isLoggedIn()
        && (uidIs(tkOldGet('senderId', ''))
          || uidIs(tkOldGet('receiverId', '')));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('senderId', ''))
        && reqStatus() == 'pending';
      allow update: if isLoggedIn()
        && (uidIs(tkOldGet('senderId', ''))
          || uidIs(tkOldGet('receiverId', '')))
        && diffKeys()
          .hasOnly(['status', 'updatedAt', 'paidRef', 'paidVia', 'paidAt', 'settledAt', 'supersededBy'])
        && (
          (uidIs(tkOldGet('receiverId', ''))
            && resStatus() == 'pending'
            && reqStatus() in ['accepted', 'declined', 'countered'])
          || (uidIs(tkOldGet('senderId', ''))
            && resStatus() == 'accepted'
            && reqStatus() == 'paid')
          || (uidIs(tkOldGet('receiverId', ''))
            && resStatus() == 'paid'
            && reqStatus() == 'settled')
          || (uidIs(tkOldGet('senderId', ''))
            && resStatus() == 'pending'
            && reqStatus() == 'cancelled'));
      allow delete: if false;
    }

    // File Vault (zero-cost Storage replacement: Firestore + IndexedDB).
        // Campus maps — public temple layouts (Phase 1: builder + visitor view).
    // Read is public: a temple map is public information. Write is org-admin
    // only (trustee/superadmin of that workspace). No personal data here.
    match /campusMaps/{orgId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && (
        hasRole(orgId, R_TRUSTEE())
        || isOwner()
      );
      allow delete: if false;
    }
    // Sevadar live reports — "human sensors" for campus conditions.
    // Read is public (live conditions are public information).
    // Write: sevadar+ of that workspace (role-gated). Reports EXPIRE
    // (expiresAt); no delete needed — clients filter expired, cleanup
    // removes them. Never per-user tracking data here.
    match /zoneReports/{reportId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && reqOrgId() != ''
        && uidIs(tkNewGet('reportedBy', ''))
        && reqKeys().hasOnly(['id', 'orgId', 'zoneId',
          'zoneName', 'type', 'note', 'reportedBy', 'reporterName',
          'createdAt', 'expiresAt', 'serverAt'])
        && (hasRole(reqOrgId(),
              ['SuperAdmin', 'SUPER_ADMIN', 'Trustee', 'TRUSTEE', 'Sevadar',
               'SEVADAR', 'Coordinator', 'COORDINATOR'])
            || isOwner());
      allow update, delete: if false;
    }

match /fileVault/{fileId} {
      allow read: if isLoggedIn()
        && (tkOldGet('visibility', 'private') == 'public'
          || uidIs(tkOldGet('ownerUid', ''))
          || (tkOldGet('visibility', '') == 'crisis'
            && isTenantMember(tkOldGet('tenantId', null))));
      allow create: if isLoggedIn()
        && uidIs(tkNewGet('ownerUid', ''))
        && reqKeys().hasOnly(['data', 'contentType', 'fileName',
          'size', 'hash', 'category', 'visibility', 'ownerUid', 'createdAt',
          'localOnly', 'chunkCount', 'tenantId'])
        && (
          // Single-doc upload: the whole file is inline — `size` (the declared
          // byte count) stays ≤ 1 MiB, and Firestore's own document cap bounds
          // the actual bytes anyway.
          (tkNewGet('chunkCount', 0) == 0
            && tkNewGet('localOnly', false) != true
            && tkNewGet('size', 99999999) <= 1048576)
          // Chunked upload: metadata only — bytes live in /chunks, so no
          // inline `data` key; the declared total may reach 10 MiB across
          // ≤ 28 chunks (500 KB base64 each, mirroring VAULT_CHUNK_B64).
          || (tkNewGet('chunkCount', 0) > 0
            && tkNewGet('chunkCount', 9999) <= 28
            && !reqKeys().hasAny(['data'])
            && tkNewGet('size', 99999999) <= 10485760)
          // Private files: bytes never leave this device — Firestore holds
          // only a tiny metadata pointer, so `size` may exceed 1 MiB.
          || tkNewGet('localOnly', false) == true);
      allow update: if false;
      allow delete: if isLoggedIn()
        && uidIs(tkOldGet('ownerUid', ''));
      // Chunks carry denormalized gating fields: authorized from the chunk doc alone.
      match /chunks/{n} {
        allow read: if isLoggedIn()
          && (tkOldGet('visibility', 'private') == 'public'
            || uidIs(tkOldGet('ownerUid', ''))
            || (tkOldGet('visibility', '') == 'crisis'
              && isTenantMember(tkOldGet('tenantId', null))));
        allow create: if isLoggedIn()
          && uidIs(tkNewGet('ownerUid', ''))
          && tkNewGet('visibility', '') in ['public', 'crisis']
          && tkNewGet('data', '').size() <= 512000
          && tkNewGet('i', -1) >= 0
          && reqKeys().hasOnly(
            ['i', 'data', 'ownerUid', 'visibility', 'tenantId']);
        allow update: if false;
        allow delete: if isLoggedIn()
          && uidIs(tkOldGet('ownerUid', ''));
      }
    }

    /* ── Translation Quality System ────────────────────────────────────
     * Devotees suggest better wording for draft strings
     * (`translationSuggestions`); owner-approved corrections ship as
     * runtime overrides (`translationOverrides/{lang}`) — live in the app
     * without a redeploy. UI strings ship in the client bundle anyway, so
     * override reads are public; writes are owner-only.
     * Regional vocabulary suggestions may carry `region` (a RegionId) and
     * `termKey` (e.g. 'temple'); the approved text lands verbatim under
     * `regional.{region}.{termKey}` in the override doc.
     */
    match /translationSuggestions/{suggestionId} {
      allow create: if isLoggedIn()
        && uidIs(reqUid())
        && reqStatus() == 'pending'
        && reqKeys().hasOnly(['lang', 'key', 'currentText',
          'suggestedText', 'uid', 'sanataniId', 'status', 'createdAt',
          'region', 'termKey'])
        && tkNewGet('lang', '') in
          ['en', 'hi', 'bn', 'sa', 'ta', 'te', 'mr', 'gu', 'kn', 'ml']
        && tkNewGet('key', '').size() > 0
        && tkNewGet('key', '').size() <= 200
        && tkNewGet('suggestedText', '').size() > 0
        && tkNewGet('suggestedText', '').size() <= 2000
        && tkNewGet('currentText', '').size() <= 2000
        && isRegionId(tkNewGet('region', ''))
        && (tkNewGet('termKey', '') == ''
          || (tkNewGet('termKey', '').size() <= 40
            && tkNewGet('termKey', '').matches('^[a-zA-Z]+$')));
      // A devotee may read their own suggestions; the owner reads the queue.
      allow read: if isLoggedIn()
        && (uidIs(resUid()) || isOwner());
      // Owner triage: approve or reject. Records are kept, never edited.
      allow update: if isOwner()
        && reqStatus() in ['approved', 'rejected'];
      allow delete: if isOwner();
    }


    /* =====================================================================
     * TIRTHA DIARY (Map Phase 2) — personal pilgrimage journal.
     * ---------------------------------------------------------------------
     * PRIVACY LAW, ENFORCED AT THE DATABASE LEVEL:
     *  - Owner-only: {uid} MUST equal request.auth.uid on every op.
     *  - No public reads. No family/org reads. No sharing at the rules
     *    level — there is no share path in this phase.
     *  - Writes are schema-pinned: visits and yatras carry only the
     *    fields the client needs; uid is immutable after create.
     *  - Deletes are always allowed for the owner ("forget in one tap").
     * ===================================================================== */
    match /tirthaVisits/{uid} {
      allow read, write: if false; // no collection-level access

      match /visits/{visitId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && tkNewGet('templeName', '').size() > 0
          && tkNewGet('templeName', '').size() <= 120
          && reqKeys().hasOnly(TIRTHA_VISIT_KEYS());
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid
          && tkNewGet('templeName', '').size() > 0
          && tkNewGet('templeName', '').size() <= 120
          && reqKeys().hasOnly(TIRTHA_VISIT_KEYS());
        allow delete: if isSelf(uid);
      }
    }

    match /tirthaYatras/{uid} {
      allow read, write: if false; // no collection-level access

      match /yatras/{yatraId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqName().size() > 0
          && reqName().size() <= 80
          && reqKeys().hasOnly(TIRTHA_YATRA_KEYS());
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid
          && reqName().size() > 0
          && reqName().size() <= 80
          && reqKeys().hasOnly(TIRTHA_YATRA_KEYS());
        allow delete: if isSelf(uid);
      }
    }

    match /translationOverrides/{lang} {
      // UI strings are public by nature — they ship in the client bundle.
      allow read: if true;
      // Owner-only corrections; the per-language map stays bounded.
      allow create, update: if isOwner()
        && request.resource.data.size() <= 2000;
      allow delete: if false;
    }

    // --- QR Intelligence Phase 1: aggregate scan analytics. ---
    // Privacy law: only the SHA-256 scanner hash leaves the device — the raw
    // uid is never written. Phase 1 is aggregate-only; the dashboard reads
    // qrScanStats, never the raw event stream.
    match /qrScanEvents/{eventId} {
      // Any signed-in user may append their own scan event. Append-only.
      allow create: if isLoggedIn()
        && reqKeys().hasOnly([
          'qrId', 'qrType', 'scannerHash', 'outcome', 'scannedAt', 'amount', 'currency'
        ])
        && tkNewGet('qrType', '') == 'p2p'
        && tkNewGet('outcome', '') in [
          'parsed', 'invalid', 'expired', 'payment_completed', 'payment_failed'
        ]
        && tkNewGet('scannerHash', '').matches('^[0-9a-f]{64}$');
      // Owner-only reads — no per-user browsing, even of hashes.
      allow read: if isOwner();
      allow update, delete: if false;
    }

    match /qrScanStats/{qrId} {
      // Any signed-in user may create the aggregate doc for a QR they scanned.
      allow create: if isLoggedIn()
        && tkNewGet('qrId', '') == qrId
        && reqKeys().hasOnly([
          'qrId', 'qrType', 'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'firstSeenAt', 'receiverId'
        ]);
      // Any signed-in user may fold a scan into the counters. Counters only
      // move forward; identity and type are immutable after creation.
      allow update: if isLoggedIn()
        && diffKeysOnly(request.resource.data, resource.data, [
          'totalScans', 'uniqueScanners', 'scannerHashes',
          'parsed', 'invalid', 'expired', 'completions', 'failures',
          'lastScannedAt', 'receiverId'
        ])
        && tkNewGet('totalScans', 0) >= tkOldGet('totalScans', 0)
        && tkNewGet('qrId', '') == tkOldGet('qrId', '')
        && tkNewGet('qrType', '') == tkOldGet('qrType', '');
      // Owner-only reads — aggregates contain no PII, but owner-only is safer.
      allow read: if isOwner();
      allow delete: if false;
    }

  }
}