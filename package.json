{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "server": "tsx server/index.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postbuild": "node scripts/generate-sitemap.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "firebase emulators:exec --project demo-sanatanibandhan \"jest\"",
    "test:rules": "firebase emulators:exec --project demo-sanatanibandhan \"jest tests/firestore.rules.spec.ts\""
  },
  "dependencies": {
