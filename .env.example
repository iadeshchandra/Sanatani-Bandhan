# Sanatani Bandhan Environment Variables
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Phase 21 — Cloud Production Wiring
# The app is offline-first by default. To enable centralized cloud sync and
# JWT-authenticated control-plane APIs, set VITE_CLOUD_API_BASE_URL.
# ---------------------------------------------------------------------------

# Base URL of the cloud control-plane API (e.g. https://api.sanatanibandhan.org).
# When EMPTY, cloud mode is disabled: the app runs in Firebase-direct mode and
# offline mutations are only logged/queued locally (no network traffic).
VITE_CLOUD_API_BASE_URL=

# Per-request timeout for cloud API calls, in milliseconds. Default: 15000.
# Requests that exceed this are aborted (AbortController) and retried as
# transient failures with exponential backoff + jitter.
VITE_CLOUD_REQUEST_TIMEOUT_MS=15000

# Max mutations flushed per POST /v1/sync/mutations batch. Default: 50.
# Lower this on very slow links; the outbox queue flushes one batch at a time.
VITE_CLOUD_SYNC_BATCH_SIZE=50

# Seconds before JWT expiry at which the cloud access token is proactively
# refreshed (via POST /v1/auth/refresh). Default: 60.
# On refresh failure the token is cleared and a 'sanatani:cloud-auth-required'
# event fires so the UI can nudge the user to re-login.
VITE_CLOUD_JWT_REFRESH_SKEW_SEC=60

# ---------------------------------------------------------------------------
# Phase 21S — Security Hardening (SERVER-ONLY; never use VITE_ prefix here)
# These values are read by the Express API (server/). Exposing them to the
# client bundle would defeat their purpose.
# ---------------------------------------------------------------------------

# Pepper mixed into the SHA-256 hash of workspace admin PINs
# (POST /api/auth/verify-pin, POST /api/admin/tenants/:id/pin).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for admin PIN login — the server fails closed (503) when unset.
PIN_PEPPER=

# Optional server-side PIN for DEMO_* sandbox workspaces. When set, demo PIN
# login is verified against its peppered hash; when empty, PIN login is
# disabled for demo workspaces entirely. Never ship a real value to clients.
DEMO_ADMIN_PIN=

# WebAuthn relying-party configuration for device biometrics
# (FaceID / TouchID / Windows Hello) in useBiometricAuth.
# WEBAUTHN_RP_ID should be the registrable domain (no scheme, no port),
# e.g. app.sanatanibandhan.org. Defaults to window.location.hostname.
WEBAUTHN_RP_ID=
# Expected origin for future server-side FIDO2 assertion verification,
# e.g. https://app.sanatanibandhan.org
WEBAUTHN_ORIGIN=

# ---------------------------------------------------------------------------
# SECURITY P1 — Firebase App Check (OPTIONAL, dormant when empty)
# When a reCAPTCHA Enterprise site key is set, the web client initialises
# App Check (lib/appCheck.ts) so Firebase can verify requests come from
# the real app. Empty = no behaviour change (the $0 default). Enforcement
# is switched on separately in the Firebase console — see ARCHITECTURE.md.
# ---------------------------------------------------------------------------
VITE_FIREBASE_APPCHECK_SITE_KEY=
